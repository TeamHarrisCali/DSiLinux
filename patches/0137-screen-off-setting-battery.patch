 {
 	int n = nchoices();
@@ -287,7 +319,7 @@ static void add_btn(int x, int y, int w, int h, int id)
 	btns[nbtn++].id = id;
 }
 
-enum { B_BR_M = 1, B_BR_P, B_PD_M, B_PD_P, B_DK_M, B_DK_P, B_TH, B_TM, B_DD, B_DMO, B_DY, B_SOUND };
