 	else if (desk < NCOLOURS + NPATTERNS)
@@ -172,6 +180,13 @@ static void load_conf(char *kind, char *path, int *n)
 		} else if (!strncmp(line, "padgain=", 8)) {
 			padgain = atoi(line + 8);
 			have_padgain = 1;
+		} else if (!strncmp(line, "screenoff=", 10)) {
+			int v = atoi(line + 10), k;
+
