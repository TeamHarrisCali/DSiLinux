 		} else if (!strncmp(line, "desktop=", 8) && line[8] && line[9] == ':') {
 			*kind = line[8];
 			if (*kind == 'F')
@@ -229,6 +244,23 @@ static void set_padgain(int v)
 		save_conf();
 }
 
+static void set_sleep(int i)
+{
+	char cmd[24];
+
+	if (i < 0)
+		i = 0;
+	if (i >= NSLEEP)
+		i = NSLEEP - 1;
+	sleep_i = i;
+	sprintf(cmd, "sleep %d\n", sleep_secs[i]);
+	proc_set(cmd);
+	if (!applying) {
+		have_sleep = 1;
+		save_conf();
+	}
+}
+
