 	w95_fill(win, gc, W95_FACE, 0, y, WIN_W, ROWH * 2);
 	nbtn = FIXED_BTNS;				/* the clock buttons are rebuilt below */
@@ -336,7 +368,7 @@ static void draw_clock(void)
 	w95_button(win, gc, PLUSX + 22, y, 20, BTNH, "M+", 0);
 	add_btn(PLUSX, y, 20, BTNH, B_TH);
 	add_btn(PLUSX + 22, y, 20, BTNH, B_TM);
-	y = ROWY(4);
+	y = ROWY(5);
 	sprintf(t, "%04d-%02d-%02d", tm->tm_year + 1900, tm->tm_mon + 1, tm->tm_mday);
 	w95_text(win, gc, W95_DARK, RX0, y + 2, "Date");
 	w95_box(win, gc, VALX, y, VALW, BTNH, 1, W95_WHITEFILL);
@@ -356,20 +388,21 @@ static void draw_info(void)
 	FILE *f;
 	long total = 0, freem = 0;
 	char l[80];
-	int y = ROWY(5) + 2;
+	int y = ROWY(6) + 2;
+	char b[24], v[16];
 
-	w95_fill(win, gc, W95_FACE, 0, y, WIN_W, th * 3 + 8);
+	w95_fill(win, gc, W95_FACE, 0, y, WIN_W, th * 2 + 6);
 	proc_info(&in);
 	if (in.battery >= 0)
-		sprintf(t, "Battery %d%%%s", in.battery * 100 / 15, in.charger ? "  (external power)" : "");
+		sprintf(b, "Battery %d%%%s", in.battery * 100 / 15, in.charger ? " (charging)" : "");
 	else
-		strcpy(t, "Battery: unknown");
-	w95_text(win, gc, W95_DARK, RX0, y, t);
+		strcpy(b, "Battery ?");
 	if (in.volume >= 0)
-		sprintf(t, "Volume %d%% (the DSi's volume buttons)", in.volume * 100 / 31);
+		sprintf(v, "Volume %d%%", in.volume * 100 / 31);
 	else
-		strcpy(t, "Volume: unknown");
-	w95_text(win, gc, W95_DARK, RX0, y + th + 1, t);
+		strcpy(v, "Volume ?");
+	sprintf(t, "%s   %s", b, v);
+	w95_text(win, gc, W95_DARK, RX0, y, t);
 	f = fopen("/proc/meminfo", "r");
 	if (f) {
 		while (fgets(l, sizeof(l), f)) {
@@ -381,7 +414,7 @@ static void draw_info(void)
 		fclose(f);
 	}
 	sprintf(t, "Memory %ld of %ld kB free", freem, total);
-	w95_text(win, gc, W95_DARK, RX0, y + 2 * (th + 1), t);
+	w95_text(win, gc, W95_DARK, RX0, y + th + 1, t);
 }
 
 static void draw_all(void)
@@ -399,6 +432,8 @@ static void draw_all(void)
 	choice_name(desk, t, sizeof(t));
 	t[11] = 0;
 	draw_value(2, t);
+	draw_spin(3, "Screen off", B_SO_M, B_SO_P);
+	draw_value(3, sleep_name[sleep_i]);
 	w95_button(win, gc, RX0, WIN_H - BTNH - 4, 70, BTNH, "Sound test", 0);
 	add_btn(RX0, WIN_H - BTNH - 4, 70, BTNH, B_SOUND);
 	draw_clock();
@@ -418,6 +453,8 @@ static void refresh_row(int row)
 		choice_name(desk, t, sizeof(t));
 		t[11] = 0;
 		draw_value(2, t);
+	} else if (row == 3) {
+		draw_value(3, sleep_name[sleep_i]);
