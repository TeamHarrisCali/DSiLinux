@@ -430,6 +467,8 @@ static void act(int id)
 	case B_PD_P: set_padgain(padgain + 1); refresh_row(1); break;
 	case B_DK_M: set_desk(desk - 1); refresh_row(2); break;
 	case B_DK_P: set_desk(desk + 1); refresh_row(2); break;
+	case B_SO_M: set_sleep(sleep_i - 1); refresh_row(3); break;
+	case B_SO_P: set_sleep(sleep_i + 1); refresh_row(3); break;
 	case B_TH: adjust_time(3600, 0); draw_clock(); break;
 	case B_TM: adjust_time(60, 0); draw_clock(); break;
 	case B_DD: adjust_time(86400, 0); draw_clock(); break;
@@ -456,6 +495,7 @@ static int apply(void)
 		set_brightness(brightness);
 	if (have_padgain)
 		set_padgain(padgain);
+	set_sleep(sleep_i);			/* the saved choice, or 2 minutes */
 	return 0;
 }
 
@@ -536,16 +576,16 @@ int main(int argc, char **argv)
 				}
 				break;
 			case MWKEY_DOWN:
-				if (focus < 2) {
+				if (focus < 3) {
 					focus++;
 					draw_all();
 				}
 				break;
 			case MWKEY_LEFT:
-				act(focus == 0 ? B_BR_M : (focus == 1 ? B_PD_M : B_DK_M));
+				act(focus == 0 ? B_BR_M : focus == 1 ? B_PD_M : focus == 2 ? B_DK_M : B_SO_M);
 				break;
 			case MWKEY_RIGHT:
-				act(focus == 0 ? B_BR_P : (focus == 1 ? B_PD_P : B_DK_P));
+				act(focus == 0 ? B_BR_P : focus == 1 ? B_PD_P : focus == 2 ? B_DK_P : B_SO_P);
 				break;
 			}
 			break;
diff --git a/vendors/Nintendo/DSI/dsautolog.c b/vendors/Nintendo/DSI/dsautolog.c
index 4a98fdee3..3b1d413ed 100644
--- a/vendors/Nintendo/DSI/dsautolog.c
+++ b/vendors/Nintendo/DSI/dsautolog.c
@@ -4,6 +4,9 @@
  * started savelog every 10 s: two more shells and some twenty programs each time, several copied from the card into RAM, even when
  * nothing had changed. Here a change means: the kernel's messages (a checksum) or the size or time of one of the logs savelog
  * collects; otherwise it saves every 5 minutes. savelog still skips while a recording runs (/tmp/rec.lock).
+ * Low battery (docs/SLEEP-LOCK-PLAN.md step 5): the DSi's power micro reports 15 (full), 11, 7, 3 (low), 1 (critical) and 0. At 1 or
+ * below, not charging, on two checks in a row (20 s), it runs /boot/shutdown (save the log, sync, power off) instead of letting the DSi
+ * lose power in the middle of a card write.
  * Started by /boot/rc in the background; prints nothing (text from a background program would be drawn over the desktop).
  * Built by scripts/build-tools.sh.
  */
@@ -42,13 +45,27 @@ static unsigned long signature(void)
 	return h;
 }
 
-static void save(void)
+/* 1 when the battery is critical and not charging (from /proc/dsisettings) */
+static int battery_critical(void)
+{
+	FILE *f = fopen("/proc/dsisettings", "r");
+	int b = -1, c = 0;
+
+	if (!f)
+		return 0;
+	if (fscanf(f, "battery=%d charger=%d", &b, &c) < 2)
+		b = -1;
+	fclose(f);
+	return b >= 0 && b <= 1 && !c;
+}
+
+static void run(const char *path, const char *arg)
 {
 	pid_t pid = vfork();
 	int status;
 
 	if (pid == 0) {
-		execl("/boot/savelog", "savelog", "quiet", (char *)0);
+		execl(path, path, arg, (char *)0);
 		_exit(127);
 	}
 	if (pid > 0)
@@ -56,9 +73,15 @@ static void save(void)
 			;
 }
 
+static void save(void)
+{
+	run("/boot/savelog", "quiet");
+}
+
 int main(void)
 {
 	unsigned long last = 0, sig;
+	int low = 0;
 	time_t saved = time(NULL);
 	int fd = open("/dev/null", O_RDWR);
 
@@ -72,6 +95,19 @@ int main(void)
 	last = signature();
 	for (;;) {
 		sleep(10);
+		if (battery_critical()) {
+			if (++low == 2) {
+				FILE *f = fopen("/tmp/desktop.log", "a");
+
+				if (f) {
+					fprintf(f, "dsautolog: battery critical, not charging: shutting down\n");
+					fclose(f);
+				}
+				run("/boot/shutdown", (char *)0);
+			}
+		} else {
+			low = 0;
+		}
 		sig = signature();
 		if (sig != last || time(NULL) - saved >= 300) {
 			save();
-- 
