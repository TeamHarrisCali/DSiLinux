From 837d1089fa210e8b1ab84373d4755f3866d39dfd Mon Sep 17 00:00:00 2001
From: TeamHarrisCali <34009957+TeamHarrisCali@users.noreply.github.com>
Date: Fri, 13 Nov 2026 11:21:09 -0600
Subject: [PATCH] DSi Wi-Fi chip: HTC services, WMI ready and a first scan

Step 4 of docs/ATHEROS-PLAN.md, after dswifi's htc.twl.c and wmi.twl.c:
- ARM7 ops 11 (send a mailbox packet, byte by byte to the addresses
  ending at 0x3FFF), 12 (receive one: wait for the RX FIFO, read the
  lookahead header, read the packet from 0xFF), 13 (read an internal word).
- ARM9: after the firmware is ready, read the HTC ready message, connect
  the five services, setup complete; wait for the WMI ready event (MAC) and
  the regulatory domain; write protocol version 3 where host interest +0
  points; scan parameters, debug log off; then per channel 1-13: channel,
  scan parameters, BSS filter "all", start scan, collect BSS info events
  (channel, RSSI, SNR, BSSID, SSID, open/WEP/WPA/WPA2 from the RSN and WPA
  elements) until scan complete. Up to 16 networks in the log.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 linux-2.6.x/arch/arm/mach-nds/arm7/twlwifi.c |  62 ++++-
 linux-2.6.x/arch/arm/mach-nds/dsiwifi.c      | 273 ++++++++++++++++++-
 linux-2.6.x/drivers/block/dldi_c.c           |  12 +
 3 files changed, 343 insertions(+), 4 deletions(-)

diff --git a/linux-2.6.x/arch/arm/mach-nds/arm7/twlwifi.c b/linux-2.6.x/arch/arm/mach-nds/arm7/twlwifi.c
index e7f55714f..735bfafa3 100644
--- a/linux-2.6.x/arch/arm/mach-nds/arm7/twlwifi.c
+++ b/linux-2.6.x/arch/arm/mach-nds/arm7/twlwifi.c
@@ -67,6 +67,7 @@
 #define C_CMD52		(52 | (4 << 8))
 
 /* Atheros function-1 registers */
+#define F1_HOST_INT_STATUS	0x400
 #define F1_RX_LOOKAHEAD_VALID	0x405
 #define F1_RX_LOOKAHEAD0	0x408
 #define F1_COUNT4		0x450	/* mailbox 0 credit counter (reading takes one credit) */
@@ -424,6 +425,50 @@ static int bmi_read(u32 addr, u8 *out, u32 len)
 	return 0;
 }
 
+/*
+ * Mailbox packets once the firmware runs (HTC): a 6-byte header (endpoint, flags, length, trailer length, 0) and the payload, padded to
+ * 0x80-byte blocks. Sent byte by byte to the addresses that end at 0x3FFF (the end-of-message address), as dswifi's byte mode does;
+ * received byte by byte from 0xFF once the RX lookahead says a packet is there. Slow, but simple; block transfers can come later.
+ */
+static void mbox_send(const u8 *p, u32 len)
+{
+	u32 a = 0x4000 - len, i;
+
+	for (i = 0; i < len; i++)
+		wr8(1, a + i, p[i]);
+}
+
+/* returns the packet's header word (0 = none within ms milliseconds); the packet (rounded up to 0x80, at most 2048 bytes) goes to out */
+static u32 mbox_recv(u8 *out, u32 ms)
+{
+	u32 t, hdr, len, full, i;
+
+	for (t = 0; t < ms * 4; t++) {			/* about 250 us per look */
+		if (rd8(1, F1_HOST_INT_STATUS) & 1)
+			break;
+		if (st & 4)
+			return 0;
+		tdelay(400);
+	}
+	if (t == ms * 4)
+		return 0;
+	hdr = rd32(1, F1_RX_LOOKAHEAD0);
+	len = hdr >> 16;
+	if (len > 2048 - 6)				/* nonsense: drop four bytes so the FIFO moves on */
+		len = 0;
+	full = (len + 6 + 0x7F) & ~0x7Fu;
+	if (full > 2048)
+		full = 2048;
+	for (i = 0; i < full; i++) {
+		for (t = 0; t < 1000 && !(rd8(1, F1_HOST_INT_STATUS) & 1) && !(st & 4); t++)
+			;
+		out[i] = rd8(1, 0xFF);
+		if (st & 4)
+			return 0;
+	}
+	return hdr ? hdr : 0xFFFFFFFF;
+}
+
 /* start the firmware (BMI done) and wait for it: steps 13-15 of a run, and the "finish" operation after an upload */
 static void twl_finish(u32 *touch, u32 *diag, u32 *info, u32 hi)
 {
@@ -463,8 +508,10 @@ static void twl_finish(u32 *touch, u32 *diag, u32 *info, u32 hi)
  * Operations while held in BMI (request count = op, sector = address, touch[0] = length or argument, data = bytes up to 2048):
  *   2 write memory, 3 LZ stream start, 4 LZ data, 5 execute (answer in info[0]), 6 set app start, 7 write a word (touch[0]),
  *   8 finish (start the firmware, wait; results like a run), 9 release.
- *   10 read back up to 64 bytes (answer in touch[] then diag[]).
- * info[1] = 0 done, 1 not held, 2 the card stopped answering (st & 4), 3 no answer from BMI; info[2] = commands sent without a credit.
+ *   10 read back up to 64 bytes (answer in touch[] then diag[]), 11 send a mailbox packet (data, arg bytes), 12 receive one (wait arg ms;
+ *   info[0] = its header word, the packet in data), 13 read an internal word (info[0]).
+ * info[1] = 0 done, 1 not held, 2 the card stopped answering (st & 4), 3 no answer from BMI, 5 no packet; info[2] = commands sent without a
+ * credit.
  */
 void twl_wifi_op(u32 op, u32 addr, u32 *touch, u32 *diag, u32 *info, const u8 *data)
 {
@@ -496,6 +543,17 @@ void twl_wifi_op(u32 op, u32 addr, u32 *touch, u32 *diag, u32 *info, const u8 *d
 		if (bmi_lz_data(data, arg > 2048 ? 2048 : arg))
 			info[1] = 4;
 		break;
+	case 11:					/* send a mailbox packet (header included, a multiple of 0x80 bytes) */
+		mbox_send(data, arg > 2048 ? 2048 : arg);
+		break;
+	case 12:					/* receive one mailbox packet: wait up to arg ms */
+		info[0] = mbox_recv((u8 *)data, arg);
+		if (!info[0])
+			info[1] = 5;
+		break;
+	case 13:					/* read an internal word: answer in info[0] */
+		info[0] = intern_rd(addr);
+		break;
 	case 10:					/* read back up to 64 bytes into touch[] and diag[] */
 		if (bmi_read(addr, (u8 *)touch, arg > 32 ? 32 : arg) ||
 		    (arg > 32 && bmi_read(addr + 32, (u8 *)diag, arg - 32 > 32 ? 32 : arg - 32)))
diff --git a/linux-2.6.x/arch/arm/mach-nds/dsiwifi.c b/linux-2.6.x/arch/arm/mach-nds/dsiwifi.c
index 494e68c8b..36ea29867 100644
--- a/linux-2.6.x/arch/arm/mach-nds/dsiwifi.c
+++ b/linux-2.6.x/arch/arm/mach-nds/dsiwifi.c
@@ -33,6 +33,8 @@
 extern int dsisd_twlwifi(unsigned int *out, int report);
 extern int dsisd_twlop(unsigned int op, unsigned int addr, unsigned int arg, const unsigned char *data, unsigned int len,
 		       unsigned int *out);
+extern int dsisd_twlop_rx(unsigned int op, unsigned int addr, unsigned int arg, const unsigned char *data, unsigned int len,
+			  unsigned int *out, unsigned char *rxbuf);
 
 #define FW_MAX	131072
 static unsigned char *fw;
@@ -41,7 +43,7 @@ static unsigned int fw_len;
 static unsigned int twl_d[19];
 static int twl_ret = -100;	/* -100 = not run yet, -101 = refused (nds up) */
 
-static char ulog[2048];
+static char ulog[2900];	/* with the run table (about 900 bytes) it must fit the 4 KB /proc page */
 static int ulog_len;
 
 static const char *twl_step[] = { "nothing", "power, antenna", "RTC clock output (FOUT)", "power chip register 0x30", "SCFG_WL",
@@ -63,6 +65,19 @@ static void lg(const char *fmt, unsigned int a, unsigned int b, unsigned int c)
 	}
 }
 
+/* a ready-made line into the log */
+static void lgs(const char *line)
+{
+	int n = strlen(line);
+
+	printk(KERN_INFO "dsiwifi2: %s", line);
+	if (ulog_len + n < (int)sizeof(ulog) - 1) {
+		memcpy(ulog + ulog_len, line, n);
+		ulog_len += n;
+		ulog[ulog_len] = 0;
+	}
+}
+
 static const char *twl_chip(unsigned int id)
 {
 	return id == 0x0D000000 ? "AR6013" : id == 0x0D000001 ? "AR6014" : id == 0x02000001 ? "AR6002" : "unknown";
@@ -136,6 +151,254 @@ static void write_part(const char *name, unsigned int addr, const unsigned char
 	(void)name;
 }
 
+/*
+ * Step 4: HTC and WMI with the running firmware (after dswifi's arm7/twl/ath/htc.twl.c and wmi.twl.c). A mailbox packet: endpoint
+ * (0 HTC, 1 WMI control, 2.. data), flags (1 = an acknowledgement is wanted), length (u16), trailer length, 0; then the payload: a u16
+ * command or event ID and its data; padded to 0x80 bytes.
+ */
+#define HTC_MSG_READY		1
+#define HTC_MSG_CONN_SVC	2
+#define HTC_MSG_CONN_SVC_RESP	3
+#define HTC_MSG_SETUP_COMPLETE	4
+#define WMI_START_SCAN_CMD	0x0007
+#define WMI_SET_SCAN_PARAMS_CMD	0x0008
+#define WMI_SET_BSS_FILTER_CMD	0x0009
+#define WMI_SET_PROBED_SSID_CMD	0x000A
+#define WMI_SET_CHANNEL_PARAMS_CMD 0x0011
+#define WMI_TARGET_ERROR_REPORT_BITMASK_CMD 0x0022
+#define WMI_WMIX_CMD		0x002E
+#define WMI_SET_HEARTBEAT_TIMEOUT_CMD 0x0047
+#define WMI_READY_EVENT		0x1001
+#define WMI_BSS_INFO_EVENT	0x1004
+#define WMI_CMD_ERROR_EVENT	0x1005
+#define WMI_REG_DOMAIN_EVENT	0x1006
+#define WMI_SCAN_COMPLETE_EVENT	0x100A
+
+static unsigned char pkt[2048], rx[2048];
+
+#define MAXNET	24
+static struct net2 {
+	unsigned char bssid[6];
+	int channel, rssi, snr;
+	char sec[5];			/* open, wep, wpa, wpa2 */
+	char ssid[33];
+} nets[MAXNET];
+static int nnets;
+static unsigned char mac[6];
+static int wmi_ready, reg_domain, scan_done;
+
+static void mbox_out(int endpoint, int ack, unsigned int id, const void *data, unsigned int len, int *bad)
+{
+	unsigned int full = (len + 8 + 0x7F) & ~0x7Fu;
+
+	memset(pkt, 0, full);
+	pkt[0] = endpoint;
+	pkt[1] = ack;
+	pkt[2] = (len + 2) & 0xff;
+	pkt[3] = (len + 2) >> 8;
+	pkt[6] = id & 0xff;
+	pkt[7] = id >> 8;
+	if (len)
+		memcpy(pkt + 8, data, len);
+	op(11, 0, full, pkt, full, bad);
+}
+
+static int wifi_mhz_to_channel(unsigned int mhz)
+{
+	return mhz == 2484 ? 14 : 1 + (int)(mhz - 2412) / 5;
+}
+
+static void bss_info(const unsigned char *d, int len)
+{
+	/* u16 channel (MHz), u8 frame type, u8 snr, s16 rssi, u8 bssid[6], u32 ieMask; then the beacon: u64 timestamp, u16 interval,
+	 * u16 capability, elements */
+	struct net2 n;
+	const unsigned char *e;
+	int left, i;
+
+	if (len < 16 + 12)
+		return;
+	memset(&n, 0, sizeof(n));
+	n.channel = wifi_mhz_to_channel(d[0] | (d[1] << 8));
+	n.snr = d[3];
+	n.rssi = (short)(d[4] | (d[5] << 8));
+	memcpy(n.bssid, d + 6, 6);
+	strcpy(n.sec, (d[16 + 10] & 0x10) ? "wep" : "open");	/* capability: privacy */
+	e = d + 16 + 12;
+	left = len - 16 - 12;
+	while (left >= 2) {
+		int id = e[0], l = e[1];
+
+		if (l + 2 > left)
+			break;
+		if (id == 0 && l <= 32) {
+			for (i = 0; i < l; i++)
+				n.ssid[i] = (e[2 + i] >= 32 && e[2 + i] < 127) ? e[2 + i] : '?';
+			n.ssid[l] = 0;
+		} else if (id == 48) {			/* RSN */
+			strcpy(n.sec, "wpa2");
+		} else if (id == 221 && l >= 4 && e[2] == 0x00 && e[3] == 0x50 && e[4] == 0xF2 && e[5] == 1 && strcmp(n.sec, "wpa2")) {
+			strcpy(n.sec, "wpa");		/* the WPA vendor element */
+		}
+		e += l + 2;
+		left -= l + 2;
+	}
+	for (i = 0; i < nnets; i++)
+		if (!memcmp(nets[i].bssid, n.bssid, 6)) {
+			if (n.rssi > nets[i].rssi)
+				nets[i] = n;
+			return;
+		}
+	if (nnets < MAXNET)
+		nets[nnets++] = n;
+}
+
+/* receive and handle packets until "want" happened or ms ran out; returns 1 if it happened */
+static int pump(int ms, int *flag, int *bad)
+{
+	int rounds;
+
+	for (rounds = 0; rounds < 64 && !*flag; rounds++) {
+		unsigned int out[19], hdr, len, alen, id;
+		int b2 = 0, r = dsisd_twlop_rx(12, 0, ms, 0, 0, out, rx);
+
+		(void)b2;
+		if (r != 0) {
+			lg("  receive: request failed (%d)\n", r, 0, 0);
+			*bad = 1;
+			return 0;
+		}
+		if (out[1] == 5)			/* nothing within ms */
+			return *flag;
+		hdr = out[0];
+		len = hdr >> 16;
+		alen = (hdr >> 8) & 0xff ? rx[4] : 0;	/* trailer (acknowledgements, lookahead) */
+		if (len < alen + 2 || len > 2040)
+			continue;
+		len -= alen;
+		id = rx[6] | (rx[7] << 8);
+		if ((hdr & 0xff) == 0) {		/* HTC */
+			if (id == HTC_MSG_READY)
+				lg("  HTC ready (%u bytes: credits %u of %u bytes)\n", len - 2, rx[8] | (rx[9] << 8), rx[10] | (rx[11] << 8));
+			else if (id == HTC_MSG_CONN_SVC_RESP)
+				lg("  HTC service connected: service %04x status %u endpoint %u\n", rx[8] | (rx[9] << 8), rx[10], rx[11]);
+		} else if ((hdr & 0xff) == 1) {		/* WMI */
+			if (id == WMI_READY_EVENT) {
+				memcpy(mac, rx + 8, 6);
+				wmi_ready = 1;
+				lg("  WMI ready, MAC %02x:%02x:%02x:..\n", mac[0], mac[1], mac[2]);
+			} else if (id == WMI_REG_DOMAIN_EVENT) {
+				reg_domain = 1;
+				lg("  WMI regulatory domain %08x\n", w32(rx + 8), 0, 0);
+			} else if (id == WMI_BSS_INFO_EVENT) {
+				bss_info(rx + 8, len - 2);
+			} else if (id == WMI_SCAN_COMPLETE_EVENT) {
+				scan_done = 1;
+			} else if (id == WMI_CMD_ERROR_EVENT) {
+				lg("  WMI command error: command %04x error %u\n", rx[8] | (rx[9] << 8), rx[10], 0);
+			}
+		}
+	}
+	return *flag;
+}
+
+static void wmi_scan(int *bad)
+{
+	static const unsigned short mhz[13] = { 2412, 2417, 2422, 2427, 2432, 2437, 2442, 2447, 2452, 2457, 2462, 2467, 2472 };
+	unsigned char b[40];
+	int c, i;
+	unsigned int v;
+
+	nnets = 0;
+	v = 0x7F;
+	mbox_out(1, 1, WMI_TARGET_ERROR_REPORT_BITMASK_CMD, &v, 4, bad);
+	v = 0;
+	mbox_out(1, 1, WMI_SET_HEARTBEAT_TIMEOUT_CMD, &v, 4, bad);
+	memset(b, 0, sizeof(b));
+	mbox_out(1, 1, WMI_SET_BSS_FILTER_CMD, b, 8, bad);		/* none while setting up */
+	mbox_out(1, 1, WMI_SET_PROBED_SSID_CMD, b, 35, bad);		/* entry 0, no SSID: any */
+	for (c = 0; c < 13 && !*bad; c++) {
+		/* channel params: reserved, scanparam, phy mode 3 (11ag, as dswifi), 1 channel, its MHz */
+		memset(b, 0, sizeof(b));
+		b[2] = 3;
+		b[3] = 1;
+		b[4] = mhz[c] & 0xff;
+		b[5] = mhz[c] >> 8;
+		mbox_out(1, 1, WMI_SET_CHANNEL_PARAMS_CMD, b, 6, bad);
+		/* scan params: fg start/end, bg period 0xFFFF, max active dwell 20, passive dwell 50, short scan ratio 3, flags 1, min active 0 */
+		memset(b, 0, sizeof(b));
+		for (i = 0; i < 6; i++)
+			b[i] = 0xFF;
+		b[6] = 20;
+		b[8] = 50;
+		b[10] = 3;
+		b[11] = 1;
+		mbox_out(1, 1, WMI_SET_SCAN_PARAMS_CMD, b, 20, bad);
+		memset(b, 0, sizeof(b));
+		b[0] = 1;					/* all BSSs */
+		mbox_out(1, 1, WMI_SET_BSS_FILTER_CMD, b, 8, bad);
+		memset(b, 0, sizeof(b));
+		b[8] = 20;					/* home dwell time */
+		mbox_out(1, 1, WMI_START_SCAN_CMD, b, 20, bad);
+		scan_done = 0;
+		pump(400, &scan_done, bad);
+	}
+	lg("  scanned 13 channels: %u networks\n", nnets, 0, 0);
+	for (i = 0; i < nnets && i < 16; i++) {
+		char line[96];
+
+		snprintf(line, sizeof(line), "    ch %2d rssi %4d snr %3d %-4s %s\n", nets[i].channel, nets[i].rssi, nets[i].snr, nets[i].sec,
+			 nets[i].ssid[0] ? nets[i].ssid : "(hidden)");
+		lgs(line);
+	}
+}
+
+/* after the firmware started: HTC services, WMI ready, then a scan */
+static void htc_wmi(unsigned int hi, int *bad)
+{
+	static const unsigned char svc[5][6] = {
+		{ 0x0, 0x1, 0x0, 0, 0, 0 }, { 0x1, 0x1, 0x5, 0, 0, 0 }, { 0x2, 0x1, 0x5, 0, 0, 0 },
+		{ 0x3, 0x1, 0x5, 0, 0, 0 }, { 0x4, 0x1, 0x5, 0, 0, 0 } };
+	int i, once = 0, got;
+
+	wmi_ready = reg_domain = 0;
+	got = 0;
+	pump(1000, &got, bad);					/* the HTC ready message that is waiting */
+	for (i = 0; i < 5 && !*bad; i++) {
+		mbox_out(0, 0, HTC_MSG_CONN_SVC, svc[i], 6, bad);
+		once = 0;
+		pump(300, &once, bad);				/* its answer (logged); "once" is never set: one pass */
+	}
+	mbox_out(0, 0, HTC_MSG_SETUP_COMPLETE, 0, 0, bad);
+	pump(2000, &reg_domain, bad);				/* WMI ready, then the regulatory domain */
+	if (!wmi_ready)
+		lg("  no WMI ready event\n", 0, 0, 0);
+	if (!reg_domain) {
+		lg("  no regulatory domain event: no scan\n", 0, 0, 0);
+		return;
+	}
+	{	/* as dswifi after the regulatory domain: protocol version 3 at the address host interest +0 points to */
+		unsigned int a = op(13, hi, 0, 0, 0, bad);
+
+		op(7, a, 3, 0, 0, bad);
+	}
+	{
+		unsigned char b[20];
+		unsigned int dbg[3] = { 0x2009, 0xFFFFFFFF, 0 };	/* WMIX debug log off */
+		int k;
+
+		memset(b, 0, sizeof(b));
+		for (k = 0; k < 6; k++)
+			b[k] = 0xFF;
+		b[6] = 20;
+		b[8] = 50;
+		b[10] = 3;
+		mbox_out(1, 1, WMI_SET_SCAN_PARAMS_CMD, b, 20, bad);
+		mbox_out(1, 1, WMI_WMIX_CMD, dbg, 12, bad);
+	}
+	wmi_scan(bad);
+}
+
 static void upload(void)
 {
 	unsigned int *g = twl_d + 8, *in = twl_d + 16, chip, ver, n, i, k;
@@ -258,6 +521,10 @@ static void upload(void)
 		g[4] = ver;
 		lg("start: request %d, step %u, ready %u\n", r, in[0] & 0xff, g[5]);
 		lg("  EEPROM at %08x version %08x, first mailbox word %08x\n", twl_d[5], g[6], twl_d[7]);
+		if (g[5] == 1) {
+			bad = 0;
+			htc_wmi(hi, &bad);
+		}
 	}
 release:
 	op(9, 0, 0, 0, 0, &bad);
@@ -290,7 +557,9 @@ static int twl_read_proc(char *page, char **start, off_t off, int count, int *eo
 			      (in[2] & 4) ? "yes" : "no", (in[2] & 8) ? "timed out" : "answered",
 			      t[0] & 0xff, t[1], t[2] & 0xff, g[0], g[1], twl_chip(g[1]), t[4], g[2], g[3], g[4],
 			      g[5], t[6], t[5], g[6], g[7] & 0xff, t[7], in[1], t[3]);
-	len += sprintf(page + len, "firmware file: %u bytes\n%s", fw_len, ulog);
+	len += snprintf(page + len, PAGE_SIZE - len, "firmware file: %u bytes\n%s", fw_len, ulog);
+	if (len > PAGE_SIZE - 1)
+		len = PAGE_SIZE - 1;
 	*eof = 1;
 	if (off >= len)
 		return 0;
diff --git a/linux-2.6.x/drivers/block/dldi_c.c b/linux-2.6.x/drivers/block/dldi_c.c
index 50bf55c1a..c2226a3b3 100644
--- a/linux-2.6.x/drivers/block/dldi_c.c
+++ b/linux-2.6.x/drivers/block/dldi_c.c
@@ -290,7 +290,17 @@ int dsisd_twlwifi(unsigned int *out, int report)
 
 /* One firmware upload operation on the ARM7 (arm7/twlwifi.c, twl_wifi_op): op 2..9, addr, arg (a length for 2 and 4, else the argument),
  * up to 2048 data bytes. out[0..2] = info (answer, status, flags); with op 8 (finish) also out[3..18] like a run (touch, diag). 0 = ok. */
+int dsisd_twlop_rx(unsigned int op, unsigned int addr, unsigned int arg, const unsigned char *data, unsigned int len, unsigned int *out,
+		   unsigned char *rxbuf);
+
 int dsisd_twlop(unsigned int op, unsigned int addr, unsigned int arg, const unsigned char *data, unsigned int len, unsigned int *out)
+{
+	return dsisd_twlop_rx(op, addr, arg, data, len, out, 0);
+}
+
+/* the same, and for op 12 the received packet (2048 bytes) into rxbuf */
+int dsisd_twlop_rx(unsigned int op, unsigned int addr, unsigned int arg, const unsigned char *data, unsigned int len, unsigned int *out,
+		   unsigned char *rxbuf)
 {
