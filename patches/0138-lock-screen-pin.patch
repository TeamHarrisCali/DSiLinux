diff --git a/linux-2.6.x/arch/arm/mach-nds/screensleep.c b/linux-2.6.x/arch/arm/mach-nds/screensleep.c
index b62c0b0b9..d1e9ae5b7 100644
--- a/linux-2.6.x/arch/arm/mach-nds/screensleep.c
+++ b/linux-2.6.x/arch/arm/mach-nds/screensleep.c
@@ -11,11 +11,13 @@
 #include <linux/init.h>
 #include <linux/timer.h>
 #include <linux/jiffies.h>
+#include <linux/proc_fs.h>
 #include <asm/arch/fifo.h>
 
 int nds_sleep_secs = 120;	/* 0 = never; the Settings app sets the saved choice at every desktop start */
 int nds_screen_is_off;
 int nds_lid_closed;
+static unsigned int lid_closes;	/* how often the lid was closed since boot: /proc/dslid, for the lock screen (dsdesk polls it) */
 static unsigned long last_input;
 static struct timer_list ss_timer;
 
@@ -58,12 +60,25 @@ void nds_lid(int closed)
 	if (closed == nds_lid_closed)
 		return;
 	nds_lid_closed = closed;
-	if (closed)
+	if (closed) {
+		lid_closes++;
 		nds_screen_off();
-	else
+	} else
 		nds_screen_on();
 }
 
+/* /proc/dslid: "lid=open|closed closes=N", cheap to read (no ARM7 request): the taskbar starts the lock screen when N goes up */
+static int dslid_read_proc(char *page, char **start, off_t off, int count, int *eof, void *data)
+{
+	int len = sprintf(page, "lid=%s closes=%u\n", nds_lid_closed ? "closed" : "open", lid_closes);
+
+	*eof = 1;
+	if (off >= len)
+		return 0;
+	*start = page + off;
+	return len - off;
+}
+
 static void ss_tick(unsigned long data)
 {
 	if (nds_sleep_secs > 0 && !nds_screen_is_off && time_after(jiffies, last_input + (unsigned long)nds_sleep_secs * HZ))
@@ -78,6 +93,7 @@ static int __init nds_screensleep_init(void)
 	ss_timer.function = ss_tick;
 	ss_timer.expires = jiffies + HZ;
 	add_timer(&ss_timer);
+	create_proc_read_entry("dslid", 0444, NULL, dslid_read_proc, NULL);
 	return 0;
 }
 
