+		gx_material(GX_RGB(25, 3, 0), GX_RGB(6, 6, 6));
+		gx_mesh_draw(&g[0]);
+		gx_pop(1);
+
+		gx_push();
+		gx_translate(3.1, -2.0, 0.0);
+		gx_rotate('z', -2.0 * angle - 9.0);
+		gx_material(GX_RGB(0, 25, 6), GX_RGB(6, 6, 6));
+		gx_mesh_draw(&g[1]);
+		gx_pop(1);
+
+		gx_push();
+		gx_translate(-3.1, 4.2, 0.0);
+		gx_rotate('z', -2.0 * angle - 25.0);
+		gx_material(GX_RGB(6, 6, 31), GX_RGB(6, 6, 6));
+		gx_mesh_draw(&g[2]);
+		gx_pop(1);
+
+		gx_swap();
+		gx_flush();
 		angle += 2.0;
 
-		/* once a second: the rate, drawn into the window's corner (opaque text over the 3D picture) */
 		frames++;
 		if (fps_t == 0)
 			fps_t = usec();
-		else if (usec() - fps_t >= 1000000L) {
