-/*
- * Viewport and projection for the current rectangle. The engine's viewport cannot go off the screen, so a window
- * that is partly outside gets the visible part as its viewport and the matching slice of the full window's frustum:
- * the picture is clipped, not squashed. (The engine's y axis starts at the bottom.)
- */
-static void set_view(void)
-{
-	int cx1 = rx, cx2 = rx + rw - 1, cy1 = ry, cy2 = ry + rh - 1;
-	double h, s, l, r, t, b;
-
-	if (cx1 < 0) cx1 = 0;
-	if (cx2 > 255) cx2 = 255;
-	if (cy1 < 0) cy1 = 0;
-	if (cy2 > 191) cy2 = 191;
-	if (cx2 <= cx1 || cy2 <= cy1)
-		return;
-	h = (double)rh / (double)rw;		/* full window: x from -1 to 1, y from -h to h */
-	s = 2.0 / (double)rw;			/* world units per pixel at the near plane */
-	l = -1.0 + (cx1 - rx) * s;
-	r = -1.0 + (cx2 + 1 - rx) * s;
-	t = h - (cy1 - ry) * s;
-	b = h - (cy2 + 1 - ry) * s;
-	W(GX_VIEWPORT, cx1 | ((191 - cy2) << 8) | (cx2 << 16) | ((191 - cy1) << 24));
-	W(MTX_MODE, 0);
-	W(MTX_IDENTITY, 0);
-	frustum(l, r, b, t, 5.0, 60.0);
-	flush_cmds();
-}
