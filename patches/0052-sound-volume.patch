diff --git a/user/microwin/src/demos/nanox/dsplay.c b/user/microwin/src/demos/nanox/dsplay.c
new file mode 100644
index 000000000..a2a55b072
--- /dev/null
+++ b/user/microwin/src/demos/nanox/dsplay.c
@@ -0,0 +1,169 @@
+/*
+ * dsplay - sound output test and WAV player for DSLinuxDSi, through the OSS device /dev/dsp (the kernel's NDS ALSA
+ * driver with OSS emulation; the ARM7 plays the samples).
+ *   dsplay           a C major scale (the sound test: if you hear it, the speaker path works)
+ *   dsplay file.wav  play a PCM WAV (8 or 16 bit, mono or stereo, any rate the driver takes, 8000..48000)
+ * It prints what it did, so a silent run can be told apart from a failed one.
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <math.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <sys/ioctl.h>
+
+/* OSS ioctl numbers (linux/soundcard.h): the same on ARM */
+#define SNDCTL_DSP_SYNC		0x5001
+#define SNDCTL_DSP_SPEED	0xC0045002
+#define SNDCTL_DSP_SETFMT	0xC0045005
+#define SNDCTL_DSP_CHANNELS	0xC0045006
+#define AFMT_S16_LE		0x10
+
+static int dsp_open(int rate, int channels)
+{
+	int fd = open("/dev/dsp", O_WRONLY), fmt = AFMT_S16_LE, r = rate, c = channels;
+
+	if (fd < 0) {
+		perror("dsplay: /dev/dsp");
+		return -1;
+	}
+	if (ioctl(fd, SNDCTL_DSP_SETFMT, &fmt) < 0 || fmt != AFMT_S16_LE)
+		fprintf(stderr, "dsplay: 16 bit samples not accepted (format %d)\n", fmt);
+	if (ioctl(fd, SNDCTL_DSP_CHANNELS, &c) < 0 || c != channels)
+		fprintf(stderr, "dsplay: %d channel(s) not accepted (got %d)\n", channels, c);
+	if (ioctl(fd, SNDCTL_DSP_SPEED, &r) < 0)
+		perror("dsplay: speed");
+	printf("dsplay: /dev/dsp open, %d Hz, %d channel(s), 16 bit\n", r, c);
+	return fd;
+}
+
+static int put(int fd, const void *p, int n)
+{
+	const char *b = p;
+
+	while (n > 0) {
+		int w = write(fd, b, n > 4096 ? 4096 : n);
+
+		if (w <= 0) {
+			perror("dsplay: write");
+			return -1;
+		}
+		b += w;
+		n -= w;
+	}
+	return 0;
+}
+
+static int tones(void)
+{
+	static const int note[8] = { 262, 294, 330, 349, 392, 440, 494, 523 };
+	enum { RATE = 22050, LEN = RATE * 35 / 100 };
+	static short sine[256], buf[LEN];
+	int fd, i, k, phase, step;
+
+	for (i = 0; i < 256; i++)
+		sine[i] = (short)(8000.0 * sin(i * 2.0 * M_PI / 256.0));
+	fd = dsp_open(RATE, 1);
+	if (fd < 0)
+		return 1;
+	printf("dsplay: playing the scale C D E F G A B C (about 3 seconds)\n");
+	for (k = 0; k < 8; k++) {
+		phase = 0;
+		step = note[k] * 256 * 256 / RATE;		/* 8.8 fixed point phase step */
+		for (i = 0; i < LEN; i++) {
+			int s = sine[(phase >> 8) & 255];
+			int edge = i < 400 ? i : (LEN - 1 - i < 400 ? LEN - 1 - i : 400);
+
+			buf[i] = (short)(s * edge / 400);	/* short fade in and out: no clicks */
+			phase += step;
+		}
+		if (put(fd, buf, sizeof(buf)))
+			break;
+	}
+	ioctl(fd, SNDCTL_DSP_SYNC, 0);
+	close(fd);
+	printf("dsplay: done\n");
+	return 0;
+}
+
+static unsigned int le32(const unsigned char *p)
+{
+	return p[0] | (p[1] << 8) | (p[2] << 16) | ((unsigned int)p[3] << 24);
+}
+
+static int wav(const char *name)
+{
+	unsigned char h[12], ck[8], fmtb[16], in[2048];
+	short out[2048];
+	unsigned int len, rate = 0, bits = 0, chans = 0, datalen = 0;
+	int f = open(name, O_RDONLY), fd, got = 0, i, n;
+
+	if (f < 0) {
+		perror(name);
+		return 1;
+	}
+	if (read(f, h, 12) != 12 || memcmp(h, "RIFF", 4) || memcmp(h + 8, "WAVE", 4)) {
+		fprintf(stderr, "dsplay: %s is not a WAV file\n", name);
+		return 1;
+	}
+	while (read(f, ck, 8) == 8) {
+		len = le32(ck + 4);
+		if (!memcmp(ck, "fmt ", 4) && len >= 16) {
+			if (read(f, fmtb, 16) != 16)
+				break;
+			if (fmtb[0] != 1) {
+				fprintf(stderr, "dsplay: only plain PCM WAV files (format %d)\n", fmtb[0]);
+				return 1;
+			}
+			chans = fmtb[2];
+			rate = le32(fmtb + 4);
+			bits = fmtb[14];
+			lseek(f, len - 16 + (len & 1), SEEK_CUR);
+			got = 1;
+		} else if (!memcmp(ck, "data", 4)) {
+			datalen = len;
+			break;
+		} else {
+			lseek(f, len + (len & 1), SEEK_CUR);
+		}
+	}
+	if (!got || !datalen || (bits != 8 && bits != 16) || chans < 1 || chans > 2) {
+		fprintf(stderr, "dsplay: unsupported WAV (%u bit, %u channels)\n", bits, chans);
+		return 1;
+	}
+	printf("dsplay: %s: %u Hz, %u bit, %u channel(s), %u bytes\n", name, rate, bits, chans, datalen);
+	fd = dsp_open(rate, chans);
+	if (fd < 0)
+		return 1;
+	while (datalen > 0) {
+		int want = bits == 16 ? 2048 : 1024;
+
+		if ((unsigned int)want > datalen)
+			want = datalen;
+		n = read(f, in, want);
+		if (n <= 0)
+			break;
+		datalen -= n;
+		if (bits == 16) {
+			if (put(fd, in, n))
+				break;
+		} else {
+			for (i = 0; i < n; i++)
+				out[i] = (short)((in[i] - 128) << 8);	/* unsigned 8 bit -> signed 16 bit */
+			if (put(fd, out, n * 2))
+				break;
+		}
+	}
+	ioctl(fd, SNDCTL_DSP_SYNC, 0);
+	close(fd);
+	close(f);
+	printf("dsplay: done\n");
+	return 0;
+}
+
+int main(int argc, char **argv)
+{
+	setvbuf(stdout, NULL, _IOLBF, 0);
+	return argc > 1 ? wav(argv[1]) : tones();
+}
