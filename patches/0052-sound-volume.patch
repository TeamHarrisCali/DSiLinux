diff --git a/linux-2.6.x/arch/arm/mach-nds/volume.c b/linux-2.6.x/arch/arm/mach-nds/volume.c
new file mode 100644
index 000000000..63144e4c4
--- /dev/null
+++ b/linux-2.6.x/arch/arm/mach-nds/volume.c
@@ -0,0 +1,42 @@
+/*
+ * DSi volume as seen by the ARM7 (see arm7/dsivol.c): /proc/dsivolume says
+ *   level=20 max=31 percent=64 status=0
+ * level is the DSi's own volume step (the power management chip's register), percent = level * 100 / 31, status 0 =
+ * read fine, 1..4 = the I2C read failed at that step (level is then -1), 5 = no message from the ARM7 yet (DS mode).
+ * The desktop shows a bar when it changes.
+ */
+#include <linux/kernel.h>
+#include <linux/init.h>
+#include <linux/proc_fs.h>
+
+static int vol_level = -1;
+static int vol_status = 5;
+
+/* called from the button FIFO handler with the whole message (bit 8 set) */
+void nds_volume_msg(u32 state)
+{
+	int lvl = state & 0xff;
+
+	vol_status = (state >> 9) & 7;
+	vol_level = lvl == 0xff ? -1 : lvl;
+}
+
+static int vol_read_proc(char *page, char **start, off_t off, int count, int *eof, void *data)
+{
+	int len = sprintf(page, "level=%d max=31 percent=%d status=%d\n", vol_level,
+			  vol_level < 0 ? 0 : vol_level * 100 / 31, vol_status);
+
+	*eof = 1;
+	if (off >= len)
+		return 0;
+	*start = page + off;
+	return len - off;
+}
+
+static int __init nds_volume_init(void)
+{
+	create_proc_read_entry("dsivolume", 0444, NULL, vol_read_proc, NULL);
+	return 0;
+}
+
+module_init(nds_volume_init);
