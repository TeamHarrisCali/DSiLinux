diff --git a/linux-2.6.x/arch/arm/mach-nds/arm7/dsivol.c b/linux-2.6.x/arch/arm/mach-nds/arm7/dsivol.c
new file mode 100644
index 000000000..5be3f9097
--- /dev/null
+++ b/linux-2.6.x/arch/arm/mach-nds/arm7/dsivol.c
@@ -0,0 +1,199 @@
+/*
+ * DSi audio output and volume for the DSLinux ARM7.
+ *
+ * - dsivol_sound_power(): DSi mode needs more than the DS sound channels: the power chip's amplifier bit and mute
+ *   bit (as libnds enableSound() does through the SPI power chip), and the DSi I2S output (SNDEXTCNT, 100% ARM mix,
+ *   32 kHz), which carries the DS mixer's output to the TSC2117 codec.
+ * - dsivol_poll(): the DSi's volume buttons only change a number in the power management chip (MCU, I2C device
+ *   0x4A register 0x40, 0..31); on a stock system a program applies it. Here the ARM7 reads it a few times a
+ *   second, applies it as the codec's DAC volume, and tells the ARM9 (FIFO_BUTTONS message with bit 8 set) so the
+ *   desktop can show it.
+ *
+ * The I2C sequence is derived from BlocksDS libnds (source/arm7/i2c.twl.c, Copyright (C) 2011 Dave Murphy
+ * (WinterMute), zlib licence). This version is altered: bounded waits, no BIOS delay calls (they hang the ARM7 in
+ * DSi mode), no interrupts. zlib notice: This software is provided 'as-is', without any express or implied warranty;
+ * the origin must not be misrepresented; altered source versions must be plainly marked as such; this notice may
+ * not be removed or altered.
+ */
+#define __DSLINUX_ARM7__
+
+#include "linux/config.h"
+#include "asm/types.h"
+#include "asm/arch/fifo.h"
+
+#include "dsitouch.h"
+#include "dsivol.h"
+
+#define REG_I2CDATA	(*(volatile u8 *)0x04004500)
+#define REG_I2CCNT	(*(volatile u8 *)0x04004501)
+#define REG_SNDEXTCNT	(*(volatile u16 *)0x04004700)
+
+#define I2C_STOP	(1 << 0)
+#define I2C_START	(1 << 1)
+#define I2C_ERROR	(1 << 2)
+#define I2C_ACK		(1 << 4)
+#define I2C_READ	(1 << 5)
+#define I2C_IRQEN	(1 << 6)
+#define I2C_ENABLE	(1 << 7)	/* writing; reading it back = busy */
+
+#define I2C_PM		0x4A
+#define PM_REG_VOL	0x40
+
+extern int pm_xfer(u8 cmd, u8 data, u8 *out);	/* main.c: SPI power chip, bounded */
+
+/* diagnostics step of the last volume read: 0 ok, 1 no answer from the device, 2 register select refused,
+ * 3 read select refused, 4 bus stuck */
+static u8 vol_step;
+static int vol_last = -1;
+static int vol_applied = -1;
+
+static void spin(int n)
+{
+	while (n-- > 0)
+		asm volatile("" ::: "memory");
+}
+
+static int i2c_wait(void)
+{
+	int n = 100000;
+
+	while ((REG_I2CCNT & I2C_ENABLE) && --n)
+		;
+	return n;
+}
+
+static void i2c_delay(void)
+{
+	i2c_wait();
+	spin(600);		/* about 45 us: the power chip needs time between bytes */
+}
+
+static int i2c_result(void)
+{
+	if (!i2c_wait())
+		return -1;
+	return (REG_I2CCNT >> 4) & 1;
+}
+
+static int i2c_select_device(u8 dev)
+{
+	if (!i2c_wait())
+		return -1;
+	REG_I2CDATA = dev;
+	REG_I2CCNT = I2C_ENABLE | I2C_IRQEN | I2C_START;
+	return i2c_result();
+}
+
+static int i2c_select_register(u8 reg)
+{
+	i2c_delay();
+	REG_I2CDATA = reg;
+	REG_I2CCNT = I2C_ENABLE | I2C_IRQEN;
+	return i2c_result();
+}
+
+/* returns the register value, or -1 (vol_step tells why) */
+static int i2c_read_reg(u8 dev, u8 reg)
+{
+	int i, r;
+
+	vol_step = 0;
+	for (i = 0; i < 4; i++) {
+		r = i2c_select_device(dev);
+		if (r < 0) {
+			vol_step = 4;
+			return -1;
+		}
+		if (r == 0) {
+			vol_step = 1;
+		} else if (i2c_select_register(reg) != 1) {
+			vol_step = 2;
+		} else {
+			i2c_delay();
+			if (i2c_select_device(dev | 1) != 1) {
+				vol_step = 3;
+			} else {
+				u8 v;
+
+				i2c_delay();
+				REG_I2CCNT = I2C_READ | I2C_ENABLE | I2C_IRQEN;
+				i2c_delay();
+				REG_I2CCNT = I2C_ENABLE | I2C_IRQEN | I2C_ERROR | I2C_STOP;
+				if (!i2c_wait()) {
+					vol_step = 4;
+					return -1;
+				}
+				v = REG_I2CDATA;
+				vol_step = 0;
+				return v;
+			}
+		}
+		REG_I2CCNT = I2C_ENABLE | I2C_IRQEN | I2C_STOP | I2C_ERROR;
+	}
+	return -1;
+}
+
+/* the sound engine is switched on (on) or off */
+void dsivol_sound_power(int on)
+{
+	u8 v = 0;
+
+	if (!dsitouch_active())		/* DS mode: nothing to do here */
+		return;
+	if (pm_xfer(0x80, 0, &v)) {	/* read power chip control register, change only the sound bits */
+		if (on)
+			v = (v & ~0x02) | 0x01;		/* amplifier on, mute off */
+		else
+			v &= ~0x01;
+		pm_xfer(0x00, v, 0);
+	}
+	if (on)
+		REG_SNDEXTCNT = (REG_SNDEXTCNT & ~0x000f) | (1 << 15) | 8;	/* I2S on, 100% ARM output, 32 kHz */
+	else
+		REG_SNDEXTCNT &= ~(1 << 15);
+}
+
+/* MCU level 0..31 -> DAC volume, 1.5 dB per step, 0 dB at 31; 0 is as quiet as the codec goes */
+static void apply_volume(int level)
+{
+	int units;			/* in 0.5 dB, 0 down to -63.5 dB */
+	u8 reg;
+
+	if (level <= 0) {
+		reg = 0x81;
+	} else {
+		units = -(31 - level) * 3;
+		if (units < -127)
+			units = -127;
+		reg = (u8)units;
+	}
+	dsitouch_cdc_write(0, 0x41, reg);	/* DAC left digital volume */
+	dsitouch_cdc_write(0, 0x42, reg);	/* DAC right */
+}
+
+/* called from the vblank interrupt: about 5 times a second reads the volume, tells the ARM9 on every change */
+void dsivol_poll(void)
+{
+	static int count;
+	int v;
+
+	if (++count < 12)
+		return;
+	count = 0;
+	if (!dsitouch_active())
+		return;
+	v = i2c_read_reg(I2C_PM, PM_REG_VOL);
+	if (v < 0) {
+		v = 0xff;
+	} else {
+		v &= 0x1f;
+		if (v != vol_applied) {
+			apply_volume(v);
+			vol_applied = v;
+		}
+	}
+	if (v != vol_last) {
+		vol_last = v;
+		nds_fifo_send(FIFO_BUTTONS | 0x100 | ((vol_step & 7) << 9) | v);
+	}
+}
