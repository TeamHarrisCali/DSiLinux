+/*
+ * Volume popup: /proc/dsivolume (written by the kernel from the ARM7's reading of the DSi's volume level) is read
+ * every 0.3 s; when the level changes a small window with the percentage and a bar is shown for 2 seconds.
+ */
+#define VOLW	130
+#define VOL_SECONDS	2
+static GR_WINDOW_ID volwin;
+static time_t vol_since;
+static int vol_last = -2, vol_pct, vol_status;
+static char vol_msg[40];
+
+static int read_volume(int *level, int *pct, int *status)
+{
+	FILE *f = fopen("/proc/dsivolume", "r");
+	int ok;
+
+	if (!f)
+		return 0;
+	ok = fscanf(f, "level=%d max=%*d percent=%d status=%d", level, pct, status) == 3;
+	fclose(f);
+	return ok;
+}
+
+static void draw_vol(void)
+{
+	char t[40];
+	int bw;
+
+	if (!volwin)
+		return;
+	w95_box(volwin, gc, 0, 0, VOLW, th + 20, 0, W95_FACEFILL);
+	if (vol_msg[0]) {
+		strcpy(t, vol_msg);
+	} else if (vol_pct == 0) {
+		strcpy(t, "Volume: muted");
+	} else {
+		sprintf(t, "Volume %d%%", vol_pct);
+	}
+	w95_text(volwin, gc, W95_DARK, 6, 4, t);
+	w95_box(volwin, gc, 6, th + 7, VOLW - 12, 8, 1, W95_WHITEFILL);
+	bw = (VOLW - 12 - 4) * vol_pct / 100;
+	if (bw > 0)
+		w95_fill(volwin, gc, W95_NAVY, 8, th + 9, bw, 4);
+}
+
+static void show_vol(void)
+{
+	if (!volwin) {
+		volwin = GrNewWindowEx(GR_WM_PROPS_NODECORATE | GR_WM_PROPS_NOFOCUS | GR_WM_PROPS_NOMOVE,
+				       "volume", GR_ROOT_WINDOW_ID, (si.cols - VOLW) / 2, 4, VOLW, th + 20, W95_FACE);
+		GrSelectEvents(volwin, GR_EVENT_MASK_EXPOSURE);
+		GrMapWindow(volwin);
+	} else {
+		GrRaiseWindow(volwin);
+		draw_vol();
+	}
+	vol_since = time(NULL);
+}
+
+static void poll_volume(void)
+{
+	int level, pct, status;
+
+	if (volwin && time(NULL) - vol_since >= VOL_SECONDS) {
+		GrDestroyWindow(volwin);
+		volwin = 0;
+	}
+	if (!read_volume(&level, &pct, &status) || status == 5)
+		return;
+	if (level < 0) {			/* the ARM7 could not read the volume: say so once */
+		if (vol_last != -1) {
+			vol_last = -1;
+			vol_pct = 0;
+			sprintf(vol_msg, "Volume: read failed (%d)", status);
+			show_vol();
+		}
+		return;
+	}
+	vol_msg[0] = 0;
+	vol_status = status;
+	if (vol_last == -2) {			/* first reading: remember it, show nothing */
+		vol_last = level;
+		return;
+	}
+	if (level != vol_last) {
+		vol_last = level;
+		vol_pct = pct;
+		show_vol();
+	}
+}
