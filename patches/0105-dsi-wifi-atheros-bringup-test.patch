 linux-2.6.x/arch/arm/mach-nds/volume.c       |  74 ++++
 linux-2.6.x/drivers/block/dldi_c.c           |  22 +
 linux-2.6.x/include/asm-arm/arch-nds/dsisd.h |   1 +
 user/microwin/src/demos/nanox/dsdesk.c       |   1 +
 vendors/Nintendo/DSI/Makefile                |   1 +
 vendors/Nintendo/DSI/logbody                 |   2 +
 vendors/Nintendo/DSI/wifi-dsi-test           |  11 +
 11 files changed, 568 insertions(+), 1 deletion(-)
 create mode 100644 linux-2.6.x/arch/arm/mach-nds/arm7/twlwifi.c
 create mode 100644 vendors/Nintendo/DSI/wifi-dsi-test

