diff --git a/vendors/Nintendo/DSI/wifi-dsi-test b/vendors/Nintendo/DSI/wifi-dsi-test
new file mode 100644
index 000000000..012d9cf51
--- /dev/null
+++ b/vendors/Nintendo/DSI/wifi-dsi-test
@@ -0,0 +1,11 @@
+#!/bin/sh
+# Start > Network > DSi Wi-Fi test: one bring-up of the DSi's own Wi-Fi chip (Atheros, step 1-3 of docs/ATHEROS-PLAN.md), its answers,
+# then the card log is saved. The DS Wi-Fi is switched off first (both chips share the antenna).
+killall udhcpc 2>/dev/null
+ifconfig nds down 2>/dev/null
+echo "DSi Wi-Fi chip test (a few seconds)..."
+echo 1 > /proc/dsiwifi2
+cat /proc/dsiwifi2
+/bin/sh /boot/savelog
+echo "-- saved in the card log (sd:/linux/DSILOG.TXT) --"
+[ -n "$1" ] || exec /bin/sh
