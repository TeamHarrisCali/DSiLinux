 	create_proc_read_entry("dsiwifi", 0444, NULL, wifi_read_proc, NULL);
+	e = create_proc_entry("dsiwifi2", 0644, NULL);
+	if (e) {
+		e->read_proc = twl_read_proc;
+		e->write_proc = twl_write_proc;
+	}
 	create_proc_read_entry("dsivolume", 0444, NULL, vol_read_proc, NULL);
 	return 0;
 }
diff --git a/linux-2.6.x/drivers/block/dldi_c.c b/linux-2.6.x/drivers/block/dldi_c.c
index a1782ac67..b6aac6831 100644
--- a/linux-2.6.x/drivers/block/dldi_c.c
+++ b/linux-2.6.x/drivers/block/dldi_c.c
@@ -229,6 +229,28 @@ int dsisd_wifiprobe(unsigned int *out)
 	return ret;
 }
 
+/* The Atheros chip bring-up on the ARM7 (arm7/twlwifi.c): out[0..7] touch, out[8..15] diag, out[16..18] info. 0 = ok. It takes a few
+ * seconds at most; the request block keeps whatever the ARM7 had written if it does not finish (out[] is filled either way). */
+int dsisd_twlwifi(unsigned int *out)
+{
+	int ret, i, save;
+
+	down(&sd_mutex);
+	save = sd_timeout;
+	sd_timeout = 15 * HZ;
+	ret = sd_request_locked(NDS_SD_CMD_TWLWIFI, 0, 0);
+	sd_timeout = save;
+	dmac_flush_range((unsigned long)&sd_block, (unsigned long)&sd_block + sizeof(sd_block));	/* also after a timeout */
+	for (i = 0; i < 8; i++) {
+		out[i] = sd_block.touch[i];
+		out[8 + i] = sd_block.diag[i];
+	}
+	for (i = 0; i < 3; i++)
+		out[16 + i] = sd_block.info[i];
+	up(&sd_mutex);
+	return ret;
+}
+
 /* Power chip status (and the backlight): op 1 sets the backlight register to val (0..4). out[0] battery register, out[1] volume register,
  * out[2] backlight register (0xffffffff = unreadable). 0 = ok. */
 int dsisd_pm(unsigned int op, unsigned int val, unsigned int *out)
