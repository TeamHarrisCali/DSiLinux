diff --git a/linux-2.6.x/arch/arm/mach-nds/arm7/time.c b/linux-2.6.x/arch/arm/mach-nds/arm7/time.c
index 43526eb67..23ae79f6f 100644
--- a/linux-2.6.x/arch/arm/mach-nds/arm7/time.c
+++ b/linux-2.6.x/arch/arm/mach-nds/arm7/time.c
@@ -63,6 +63,16 @@ static void rtcTransaction(u8 * command, u32 commandLen, u8 * result,
 	swiDelay(RTC_DELAY);
 }
 
+/* a two-byte command to the RTC (twlwifi.c: the DSi RTC's FOUT registers, the Wi-Fi module's 32 kHz clock) */
+void nds_rtc_write2(u8 cmd, u8 val)
+{
+	u8 c[2];
+
+	c[0] = cmd;
+	c[1] = val;
+	rtcTransaction(c, 2, 0, 0);
+}
+
 static u8 BCDToInt(u8 data)
 {
 	return ((data & 0xF) + ((data & 0xF0) >> 4) * 10);
diff --git a/linux-2.6.x/arch/arm/mach-nds/arm7/twlwifi.c b/linux-2.6.x/arch/arm/mach-nds/arm7/twlwifi.c
new file mode 100644
index 000000000..b1195da23
--- /dev/null
+++ b/linux-2.6.x/arch/arm/mach-nds/arm7/twlwifi.c
@@ -0,0 +1,434 @@
+/*
+ * twlwifi.c - first contact with the DSi's own Wi-Fi chip (Atheros AR60xx on the second SDIO controller, 0x04004A00).
+ * Step 1-3 of docs/ATHEROS-PLAN.md, run on request from the ARM9 (/proc/dsiwifi2), never at boot:
+ *   switch the antenna to the Atheros chip, its 32 kHz clock (RTC FOUT) and power, set up the SDIO controller, bring the card up
+ *   (CMD5/CMD3/CMD7, function 1, 4-bit bus, 128-byte blocks), read revision, manufacturer and chip ID, see whether the System Menu left
+ *   firmware in the chip, reset it into its boot ROM, ask the boot ROM (BMI) for its version and, when firmware is there, start it and
+ *   wait for "ready". Everything that waits for the chip is bounded: a chip that does not answer must not hang the ARM7.
+ * Results: info[0] = last step reached, info[1] = controller status at the first failure, info[2] = flags; diag[] and touch[] = values
+ * (see the ARM9 side, arch/arm/mach-nds/volume.c).
+ *
+ * The SDIO command sequence and register use follow BlocksDS dswifi (source/arm7/twl/sdio.twl.c and card.twl.c):
+ * SPDX-License-Identifier: MIT
+ * Copyright (C) 2021 Max Thomas (ShinyQuagsire), Copyright (C) 2023-2025 Antonio Nino Diaz (dswifi)
+ * Copyright (c) 2026 DSLinuxDSi project (port to the DSLinux ARM7, polling with bounded waits)
+ * Permission is hereby granted, free of charge, to any person obtaining a copy of this software and associated documentation files (the
+ * "Software"), to deal in the Software without restriction, including without limitation the rights to use, copy, modify, merge, publish,
+ * distribute, sublicense, and/or sell copies of the Software, and to permit persons to whom the Software is furnished to do so, subject to
+ * the following conditions: The above copyright notice and this permission notice shall be included in all copies or substantial portions
+ * of the Software. THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE
+ * WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS
+ * BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN
+ * CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
+ */
+#include "linux/config.h"
+#include "asm/types.h"
+
+#include "dsivol.h"
+
+#define R16(a)	(*(volatile u16 *)(a))
+#define R32(a)	(*(volatile u32 *)(a))
+
+#define GPIO_WIFI	0x04004C04	/* bit 8: 1 = DS chip, 0 = Atheros */
+#define POWCNT2		0x04000304
+#define SCFG_WL		0x04004020
+
+/* TMIO controller 2 */
+#define SDIO		0x04004A00
+#define S_CMD		(SDIO + 0x000)
+#define S_PORT_SEL	(SDIO + 0x002)
+#define S_PARAM0	(SDIO + 0x004)
+#define S_PARAM1	(SDIO + 0x006)
+#define S_STOP		(SDIO + 0x008)
+#define S_BLK_CNT16	(SDIO + 0x00A)
+#define S_RESP0		(SDIO + 0x00C)
+#define S_STAT0		(SDIO + 0x01C)
+#define S_STAT1		(SDIO + 0x01E)
+#define S_MASK		(SDIO + 0x020)
+#define S_CLK		(SDIO + 0x024)
+#define S_BLK_LEN16	(SDIO + 0x026)
+#define S_CARD_OPT	(SDIO + 0x028)
+#define S_ERR0		(SDIO + 0x02C)
+#define S_ERR1		(SDIO + 0x02E)
+#define S_DATA16_CNT	(SDIO + 0x0D8)
+#define S_RESET		(SDIO + 0x0E0)
+#define S_IRQ32		(SDIO + 0x100)
+#define S_BLK_LEN32	(SDIO + 0x104)
+#define S_BLK_CNT32	(SDIO + 0x108)
+
+#define STAT0_RESPEND	0x0001
+#define STAT1_CMD_BUSY	0x4000
+#define STAT1_ERR	(0x8000 | 0x0040 | 0x0020 | 0x0010 | 0x0008 | 0x0004 | 0x0002 | 0x0001)
+
+/* TMIO command word: index | response type << 8 (3 none, 4 R1-like 48 bit, 5 48 bit busy, 7 48 bit OCR without CRC) */
+#define C_CMD3		(3 | (4 << 8))
+#define C_CMD5		(5 | (7 << 8))
+#define C_CMD7		(7 | (5 << 8))
+#define C_CMD52		(52 | (4 << 8))
+
+/* Atheros function-1 registers */
+#define F1_RX_LOOKAHEAD_VALID	0x405
+#define F1_RX_LOOKAHEAD0	0x408
+#define F1_WINDOW_DATA		0x474
+#define F1_WINDOW_WRITE_ADDR	0x478
+#define F1_WINDOW_READ_ADDR	0x47C
+
+#define CHIP_ID_AR6002	0x02000001
+#define HI_AR6002	0x00500400	/* "host interest" area: what the host and the firmware tell each other */
+#define HI_AR601X	0x00520000
+
+#define BMI_DONE		1
+#define BMI_READ_SOC_REGISTER	6
+#define BMI_WRITE_SOC_REGISTER	7
+#define BMI_GET_TARGET_ID	8
+
+/* RTC: the DSi's clock chip gives the Wi-Fi module its 32 kHz sleep clock (FOUT) */
+extern void nds_rtc_write2(u8 cmd, u8 val);
+
+static u32 st;		/* bit 0 response seen, bit 2 error or timeout (as dswifi's ctx->status) */
+static u32 resp;
+static u32 fail_stat, fail_err;	/* controller status and error detail at the first failure */
+
+static void tdelay(u32 n)
+{
+	volatile u32 i;
+
+	for (i = 0; i < n; i++)
+		;
+}
+
+static void mask16(u32 reg, u16 clear, u16 set)
+{
+	R16(reg) = (R16(reg) & ~clear) | set;
+}
+
+static void controller_init(void)
+{
+	mask16(S_IRQ32, 0x0800, 0);
+	mask16(S_IRQ32, 0x1000, 0);
+	mask16(S_IRQ32, 0, 0x0402);
+	mask16(S_DATA16_CNT, 0x0022, 0x0002);
+	mask16(S_DATA16_CNT, 0x0020, 0);
+	R16(S_BLK_LEN32) = 128;
+	R16(S_BLK_CNT32) = 1;
+	mask16(S_RESET, 0x0003, 0);
+	mask16(S_RESET, 0, 0x0003);
+	R32(S_MASK) = 0xFFFFFFFF;		/* no controller interrupts: this driver polls */
+	mask16(SDIO + 0x0FC, 0, 0x00DB);
+	mask16(SDIO + 0x0FE, 0, 0x00DB);
+	mask16(S_PORT_SEL, 3, 0);
+	R16(S_CLK) = 0x0020;
+	R16(S_CARD_OPT) = 0x40EE;
+	mask16(S_IRQ32, 0x8000, 0);
+	mask16(S_IRQ32, 0, 0x0100);
+	mask16(S_IRQ32, 0x0100, 0);
+	mask16(S_PORT_SEL, 3, 0);
+	R16(S_BLK_LEN16) = 128;
+	R16(S_STOP) = 0x0100;
+}
+
+/* clock divider 0 (fastest, as dswifi), bus width 4 or 1 */
+static void switch_device(int width4)
+{
+	mask16(S_PORT_SEL, 3, 0);
+	mask16(S_CLK, 0x100, 0);
+	mask16(S_CLK, 0x2FF, 0);
+	mask16(S_CLK, 0, 0x100);
+	if (width4)
+		mask16(S_CARD_OPT, 0x8000, 0);
+	else
+		mask16(S_CARD_OPT, 0, 0x8000);
+}
+
+/* a command without data; st bit 0 = response, bit 2 = error/timeout */
+static void cmd(u16 c, u32 arg, int want_resp)
+{
+	u32 t;
+	u16 s0 = 0, s1 = 0;
+
+	st = 0;
+	for (t = 0; (R16(S_STAT1) & STAT1_CMD_BUSY) && t < 200000; t++)
+		;
+	R16(S_STAT0) = 0;
+	R16(S_STAT1) = 0;
+	R16(S_PARAM0) = arg & 0xFFFF;
+	R16(S_PARAM1) = arg >> 16;
+	R16(S_BLK_LEN16) = 128;
+	R16(S_BLK_CNT16) = 0;
+	R16(S_CMD) = c;
+	for (t = 0; t < 262144; t++) {
+		s1 = R16(S_STAT1);
+		if (s1 & STAT1_ERR) {
+			st |= 4;
+			break;
+		}
+		if (!(s1 & STAT1_CMD_BUSY)) {
+			s0 = R16(S_STAT0);
+			if (s0 & STAT0_RESPEND)
+				st |= 1;
+			if (!want_resp || (s0 & STAT0_RESPEND))
+				break;
+		}
+	}
+	if (t == 262144)
+		st |= 4;
+	if ((st & 4) && !fail_stat) {
+		fail_stat = ((u32)R16(S_STAT1) << 16) | R16(S_STAT0) | 0x80000000u;	/* bit 31 marks "recorded" */
+		fail_err = ((u32)R16(S_ERR1) << 16) | R16(S_ERR0);
+	}
+	R16(S_STAT0) = 0;
+	R16(S_STAT1) = 0;
+	resp = R16(S_RESP0) | ((u32)R16(S_RESP0 + 2) << 16);
+}
+
+static int wr8(u32 func, u32 addr, u8 val)
+{
+	cmd(C_CMD52, 0x80000000u | (func << 28) | ((addr & 0x1FFFF) << 9) | val, 1);
+	return (st & 4) ? -1 : 0;
+}
+
+static u8 rd8(u32 func, u32 addr)
+{
+	cmd(C_CMD52, (func << 28) | ((addr & 0x1FFFF) << 9), 1);
+	return (st & 4) ? 0xFF : (u8)resp;
+}
+
+static u32 rd32(u32 func, u32 addr)
+{
+	return rd8(func, addr) | ((u32)rd8(func, addr + 1) << 8) | ((u32)rd8(func, addr + 2) << 16) | ((u32)rd8(func, addr + 3) << 24);
+}
+
+static void wr32_f1(u32 addr, u32 val)		/* most significant byte first, as dswifi */
+{
+	wr8(1, addr + 3, val >> 24);
+	wr8(1, addr + 2, val >> 16);
+	wr8(1, addr + 1, val >> 8);
+	wr8(1, addr, val);
+}
+
+static u32 intern_rd(u32 addr)
+{
+	wr32_f1(F1_WINDOW_READ_ADDR, addr);
+	return rd32(1, F1_WINDOW_DATA);
+}
+
+static void intern_wr(u32 addr, u32 val)
+{
+	wr32_f1(F1_WINDOW_DATA, val);
+	wr32_f1(F1_WINDOW_WRITE_ADDR, addr);
+}
+
+/* mailbox 0, byte by byte; the last byte of a message goes to 0xFF (end of message) */
+static void mbox_wr32(u32 val, int last)
+{
+	int i;
+
+	for (i = 0; i < 4; i++) {
+		wr8(1, (i == 3 && last) ? 0xFF : 0, val & 0xFF);
+		val >>= 8;
+	}
+}
+
+static int mbox_rd32(u32 *val, u32 tries)
+{
+	u32 t, v = 0;
+	int i;
+
+	for (t = 0; t < tries; t++) {
+		if (rd8(1, F1_RX_LOOKAHEAD_VALID) & 1)
+			break;
+		if (st & 4)			/* the card stopped answering: do not wait out every try */
+			return -1;
+		tdelay(2000);
+	}
+	if (t == tries)
+		return -1;
+	for (i = 0; i < 4; i++)
+		v |= (u32)rd8(1, 0xFF) << (i * 8);
+	*val = v;
+	return 0;
+}
+
+static u32 bmi_rd_reg(u32 addr)
+{
+	u32 v = 0xFFFFFFFF;
+
+	mbox_wr32(BMI_READ_SOC_REGISTER, 0);
+	mbox_wr32(addr, 1);
+	mbox_rd32(&v, 500);
+	return v;
+}
+
+static void bmi_wr_reg(u32 addr, u32 val)
+{
+	mbox_wr32(BMI_WRITE_SOC_REGISTER, 0);
+	mbox_wr32(addr, 0);
+	mbox_wr32(val, 1);
+}
+
+/*
+ * The whole bring-up. touch[8], diag[8], info[3] go back to the ARM9:
+ *   info[0] step reached (see the ARM9 side), info[1] controller status at the first failure, info[2] flags:
+ *     bit 0 4-bit bus, bit 1 CMD5 skipped (card was already initialised), bit 2 firmware started, bit 3 BMI timed out
+ *   diag[0] manufacturer, [1] chip ID, [2] firmware-loaded flag before reset, [3] reset cause, [4] BMI version,
+ *   [5] ready flag after start, [6] EEPROM version, [7] RX lookahead valid
+ *   touch[0] CCCR revision, [1] OCR, [2] bus interface control, [3] error detail at the first failure, [4] host interest address,
+ *   [5] EEPROM address, [6] ready polls, [7] first RX lookahead word
+ */
+void twl_wifi_probe(u32 *touch, u32 *diag, u32 *info)
+{
+	u16 gpio0 = R16(GPIO_WIFI), pwr0 = R16(POWCNT2);
+	u32 hi, uploaded, t, ocr = 0;
+	int i;
+
+	for (i = 0; i < 8; i++)
+		touch[i] = diag[i] = 0;
+	info[0] = info[1] = info[2] = 0;
+	fail_stat = fail_err = 0;
+
+	/* 1: power, antenna, clock */
+	info[0] = 1;
+	R16(POWCNT2) = pwr0 | 2;
+	R16(GPIO_WIFI) = gpio0 & ~0x100;		/* Atheros */
+	tdelay(40000);
+	nds_rtc_write2(0x72, 0x80);			/* FOUT1, FOUT2: the 32 kHz clock for the module */
+	nds_rtc_write2(0x74, 0x00);
+	dsivol_pm_write(0x30, 0x13);
+	R32(SCFG_WL) |= 1;
+
+	/* 2: controller */
+	info[0] = 2;
+	controller_init();
+	switch_device(1);
+	tdelay(60000);
+	rd8(0, 0x00);					/* revision, as a test of the 4-bit bus */
+	if (st & 4) {
+		switch_device(0);
+		fail_stat = 0;
+	} else {
+		info[2] |= 1;
+	}
+
+	/* 3: CMD5 (operating conditions) until ready, CMD3 (address), CMD7 (select); skipped when CMD5 fails because the card is already up */
+	info[0] = 3;
+	R16(S_STOP) = 0x100;
+	for (t = 0; t < 100; t++) {
+		cmd(C_CMD5, ocr, 1);
+		if (st & 4)
+			break;
+		ocr = resp & 0xFFFFFF;
+		if (resp & 0x80000000u)
+			break;
+		tdelay(2000);
+	}
+	touch[1] = resp;
+	if (st & 4) {
+		info[2] |= 2;
+		fail_stat = fail_err = 0;		/* expected when the card was already initialised */
+	} else {
+		info[0] = 4;
+		cmd(C_CMD3, 0, 1);
+		if (st & 4)
+			goto out;
+		cmd(C_CMD7, (resp >> 16) << 16, 1);
+		if (st & 4)
+			goto out;
+	}
+
+	/* 5: function 1 on (no delay between the two writes: dswifi notes a delay there wipes the firmware) */
+	info[0] = 5;
+	wr8(0, 0x02, 0x00);
+	wr8(0, 0x02, 0x02);
+	tdelay(60000);
+	touch[2] = rd8(0, 0x07);
+	if (st & 4)
+		goto out;
+	if (wr8(0, 0x07, touch[2] | 0x82))		/* 4-bit bus, card detect off */
+		goto out;
+	switch_device(1);
+	info[2] |= 1;
+	if (wr8(0, 0x12, 0x02) || wr8(0, 0x110, 128) || wr8(0, 0x111, 0) || wr8(0, 0x10, 128) || wr8(0, 0x11, 0))
+		goto out;
+	tdelay(60000);
+
+	/* 6: identify */
+	info[0] = 6;
+	touch[0] = rd8(0, 0x00);
+	for (t = 0; t < 1000 && rd8(0, 0x03) != 0x02 && !(st & 4); t++)	/* function 1 ready */
+		tdelay(1000);
+	if (t == 1000 || (st & 4))
+		goto out;
+	diag[0] = rd32(0, 0x1007);			/* manufacturer (CIS) */
+	diag[1] = intern_rd(0x000040EC);		/* chip ID */
+	hi = diag[1] == CHIP_ID_AR6002 ? HI_AR6002 : HI_AR601X;
+	touch[4] = hi;
+	uploaded = intern_rd(hi + 0x58);		/* non-zero: firmware already in the chip */
+	diag[2] = uploaded;
+
+	/* 7: reset into the boot ROM (the firmware stays in RAM), reset cause should be 2 */
+	info[0] = 7;
+	intern_wr(0x4000, 0x00000100);
+	tdelay(120000);
+	diag[3] = intern_rd(0x40C0);
+
+	/* 8: boot ROM version (BMI) */
+	info[0] = 8;
+	mbox_wr32(BMI_GET_TARGET_ID, 1);
+	if (mbox_rd32(&diag[4], 500)) {
+		info[2] |= 8;
+		goto out;
+	}
+	if (diag[4] == 0xFFFFFFFF) {			/* extended answer: length, version, more words */
+		u32 len = 0, v;
+
+		mbox_rd32(&len, 500);
+		mbox_rd32(&diag[4], 500);
+		for (t = 2; t < len / 4 && t < 16; t++)
+			mbox_rd32(&v, 500);
+	}
+
+	/* 9: the settings dswifi makes before starting the firmware */
+	info[0] = 9;
+	intern_wr(hi, 2);
+	bmi_wr_reg(0x0180C0, bmi_rd_reg(0x0180C0) | 0x8);
+	bmi_wr_reg(0x0040C4, bmi_rd_reg(0x0040C4) | 1);	/* WLAN_SYSTEM_SLEEP */
+	bmi_wr_reg(0x004028, 0x5);			/* WLAN_CLOCK_CONTROL */
+	bmi_wr_reg(0x004020, 0x0);
+	if (!uploaded)					/* no firmware: an upload is needed (a later step); stop here */
+		goto out;
+
+	/* 10: start the firmware that is already there and wait for it */
+	info[0] = 10;
+	intern_wr(hi + 0x6C, 0x80);
+	intern_wr(hi + 0x74, 0x63);
+	mbox_wr32(BMI_DONE, 1);
+	info[2] |= 4;
+	for (t = 0; t < 2000; t++) {			/* about 2 s */
+		diag[5] = intern_rd(hi + 0x58);
+		if (diag[5] == 1 || (st & 4))
+			break;
+		tdelay(4000);
+	}
+	touch[6] = t;
+	if (diag[5] != 1)
+		goto out;
+	touch[5] = intern_rd(hi + 0x54);		/* EEPROM (board data) address */
+	diag[6] = intern_rd(touch[5] + 0x10);		/* its version */
+
+	/* 11: the firmware's first message (WMI ready) should be waiting in mailbox 0 */
+	info[0] = 11;
+	for (t = 0; t < 500; t++) {
+		diag[7] = rd8(1, F1_RX_LOOKAHEAD_VALID);
+		if ((diag[7] & 1) || (st & 4))
+			break;
+		tdelay(4000);
+	}
+	touch[7] = rd32(1, F1_RX_LOOKAHEAD0);
+	info[0] = 12;					/* all done */
+
+out:
+	info[1] = fail_stat;
+	touch[3] = fail_err;
+	R16(GPIO_WIFI) = gpio0;				/* antenna back to the DS chip, power as it was */
+	R16(POWCNT2) = pwr0;
+}
diff --git a/linux-2.6.x/arch/arm/mach-nds/volume.c b/linux-2.6.x/arch/arm/mach-nds/volume.c
