From 36e7e1a3e3e6c8bda9657391f72b9b798e4a7a26 Mon Sep 17 00:00:00 2001
From: TeamHarrisCali <34009957+TeamHarrisCali@users.noreply.github.com>
Date: Fri, 13 Nov 2026 00:57:31 -0600
Subject: [PATCH] Wi-Fi window: log each scanned network to /tmp/dsnet.log

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 user/microwin/src/demos/nanox/dsnet.c | 29 +++++++++++++++++----------
 1 file changed, 18 insertions(+), 11 deletions(-)

diff --git a/user/microwin/src/demos/nanox/dsnet.c b/user/microwin/src/demos/nanox/dsnet.c
index 9bea1865f..9267f8224 100644
--- a/user/microwin/src/demos/nanox/dsnet.c
+++ b/user/microwin/src/demos/nanox/dsnet.c
@@ -183,6 +183,17 @@ static void save_known(const char *ssid, const char *key, int forget)
 	fclose(o);
 }
 
+/* what the window did, for the log (Save log puts /tmp/dsnet.log on the card) */
+static void dlog(const char *s)
+{
+	FILE *f = fopen("/tmp/dsnet.log", "a");
+
+	if (f) {
+		fprintf(f, "dsnet: %s\n", s);
+		fclose(f);
+	}
+}
+
 /* read the networks from /proc/dswifi: "bssid channel open|wep|wpa signal b|b11|g name" (g: needs an 802.11g rate, beyond the DS chip); the same name heard twice keeps its best signal */
 static void read_networks(void)
 {
@@ -193,6 +204,7 @@ static void read_networks(void)
 	nnet = 0;
 	if (!f)
 		return;
+	dlog("scan:");
 	while (fgets(line, sizeof(line), f) && nnet < MAXNET) {
 		char bssid[24], sec[8], rates[4], *name, *nl;
 		int ch, sig, i, pos = 0;
@@ -202,6 +214,12 @@ static void read_networks(void)
 		name = line + pos;
 		if ((nl = strchr(name, '\n')))
 			*nl = 0;
+		{
+			char t[96];
+
+			snprintf(t, sizeof(t), "  ch %d %s %s sig %d %s", ch, sec, rates, sig, name);
+			dlog(t);
+		}
 		for (i = 0; i < nnet; i++)
 			if (!strcmp(nets[i].ssid, name))
 				break;
@@ -381,17 +399,6 @@ static void scan(void)
 	draw_all();
 }
 
-/* what the window did, for the log (Save log puts /tmp/dsnet.log on the card) */
-static void dlog(const char *s)
-{
-	FILE *f = fopen("/tmp/dsnet.log", "a");
-
-	if (f) {
-		fprintf(f, "dsnet: %s\n", s);
-		fclose(f);
-	}
-}
-
 /*
  * Wait until the console has joined the network (the ARM7 retries the authentication / association every second), at most 12 s.
  * /proc/dswifistat: "state 0x.. names", "auth N assoc N status A B". Returns 1 when joined.
-- 
2.56.0

