+# Wi-Fi at boot: the network chosen with Auto in the Wi-Fi window (/home/wifi.auto), in the background (up to a minute or two)
+if [ -f /home/wifi.auto ]
+then
+	/boot/dssettings wifi auto > /tmp/wifi-auto.log 2>&1 &
+fi
+# the first login shell (tty1) starts the desktop (/boot/session, through /etc/profile)
