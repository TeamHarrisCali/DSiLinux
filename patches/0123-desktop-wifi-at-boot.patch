 if [ -x /boot/autolog ]
diff --git a/vendors/Nintendo/DSI/session b/vendors/Nintendo/DSI/session
new file mode 100644
index 000000000..d6af6da1c
--- /dev/null
+++ b/vendors/Nintendo/DSI/session
@@ -0,0 +1,23 @@
+#!/bin/sh
+# The desktop at boot. Sourced by the first login shell after boot (/etc/profile in ROOTFS.IMG: "[ -f /boot/session ] && . /boot/session";
+# /boot/rc leaves /tmp/.boot-session for it, so SSH logins and later shells never start a desktop). When the desktop ends (Start >
+# Exit desktop) this shell carries on as the text console.
+# No desktop: with /home/.no-desktop, or when the desktop started at the last boot did not run a minute (/home/.desktop-starting is
+# still there: a kernel panic or a freeze while it started). Then the text console this once, so a crash cannot repeat at every boot.
+if [ -f /tmp/.boot-session ]
+then
+	rm -f /tmp/.boot-session
+	if [ -f /home/.no-desktop ]
+	then
+		echo "Desktop at boot: off (/home/.no-desktop). /boot/desktop starts it."
+	elif [ -f /home/.desktop-starting ]
+	then
+		rm -f /home/.desktop-starting
+		sync
+		echo "The desktop did not run a minute at the last boot (crash?): text console this time. /boot/desktop starts it."
+	else
+		echo started > /home/.desktop-starting
+		sync
+		/boot/desktop
+	fi
+fi
diff --git a/vendors/Nintendo/DSI/shutdown b/vendors/Nintendo/DSI/shutdown
index fb233f462..d86eb7012 100644
--- a/vendors/Nintendo/DSI/shutdown
+++ b/vendors/Nintendo/DSI/shutdown
@@ -1,6 +1,7 @@
 #!/bin/sh
 # Power the DS off (the Start menu's Shut down): write everything to the card, stop all programs, power off.
 # /boot/desktop stop only ends the desktop.
+rm -f /home/.desktop-starting		# a shut down is not a crash (see /boot/session)
 [ -x /boot/savelog ] && /boot/savelog quiet
 sync
 poweroff
