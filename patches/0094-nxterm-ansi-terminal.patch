+		clear_cells(rows - 1, 0, cols);
+		if (scrolled < rows)
+			scrolled++;
+		return;
+	}
+	for (y = top; y < bot; y++) {
+		memcpy(scr[y], scr[y + 1], sizeof(scr[0]));
+		dirty[y] = 1;
+	}
+	clear_cells(bot, 0, cols);
