From af0b114cbbb8ab0c185bbf64ea02a981d3642995 Mon Sep 17 00:00:00 2001
From: TeamHarrisCali <34009957+TeamHarrisCali@users.noreply.github.com>
Date: Thu, 12 Nov 2026 23:55:17 -0600
Subject: [PATCH] nxterm rewritten: VT100/ANSI terminal (cursor, erase,
 insert/delete, scroll regions, 16 colours, status replies), screen kept as
 cells (correct redraws), 200 line scrollback on Page Up/Down, runs the
 program it is given (the Network menu scripts showed nothing), title,
 coloured prompt, TERM=vt100; dsdesk: test bed path remap

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 user/microwin/src/demos/nanox/dsdesk.c |   16 +-
 user/microwin/src/demos/nanox/nxterm.c | 1732 ++++++++----------------
 2 files changed, 606 insertions(+), 1142 deletions(-)

diff --git a/user/microwin/src/demos/nanox/dsdesk.c b/user/microwin/src/demos/nanox/dsdesk.c
index 422429c6d..c452daf7c 100644
--- a/user/microwin/src/demos/nanox/dsdesk.c
+++ b/user/microwin/src/demos/nanox/dsdesk.c
@@ -188,11 +188,25 @@ static volatile int exec_errno;
 static void launch(const char *prog, const char *arg)
 {
 	pid_t pid;
+#ifdef NANOX_TESTBED
+	/* PC test bed: /boot/... lives under $DSDESK_ROOT */
+	static char p2[256], a2[256];
+	const char *root = getenv("DSDESK_ROOT");
+
+	if (root && prog[0] == '/') {
+		snprintf(p2, sizeof(p2), "%s%s", root, prog);
+		prog = p2;
+	}
+	if (root && arg && arg[0] == '/') {
+		snprintf(a2, sizeof(a2), "%s%s", root, arg);
+		arg = a2;
+	}
+#endif
 
 	exec_errno = 0;
 	pid = vfork();
 	if (pid == 0) {
-		if (arg && !strcmp(prog, "/boot/nxterm"))
+		if (arg && strstr(prog, "/boot/nxterm"))
 			/* a script in a terminal window: nxterm uses execvp(), which (unlike the shell) cannot run a file with no binary
 			 * header, so the shell is started with the script as its argument */
 			execl(prog, prog, "/bin/sh", arg, (char *)NULL);
