+/*
+ * Menu icons: 9x9 pixel pictures made of a few rectangles (each rectangle is one request, so they stay simple). Which one an entry
+ * gets is decided by its name; groups get the picture of their group.
+ */
+/* the colours are shared with the taskbar (battery, Start flag): the server keeps only 16 graphics contexts (w95.h) */
+#define ICO_YELLOW	GR_RGB(255, 200, 0)
+#define ICO_RED		GR_RGB(220, 0, 0)
+#define ICO_GREEN	GR_RGB(0, 160, 0)
+#define ICO_BLUE	GR_RGB(0, 0, 255)
+
+static int is(const char *a, const char *b)
+{
+	return !strcmp(a, b);
+}
+
+static int is_arg(const struct item *it, const char *a)
