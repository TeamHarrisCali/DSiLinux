+		w95_fill(d, gc, is(n, "DOOM") ? ICO_RED : ICO_GREEN, x + 6, y + 4, 1, 1);
+	} else if (is(n, "System") || is(n, "Settings") || is(n, "Bench")) {	/* a gear: teeth and a hole */
