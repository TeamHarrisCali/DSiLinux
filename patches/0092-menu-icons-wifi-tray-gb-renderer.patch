+#ifdef PEANUT_GB_FAST_BG
+/*
+ * DSLinuxDSi change: background and window drawn a tile row at a time. The two bit planes of a tile row are spread through a table
+ * into one 16 bit word with the 2 bit colour of each pixel side by side, so a pixel costs a shift, a mask and a palette load instead of
+ * the per pixel bookkeeping of the original loop. Same pixels as the original (checked on a PC frame by frame).
+ */
+static uint16_t pgb_spread[256];
+
+static void pgb_spread_init(void)
+{
+	int i, b;
+
+	for(i = 0; i < 256; i++)
+	{
+		uint16_t w = 0;
+
+		for(b = 0; b < 8; b++)
+			if(i & (1 << b))
+				w |= 1 << (2 * b);
+		pgb_spread[i] = w;
+	}
+}
+
+/* four pixels' 2 bit colours (one byte of a spread word, leftmost pixel in the top bits) -> four palette entries, leftmost first in memory.
+ * Rebuilt when the background palette changes (rarely: it is written by the game, usually once per screen). */
+static uint32_t pgb_pal4[256];
+static uint8_t pgb_pal4_for[4];
+static int pgb_pal4_ok;
+
+static void pgb_pal4_update(const uint8_t *pal)
+{
+	int v;
+
+	if(pgb_pal4_ok && !memcmp(pgb_pal4_for, pal, 4))
+		return;
+	for(v = 0; v < 256; v++)
+		pgb_pal4[v] = (uint32_t)pal[(v >> 6) & 3] | ((uint32_t)pal[(v >> 4) & 3] << 8) |
+			      ((uint32_t)pal[(v >> 2) & 3] << 16) | ((uint32_t)pal[v & 3] << 24);
+	memcpy(pgb_pal4_for, pal, 4);
+	pgb_pal4_ok = 1;
+}
+
+/* pixels[x0..x1] from one row of a tile map; the map column of pixel x is ((x + xoff) & 255) >> 3 */
+static void pgb_draw_tiles(struct gb_s *gb, uint8_t *pixels, int x0, int x1, uint16_t map_row, uint8_t py, uint8_t xoff)
+{
+	int x = x0;
+
+	if(!pgb_spread[255])
+		pgb_spread_init();
+#if !PEANUT_GB_12_COLOUR
+	pgb_pal4_update(gb->display.bg_palette);
+#endif
+	while(x <= x1)
+	{
+		uint8_t X = (uint8_t)(x + xoff);
+		uint8_t idx = gb->vram[map_row + (X >> 3)];
+		uint16_t tile, w;
+		int b;
+
+		if(gb->hram_io[IO_LCDC] & LCDC_TILE_SELECT)
+			tile = VRAM_TILES_1 + idx * 0x10;
+		else
+			tile = VRAM_TILES_2 + ((idx + 0x80) % 0x100) * 0x10;
+		tile += 2 * py;
+		w = pgb_spread[gb->vram[tile]] | (pgb_spread[gb->vram[tile + 1]] << 1);
+#if !PEANUT_GB_12_COLOUR
+		if((X & 7) == 0 && x + 7 <= x1)		/* a whole tile row: two table loads, eight bytes */
+		{
+			uint32_t a = pgb_pal4[w >> 8], c = pgb_pal4[w & 0xff];
+
+			memcpy(pixels + x, &a, 4);
+			memcpy(pixels + x + 4, &c, 4);
+			x += 8;
+			continue;
+		}
+#endif
+		for(b = 7 - (X & 7); b >= 0 && x <= x1; b--, x++)
+		{
+			pixels[x] = gb->display.bg_palette[(w >> (2 * b)) & 3];
+#if PEANUT_GB_12_COLOUR
+			pixels[x] |= LCD_PALETTE_BG;
+#endif
+		}
+	}
+}
+#endif
