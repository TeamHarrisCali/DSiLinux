+static void draw_icon(GR_WINDOW_ID d, const struct item *it, int x, int y)
+{
+	const char *n = it->name;
+
+	if (is(n, "Shut down") || is(n, "Exit desktop")) {		/* red power button */
+		w95_fill(d, gc, W95_DARK, x, y, 9, 9);
+		w95_fill(d, gc, ICO_RED, x + 1, y + 1, 7, 7);
+		w95_fill(d, gc, W95_LIGHT, x + 4, y + 2, 1, 4);
+	} else if (is(n, "Terminal")) {					/* a black screen with a prompt */
+		w95_fill(d, gc, W95_DARK, x, y, 9, 9);
+		w95_fill(d, gc, ICO_GREEN, x + 2, y + 3, 2, 1);
+		w95_fill(d, gc, ICO_GREEN, x + 4, y + 4, 1, 1);
+		w95_fill(d, gc, ICO_GREEN, x + 2, y + 5, 2, 1);
+		w95_fill(d, gc, W95_LIGHT, x + 5, y + 6, 3, 1);
+	} else if (is(n, "Files") || is(n, "Accessories") || is(n, "Save log")) {	/* folder */
+		w95_fill(d, gc, ICO_YELLOW, x, y + 1, 4, 2);
+		w95_fill(d, gc, W95_DARK, x, y + 3, 9, 6);
+		w95_fill(d, gc, ICO_YELLOW, x + 1, y + 4, 7, 4);
+	} else if (is(n, "Notes") || is(n, "Paint")) {			/* a page with lines */
