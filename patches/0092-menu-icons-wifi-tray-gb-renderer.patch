+		w95_fill(d, gc, W95_LIGHT, x + 1, y + 1, 7, 7);
+		w95_fill(d, gc, W95_DARK, x + 4, y + 2, 1, 3);
+		w95_fill(d, gc, W95_DARK, x + 4, y + 4, 3, 1);
+	} else if (is(n, "Camera") || is(n, "Photos") || is(n, "Multimedia")) {	/* camera body and lens */
