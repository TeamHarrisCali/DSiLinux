From f0fbf1bdaf00e4bf94ee899c7b71cd7a9dd24a3b Mon Sep 17 00:00:00 2001
From: TeamHarrisCali <34009957+TeamHarrisCali@users.noreply.github.com>
Date: Wed, 11 Nov 2026 04:26:16 -0600
Subject: [PATCH] DSI desktop: 6x10 X11 misc-fixed font as Tiny (8x8 looked
 squashed), 11 px captions, 40x12 terminal, Notes/Files 232x130; dsbench waits
 for the server

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 user/microwin/src/demos/nanox/dsbench.c |   18 +-
 user/microwin/src/demos/nanox/dsfiles.c |    4 +-
 user/microwin/src/demos/nanox/dsnotes.c |    4 +-
 user/microwin/src/demos/nanox/nxterm.c  |    4 +-
 user/microwin/src/drivers/genfont.c     |    4 +-
 user/microwin/src/fonts/Makefile        |    2 +-
 user/microwin/src/fonts/X6x10.c         | 2833 +++++++++++++++++++++++
 user/microwin/src/include/nxdraw.h      |    2 +-
 8 files changed, 2855 insertions(+), 16 deletions(-)
 create mode 100644 user/microwin/src/fonts/X6x10.c

diff --git a/user/microwin/src/demos/nanox/dsbench.c b/user/microwin/src/demos/nanox/dsbench.c
index 43ee1337e..0889caecf 100644
--- a/user/microwin/src/demos/nanox/dsbench.c
+++ b/user/microwin/src/demos/nanox/dsbench.c
@@ -16,6 +16,14 @@ static long now_ms(void)
 	return tv.tv_sec * 1000L + tv.tv_usec / 1000;
 }
 
+/* a request with an answer: the server has finished everything sent before it */
+static void sync_server(GR_WINDOW_ID w)
+{
+	GR_WINDOW_INFO info;
+
+	GrGetWindowInfo(w, &info);
+}
+
 int main(void)
 {
 	GR_WINDOW_ID w;
@@ -40,25 +48,23 @@ int main(void)
 		GrGetNextEvent(&ev);
 	while (ev.type != GR_EVENT_TYPE_EXPOSURE);
 
+	sync_server(w);
 	t = now_ms();
 	for (i = 0; i < 20; i++)
 		w95_fill(w, gc, i & 1 ? W95_LIGHT : W95_NAVY, 0, 0, 100, 100);	/* 10000 pixels each */
-	GrFlush();
-	GrGetNextEventTimeout(&ev, 1);	/* a round trip to the server, so the work is really done */
+	sync_server(w);
 	r[0] = now_ms() - t;
 
 	t = now_ms();
 	for (i = 0; i < 100; i++)
 		w95_text(w, gc, W95_DARK, 2, 2 + (i % 10) * 8, "The quick brown fox jumps");
-	GrFlush();
-	GrGetNextEventTimeout(&ev, 1);
+	sync_server(w);
 	r[1] = now_ms() - t;
 
 	t = now_ms();
 	for (i = 0; i < 100; i++)
 		w95_box(w, gc, 10, 10, 60, 20, i & 1, 1);
-	GrFlush();
-	GrGetNextEventTimeout(&ev, 1);
+	sync_server(w);
 	r[2] = now_ms() - t;
 
 	sprintf(line, "20 fills of 10000 px: %ld ms", r[0]);
