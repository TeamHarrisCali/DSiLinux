@@ -160,6 +160,7 @@ finishrom:
 	-cp -p $(ROMFSDIR)/$(FATFS)/linux/usr/bin/dsnotes $(ROMFSDIR)/boot/dsnotes
 	-cp -p $(ROMFSDIR)/$(FATFS)/linux/usr/bin/dsfiles $(ROMFSDIR)/boot/dsfiles
 	-cp -p $(ROMFSDIR)/$(FATFS)/linux/usr/bin/dsbench $(ROMFSDIR)/boot/dsbench
+	-cp -p $(ROMFSDIR)/$(FATFS)/linux/usr/bin/dsgears $(ROMFSDIR)/boot/dsgears
 	-cp -p $(ROMFSDIR)/$(FATFS)/linux/usr/bin/madplay $(ROMFSDIR)/$(OPTDIR)
 	# Compress the data area of these programs
 	$(CROSS)flthdr -d $(ROMFSDIR)/$(OPTDIR)/*
diff --git a/vendors/Nintendo/DSI/gl b/vendors/Nintendo/DSI/gl
index 17818ebe1..9b0305344 100644
--- a/vendors/Nintendo/DSI/gl
+++ b/vendors/Nintendo/DSI/gl
@@ -2,10 +2,16 @@
 # 3D speed test on the text screen: TinySDGL's "gears" (a software OpenGL, no 3D hardware used).
 # The desktop owns the screen: stop it first (Start menu > Exit desktop, or /boot/desktop stop).
 # It prints frames per second every few seconds. Esc or q ends it, the arrow keys turn the gears.
+# /boot/gl profile: a 15 second profiling run (dsgears) that prints a table of where the time of a frame goes.
 if [ -n "`pidof nano-X`" ]; then
 	echo "gl: stop the desktop first (Start menu > Exit desktop)"
 	exit 1
 fi
-echo "gears: Esc or q to quit"
-/usr/bin/gears
+if [ "$1" = "profile" ]; then
+	echo "dsgears: 5 tests of 3 s, then a table of where a frame's time goes"
+	/boot/dsgears
+else
+	echo "gears: Esc or q to quit"
+	/usr/bin/gears
+fi
 echo "gl: done"
