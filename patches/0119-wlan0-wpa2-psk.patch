+		lg(cur_group == 3 ? "connect: WPA2 (group cipher TKIP): computing the key from the password...\n" :
+		   "connect: WPA2 (AES): computing the key from the password...\n", 0, 0, 0);
+		wpa_pmk(psk, (const unsigned char *)n->ssid, strlen(n->ssid), pmk);
+		lg("connect: key computed\n", 0, 0, 0);
+	}
 	{
 		char line[80];
 
@@ -736,6 +954,11 @@ static noinline void do_connect(void)
 	 * channel switches) */
 	memset(b, 0, sizeof(b));
 	b[0] = 1; b[1] = 1; b[2] = 1; b[3] = 1; b[4] = 0; b[5] = 1; b[6] = 0;
+	if (wpa2) {						/* WPA2-PSK (auth mode 5), pairwise AES (4), the AP's group cipher */
+		b[2] = 5;
+		b[3] = 4;
+		b[5] = cur_group;
+	}
 	b[7] = strlen(n->ssid);
 	memcpy(b + 8, n->ssid, b[7]);
 	b[40] = wifi_channel_to_mhz(n->channel) & 0xff;
@@ -842,7 +1065,7 @@ static int wthread(void *arg)
 
