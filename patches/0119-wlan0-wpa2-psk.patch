+/*
+ * WPA2-PSK 4-way handshake (after dswifi's arm7/twl/ath/wmi.twl.c, with the MIC of message 3 checked). An EAPOL-Key frame: version,
+ * type 3, length (BE), descriptor 2, key info (BE), key length, replay counter (8), nonce (32), IV (16), RSC (8), key ID (8),
+ * MIC (16), key data length (BE), key data. Key info bits: 0x0008 pairwise, 0x0040 install, 0x0080 ack, 0x0100 MIC, 0x0200 secure,
+ * 0x1000 encrypted key data; version 2 = HMAC-SHA1 MIC and AES key wrap.
+ */
+static unsigned char eapol[160];
+
+/* send an EAPOL-Key frame (key info, replay counter, nonce or none, key data) to the AP as a data packet (header word 0, 00 1C) */
+static noinline void eapol_out(unsigned int keyinfo, const unsigned char *replay, const unsigned char *nonce,
+			       const unsigned char *kd, unsigned int kdlen)
+{
+	unsigned int body = 95 + kdlen, flen = 4 + body, full, pl;
+	unsigned char mic[16];
+	int bad = 0;
+
+	memset(eapol, 0, sizeof(eapol));
+	eapol[0] = 1;					/* version (as dswifi) */
+	eapol[1] = 3;					/* EAPOL-Key */
+	eapol[2] = body >> 8;
+	eapol[3] = body & 0xff;
+	eapol[4] = 2;					/* RSN key descriptor */
+	eapol[5] = keyinfo >> 8;
+	eapol[6] = keyinfo & 0xff;
+	memcpy(eapol + 9, replay, 8);
+	if (nonce)
+		memcpy(eapol + 17, nonce, 32);
+	eapol[97] = kdlen >> 8;
+	eapol[98] = kdlen & 0xff;
+	if (kdlen)
+		memcpy(eapol + 99, kd, kdlen);
+	wpa_mic(ptk, eapol, flen, mic);			/* KCK = PTK bytes 0..15 */
+	memcpy(eapol + 81, mic, 16);
+
+	pl = 24 + flen;					/* data header with LLC/SNAP and EtherType 0x888E, then the frame */
+	full = (6 + pl + 0x7F) & ~0x7Fu;
+	memset(pkt, 0, full);
+	pkt[0] = 2;
+	pkt[2] = pl & 0xff;
+	pkt[3] = pl >> 8;
+	pkt[6] = 0x00;
+	pkt[7] = 0x1C;
+	memcpy(pkt + 8, ap_mac, 6);
+	memcpy(pkt + 14, mac, 6);
+	pkt[20] = (flen + 8) >> 8;
+	pkt[21] = (flen + 8) & 0xff;
+	pkt[22] = 0xAA; pkt[23] = 0xAA; pkt[24] = 0x03;
+	pkt[28] = 0x88; pkt[29] = 0x8E;
+	memcpy(pkt + 30, eapol, flen);
+	op(11, 0, full, pkt, full, &bad);
+}
+
+/* the keys into the firmware: pairwise (TK) and group, as dswifi's wmi_post_handshake() */
+static noinline void install_key(int idx, int type, int usage, const unsigned char *key, const unsigned char *rsc, int *bad)
+{
+	unsigned char b[45];
+	int klen = type == 3 ? 32 : 16;
+
+	memset(b, 0, sizeof(b));
+	b[0] = idx;
+	b[1] = type;
+	b[2] = usage;
+	b[3] = klen;
+	if (rsc)
+		memcpy(b + 4, rsc, 8);
+	if (type == 3) {				/* TKIP: dswifi swaps the two MIC keys */
+		memcpy(b + 12, key, 16);
+		memcpy(b + 12 + 16, key + 24, 8);
+		memcpy(b + 12 + 24, key + 16, 8);
+	} else {
+		memcpy(b + 12, key, 16);
+	}
+	b[44] = 3;					/* key_op_ctrl */
+	mbox_out(1, 1, WMI_ADD_CIPHER_KEY_CMD, b, 45, bad);
+}
+
+/* the GTK from the (decrypted) key data: KDE dd len 00-0F-AC 01, key ID info, reserved, key */
+static noinline int find_gtk(const unsigned char *kd, int len, int *keyid, const unsigned char **gtk)
+{
+	int i = 0;
+
+	while (i + 2 <= len) {
+		int t = kd[i], l = kd[i + 1];
+
+		if (t == 0xDD && l >= 6 + 16 && i + 2 + l <= len && kd[i + 2] == 0x00 && kd[i + 3] == 0x0F && kd[i + 4] == 0xAC &&
+		    kd[i + 5] == 0x01) {
+			*keyid = kd[i + 6] & 3;
+			*gtk = kd + i + 8;
+			return 0;
+		}
+		if (t == 0 && l == 0)
+			break;
+		i += 2 + l;
+	}
+	return -1;
+}
+
+static noinline void eapol_in(const unsigned char *f, int len)
+{
+	unsigned int keyinfo, flen, kdlen;
+	unsigned char mic[16], kd[128], copy[256];
+	const unsigned char *gtk;
+	int keyid, bad = 0, k;
+
+	if (len < 99 || f[1] != 3)
+		return;
+	flen = 4 + ((f[2] << 8) | f[3]);
+	keyinfo = (f[5] << 8) | f[6];
+	kdlen = (f[97] << 8) | f[98];
+	if (flen > (unsigned int)len || flen > sizeof(copy) || 99 + kdlen > flen)
+		return;
+	if ((keyinfo & 0x0108) == 0x0008 && (keyinfo & 0x0080)) {		/* message 1 of 4 */
+		static const unsigned char rsn_aes[22] = { 0x30, 0x14, 0x01, 0x00, 0x00, 0x0F, 0xAC, 0x04, 0x01, 0x00, 0x00, 0x0F, 0xAC,
+							   0x04, 0x01, 0x00, 0x00, 0x0F, 0xAC, 0x02, 0x00, 0x00 };
+		unsigned char rsn[22];
+
+		memcpy(rsn, rsn_aes, 22);
+		if (cur_group == 3)
+			rsn[7] = 0x02;				/* TKIP group cipher */
+		memcpy(anonce, f + 17, 32);
+		get_random_bytes(snonce, 32);
+		wpa_ptk(pmk, ap_mac, mac, anonce, snonce, ptk);
+		eapol_out(0x010A, f + 9, snonce, rsn, 22);
+		lg("  WPA2 handshake: message 1 received, 2 sent\n", 0, 0, 0);
+		return;
+	}
+	if (!(keyinfo & 0x0100) || !(keyinfo & 0x0080))
+		return;
+	/* messages 3 of 4 and group renewals carry a MIC: check it over the frame with the MIC field zeroed */
+	memcpy(copy, f, flen);
+	memset(copy + 81, 0, 16);
+	wpa_mic(ptk, copy, flen, mic);
+	if (memcmp(mic, f + 81, 16)) {
+		lg("  WPA2 handshake: MIC wrong (key info %04x): wrong password?\n", keyinfo, 0, 0);
+		return;
+	}
+	if (!(keyinfo & 0x1000) || kdlen < 24 || kdlen - 8 > sizeof(kd) || wpa_unwrap(ptk + 16, f + 99, kdlen, kd)) {
+		lg("  WPA2 handshake: key data not readable (key info %04x, %u bytes)\n", keyinfo, kdlen, 0);
+		return;
+	}
+	if (find_gtk(kd, kdlen - 8, &keyid, &gtk)) {
+		lg("  WPA2 handshake: no group key in message (key info %04x)\n", keyinfo, 0, 0);
+		return;
+	}
+	if (keyinfo & 0x0008) {
+		eapol_out(0x030A, f + 9, 0, 0, 0);		/* message 4 of 4 */
+		lg("  WPA2 handshake: message 3 received (MIC ok), 4 sent\n", 0, 0, 0);
+	} else {
+		eapol_out(0x0302, f + 9, 0, 0, 0);		/* group message 2 of 2 */
+		lg("  WPA2 group key renewed (key %u)\n", keyid, 0, 0);
+	}
+	/* as dswifi: synchronize, two empty data packets, the keys, synchronize */
+	k = 1;
+	mbox_out(1, 1, WMI_SYNCHRONIZE_CMD, &k, 1, &bad);
+	{
+		unsigned char d[2] = { 0x00, 0x02 };
+		unsigned int full = 0x80;
+
+		memset(pkt, 0, full);
+		pkt[0] = 2;
+		pkt[2] = 2;
+		memcpy(pkt + 6, d, 2);
+		op(11, 0, full, pkt, full, &bad);
+		op(11, 0, full, pkt, full, &bad);
+	}
+	if (keyinfo & 0x0008)
+		install_key(0, 4, 0, ptk + 32, 0, &bad);	/* pairwise: TK, AES */
+	install_key(keyid, cur_group, 1, gtk, f + 65, &bad);	/* group, with the AP's RSC */
+	mbox_out(1, 1, WMI_SYNCHRONIZE_CMD, &k, 1, &bad);
+	if (bad) {
+		lg("  WPA2: installing the keys FAILED\n", 0, 0, 0);
+		return;
+	}
+	if (!keys_ok) {
+		keys_ok = 1;
+		lg("  WPA2 keys installed: link up\n", 0, 0, 0);
+		if (wdev)
+			netif_carrier_on(wdev);
+	}
+}
+
 /* a received data packet (endpoint 2..5): rssi, 0, dst[6], src[6], length (BE), LLC/SNAP AA AA 03 00 00 00, EtherType, data */
