 		lg("  disconnected: reason %u (protocol reason %u)\n", rx[16], rx[8] | (rx[9] << 8), 0);
 		if (wdev)
 			netif_carrier_off(wdev);
@@ -669,17 +873,31 @@ static noinline void do_connect(void)
 	int i, bad = 0;
 
 	for (i = 0; i < nnets; i++) {
-		if (strcmp(nets[i].sec, "open"))
-			continue;
-		if (conn_req[0] && strcmp(nets[i].ssid, conn_req))
