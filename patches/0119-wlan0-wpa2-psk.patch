+/*
+ * WPA2-PSK crypto for the DSi's Atheros Wi-Fi (arch/arm/mach-nds/dsiwifi.c, step 6 of docs/ATHEROS-PLAN.md): SHA-1, HMAC-SHA1, PBKDF2
+ * (passphrase -> PMK), the IEEE 802.11i PRF (PMK -> PTK), the EAPOL-Key MIC and AES key unwrap (RFC 3394) for the group key.
+ * The kernel's crypto API is not built in this configuration, so it is done here. Plain C with no kernel headers when DSIWPA_HOST is
+ * defined: testbed/wpa_test.c checks every function against the RFC 2202, IEEE 802.11i and RFC 3394 test vectors on the PC.
+ * The helpers are noinline and structures are copied with memcpy: gcc 4.0.4 (with the DS's byte-write option) crashed on wpa_pmk()
+ * otherwise ("unrecognizable insn").
+ */
+#ifdef DSIWPA_HOST
+#include <string.h>
+typedef unsigned char u8;
+typedef unsigned int u32;
+#define noinline __attribute__((noinline))
+#else
+#include <linux/kernel.h>
+#include <linux/string.h>
+#include <linux/types.h>
+#endif
+
+/* ---------------------------------------------------------------- SHA-1 */
+struct sha1 {
+	u32 h[5];
+	u8 buf[64];
+	u32 n;			/* bytes in buf */
+	u32 total;		/* bytes hashed */
+};
+
+#define ROL(x, n)	(((x) << (n)) | ((x) >> (32 - (n))))
+
+static noinline void sha1_block(u32 *h, const u8 *p)
+{
+	u32 w[80], a, b, c, d, e, t;
+	int i;
+
+	for (i = 0; i < 16; i++)
+		w[i] = (p[i * 4] << 24) | (p[i * 4 + 1] << 16) | (p[i * 4 + 2] << 8) | p[i * 4 + 3];
+	for (; i < 80; i++)
+		w[i] = ROL(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16], 1);
+	a = h[0]; b = h[1]; c = h[2]; d = h[3]; e = h[4];
+	for (i = 0; i < 80; i++) {
+		if (i < 20)
+			t = ((b & c) | (~b & d)) + 0x5A827999;
+		else if (i < 40)
+			t = (b ^ c ^ d) + 0x6ED9EBA1;
+		else if (i < 60)
+			t = ((b & c) | (b & d) | (c & d)) + 0x8F1BBCDC;
+		else
+			t = (b ^ c ^ d) + 0xCA62C1D6;
+		t += ROL(a, 5) + e + w[i];
+		e = d; d = c; c = ROL(b, 30); b = a; a = t;
+	}
+	h[0] += a; h[1] += b; h[2] += c; h[3] += d; h[4] += e;
+}
+
+static noinline void sha1_init(struct sha1 *s)
+{
+	s->h[0] = 0x67452301; s->h[1] = 0xEFCDAB89; s->h[2] = 0x98BADCFE; s->h[3] = 0x10325476; s->h[4] = 0xC3D2E1F0;
+	s->n = s->total = 0;
+}
+
+static noinline void sha1_add(struct sha1 *s, const u8 *p, u32 len)
+{
+	s->total += len;
+	while (len) {
+		u32 k = 64 - s->n < len ? 64 - s->n : len;
+
+		memcpy(s->buf + s->n, p, k);
+		s->n += k;
+		p += k;
+		len -= k;
+		if (s->n == 64) {
+			sha1_block(s->h, s->buf);
+			s->n = 0;
+		}
+	}
+}
+
+static noinline void sha1_end(struct sha1 *s, u8 out[20])
+{
+	u32 bits = s->total * 8;
+	u8 pad = 0x80, z = 0, l[8];
+	int i;
+
+	sha1_add(s, &pad, 1);
+	while (s->n != 56)
+		sha1_add(s, &z, 1);
+	for (i = 0; i < 4; i++)
+		l[i] = 0;
+	l[4] = bits >> 24; l[5] = bits >> 16; l[6] = bits >> 8; l[7] = bits;
+	sha1_add(s, l, 8);
+	for (i = 0; i < 5; i++) {
+		out[i * 4] = s->h[i] >> 24;
+		out[i * 4 + 1] = s->h[i] >> 16;
+		out[i * 4 + 2] = s->h[i] >> 8;
+		out[i * 4 + 3] = s->h[i];
+	}
+}
+
+/* ---------------------------------------------------------------- HMAC-SHA1 */
+/* the key's inner and outer states, so PBKDF2 does not rehash the key 8192 times */
+struct hmac {
+	struct sha1 in, out;
+};
+
+static noinline void hmac_key(struct hmac *m, const u8 *key, u32 klen)
+{
+	u8 k[64], pad[64];
+	int i;
+
+	memset(k, 0, 64);
+	if (klen > 64) {
+		struct sha1 s;
+
+		sha1_init(&s);
+		sha1_add(&s, key, klen);
+		sha1_end(&s, k);
+	} else {
+		memcpy(k, key, klen);
+	}
+	for (i = 0; i < 64; i++)
+		pad[i] = k[i] ^ 0x36;
+	sha1_init(&m->in);
+	sha1_add(&m->in, pad, 64);
+	for (i = 0; i < 64; i++)
+		pad[i] = k[i] ^ 0x5C;
+	sha1_init(&m->out);
+	sha1_add(&m->out, pad, 64);
+}
+
+static noinline void hmac_run(const struct hmac *m, const u8 *p, u32 len, const u8 *p2, u32 len2, u8 out[20])
+{
+	struct sha1 s;
+	u8 ih[20];
+
+	memcpy(&s, &m->in, sizeof(s));
+	sha1_add(&s, p, len);
+	if (p2)
+		sha1_add(&s, p2, len2);
+	sha1_end(&s, ih);
+	memcpy(&s, &m->out, sizeof(s));
+	sha1_add(&s, ih, 20);
+	sha1_end(&s, out);
+}
+
+void wpa_hmac_sha1(const u8 *key, u32 klen, const u8 *data, u32 len, u8 out[20])
+{
+	struct hmac m;
+
+	hmac_key(&m, key, klen);
+	hmac_run(&m, data, len, 0, 0, out);
+}
+
+/* ---------------------------------------------------------------- PBKDF2: PMK = PBKDF2-HMAC-SHA1(passphrase, SSID, 4096, 32) */
+void wpa_pmk(const char *pass, const u8 *ssid, u32 ssid_len, u8 pmk[32])
+{
+	/* whole words, no byte stores: gcc 4.0.4 crashed on the byte-wise version (a spilled byte under the DS byte-write option) */
+	static const u8 cnt[2][4] = { { 0, 0, 0, 1 }, { 0, 0, 0, 2 } };
+	struct hmac m;
+	u32 u[5], t[5];
+	int blk, i, j;
+
+	hmac_key(&m, (const u8 *)pass, strlen(pass));
+	for (blk = 0; blk < 2; blk++) {
+		hmac_run(&m, ssid, ssid_len, cnt[blk], 4, (u8 *)u);
+		for (j = 0; j < 5; j++)
+			t[j] = u[j];
+		for (i = 1; i < 4096; i++) {
+			hmac_run(&m, (const u8 *)u, 20, 0, 0, (u8 *)u);
+			for (j = 0; j < 5; j++)
+				t[j] ^= u[j];
+		}
+		memcpy(pmk + blk * 20, t, blk == 0 ? 20 : 12);
+	}
+}
+
+/* ---------------------------------------------------------------- PRF-384: PTK = KCK (16) | KEK (16) | TK (16) */
+static const u8 *bmin(const u8 *a, const u8 *b, int n)
+{
+	return memcmp(a, b, n) < 0 ? a : b;
+}
+
+static const u8 *bmax(const u8 *a, const u8 *b, int n)
+{
+	return memcmp(a, b, n) < 0 ? b : a;
+}
+
+void wpa_ptk(const u8 pmk[32], const u8 *aa, const u8 *spa, const u8 *anonce, const u8 *snonce, u8 ptk[48])
+{
+	static const char label[] = "Pairwise key expansion";
+	u8 data[23 + 6 + 6 + 32 + 32 + 1], out[80];
+	struct hmac m;
+	int i, p = 0;
+
+	memcpy(data, label, 22);
+	data[22] = 0;
+	p = 23;
+	memcpy(data + p, bmin(aa, spa, 6), 6);
+	p += 6;
+	memcpy(data + p, bmax(aa, spa, 6), 6);
+	p += 6;
+	memcpy(data + p, bmin(anonce, snonce, 32), 32);
+	p += 32;
+	memcpy(data + p, bmax(anonce, snonce, 32), 32);
+	p += 32;
+	hmac_key(&m, pmk, 32);
+	for (i = 0; i < 3; i++) {			/* 3 x 20 bytes >= 48 */
+		data[p] = i;
+		hmac_run(&m, data, p + 1, 0, 0, out + i * 20);
+	}
+	memcpy(ptk, out, 48);
+}
+
+/* EAPOL-Key MIC (key descriptor version 2): the first 16 bytes of HMAC-SHA1(KCK, frame with the MIC field zeroed) */
+void wpa_mic(const u8 kck[16], const u8 *frame, u32 len, u8 mic[16])
+{
+	u8 out[20];
+
+	wpa_hmac_sha1(kck, 16, frame, len, out);
+	memcpy(mic, out, 16);
+}
+
+/* ---------------------------------------------------------------- AES-128 decryption, key unwrap (RFC 3394) */
+static const u8 sbox[256] = {
+	0x63,0x7c,0x77,0x7b,0xf2,0x6b,0x6f,0xc5,0x30,0x01,0x67,0x2b,0xfe,0xd7,0xab,0x76,0xca,0x82,0xc9,0x7d,0xfa,0x59,0x47,0xf0,0xad,0xd4,0xa2,0xaf,0x9c,0xa4,0x72,0xc0,
+	0xb7,0xfd,0x93,0x26,0x36,0x3f,0xf7,0xcc,0x34,0xa5,0xe5,0xf1,0x71,0xd8,0x31,0x15,0x04,0xc7,0x23,0xc3,0x18,0x96,0x05,0x9a,0x07,0x12,0x80,0xe2,0xeb,0x27,0xb2,0x75,
+	0x09,0x83,0x2c,0x1a,0x1b,0x6e,0x5a,0xa0,0x52,0x3b,0xd6,0xb3,0x29,0xe3,0x2f,0x84,0x53,0xd1,0x00,0xed,0x20,0xfc,0xb1,0x5b,0x6a,0xcb,0xbe,0x39,0x4a,0x4c,0x58,0xcf,
+	0xd0,0xef,0xaa,0xfb,0x43,0x4d,0x33,0x85,0x45,0xf9,0x02,0x7f,0x50,0x3c,0x9f,0xa8,0x51,0xa3,0x40,0x8f,0x92,0x9d,0x38,0xf5,0xbc,0xb6,0xda,0x21,0x10,0xff,0xf3,0xd2,
+	0xcd,0x0c,0x13,0xec,0x5f,0x97,0x44,0x17,0xc4,0xa7,0x7e,0x3d,0x64,0x5d,0x19,0x73,0x60,0x81,0x4f,0xdc,0x22,0x2a,0x90,0x88,0x46,0xee,0xb8,0x14,0xde,0x5e,0x0b,0xdb,
+	0xe0,0x32,0x3a,0x0a,0x49,0x06,0x24,0x5c,0xc2,0xd3,0xac,0x62,0x91,0x95,0xe4,0x79,0xe7,0xc8,0x37,0x6d,0x8d,0xd5,0x4e,0xa9,0x6c,0x56,0xf4,0xea,0x65,0x7a,0xae,0x08,
+	0xba,0x78,0x25,0x2e,0x1c,0xa6,0xb4,0xc6,0xe8,0xdd,0x74,0x1f,0x4b,0xbd,0x8b,0x8a,0x70,0x3e,0xb5,0x66,0x48,0x03,0xf6,0x0e,0x61,0x35,0x57,0xb9,0x86,0xc1,0x1d,0x9e,
+	0xe1,0xf8,0x98,0x11,0x69,0xd9,0x8e,0x94,0x9b,0x1e,0x87,0xe9,0xce,0x55,0x28,0xdf,0x8c,0xa1,0x89,0x0d,0xbf,0xe6,0x42,0x68,0x41,0x99,0x2d,0x0f,0xb0,0x54,0xbb,0x16 };
+
+static u8 inv_sbox[256];
+
+static u8 xt(u8 x)
+{
+	return (x << 1) ^ ((x & 0x80) ? 0x1B : 0);
+}
+
+static u8 mul(u8 a, u8 b)
+{
+	u8 r = 0;
+
+	while (b) {
+		if (b & 1)
+			r ^= a;
+		a = xt(a);
+		b >>= 1;
+	}
+	return r;
+}
+
+static void aes_expand(const u8 key[16], u8 rk[176])
+{
+	u8 rcon = 1, t[4];
+	int i;
+
+	memcpy(rk, key, 16);
+	for (i = 16; i < 176; i += 4) {
+		memcpy(t, rk + i - 4, 4);
+		if (i % 16 == 0) {
+			u8 x = t[0];
+
+			t[0] = sbox[t[1]] ^ rcon;
+			t[1] = sbox[t[2]];
+			t[2] = sbox[t[3]];
+			t[3] = sbox[x];
+			rcon = xt(rcon);
+		}
+		rk[i] = rk[i - 16] ^ t[0];
+		rk[i + 1] = rk[i - 15] ^ t[1];
+		rk[i + 2] = rk[i - 14] ^ t[2];
+		rk[i + 3] = rk[i - 13] ^ t[3];
+	}
+}
+
+static void aes_decrypt(const u8 rk[176], u8 b[16])
+{
+	u8 t[16];
+	int r, i, c;
+
+	static int inv_ready;
+
+	if (!inv_ready) {				/* built once: the inverse of the S-box */
+		for (i = 0; i < 256; i++)
+			inv_sbox[sbox[i]] = i;
+		inv_ready = 1;
+	}
+	for (i = 0; i < 16; i++)
+		b[i] ^= rk[160 + i];
+	for (r = 9; r >= 0; r--) {
+		/* inverse shift rows, inverse substitute */
+		for (c = 0; c < 4; c++)
+			for (i = 0; i < 4; i++)
+				t[c * 4 + i] = inv_sbox[b[((c - i + 4) % 4) * 4 + i]];
+		for (i = 0; i < 16; i++)
+			b[i] = t[i] ^ rk[r * 16 + i];
+		if (r == 0)
+			break;
+		for (c = 0; c < 4; c++) {		/* inverse mix columns */
+			u8 *s = b + c * 4, a0 = s[0], a1 = s[1], a2 = s[2], a3 = s[3];
+
+			s[0] = mul(a0, 14) ^ mul(a1, 11) ^ mul(a2, 13) ^ mul(a3, 9);
+			s[1] = mul(a0, 9) ^ mul(a1, 14) ^ mul(a2, 11) ^ mul(a3, 13);
+			s[2] = mul(a0, 13) ^ mul(a1, 9) ^ mul(a2, 14) ^ mul(a3, 11);
+			s[3] = mul(a0, 11) ^ mul(a1, 13) ^ mul(a2, 9) ^ mul(a3, 14);
+		}
+	}
+}
+
+/* RFC 3394 unwrap: in = n + 1 blocks of 8 bytes; out = n blocks. 0 = ok (the integrity value A6A6A6A6A6A6A6A6 matched) */
+int wpa_unwrap(const u8 kek[16], const u8 *in, u32 len, u8 *out)
+{
+	u8 rk[176], a[8], b[16];
+	int n = len / 8 - 1, i, j, k;
+
+	if (len % 8 || n < 1 || n > 64)
+		return -1;
+	aes_expand(kek, rk);
+	memcpy(a, in, 8);
+	memcpy(out, in + 8, n * 8);
+	for (j = 5; j >= 0; j--)
+		for (i = n; i >= 1; i--) {
+			u32 t = n * j + i;
+
+			memcpy(b, a, 8);
+			b[7] ^= t;
+			b[6] ^= t >> 8;
+			b[5] ^= t >> 16;
+			b[4] ^= t >> 24;
+			memcpy(b + 8, out + (i - 1) * 8, 8);
+			aes_decrypt(rk, b);
+			memcpy(a, b, 8);
+			memcpy(out + (i - 1) * 8, b + 8, 8);
+		}
+	for (k = 0; k < 8; k++)
+		if (a[k] != 0xA6)
+			return -1;
+	return 0;
+}
