index 2657f94f9..222eb62a2 100644
--- a/user/microwin/src/demos/nanowm/actions.c
+++ b/user/microwin/src/demos/nanowm/actions.c
@@ -113,6 +113,20 @@ void container_buttondown(win *window, GR_EVENT_BUTTON *event)
 		}
 	}
 
+	/* minimise box, left of the close box (see nxPaintNCArea)*/
+	if ((info.props & (GR_WM_PROPS_CAPTION|GR_WM_PROPS_CLOSEBOX)) ==
+	    (GR_WM_PROPS_CAPTION|GR_WM_PROPS_CLOSEBOX)) {
+		r.x = info.width - 2 * CXCLOSEBOX - cxborder - 4;
+		r.y = cyborder + 2;
+		r.width = CXCLOSEBOX;
+		r.height = CYCLOSEBOX;
+		if (PtInRect(&r, event->x, event->y)) {
+			/* the taskbar (dsdesk) sees the unmap, gives the focus to another window and keeps a button */
+			GrUnmapWindow(window->wid);
+			return;
+		}
+	}
+
 	/* Set focus on button down*/
 	GrSetFocus(window->clientid);
 /*
diff --git a/user/microwin/src/demos/nanox/dsdesk.c b/user/microwin/src/demos/nanox/dsdesk.c
index 878841448..cc9939c58 100644
--- a/user/microwin/src/demos/nanox/dsdesk.c
+++ b/user/microwin/src/demos/nanox/dsdesk.c
@@ -91,6 +91,22 @@ static void refresh_windows(void)
 	}
 	active_client = GrGetFocus();
 	want_refresh = 0;
+
+	/* the focus is on a window that was minimised or closed: hand it to another open window */
+	if (active_client && active_client != GR_ROOT_WINDOW_ID) {
+		int ok = 0;
+
+		for (i = 0; i < ntw; i++)
+			if (tws[i].client == active_client && tws[i].mapped)
+				ok = 1;
+		if (!ok)
+			for (i = ntw - 1; i >= 0; i--)
+				if (tws[i].mapped) {
+					GrSetFocus(tws[i].client);
+					active_client = tws[i].client;
+					break;
+				}
+	}
 }
 
