 #include "nano-X.h"
 #include "nxdraw.h"
 
+/*
+ * On the Nintendo DS every request that waits for an answer from the server costs several milliseconds. A caption
+ * repaint used to create and destroy graphics contexts and ask for about 25 system colours: over 100 ms. The
+ * colours never change and one graphics context is enough (every function sets what it draws with).
+ */
+static GR_COLOR nx_syscolor(int idx)
+{
+	static GR_COLOR col[20];
+	static char have[20];
+
+	if (idx < 0 || idx >= 20)
+		return GrGetSysColor(idx);
+	if (!have[idx]) {
+		col[idx] = GrGetSysColor(idx);
+		have[idx] = 1;
+	}
+	return col[idx];
+}
+
+static GR_GC_ID nx_getgc(void)
+{
+	static GR_GC_ID gc;
+
+	if (!gc)
+		gc = GrNewGC();
+	return gc;
+}
