--- a/user/microwin/src/nanox/srvnet.c
+++ b/user/microwin/src/nanox/srvnet.c
@@ -33,6 +33,9 @@
 #include <linuxmt/na.h>
 #elif __ECOS || NDSDRIVER
 #include <netinet/in.h>
+#if NDSDRIVER
+#include <sys/un.h>
+#endif
 
 #else
 #ifndef TRIMEDIA
@@ -1810,9 +1813,8 @@ GsOpenSocket(void)
 #endif
 #elif __ECOS || NDSDRIVER
 	struct sockaddr_in sckt;
-#ifndef SUN_LEN
+#undef SUN_LEN		/* <sys/un.h> defines it for sockaddr_un; here it is the TCP address */
 #define SUN_LEN(ptr)	(sizeof(sckt))
-#endif
 #else
 	struct sockaddr_un sckt;
 #ifndef SUN_LEN
@@ -1821,6 +1823,35 @@ GsOpenSocket(void)
 #endif
 #endif /* ELKS */
 
+#if NDSDRIVER
+	/*
+	 * Default on the DS: a local (unix) socket. The TCP loopback connection used before costs about 0.8 ms per
+	 * request (a protocol stack for every small message); NANOX_TCP=1 brings it back. Clients decide the same way
+	 * (see client.c), so the variable must be the same for all of them.
+	 */
+	if (!getenv("NANOX_TCP")) {
+		struct sockaddr_un us;
+
+		if (access(GR_NAMED_SOCKET, F_OK) == 0)
+			unlink(GR_NAMED_SOCKET);
+		if ((un_sock = socket(AF_UNIX, SOCK_STREAM, 0)) == -1)
+			return -1;
+		memset(&us, 0, sizeof(us));
+		us.sun_family = AF_UNIX;
+		strncpy(us.sun_path, GR_NAMED_SOCKET, sizeof(us.sun_path) - 1);
+		if (bind(un_sock, (struct sockaddr *) &us,
+			 offsetof(struct sockaddr_un, sun_path) + strlen(us.sun_path) + 1) < 0) {
+			EPRINTF("nano-X: cannot bind the unix socket %s: %m (try NANOX_TCP=1)\n", GR_NAMED_SOCKET);
+			return -1;
+		}
+		if (listen(un_sock, 5) == -1)
+			return -1;
+		EPRINTF("nano-X: unix socket %s\n", GR_NAMED_SOCKET);
+		return 1;
+	}
+	EPRINTF("nano-X: TCP loopback socket (NANOX_TCP)\n");
+#endif
+
 #if ELKS
 	if((un_sock = socket(AF_NANO, SOCK_STREAM, 0)) == -1)
 		return -1;
@@ -1894,7 +1925,7 @@ GsAcceptClient(void)
 		return;
 	}
 #if NDSDRIVER
-	{
+	if (getenv("NANOX_TCP")) {
 		/* see client.c: no Nagle delay, replies are written in two small pieces */
 		int one = 1;
 
