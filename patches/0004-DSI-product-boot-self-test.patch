@@ -0,0 +1,24 @@
+#!/bin/sh
+# DSLinuxDSi boot self-test: prints a short PASS/FAIL summary at the end of boot (no typing needed).
+echo "======== DSLinuxDSi self-test ========"
+grep MemTotal /proc/meminfo
+if dmesg | grep -q MIRRORED
+then
+	echo "RAM : FAIL - only 4 MB real (DS mode)"
+else
+	if dmesg | grep -q 'NDS: main RAM'
+	then
+		echo "RAM : PASS - 16 MB real"
+	else
+		echo "RAM : ? (no probe line)"
+	fi
+fi
+if dmesg | grep -q 'dsisd: init result 0'
+then
+	echo "SD  : PASS - card found"
+else
+	echo "SD  : FAIL - see below"
+fi
+dmesg | grep 'dsisd: init'
+dmesg | grep 'dsisd: diag'
+echo "======================================"
