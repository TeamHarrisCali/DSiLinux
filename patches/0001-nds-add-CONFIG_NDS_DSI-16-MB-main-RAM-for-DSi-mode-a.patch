diff --git a/linux-2.6.x/arch/arm/mach-nds/Kconfig b/linux-2.6.x/arch/arm/mach-nds/Kconfig
index 09b10fc0b..d1352fbe7 100644
--- a/linux-2.6.x/arch/arm/mach-nds/Kconfig
+++ b/linux-2.6.x/arch/arm/mach-nds/Kconfig
@@ -1,5 +1,19 @@
 menu "Nintendo DS Options"
 
+config NDS_DSI
+	bool "Nintendo DSi mode: 16 MB main RAM"
+	depends on ARCH_NDS
+	default n
+	help
+	  Build for a Nintendo DSi running in DSi mode (for example launched
+	  through TWiLight Menu++ with "Run in DSi mode"). The DSi has 16 MB of
+	  main RAM instead of 4 MB. This widens the MPU's main RAM region to
+	  16 MB and moves the ARM9 DTCM out of RAM (to 0x02FF0000, just above
+	  the area the kernel uses). Set the DRAM size to 0x00FF0000 so that
+	  the top 64 KB, which the DSi system uses, is left alone.
+	  A kernel built this way does NOT boot on a DS or a DSi in DS mode.
+	  If unsure, say N.
+
 config NDS_TEXT_CONSOLE
 	bool "Nintendo DS text console"
 	depends on ARCH_NDS
diff --git a/linux-2.6.x/arch/arm/mach-nds/head.S b/linux-2.6.x/arch/arm/mach-nds/head.S
index ccddeecaf..11a7096d6 100644
--- a/linux-2.6.x/arch/arm/mach-nds/head.S
+++ b/linux-2.6.x/arch/arm/mach-nds/head.S
@@ -76,7 +76,19 @@
 /*
  *	Start address of the DTCM Memory.
  */
+#ifdef CONFIG_NDS_DSI
+/*
+ * DSi mode: main RAM is 16 MB, so the standard DTCM address 0x027C0000 would
+ * lie inside RAM the kernel hands out (and ARM7/DMA cannot reach DTCM).
+ * Put DTCM into the reserved top 64 KB of RAM instead (kernel DRAM_SIZE is
+ * 0x00FF0000, i.e. RAM ends at 0x02FF0000).
+ */
+#define DTCM_BASE	0x02FF0000
+#define MAIN_RAM_PAGE	PAGE_16M
+#else
 #define DTCM_BASE	0x027C0000	/* NDS DTCM standard address */
+#define MAIN_RAM_PAGE	PAGE_4M
+#endif
 
 
 /****************************************************************************/
@@ -225,7 +237,7 @@ _entry:
 	@-------------------------------------------------------------------------
 	@ Region 1 - Main Memory
 	@-------------------------------------------------------------------------
-	ldr	r0,=( PAGE_4M  | 0x02000000 | 1)
+	ldr	r0,=( MAIN_RAM_PAGE | 0x02000000 | 1)
 	mcr	p15, 0, r0, c6, c1, 0
 	
 	@-------------------------------------------------------------------------
