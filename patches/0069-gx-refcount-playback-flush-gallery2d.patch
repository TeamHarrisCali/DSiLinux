+	w95_text(win, gc, W95_DARK, 4, VH + 5, t);
+	w95_text(win, gc, W95_SHADOW, 4, VH + 5 + th + 1, "< >  d:del  c:camera");
+}
+
+static void draw_all(void)
+{
+	w95_fill(win, gc, W95_FACE, 0, 0, WIN_W, 2);
+	draw_photo();
+	draw_label();
+}
+
+static void show(int delta)
+{
+	int n = sel + delta;
+
+	if (n < 0 || n >= nphotos)
+		return;
+	sel = n;
+	have = load() == 0;
+	draw_photo();
+	draw_label();
 }
 
