-	return gx_texture_load(0, frame, sizeof(frame));
+	return bmp_read(path, frame);
 }
 
-static void draw(int have)
+/* the photo, in strips of 16 rows (one big request would be too much for the connection) */
+static void draw_photo(void)
 {
-	double hw = 2.0, hh = 1.5;
-
-	gx_mode(GX_MODELVIEW);
-	gx_identity();
-	gx_polyattr(0, GX_CULL_NONE, 31);
-	if (have) {
-		gx_texture(0, 256, 256, 0);
-		gx_begin(GX_QUADS);
-		gx_color(31, 31, 31);
-		gx_texcoord(0, 0); gx_vertex(-hw, hh, -2.0);
-		gx_texcoord(0, PH); gx_vertex(-hw, -hh, -2.0);
-		gx_texcoord(PW, PH); gx_vertex(hw, -hh, -2.0);
-		gx_texcoord(PW, 0); gx_vertex(hw, hh, -2.0);
-		gx_end();
-	} else {				/* nothing to show: a dark grey panel */
-		gx_cmd(GXR_TEXIMAGE, 0);
-		gx_begin(GX_QUADS);
-		gx_color(4, 4, 4);
-		gx_vertex(-hw, hh, -2.0);
-		gx_vertex(-hw, -hh, -2.0);
-		gx_vertex(hw, -hh, -2.0);
-		gx_vertex(hw, hh, -2.0);
-		gx_end();
+	int y0, y, x;
+
+	if (!have) {
+		w95_fill(win, gc, W95_DARK, 2, 2, VW, VH);
+		w95_text(win, gc, W95_LIGHT, 8, 8, nphotos ? "cannot read this photo" : "no photos yet");
+		return;
+	}
+	for (y0 = 0; y0 < VH; y0 += 16) {
+		for (y = 0; y < 16; y++) {
+			const unsigned short *row = frame + ((y0 + y) * 4 / 3) * PW;
+
+			for (x = 0; x < VW; x++) {
+				unsigned short p = row[x * 4 / 3];
+
+				/* DS pixel (red in the low bits) -> 0RRRRRGGGGGBBBBB for the server */
+				strip[y * VW + x] = ((p & 31) << 10) | (p & 0x3e0) | ((p >> 10) & 31);
+			}
+		}
+		GrArea(win, gc, 2, 2 + y0, VW, 16, strip, MWPF_TRUECOLOR555);
 	}
-	gx_swap();
-	gx_flush();
 }
 
-static void label(struct gxw *w, int have, int armed)
+static void draw_label(void)
 {
-	char t[40];
+	char t[48];
 
+	w95_fill(win, gc, W95_FACE, 0, VH + 4, WIN_W, 24);
 	if (nphotos)
-		sprintf(t, "%s", names[sel]);
+		sprintf(t, "%s  %d/%d%s", names[sel], sel + 1, nphotos, armed ? "  delete?" : "");
 	else
 		strcpy(t, "no photos yet");
-	gxw_text(w, 0, t);
-	sprintf(t, "%d / %d%s", nphotos ? sel + 1 : 0, nphotos, armed ? "  delete?" : "");
