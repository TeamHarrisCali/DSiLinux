+++ b/linux-2.6.x/arch/arm/mach-nds/volume.c
@@ -44,8 +44,8 @@ static int mic_read_proc(char *page, char **start, off_t off, int count, int *eo
 	if (dsisd_micdiag(d) != 0)
 		len = sprintf(page, "ARM7 did not answer\n");
 	else
-		len = sprintf(page, "mic_on=%u start=%u stop=%u irq=%u fifo_full=%u fifo_empty=%u period_msgs=%u wraps=%u\n"
-			      "buf=%08x size=%u period=%u rate=%u fmt=%u last=%08x miccnt/tm3=%08x ie=%08x\n"
+		len = sprintf(page, "mic_on=%u start=%u stop=%u irq=%u fifo_full=%u fifo_empty=%u period_msgs=%u hi_nonsign=%u\n"
+			      "lastraw=%08x size=%u period=%u rate=%u fmt=%u last=%08x miccnt/tm3=%08x ie=%08x\n"
 			      "samples: lowest %d highest %d, fifo restarts: overrun %u stall %u\n",
 			      d[0], d[1], d[2], d[3], d[4], d[5], d[6], d[7], d[8], d[9], d[10], d[11], d[12], d[13], d[14], d[15],
 			      (int)d[16], (int)d[17], d[18] >> 16, d[18] & 0xffff);
diff --git a/linux-2.6.x/drivers/video/ndsfb.c b/linux-2.6.x/drivers/video/ndsfb.c
index 539585938..78afe53d6 100644
--- a/linux-2.6.x/drivers/video/ndsfb.c
+++ b/linux-2.6.x/drivers/video/ndsfb.c
@@ -368,8 +368,22 @@ struct ndsfb_gx_submit {
 };
 static int ndsfb_gx_on;
 
+static int ndsfb_gx_users;		/* programs that switched the 3D engine on and not off again */
+
 static void ndsfb_gx_setup(int on)
 {
+	/* more than one program may use the engine (the camera and the 3D gears, say): it goes off when the last one is done, not when
+	 * the first one quits (the others' commands then all failed with errno 22) */
+	if (on) {
+		ndsfb_gx_users++;
+		if (ndsfb_gx_users > 1 && ndsfb_gx_on)
+			return;
+	} else {
+		if (ndsfb_gx_users > 0)
+			ndsfb_gx_users--;
+		if (ndsfb_gx_users > 0)
+			return;
+	}
 	if (on) {
 		POWER_CR |= POWER_MATRIX | POWER_3D_CORE;
 		*(volatile u32 *)0x04000060 = 0;		/* DISP3DCNT: plain */
diff --git a/linux-2.6.x/sound/arm/nds-sound.c b/linux-2.6.x/sound/arm/nds-sound.c
index 16950e7b5..4d8bd9e49 100644
--- a/linux-2.6.x/sound/arm/nds-sound.c
+++ b/linux-2.6.x/sound/arm/nds-sound.c
@@ -330,6 +330,9 @@ static int snd_nds_playback_trigger(snd_pcm_substream_t * substream, int cmd)
 	switch (cmd) 
 	{
 	case SNDRV_PCM_TRIGGER_START:
+		// what was written so far must be in main memory before the hardware reads it
+		if (runtime->dma_area && runtime->dma_bytes)
+			dmac_flush_range((unsigned long)runtime->dma_area, (unsigned long)runtime->dma_area + runtime->dma_bytes);
 		// start the PCM engine
 		nds_fifo_send(FIFO_SOUND | FIFO_SOUND_TRIGGER | 1);
 
@@ -535,6 +538,12 @@ static irqreturn_t snd_nds_interrupt(int irq, void *dev_id,
 	snd_pcm_runtime_t *runtime = substream->runtime;
     	u8 period ;
 
+	/* The ARM9 data cache is write back: samples a program just wrote may still sit in it while the sound hardware (reading main
+	 * memory) is about to play them, and it plays the old contents of the buffer instead (an intermittent whine or buzz). Write the
+	 * buffer back every period; the program is always more than a period ahead of the hardware. */
+	if (runtime->dma_area && runtime->dma_bytes)
+		dmac_flush_range((unsigned long)runtime->dma_area, (unsigned long)runtime->dma_area + runtime->dma_bytes);
+
 	spin_lock(&chip->lock);
 
 	period = chip->period + 1;
