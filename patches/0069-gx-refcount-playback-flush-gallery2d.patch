From 6461b539a281c0879a7db52ea25feed947d3ae5f Mon Sep 17 00:00:00 2001
From: TeamHarrisCali <34009957+TeamHarrisCali@users.noreply.github.com>
Date: Wed, 11 Nov 2026 14:16:30 -0600
Subject: [PATCH] 3D engine reference counted (one program closing no longer
 switches it off under another: dsgx submit errno 22 when Photos and Camera
 were open together); Photos draws with plain Nano-X, not the 3D engine;
 playback buffer written back from the ARM9 write-back cache every period and
 at start (stale samples reached the sound hardware at random times:
 intermittent whine); mic counters show the raw FIFO words

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 .../arch/arm/mach-nds/arm7/microphone.c       |  12 +-
 linux-2.6.x/arch/arm/mach-nds/volume.c        |   4 +-
 linux-2.6.x/drivers/video/ndsfb.c             |  14 ++
 linux-2.6.x/sound/arm/nds-sound.c             |   9 +
 user/microwin/src/demos/nanox/dsgallery.c     | 194 ++++++++++--------
 5 files changed, 143 insertions(+), 90 deletions(-)

diff --git a/linux-2.6.x/arch/arm/mach-nds/arm7/microphone.c b/linux-2.6.x/arch/arm/mach-nds/arm7/microphone.c
index a211b1dbc..7815c869b 100644
--- a/linux-2.6.x/arch/arm/mach-nds/arm7/microphone.c
+++ b/linux-2.6.x/arch/arm/mach-nds/arm7/microphone.c
@@ -37,6 +37,7 @@ static s16 dsi_last;
 static s16 dbg_smin = 0x7fff, dbg_smax = -0x8000;
 static u32 dbg_restart_ovr, dbg_restart_stall;
 static int empty_run;
+static u32 dbg_raw, dbg_hi_other;
 static int mic_is_running;
 static u32 dbg_on, dbg_start, dbg_stop, dbg_irq, dbg_full, dbg_empty, dbg_have, dbg_wraps;
 
@@ -278,7 +279,12 @@ static void dsi_timer_tick(void)
 	empty_run = 0;
 	dbg_full++;
 	while (!(REG_MICCNT & MICCNT_EMPTY) && n--) {
-		dsi_last = (s16)(REG_MICDATA & 0xffff);
+		u32 raw = REG_MICDATA;
+
+		dbg_raw = raw;
+		if ((raw >> 16) != ((raw & 0x8000) ? 0xffff : 0))	/* more than a sign extension in the upper half? */
+			dbg_hi_other++;
+		dsi_last = (s16)(raw & 0xffff);
 		if (dsi_last < dbg_smin)
 			dbg_smin = dsi_last;
 		if (dsi_last > dbg_smax)
@@ -346,8 +352,8 @@ void mic_diag(u32 *touch, u32 *diag, u32 *info)
 	touch[4] = dbg_full;
 	touch[5] = dbg_empty;
 	touch[6] = dbg_have;
-	touch[7] = dbg_wraps;
-	diag[0] = (u32)(mic_buffer16 ? mic_buffer16 : (u16 *)mic_buffer8);
+	touch[7] = dbg_hi_other;		/* FIFO words whose upper half is not just the sign of the lower half */
+	diag[0] = dbg_raw;			/* the last raw FIFO word */
 	diag[1] = buffer_size;
 	diag[2] = period_size;
 	diag[3] = mic_rate;
