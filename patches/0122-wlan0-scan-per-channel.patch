From a592912c6058cfaf1576805d36154a20f4acfa74 Mon Sep 17 00:00:00 2001
From: TeamHarrisCali <34009957+TeamHarrisCali@users.noreply.github.com>
Date: Tue, 17 Nov 2026 00:42:13 -0600
Subject: [PATCH] wlan0: scan one channel at a time, channel from the beacon

Every scan so far showed only channel 1 although the firmware lists
channels 1-11. w98s's packet ring had the scan-complete event, but long
after the 6 s wait, behind a flood of channel-1 beacon reports that are
read byte by byte. Now, as dswifi: per channel from the firmware's list
(asked once), channel params (11g, that channel), scan params, all BSS
reports, start, wait at most 1.2 s for scan complete (pump_for: a time
limit, not "no packet for 1.2 s"), reports off before the next channel.
The log gets one line with the reports per channel ("*": no scan
complete). A network's channel now comes from its beacon (DS parameter
set). The Wi-Fi window waits up to 30 s for a rescan.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 linux-2.6.x/arch/arm/mach-nds/dsiwifi.c | 113 +++++++++++++++++++-----
 user/microwin/src/demos/nanox/dsnet.c   |   2 +-
 2 files changed, 91 insertions(+), 24 deletions(-)

diff --git a/linux-2.6.x/arch/arm/mach-nds/dsiwifi.c b/linux-2.6.x/arch/arm/mach-nds/dsiwifi.c
index 7c9d49b50..5412be927 100644
--- a/linux-2.6.x/arch/arm/mach-nds/dsiwifi.c
+++ b/linux-2.6.x/arch/arm/mach-nds/dsiwifi.c
@@ -215,6 +215,9 @@ static struct net2 {
 static int nnets;
 static unsigned char mac[6];
 static int wmi_ready, reg_domain, scan_done;
+static unsigned short chlist[16];	/* the firmware's channels (MHz), from its answer to WMI_GET_CHANNEL_LIST_CMD */
+static int nch, got_chlist;
+static unsigned int bss_reports;	/* BSS info events so far (the per-channel scan counts them) */
 
 static noinline void mbox_out_x(int endpoint, int ack, unsigned int word, unsigned int id, const void *data, unsigned int len, int *bad)
 {
@@ -273,6 +276,8 @@ static noinline void bss_info(const unsigned char *d, int len)
 			for (i = 0; i < l; i++)
 				n.ssid[i] = (e[2 + i] >= 32 && e[2 + i] < 127) ? e[2 + i] : '?';
 			n.ssid[l] = 0;
+		} else if (id == 3 && l >= 1 && e[2] >= 1 && e[2] <= 14) {
+			n.channel = e[2];		/* the beacon's own channel (DS parameter set), not where the report says it was heard */
 		} else if (id == 48) {			/* RSN: version, group cipher suite 00-0F-AC-x (4 CCMP, 2 TKIP), ... */
 			strcpy(n.sec, "wpa2");
 			n.group = (l >= 6 && e[7] == 2) ? 3 : 4;
@@ -559,6 +564,7 @@ static void handle_pkt(unsigned int hdr, int *ev_scan_done)
 		lg("  WMI regulatory domain %08x\n", w32(rx + 8), 0, 0);
 		break;
 	case WMI_BSS_INFO_EVENT:
+		bss_reports++;
 		bss_info(rx + 8, len - 2);
 		break;
 	case WMI_SCAN_COMPLETE_EVENT:
@@ -567,6 +573,9 @@ static void handle_pkt(unsigned int hdr, int *ev_scan_done)
 			*ev_scan_done = 1;
 		break;
 	case WMI_GET_CHANNEL_LIST_CMD:
+		for (nch = 0; nch < rx[9] && nch < 16; nch++)
+			chlist[nch] = rx[10 + 2 * nch] | (rx[11 + 2 * nch] << 8);
+		got_chlist = 1;
 		lg("  WMI channel list: %u channels, %u to %u MHz\n", rx[9], rx[10] | (rx[11] << 8),
 		   rx[9] ? rx[10 + 2 * (rx[9] - 1)] | (rx[11 + 2 * (rx[9] - 1)] << 8) : 0);
 		break;
@@ -619,6 +628,77 @@ static int pump(int ms, int *flag, int *bad)
 	return *flag;
 }
 
+/* as pump(), but for at most ms in all (a stream of beacon reports keeps pump() going) */
+static noinline int pump_for(int ms, int *flag, int *bad)
+{
+	unsigned long end = jiffies + ms * HZ / 1000 + 1;
+
+	while (!*flag && time_before(jiffies, end)) {
+		unsigned int out[19];
+		int r = dsisd_twlop_rx(12, 0, 50, 0, 0, out, rx);
+
+		if (r != 0) {
+			lg("  receive: request failed (%d)\n", r, 0, 0);
+			*bad = 1;
+			return 0;
+		}
+		if (out[1] != 5)
+			handle_pkt(out[0], flag);
+	}
+	return *flag;
+}
+
+/*
+ * One channel at a time, as dswifi: channel params (11g, that channel), scan params, all BSS reports, start, wait for "scan complete"
+ * (at most 1.2 s), reports off. w98m's single scan over all channels and w98l's 0.4 s per channel only ever showed channel 1: the
+ * scan-complete event came long after (w98s's packet ring), behind a flood of channel-1 beacon reports read byte by byte. Logs the
+ * reports per channel ("*": no scan complete).
+ */
+static noinline void scan_channels(int *bad)
+{
+	static unsigned char b[24];
+	static char line[200];
+	int c, i, k;
+
+	k = snprintf(line, sizeof(line), "  reports per channel:");
+	for (c = 0; c < nch && !*bad; c++) {
+		unsigned int before = bss_reports;
+
+		memset(b, 0, sizeof(b));
+		b[2] = 2;
+		b[3] = 1;
+		b[4] = chlist[c] & 0xff;
+		b[5] = chlist[c] >> 8;
+		mbox_out(1, 1, WMI_SET_CHANNEL_PARAMS_CMD, b, 6, bad);
+		memset(b, 0, sizeof(b));
+		for (i = 0; i < 6; i++)
+			b[i] = 0xFF;
+		b[6] = 20;
+		b[8] = 50;
+		b[10] = 3;
+		b[11] = 1;
+		mbox_out(1, 1, WMI_SET_SCAN_PARAMS_CMD, b, 20, bad);
+		memset(b, 0, sizeof(b));
+		b[0] = 1;					/* all BSSs */
+		mbox_out(1, 1, WMI_SET_BSS_FILTER_CMD, b, 8, bad);
+		memset(b, 0, sizeof(b));
+		b[8] = 20;					/* home dwell time */
+		mbox_out(1, 1, WMI_START_SCAN_CMD, b, 20, bad);
+		scan_done = 0;
+		pump_for(1200, &scan_done, bad);
+		memset(b, 0, sizeof(b));			/* reports off before the next channel: no backlog */
+		mbox_out(1, 1, WMI_SET_BSS_FILTER_CMD, b, 8, bad);
+		if (k < (int)sizeof(line) - 12)
+			k += snprintf(line + k, sizeof(line) - k, " %d:%u%s", wifi_mhz_to_channel(chlist[c]), bss_reports - before,
+				      scan_done ? "" : "*");
+	}
+	if (k < (int)sizeof(line) - 2) {
+		line[k++] = '\n';
+		line[k] = 0;
+	}
+	lgs(line);
+}
+
 static noinline void wmi_scan(int *bad)
 {
 	unsigned char b[40];
@@ -633,33 +713,20 @@ static noinline void wmi_scan(int *bad)
 	memset(b, 0, sizeof(b));
 	mbox_out(1, 1, WMI_SET_BSS_FILTER_CMD, b, 8, bad);		/* none while setting up */
 	mbox_out(1, 1, WMI_SET_PROBED_SSID_CMD, b, 35, bad);		/* entry 0, no SSID: any */
-	mbox_out(1, 1, WMI_GET_CHANNEL_LIST_CMD, b, 0, bad);		/* w98s: every network still on channel 1; what does it allow? */
-	/* one scan over every channel (w98l's channel-by-channel scan with phy mode 11ag, as dswifi, had its channel commands refused and
-	 * stayed on channel 1): channel params with phy mode 11g (2) and no channel list (= all), scan params, all BSSs, start */
-	memset(b, 0, sizeof(b));
-	b[2] = 2;
-	mbox_out(1, 1, WMI_SET_CHANNEL_PARAMS_CMD, b, 6, bad);
-	memset(b, 0, sizeof(b));
-	for (i = 0; i < 6; i++)
-		b[i] = 0xFF;
-	b[6] = 20;
-	b[8] = 50;
-	b[10] = 3;
-	b[11] = 1;
-	mbox_out(1, 1, WMI_SET_SCAN_PARAMS_CMD, b, 20, bad);
-	memset(b, 0, sizeof(b));
-	b[0] = 1;						/* all BSSs */
-	mbox_out(1, 1, WMI_SET_BSS_FILTER_CMD, b, 8, bad);
-	memset(b, 0, sizeof(b));
-	b[8] = 20;						/* home dwell time */
-	mbox_out(1, 1, WMI_START_SCAN_CMD, b, 20, bad);
-	scan_done = 0;
-	pump(6000, &scan_done, bad);
+	if (!got_chlist) {					/* the firmware's channels, once */
+		mbox_out(1, 1, WMI_GET_CHANNEL_LIST_CMD, b, 0, bad);
+		pump(800, &got_chlist, bad);
+	}
+	if (!nch) {						/* no answer: channels 1-11 (USA) */
+		for (nch = 0; nch < 11; nch++)
+			chlist[nch] = 2412 + 5 * nch;
+	}
+	scan_channels(bad);
 	/* the scan keeps reporting beacons (w98p: 227 BSS info events before the first connect retry, the connect delayed by the backlog
 	 * of byte-by-byte transfers): no more BSS reports from here on */
 	memset(b, 0, sizeof(b));
 	mbox_out(1, 1, WMI_SET_BSS_FILTER_CMD, b, 8, bad);
-	lg(scan_done ? "  scan complete: %u networks\n" : "  scan did not report completion: %u networks\n", nnets, 0, 0);
+	lg("  scan: %u networks\n", nnets, 0, 0);
 	for (i = 0; i < nnets && i < 16; i++) {
 		char line[96];
 
diff --git a/user/microwin/src/demos/nanox/dsnet.c b/user/microwin/src/demos/nanox/dsnet.c
index 2ed44cbb1..92dc3ee72 100644
--- a/user/microwin/src/demos/nanox/dsnet.c
+++ b/user/microwin/src/demos/nanox/dsnet.c
@@ -494,7 +494,7 @@ static void scan(void)
 
 		dsi_state(&st);
 		if (!fresh && !st.connected && dsi_cmd("scan\n") == 0)	/* connected: the list of the last scan */
-			for (s = 0; s < 15; s++) {
+			for (s = 0; s < 30; s++) {		/* channel by channel: up to about 15 s */
 				sleep(1);
 				dsi_state(&st);
 				if (!st.scanning)
