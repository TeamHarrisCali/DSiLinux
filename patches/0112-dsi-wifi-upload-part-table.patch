From 1d2155f162ac1f94468c0fc1b1fb77be3c5912f0 Mon Sep 17 00:00:00 2001
From: TeamHarrisCali <34009957+TeamHarrisCali@users.noreply.github.com>
Date: Fri, 13 Nov 2026 11:12:16 -0600
Subject: [PATCH] DSi Wi-Fi chip upload: read the part table correctly

w98j's writes were verified by read-back, but executing part 5 never got an
answer at either address: it is data. Each part entry is offset, size,
type, load address (the address came one field too early): part 4 starts
with the Xtensa "entry" instruction (code, 0x527000), part 5 is 56 bytes of
configuration (0x524C00), part 2 is a linked list whose pointers fit only
at 0x53F040 (the dataset). Both blobs agree. Upload now as dswifi: write
D (5) and C (4), execute C, LZ-stream A (1), write D again, write B (2) and
point hi_dset_list_head at it; no app start. Refuse a blob whose code part
does not begin with "entry".

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 linux-2.6.x/arch/arm/mach-nds/dsiwifi.c | 64 ++++++++++++-------------
 1 file changed, 31 insertions(+), 33 deletions(-)

diff --git a/linux-2.6.x/arch/arm/mach-nds/dsiwifi.c b/linux-2.6.x/arch/arm/mach-nds/dsiwifi.c
index cc4415479..494e68c8b 100644
--- a/linux-2.6.x/arch/arm/mach-nds/dsiwifi.c
+++ b/linux-2.6.x/arch/arm/mach-nds/dsiwifi.c
@@ -9,15 +9,18 @@
  * Both refuse while the DS Wi-Fi (nds) is up: the two chips share the antenna.
  *
  * The firmware file (dsibrew "WiFi Firmware"): 0x00 RSA signature, 0x80 SHA-1, then at 0xA0 an entry header (byte 0xA2 = number of
- * entries) and entries of 0x20 bytes from 0xA4: offset, length, ID, SHA-1. Each entry is a blob for some chips. A blob starts with:
- *   +0x00 flags, +0x04 offset of part 1 (in the blob), +0x08 its size, +0x0C its type (bit 31 = LZ compressed),
- *   +0x10, +0x20, +0x30 more parts: load address, offset, size, type;   +0x40 part 1's load address (the firmware's start),
- *   +0x44/+0x48 and +0x4C/+0x50: chip ID / boot ROM version it is for, +0x58 host interest address.
- * On this DSi XL: blob 2, AR6013 or AR6014 with boot ROM 0x23000024: type 1 LZ firmware for 0x524C00, type 2 for 0x524C00, type 4 (the
- * data patch) for 0x53F040, type 5 (a small patch that is executed) for 0x527000.
- * Upload order after dswifi's (disabled) code and the AR6000 host interest layout: write 2 and 5, execute 5 (at its address + 0x400000,
- * argument its address), LZ-stream 1 to its address, set the app start to it, write 4 and point hi_dset_list_head (+0x18) at it, then
- * start (hi_mbox_io_block_sz +0x6C = 0x80, hi_mbox_isr_yield_limit +0x74 = 0x63, BMI done) and wait for hi_board_data_initialized (+0x58).
+ * entries) and entries of 0x20 bytes from 0xA4: offset, length, ID, SHA-1. Each entry is a blob for some chips. A blob starts with a
+ * word of flags, then four parts of 16 bytes from +0x04: offset (in the blob), size, type (bit 31 = LZ compressed), load address;
+ * then from +0x44 pairs of chip ID / boot ROM version it is for, and the host interest address at +0x58.
+ * (w98i/w98j read the address one field too early and executed data: part 5 is 56 bytes of configuration words, part 4 begins with the
+ * Xtensa "entry" instruction, and part 2 is a linked list whose pointers only fit at 0x53F040.)
+ * On this DSi XL: blob 2, AR6013 or AR6014 with boot ROM 0x23000024:
+ *   type 1 LZ firmware ("A") for 0x524C00, type 2 dataset list ("B") for 0x53F040, type 4 code ("C") for 0x527000,
+ *   type 5 configuration ("D") for 0x524C00 (the start of the firmware image).
+ * Upload order as dswifi's (disabled) code: write D and C, execute C (at its address + 0x400000, the instruction view of RAM, argument
+ * its address), LZ-stream A to its address, write D again (over the firmware's first bytes), write B and point hi_dset_list_head (+0x18)
+ * at it, then start (hi_mbox_io_block_sz +0x6C = 0x80, hi_mbox_isr_yield_limit +0x74 = 0x63, BMI done) and wait for
+ * hi_board_data_initialized (+0x58). No app start is set (dswifi sets none; the firmware's start is not its first byte).
  */
 #include <linux/kernel.h>
 #include <linux/init.h>
@@ -182,36 +185,31 @@ static void upload(void)
 		part[k] = 0;
 		paddr[k] = psize[k] = 0;
 	}
-	/* part 1 (described in the header's first words), then three more */
-	k = w32(blob + 0x0C) & 0xff;
-	ptype1 = w32(blob + 0x0C);
-	if (k < 6) {
-		part[k] = blob + w32(blob + 0x04);
-		psize[k] = w32(blob + 0x08);
-		paddr[k] = w32(blob + 0x40);
-	}
-	for (i = 0; i < 3; i++) {
-		const unsigned char *e = blob + 0x10 + i * 0x10;
+	/* four parts from +0x04: offset, size, type, load address */
+	for (i = 0; i < 4; i++) {
+		const unsigned char *e = blob + 0x04 + i * 0x10;
 
-		k = w32(e + 12) & 0xff;
+		k = w32(e + 8) & 0xff;
+		if (k == 1)
+			ptype1 = w32(e + 8);
 		if (k < 6) {
-			part[k] = blob + w32(e + 4);
-			paddr[k] = w32(e);
-			psize[k] = w32(e + 8);
+			part[k] = blob + w32(e);
+			psize[k] = w32(e + 4);
+			paddr[k] = w32(e + 12);
 		}
 	}
 	for (k = 1; k < 6; k++)
 		if (part[k])
 			lg("  part type %u: %u bytes for %08x\n", k, psize[k], paddr[k]);
-	if (!part[1] || !part[2] || !part[4] || !part[5] || !(ptype1 & 0x80000000)) {
+	if (!part[1] || !part[2] || !part[4] || !part[5] || !(ptype1 & 0x80000000) || part[4][0] != 0x36) {
 		lg("unexpected blob layout (part 1 type %08x); nothing uploaded\n", ptype1, 0, 0);
 		goto release;
 	}
 
-	/* parts 2 and 5, then execute 5: first at its address + 0x400000 (dswifi), and if the boot ROM does not answer, after a fresh run
+	/* D (5) and C (4), then execute C: first at its address + 0x400000 (dswifi), and if the boot ROM does not answer, after a fresh run
 	 * (a reset into the boot ROM) at its plain address */
 	for (i = 0; i < 2; i++) {
-		unsigned int xa = i == 0 ? paddr[5] + 0x400000 : paddr[5], ans;
+		unsigned int xa = i == 0 ? paddr[4] + 0x400000 : paddr[4], ans;
 
 		if (i == 1) {
 			bad = 0;
@@ -223,12 +221,12 @@ static void upload(void)
 				return;
 			}
 		}
-		write_part("2", paddr[2], part[2], psize[2], &bad);
-		write_part("5", paddr[5], part[5], psize[5], &bad);
+		write_part("D", paddr[5], part[5], psize[5], &bad);
+		write_part("C", paddr[4], part[4], psize[4], &bad);
 		if (bad)
 			goto release;
-		ans = op(5, xa, paddr[5], 0, 0, &bad);
-		lg("execute %08x (argument %08x): answer %08x\n", xa, paddr[5], ans);
+		ans = op(5, xa, paddr[4], 0, 0, &bad);
+		lg("execute %08x (argument %08x): answer %08x\n", xa, paddr[4], ans);
 		if (!bad)
 			break;
 	}
@@ -239,9 +237,9 @@ static void upload(void)
 		op(4, 0, psize[1] - i > 2048 ? 2048 : psize[1] - i, part[1] + i, psize[1] - i > 2048 ? 2048 : psize[1] - i, &bad);
 	op(3, 0, 0, 0, 0, &bad);			/* close the stream (a new empty one flushes the target's caches) */
 	lg(bad ? "LZ-streamed %u bytes to %08x (FAILED)\n" : "LZ-streamed %u bytes to %08x\n", psize[1], paddr[1], 0);
-	op(6, paddr[1], 0, 0, 0, &bad);			/* app start */
-	write_part("4", paddr[4], part[4], psize[4], &bad);
-	op(7, hi + 0x18, paddr[4], 0, 0, &bad);		/* hi_dset_list_head = the data patch */
+	write_part("D", paddr[5], part[5], psize[5], &bad);	/* again, over the firmware's first bytes (as dswifi) */
+	write_part("B", paddr[2], part[2], psize[2], &bad);
+	op(7, hi + 0x18, paddr[2], 0, 0, &bad);		/* hi_dset_list_head = the dataset list */
 	if (bad)
 		goto release;
 
-- 
2.56.0

