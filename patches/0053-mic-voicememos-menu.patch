@@ -0,0 +1,687 @@
+/*
+ * dsmemo - voice memos for the DSLinuxDSi desktop: record from the microphone, play back, with a live waveform
+ * scope and a level meter for both. Memos are 16 bit mono WAV files in /home/memos (memo001.wav ...; Files shows
+ * them, dsplay can play them).
+ *
+ * Buttons: Rec, Stop, Play, < > (choose a memo), Del (press twice). Keys: r record, s stop, p or space play/stop,
+ * left/right or , . choose, d delete (twice), q or Esc quit.
+ * Sound goes through the OSS device /dev/dsp (the kernel's NDS ALSA driver); both directions are used in non
+ * blocking mode so the window keeps drawing. Drawing is incremental: the scope scrolls with one blit and only the
+ * new columns are drawn, since every request costs time on the DS.
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <fcntl.h>
+#include <errno.h>
+#include <dirent.h>
+#include <sys/stat.h>
+#include <sys/ioctl.h>
+#include <sys/time.h>
+#include "nano-X.h"
+#include "w95.h"
+
+#define MEMO_DIR	"/home/memos"
+#define RATE		16000
+#define MAXMEMOS	64
+#define MAXLOAD		(3 * 1024 * 1024)	/* longest memo that is loaded for playback */
+
+/* OSS ioctl numbers (linux/soundcard.h): the same on ARM */
+#define SNDCTL_DSP_SETFRAGMENT	0xC004500A
+#define SNDCTL_DSP_SPEED	0xC0045002
+#define SNDCTL_DSP_SETFMT	0xC0045005
+#define SNDCTL_DSP_CHANNELS	0xC0045006
+#define AFMT_S16_LE		0x10
+
+/* window layout (client coordinates) */
+#define WIN_W	208
+#define WIN_H	124
+#define SX	4		/* scope */
+#define SY	4
+#define SW	200
+#define SH	44
+#define LY	52		/* level meter */
+#define LH	7
+#define TY	63		/* status text */
+#define NY	75		/* memo name */
+#define BY	92		/* buttons */
+#define BH	18
+#define BW	31
+#define BGAP	2
+#define BX0	6
+#define NBTN	6
+#define FULL	12000		/* sample value that fills the scope and the meter */
+#define COLSAMP	(RATE / 25)	/* samples per scope column (25 columns a second) */
+
+enum { IDLE, REC, PLAY };
+static int state = IDLE;
+
+static GR_WINDOW_ID win;
+static GR_GC_ID gc;
+static int th;
+
+static char names[MAXMEMOS][24];
+static int nmemos, sel;
+static int del_armed;
+static char msg[40];
+
+/* scope history, so an exposure can redraw it */
+static short hist_min[SW], hist_max[SW];
+static int level_disp;			/* 0..100, with a slow fall */
+
+/* column builder */
+static int acc_n, acc_min, acc_max;
+static short pend_min[64], pend_max[64];
+static int npend;
+static int tick_peak;
+
+/* recording / playback state */
+static int dsp = -1, file = -1;
+static long rec_bytes;
+static unsigned char *pcm;		/* loaded memo */
+static long pcm_len, pcm_written, pcm_fed;
+static int pcm_rate, pcm_ch;
+static struct timeval t_start;
+static int last_secs = -1;
+
+static long elapsed_us(void)
+{
+	struct timeval now;
+
+	gettimeofday(&now, NULL);
+	return (now.tv_sec - t_start.tv_sec) * 1000000L + (now.tv_usec - t_start.tv_usec);
+}
+
+/* ------------------------------------------------------------------ files */
+
+static int cmpnames(const void *a, const void *b)
+{
+	return strcmp((const char *)a, (const char *)b);
+}
+
+static void scan_memos(void)
+{
+	DIR *d;
+	struct dirent *e;
+
+	nmemos = 0;
+	d = opendir(MEMO_DIR);
+	if (d) {
+		while ((e = readdir(d)) != NULL && nmemos < MAXMEMOS) {
+			int n = strlen(e->d_name);
+
+			if (n > 8 && n < 24 && !strncmp(e->d_name, "memo", 4) && !strcmp(e->d_name + n - 4, ".wav"))
+				strcpy(names[nmemos++], e->d_name);
+		}
+		closedir(d);
+	}
+	qsort(names, nmemos, sizeof(names[0]), cmpnames);
+	if (sel >= nmemos)
+		sel = nmemos - 1;
+	if (sel < 0)
+		sel = 0;
+}
+
+static void put32(unsigned char *p, unsigned long v)
+{
+	p[0] = v;
+	p[1] = v >> 8;
+	p[2] = v >> 16;
+	p[3] = v >> 24;
+}
+
+static void wav_header(unsigned char *h, long datalen)
+{
+	memcpy(h, "RIFF", 4);
+	put32(h + 4, 36 + datalen);
+	memcpy(h + 8, "WAVEfmt ", 8);
+	put32(h + 16, 16);
+	h[20] = 1; h[21] = 0;			/* PCM */
+	h[22] = 1; h[23] = 0;			/* mono */
+	put32(h + 24, RATE);
+	put32(h + 28, RATE * 2);
+	h[32] = 2; h[33] = 0;			/* block align */
+	h[34] = 16; h[35] = 0;			/* bits */
+	memcpy(h + 36, "data", 4);
+	put32(h + 40, datalen);
+}
+
+/* ------------------------------------------------------------------ drawing */
+
+#define C_BLACK		GR_RGB(0, 0, 0)
+#define C_GREEN		GR_RGB(0, 230, 0)
+#define C_DKGREEN	GR_RGB(0, 80, 0)
+#define C_RED		GR_RGB(230, 30, 30)
+
+static int ypos(int v)
+{
+	int h = SH / 2 - 1, y;
+
+	if (v > FULL)
+		v = FULL;
+	if (v < -FULL)
+		v = -FULL;
+	y = SY + SH / 2 - v * h / FULL;
+	return y;
+}
+
+static void draw_column(int x, int vmin, int vmax)
+{
+	w95_fill(win, gc, C_BLACK, x, SY, 1, SH);
+	w95_hline(win, gc, C_DKGREEN, x, x, SY + SH / 2);
+	w95_vline(win, gc, C_GREEN, x, ypos(vmax), ypos(vmin));
+}
+
+/* the scope is a window onto the last SW columns; new columns come in at the right edge */
+static void flush_columns(void)
+{
+	int n = npend, i;
+
+	if (!n)
+		return;
+	memmove(hist_min, hist_min + n, (SW - n) * sizeof(short));
+	memmove(hist_max, hist_max + n, (SW - n) * sizeof(short));
+	for (i = 0; i < n; i++) {
+		hist_min[SW - n + i] = pend_min[i];
+		hist_max[SW - n + i] = pend_max[i];
+	}
+	GrCopyArea(win, gc, SX, SY, SW - n, SH, win, SX + n, SY, MWROP_COPY);
+	for (i = 0; i < n; i++)
+		draw_column(SX + SW - n + i, pend_min[i], pend_max[i]);
+	npend = 0;
+}
+
+static void draw_scope_all(void)
+{
+	int x;
+
+	w95_box(win, gc, SX - 2, SY - 2, SW + 4, SH + 4, 1, W95_KEEP);
+	for (x = 0; x < SW; x++)
+		draw_column(SX + x, hist_min[x], hist_max[x]);
+}
+
+static void draw_level(void)
+{
+	int w = (SW - 4) * level_disp / 100;
+
+	w95_box(win, gc, SX - 2, LY - 2, SW + 4, LH + 4, 1, W95_KEEP);
+	w95_fill(win, gc, C_BLACK, SX, LY, SW, LH);
+	if (w > 0)
+		w95_fill(win, gc, level_disp > 85 ? C_RED : C_GREEN, SX, LY, w, LH);
+}
+
+static void draw_status(void)
+{
+	char t[48];
+	int secs;
+
+	w95_fill(win, gc, W95_FACE, 0, TY, WIN_W, th + 1);
+	if (msg[0]) {
+		strcpy(t, msg);
+	} else if (state == REC) {
+		secs = rec_bytes / (RATE * 2);
+		sprintf(t, "REC  %02d:%02d", secs / 60, secs % 60);
+	} else if (state == PLAY) {
+		long cur = pcm_ch ? elapsed_us() / 1000000L : 0;
+		long tot = pcm_len / (pcm_rate * 2L * pcm_ch);
+
+		if (cur > tot)
+			cur = tot;
+		sprintf(t, "PLAY %02ld:%02ld / %02ld:%02ld", cur / 60, cur % 60, tot / 60, tot % 60);
+	} else {
+		strcpy(t, "Ready");
+	}
+	w95_text(win, gc, state == REC ? C_RED : W95_DARK, 6, TY, t);
+
+	w95_fill(win, gc, W95_FACE, 0, NY, WIN_W, th + 1);
+	if (nmemos)
+		sprintf(t, "%s  (%d/%d)", names[sel], sel + 1, nmemos);
+	else
+		strcpy(t, "no memos yet");
+	w95_text(win, gc, W95_DARK, 6, NY, t);
+}
+
+static void draw_buttons(void)
+{
+	static const char *lab[NBTN] = { "Rec", "Stop", "Play", "<", ">", "Del" };
+	int i;
+
+	for (i = 0; i < NBTN; i++) {
+		int down = (i == 0 && state == REC) || (i == 2 && state == PLAY) || (i == 5 && del_armed);
+
+		w95_button(win, gc, BX0 + i * (BW + BGAP), BY, BW, BH, del_armed && i == 5 ? "Sure?" : lab[i], down);
+	}
+}
+
+static void redraw_all(void)
+{
+	w95_fill(win, gc, W95_FACE, 0, 0, WIN_W, WIN_H);
+	draw_scope_all();
+	draw_level();
+	draw_status();
+	draw_buttons();
+}
+
+/* ------------------------------------------------------------------ scope input */
+
+static void feed(const short *s, int step, int count)
+{
+	int i, v;
+
+	for (i = 0; i < count; i++) {
+		v = s[i * step];
+		if (!acc_n || v < acc_min)
+			acc_min = v;
+		if (!acc_n || v > acc_max)
+			acc_max = v;
+		acc_n++;
+		if ((v < 0 ? -v : v) > tick_peak)
+			tick_peak = v < 0 ? -v : v;
+		if (acc_n >= COLSAMP) {
+			if (npend < 64) {
+				pend_min[npend] = acc_min;
+				pend_max[npend] = acc_max;
+				npend++;
+			}
+			acc_n = 0;
+		}
+	}
+}
+
+static void level_update(void)
+{
+	int pct = tick_peak * 100 / FULL;
+
+	if (pct > 100)
+		pct = 100;
+	level_disp = pct > level_disp ? pct : level_disp * 3 / 4;
+	tick_peak = 0;
+	draw_level();
+}
+
+/* ------------------------------------------------------------------ sound device */
+
+static int dsp_open(int mode, int rate, int channels)
+{
+	int fd = open("/dev/dsp", mode | O_NONBLOCK), frag = (8 << 16) | 10, fmt = AFMT_S16_LE, r = rate, c = channels;
+
+	if (fd < 0)
+		return -1;
+	ioctl(fd, SNDCTL_DSP_SETFRAGMENT, &frag);	/* 1 KB pieces: lively scope */
+	ioctl(fd, SNDCTL_DSP_SETFMT, &fmt);
+	ioctl(fd, SNDCTL_DSP_CHANNELS, &c);
+	ioctl(fd, SNDCTL_DSP_SPEED, &r);
+	return fd;
+}
+
+static void stop_all(void)
+{
+	if (state == REC && file >= 0) {
+		unsigned char h[44];
+
+		wav_header(h, rec_bytes);
+		lseek(file, 0, SEEK_SET);
+		write(file, h, 44);
+		close(file);
+		file = -1;
+	}
+	if (dsp >= 0) {
+		close(dsp);
+		dsp = -1;
+	}
+	if (pcm) {
+		free(pcm);
+		pcm = NULL;
+	}
+	state = IDLE;
+	level_disp = 0;
+}
+
+static void start_record(void)
+{
+	char path[64];
+	unsigned char h[44];
+	int n, i;
+
+	stop_all();
+	mkdir(MEMO_DIR, 0755);
+	for (n = 1; n < 1000; n++) {
+		sprintf(path, MEMO_DIR "/memo%03d.wav", n);
+		if (access(path, F_OK) != 0)
+			break;
+	}
+	file = open(path, O_WRONLY | O_CREAT | O_TRUNC, 0644);
+	if (file < 0) {
+		sprintf(msg, "cannot write %s", MEMO_DIR);
+		return;
+	}
+	dsp = dsp_open(O_RDONLY, RATE, 1);
+	if (dsp < 0) {
+		close(file);
+		file = -1;
+		unlink(path);
+		strcpy(msg, "cannot open /dev/dsp");
+		return;
+	}
+	wav_header(h, 0);
+	write(file, h, 44);
+	rec_bytes = 0;
+	msg[0] = 0;
+	memset(hist_min, 0, sizeof(hist_min));
+	memset(hist_max, 0, sizeof(hist_max));
+	acc_n = 0;
+	npend = 0;
+	state = REC;
+	gettimeofday(&t_start, NULL);
+	last_secs = -1;
+	scan_memos();
+	for (i = 0; i < nmemos; i++)
+		if (!strcmp(names[i], strrchr(path, '/') + 1))
+			sel = i;
+	draw_scope_all();
+}
+
+static int load_memo(const char *name)
+{
+	char path[64];
+	unsigned char h[44];
+	int f;
+	long total;
+
+	sprintf(path, MEMO_DIR "/%s", name);
+	f = open(path, O_RDONLY);
+	if (f < 0)
+		return -1;
+	if (read(f, h, 44) != 44 || memcmp(h, "RIFF", 4) || memcmp(h + 8, "WAVE", 4) || memcmp(h + 36, "data", 4) ||
+	    h[20] != 1 || h[34] != 16 || h[22] < 1 || h[22] > 2) {
+		close(f);
+		return -2;
+	}
+	pcm_ch = h[22];
+	pcm_rate = h[24] | (h[25] << 8) | (h[26] << 16);
+	total = h[40] | (h[41] << 8) | (h[42] << 16) | ((long)h[43] << 24);
+	if (total > MAXLOAD)
+		total = MAXLOAD;
+	if (total < 2) {
+		close(f);
+		return -3;
+	}
+	pcm = malloc(total);
+	if (!pcm) {
+		close(f);
+		return -4;
+	}
+	pcm_len = 0;
+	while (pcm_len < total) {
+		int n = read(f, pcm + pcm_len, total - pcm_len > 8192 ? 8192 : total - pcm_len);
+
+		if (n <= 0)
+			break;
+		pcm_len += n;
+	}
+	close(f);
+	pcm_len &= ~3L;
+	return pcm_len > 0 ? 0 : -3;
+}
+
+static void start_play(void)
+{
+	int r;
+
+	stop_all();
+	if (!nmemos) {
+		strcpy(msg, "nothing to play");
+		return;
+	}
+	r = load_memo(names[sel]);
+	if (r) {
+		sprintf(msg, "cannot load memo (%d)", r);
+		return;
+	}
+	dsp = dsp_open(O_WRONLY, pcm_rate, pcm_ch);
+	if (dsp < 0) {
+		free(pcm);
+		pcm = NULL;
+		strcpy(msg, "cannot open /dev/dsp");
+		return;
+	}
+	msg[0] = 0;
+	memset(hist_min, 0, sizeof(hist_min));
+	memset(hist_max, 0, sizeof(hist_max));
+	acc_n = 0;
+	npend = 0;
+	pcm_written = 0;
+	pcm_fed = 0;
+	state = PLAY;
+	gettimeofday(&t_start, NULL);
+	last_secs = -1;
+	draw_scope_all();
+}
+
+/* called every 40 ms while recording or playing */
+static void tick(void)
+{
+	if (state == REC) {
+		short buf[512];
+		int n, loops = 0;
+
+		while (loops++ < 8 && (n = read(dsp, buf, sizeof(buf))) > 0) {
+			write(file, buf, n);
+			rec_bytes += n;
+			feed(buf, 1, n / 2);
+		}
+		if (rec_bytes == 0 && elapsed_us() > 2000000L && !msg[0]) {
+			strcpy(msg, "REC  (no microphone data yet)");
+			last_secs = -1;
+		} else if (rec_bytes > 0 && msg[0]) {
+			msg[0] = 0;
+			last_secs = -1;
+		}
+		if (rec_bytes > 20L * 1024 * 1024) {	/* 10 minutes: enough */
+			int i;
+
+			stop_all();
+			scan_memos();
+			for (i = 0; i < nmemos; i++)
+				sel = i;
+			strcpy(msg, "stopped: size limit");
+			draw_buttons();
+			draw_status();
+			return;
+		}
+	} else if (state == PLAY) {
+		long pos, bps = pcm_rate * 2L * pcm_ch;
+		int n;
+
+		while (pcm_written < pcm_len) {
+			n = write(dsp, pcm + pcm_written, pcm_len - pcm_written > 4096 ? 4096 : pcm_len - pcm_written);
+			if (n <= 0)
+				break;
+			pcm_written += n;
+		}
+		pos = (long)((elapsed_us() / 1000L) * bps / 1000L);	/* what has been heard so far, estimated */
+		if (pos > pcm_written)
+			pos = pcm_written;
+		pos &= ~3L;
+		if (pos > pcm_fed) {
+			feed((const short *)(pcm + pcm_fed), pcm_ch, (pos - pcm_fed) / (2 * pcm_ch));
+			pcm_fed = pos;
+		}
+		if (pos >= pcm_len) {
+			stop_all();
+			draw_buttons();
+			last_secs = -1;
+		}
+	}
+	flush_columns();
+	level_update();
+	if (state != IDLE) {
+		int secs = (int)(elapsed_us() / 1000000L);
+
+		if (secs != last_secs) {
+			last_secs = secs;
+			draw_status();
+		}
+	} else {
+		draw_status();
+	}
+}
+
+/* ------------------------------------------------------------------ commands */
+
+static void do_stop(void)
+{
+	int was = state, i;
+
+	stop_all();
+	if (was == REC) {
+		scan_memos();
+		for (i = 0; i < nmemos; i++)
+			sel = i;		/* names sort by number: the last one is the new memo */
+	}
+	msg[0] = 0;
+	draw_buttons();
+	draw_status();
+}
+
+static void do_delete(void)
+{
+	char path[64];
+
+	if (state != IDLE || !nmemos)
+		return;
+	if (!del_armed) {
+		del_armed = 1;
+		draw_buttons();
+		return;
+	}
+	del_armed = 0;
+	sprintf(path, MEMO_DIR "/%s", names[sel]);
+	unlink(path);
+	scan_memos();
+	strcpy(msg, "deleted");
+	draw_buttons();
+	draw_status();
+}
+
+static void command(int b)
+{
+	if (b != 5 && del_armed) {
+		del_armed = 0;
+		draw_buttons();
+	}
+	msg[0] = 0;
+	switch (b) {
+	case 0:
+		if (state != REC)
+			start_record();
+		break;
+	case 1:
+		do_stop();
+		return;
+	case 2:
+		if (state == PLAY)
+			do_stop();
+		else if (state == IDLE)
+			start_play();
+		break;
+	case 3:
+		if (state == IDLE && sel > 0)
+			sel--;
+		break;
+	case 4:
+		if (state == IDLE && sel + 1 < nmemos)
+			sel++;
+		break;
+	case 5:
+		do_delete();
+		return;
+	}
+	draw_buttons();
+	draw_status();
+}
+
+int main(int argc, char **argv)
+{
+	GR_EVENT ev;
+	GR_FONT_ID font;
+
+	if (GrOpen() < 0) {
+		fprintf(stderr, "dsmemo: cannot connect to Nano-X\n");
+		return 1;
+	}
+	gc = GrNewGC();
+	font = GrCreateFont("Tiny", 0, NULL);
+	GrSetGCFont(gc, font);
+	w95_init(font);
+	th = w95_texth(gc);
+	w95_gc(C_BLACK);
+	w95_gc(C_GREEN);
+	w95_gc(C_DKGREEN);
+	w95_gc(C_RED);
+	scan_memos();
+	if (nmemos)
+		sel = nmemos - 1;
+
+	win = GrNewWindowEx(GR_WM_PROPS_APPFRAME | GR_WM_PROPS_CAPTION | GR_WM_PROPS_CLOSEBOX, "Voice memos",
+			    GR_ROOT_WINDOW_ID, 24, 8, WIN_W, WIN_H, W95_FACE);
+	GrSelectEvents(win, GR_EVENT_MASK_EXPOSURE | GR_EVENT_MASK_BUTTON_DOWN | GR_EVENT_MASK_KEY_DOWN |
+		       GR_EVENT_MASK_CLOSE_REQ);
+	GrMapWindow(win);
+	GrSetFocus(win);
+
+	for (;;) {
+		GrGetNextEventTimeout(&ev, state != IDLE ? 40 : 1000);
+		switch (ev.type) {
+		case GR_EVENT_TYPE_EXPOSURE:
+			redraw_all();
+			break;
+		case GR_EVENT_TYPE_CLOSE_REQ:
+			stop_all();
+			GrClose();
+			return 0;
+		case GR_EVENT_TYPE_BUTTON_DOWN:
+			if (ev.button.y >= BY && ev.button.y < BY + BH && ev.button.x >= BX0) {
+				int b = (ev.button.x - BX0) / (BW + BGAP);
+
+				if (b >= 0 && b < NBTN && (ev.button.x - BX0) % (BW + BGAP) < BW)
+					command(b);
+			}
+			break;
+		case GR_EVENT_TYPE_KEY_DOWN:
+			switch (ev.keystroke.ch) {
+			case 'r':
+				command(0);
+				break;
+			case 's':
+				command(1);
+				break;
+			case 'p':
+			case ' ':
+				command(state == IDLE ? 2 : 1);
+				break;
+			case MWKEY_LEFT:
+			case ',':
+				command(3);
+				break;
+			case MWKEY_RIGHT:
+			case '.':
+				command(4);
+				break;
+			case 'd':
+				command(5);
+				break;
+			case 'q':
+			case MWKEY_ESCAPE:
+				stop_all();
+				GrClose();
+				return 0;
+			}
+			break;
+		}
+		if (state != IDLE)
+			tick();
+	}
+	return 0;
+}
