diff --git a/linux-2.6.x/arch/arm/mach-nds/arm7/microphone.c b/linux-2.6.x/arch/arm/mach-nds/arm7/microphone.c
index efda625ed..6e09b11db 100644
--- a/linux-2.6.x/arch/arm/mach-nds/arm7/microphone.c
+++ b/linux-2.6.x/arch/arm/mach-nds/arm7/microphone.c
@@ -4,6 +4,72 @@
 #include "microphone.h"
 #include "arm7.h"
 #include "asm/arch/fifo.h"
+#include "dsitouch.h"
+
+/*
+ * DSi mode: the microphone is not on the DS touch chip's AUX input any more. It is the TSC2117 codec's ADC (switched on
+ * through codec registers) and the samples come out of a small FIFO (MICCNT/MICDATA at 0x04004600/04), as in BlocksDS
+ * libnds (source/arm7/microphone.twl.c, Copyright (C) 2017 fincs, zlib licence; this version is altered: no BIOS
+ * delay calls, FIFO drained by the timer interrupt instead of a one-sample-at-a-time restart). The timer interrupt
+ * stays the pace of the recording: each tick takes the newest sample the FIFO has (the FIFO runs at 32.7 kHz, more
+ * than any rate asked for).
+ */
+#define REG_MICCNT		(*(volatile u16 *)0x04004600)
+#define REG_MICDATA		(*(volatile u32 *)0x04004604)
+#define MICCNT_FORMAT_NORMAL	2
+#define MICCNT_EMPTY		(1 << 8)
+#define MICCNT_CLEAR_FIFO	(1 << 12)
+#define MICCNT_ENABLE		(1 << 15)
+
+#define CDC_CONTROL		0x00
+#define CDC_SOUND		0x01
+#define CDC_DAC_CTRL		0x3F
+#define CDC_ADC_MIC		0x51
+#define CDC_ADC_VOL_FINE	0x52
+#define CDC_MIC_BIAS		0x2E
+#define CDC_MIC_GAIN		0x2F
+#define DSI_MIC_GAIN		3	/* 0..3 = 15.5, 21.5, 27.5, 33.5 dB (libnds uses the highest) */
+
+static s16 dsi_last;
+
+static void dsi_spin(int n)
+{
+	while (n-- > 0)
+		asm volatile("" ::: "memory");
+}
+
+static void dsi_mic_amp(int on)
+{
+	static const u8 gaintbl[] = { 31, 43, 55, 67 };
+
+	if (on) {
+		int adc_on, dac_on;
+
+		dsitouch_cdc_write(CDC_SOUND, CDC_MIC_BIAS, 0x03);		/* ADC bias */
+		adc_on = dsitouch_cdc_read(CDC_CONTROL, CDC_ADC_MIC) & 0x80;
+		dac_on = dsitouch_cdc_read(CDC_CONTROL, CDC_DAC_CTRL) & 0xC0;
+		dsitouch_cdc_write(CDC_CONTROL, CDC_ADC_MIC, 0x80);		/* ADC on */
+		if (!adc_on || !dac_on)
+			dsi_spin(600000);					/* about 20 ms to settle */
+		dsitouch_cdc_write(CDC_CONTROL, CDC_ADC_VOL_FINE, 0x00);	/* unmute */
+		dsitouch_cdc_write(CDC_SOUND, CDC_MIC_GAIN, gaintbl[DSI_MIC_GAIN]);
+	} else {
+		dsitouch_cdc_write(CDC_CONTROL, CDC_ADC_VOL_FINE, 0x80);	/* mute */
+		dsitouch_cdc_write(CDC_CONTROL, CDC_ADC_MIC, 0x00);		/* ADC off */
+		dsitouch_cdc_write(CDC_SOUND, CDC_MIC_BIAS, 0x00);
+		REG_MICCNT &= ~MICCNT_ENABLE;
+	}
+}
+
+/* the newest sample in the FIFO (signed 16 bit), else the previous one */
+static s16 dsi_sample(void)
+{
+	int n = 64;
+
+	while (!(REG_MICCNT & MICCNT_EMPTY) && n--)
+		dsi_last = (s16)(REG_MICDATA & 0xffff);
+	return dsi_last;
+}
 
 //same as SOUND_FREQ(n)
 #define MIC_FREQ(n)		(0 - (0x1000000 / (n)))
@@ -21,7 +87,10 @@ static u32 period_size = 0; //number of bytes to read before signaling arm9
  ********************/
 void mic_on()
 {
-	mic_on_off(1); // or power_write(POWER_MIC_CONTROL, 1);
+	if (dsitouch_active())
+		dsi_mic_amp(1);
+	else
+		mic_on_off(1); // or power_write(POWER_MIC_CONTROL, 1);
 }
 
 /********************
@@ -29,7 +98,10 @@ void mic_on()
  ********************/
 void mic_off()
 {
-	mic_on_off(0); // or power_write(POWER_MIC_CONTROL, 0);
+	if (dsitouch_active())
+		dsi_mic_amp(0);
+	else
+		mic_on_off(0); // or power_write(POWER_MIC_CONTROL, 0);
 }
 
 /********************
@@ -39,12 +111,14 @@ void mic_set_power(u8 power) {
 	if (power == 0) 
 	{
 		mic_off();
-		power_write(POWER_MIC_GAIN, 0);
+		if (!dsitouch_active())
+			power_write(POWER_MIC_GAIN, 0);
 	}
 	else 
 	{
 		mic_on();
-		power_write(POWER_MIC_GAIN, power - 1);
+		if (!dsitouch_active())
+			power_write(POWER_MIC_GAIN, power - 1);
 	}
 }
 
@@ -96,6 +170,12 @@ void mic_start()
 {
 	// Setup timer3, since timer0 is used for wifi, 
 	// and timers 1 and 2 are for sound.
+	if (dsitouch_active()) {		/* DSi: FIFO on, 32.7 kHz, normal format, emptied */
+		REG_MICCNT &= ~MICCNT_ENABLE;
+		REG_MICCNT = MICCNT_CLEAR_FIFO | MICCNT_FORMAT_NORMAL;
+		REG_MICCNT |= MICCNT_ENABLE;
+		dsi_last = 0;
+	}
 	REG_TM3CNT_L = MIC_FREQ(mic_rate);
 	REG_TM3CNT_H = NDS_TCR_ENB | NDS_TCR_CLK | NDS_TCR_IRQ;
 	NDS_IE |= IRQ_TIMER3;
@@ -108,6 +188,8 @@ int mic_stop(void)
 {
 	//turn off the timer.
 	REG_TM3CNT_H &= ~NDS_TCR_ENB;
+	if (dsitouch_active())
+		REG_MICCNT &= ~MICCNT_ENABLE;
 	//disable the timer irq.
 	NDS_IE &= ~IRQ_TIMER3;
 	mic_buffer8 = 0;
@@ -124,7 +206,7 @@ void mic_timer_handler(void)
 	{
 		if (mic_buffer8) 
 		{
-			mic_buffer8[current_ptr] = mic_read8();
+			mic_buffer8[current_ptr] = dsitouch_active() ? (u8)((dsi_sample() >> 8) ^ 0x80) : mic_read8();
 			if (mic_format & MIC_FORMAT_SIGNED)
 				mic_buffer8[current_ptr] = mic_buffer8[current_ptr] ^ 0x80;
 			current_ptr++;
@@ -134,7 +216,7 @@ void mic_timer_handler(void)
 	{
 		if (mic_buffer16)
 		{
-			mic_buffer16[current_ptr/2] = mic_read12();
+			mic_buffer16[current_ptr/2] = dsitouch_active() ? (u16)(((u16)dsi_sample() ^ 0x8000) >> 4) : mic_read12();
 			if (mic_format & MIC_FORMAT_SIGNED)
 				mic_buffer16[current_ptr/2] = (mic_buffer16[current_ptr/2] - 2048) << 4;
 			current_ptr+=2;
