index 4fc6259e2..9a7213adf 100644
--- a/linux-2.6.x/sound/arm/nds-sound.c
+++ b/linux-2.6.x/sound/arm/nds-sound.c
@@ -14,6 +14,7 @@
 #include <sound/initval.h>
 #include <sound/pcm.h>
 #include <asm/mach-types.h>
+#include <asm/cacheflush.h>
 
 #include <asm/arch/fifo.h>
 
@@ -87,7 +88,7 @@ static snd_pcm_hardware_t snd_nds_capture_hw = {
 	.channels_min = 1,
 	.channels_max = 1,
 	.buffer_bytes_max = DMA_BUFFERSIZE_CAPTURE,
-	.period_bytes_min = DMA_BUFFERSIZE_CAPTURE/16,
+	.period_bytes_min = DMA_BUFFERSIZE_CAPTURE/64,		/* 1 KB: a recording program sees new data about every 60 ms */
 	.period_bytes_max = DMA_BUFFERSIZE_CAPTURE/8,
 	.periods_min = 1,
 	.periods_max = 1024,
@@ -407,6 +408,8 @@ static int snd_nds_capture_copy(snd_pcm_substream_t *substream, int channel,
 		ccount = count * 2;
 		break;
 	}
+	/* the ARM7 wrote these bytes behind the ARM9 data cache */
+	dmac_flush_range((unsigned long)&capturebuf[cpos], (unsigned long)&capturebuf[cpos] + ccount);
 	memcpy(dst, &capturebuf[cpos], ccount);
 
 	return 0;
