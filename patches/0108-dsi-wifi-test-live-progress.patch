From 0fa65b3299ad8abf42a967b18882aa58e95ef577 Mon Sep 17 00:00:00 2001
From: TeamHarrisCali <34009957+TeamHarrisCali@users.noreply.github.com>
Date: Fri, 13 Nov 2026 10:45:11 -0600
Subject: [PATCH] DSi Wi-Fi test: live progress and a per-second step timeline

w98f showed "step 0" twice after 30 s: the ARM7 copied its results into the
request block only at the end, so a run that hangs showed nothing. Now the
run writes into the block as it goes (and keeps a copy for later reports),
and the ARM9 looks every second while waiting, logging "dsiwifi2: ARM7 at
step N after M s" for each new step.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 linux-2.6.x/arch/arm/mach-nds/arm7/twlwifi.c | 12 +++++-
 linux-2.6.x/drivers/block/dldi_c.c           | 41 ++++++++++++++++++--
 2 files changed, 47 insertions(+), 6 deletions(-)

diff --git a/linux-2.6.x/arch/arm/mach-nds/arm7/twlwifi.c b/linux-2.6.x/arch/arm/mach-nds/arm7/twlwifi.c
index b3dcf7088..ee2f95f24 100644
--- a/linux-2.6.x/arch/arm/mach-nds/arm7/twlwifi.c
+++ b/linux-2.6.x/arch/arm/mach-nds/arm7/twlwifi.c
@@ -292,10 +292,18 @@ void twl_wifi_report(u32 *touch, u32 *diag, u32 *info)
 
 static void twl_run(u32 *touch, u32 *diag, u32 *info);
 
+/* the run writes straight into the request block, so the ARM9 sees each step as it happens (and where a run hangs); then it is kept */
 void twl_wifi_probe(u32 *touch, u32 *diag, u32 *info)
 {
-	twl_run(r_touch, r_diag, r_info);
-	twl_wifi_report(touch, diag, info);
+	int i;
+
+	twl_run(touch, diag, info);
+	for (i = 0; i < 8; i++) {
+		r_touch[i] = touch[i];
+		r_diag[i] = diag[i];
+	}
+	for (i = 0; i < 3; i++)
+		r_info[i] = info[i];
 }
 
 static void twl_run(u32 *touch, u32 *diag, u32 *info)
diff --git a/linux-2.6.x/drivers/block/dldi_c.c b/linux-2.6.x/drivers/block/dldi_c.c
index a3f572ffc..a37e35655 100644
--- a/linux-2.6.x/drivers/block/dldi_c.c
+++ b/linux-2.6.x/drivers/block/dldi_c.c
@@ -240,10 +240,43 @@ int dsisd_twlwifi(unsigned int *out, int report)
 		sd_block.touch[i] = sd_block.diag[i] = 0;
 	for (i = 0; i < 3; i++)
 		sd_block.info[i] = 0;
-	save = sd_timeout;
-	sd_timeout = report ? 3 * HZ : 30 * HZ;
-	ret = sd_request_locked(NDS_SD_CMD_TWLWIFI, 0, report ? 1 : 0);
-	sd_timeout = save;
+	if (report) {
+		save = sd_timeout;
+		sd_timeout = 3 * HZ;
+		ret = sd_request_locked(NDS_SD_CMD_TWLWIFI, 0, 1);
+		sd_timeout = save;
+	} else {
+		/* a run: wait up to 30 s, looking at the block every second and logging each new step with its time, so the kernel log shows
+		 * where the ARM7 spends its time (or hangs) */
+		unsigned int last = 0xffffffff, sec;
+
+		sd_block.cmd = NDS_SD_CMD_TWLWIFI;
+		sd_block.sector = 0;
+		sd_block.count = 0;
+		sd_block.result = 0xffffffff;
+		sd_seq++;
+		sd_block.seq = sd_seq;
+		sd_block.done_seq = 0;
+		sd_done = 0;
+		dmac_flush_range((unsigned long)&sd_block, (unsigned long)&sd_block + sizeof(sd_block));
+		nds_fifo_send(FIFO_FIRMWARE_CMD(FIFO_FIRMWARE_CMD_SD_REQUEST, 0));
+		ret = -1;
+		for (sec = 0; sec < 30; sec++) {
+			int done = wait_event_timeout(sd_wait, sd_done, HZ);
+
+			dmac_flush_range((unsigned long)&sd_block, (unsigned long)&sd_block + sizeof(sd_block));	/* clean lines: just refetched */
+			if (sd_block.info[0] != last) {
+				last = sd_block.info[0];
+				printk(KERN_INFO "dsiwifi2: ARM7 at step %u after %u s\n", last & 0xff, sec);
+			}
+			if (done) {
+				ret = (int)sd_block.result;
+				break;
+			}
+		}
+		if (ret == -1)
+			printk(KERN_ERR "dsisd: ARM7 did not finish the Wi-Fi run in 30 s (step %u)\n", last & 0xff);
+	}
 	dmac_flush_range((unsigned long)&sd_block, (unsigned long)&sd_block + sizeof(sd_block));	/* also after a timeout */
 	for (i = 0; i < 8; i++) {
 		out[i] = sd_block.touch[i];
-- 
2.56.0

