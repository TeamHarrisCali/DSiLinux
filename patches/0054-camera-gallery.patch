diff --git a/user/microwin/src/demos/nanox/dsbmp.h b/user/microwin/src/demos/nanox/dsbmp.h
new file mode 100644
index 000000000..11eab360e
--- /dev/null
+++ b/user/microwin/src/demos/nanox/dsbmp.h
@@ -0,0 +1,106 @@
+/*
+ * dsbmp.h - the photo files of dscam and dsgallery: 24 bit uncompressed BMP, 256x192, bottom-up rows (opens on a PC).
+ * The frames in memory are 256x192 DS pixels (RGB555, red in the low bits, bit 15 set).
+ */
+#ifndef DSBMP_H
+#define DSBMP_H
+
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+#include <fcntl.h>
+
+#define PHOTO_DIR	"/home/photos"
+#define PW		256
+#define PH		192
+
+static void bmp_put32(unsigned char *p, unsigned long v)
+{
+	p[0] = v;
+	p[1] = v >> 8;
+	p[2] = v >> 16;
+	p[3] = v >> 24;
+}
+
+static unsigned char c5to8(int v)
+{
+	return (unsigned char)((v << 3) | (v >> 2));
+}
+
+/* write the frame; flipx/flipy mirror it, swap exchanges red and blue (for a sensor whose colour order is the other way) */
+static int bmp_write(const char *path, const unsigned short *frame, int flipx, int flipy, int swap)
+{
+	unsigned char h[54], row[PW * 3];
+	int f = open(path, O_WRONLY | O_CREAT | O_TRUNC, 0644), y, x;
+
+	if (f < 0)
+		return -1;
+	memset(h, 0, sizeof(h));
+	h[0] = 'B';
+	h[1] = 'M';
+	bmp_put32(h + 2, 54 + PW * PH * 3);
+	bmp_put32(h + 10, 54);
+	bmp_put32(h + 14, 40);
+	bmp_put32(h + 18, PW);
+	bmp_put32(h + 22, PH);
+	h[26] = 1;
+	h[28] = 24;
+	bmp_put32(h + 34, PW * PH * 3);
+	if (write(f, h, 54) != 54) {
+		close(f);
+		return -1;
+	}
+	for (y = PH - 1; y >= 0; y--) {		/* bottom-up */
+		int sy = flipy ? PH - 1 - y : y;
+
+		for (x = 0; x < PW; x++) {
+			unsigned short p = frame[sy * PW + (flipx ? PW - 1 - x : x)];
+			int r = p & 31, g = (p >> 5) & 31, b = (p >> 10) & 31;
+
+			if (swap) {
+				int t = r;
+
+				r = b;
+				b = t;
+			}
+			row[x * 3 + 0] = c5to8(b);
+			row[x * 3 + 1] = c5to8(g);
+			row[x * 3 + 2] = c5to8(r);
+		}
+		if (write(f, row, sizeof(row)) != (int)sizeof(row)) {
+			close(f);
+			return -1;
+		}
+	}
+	close(f);
+	return 0;
+}
+
+/* read a photo written by bmp_write into frame (DS pixels, bit 15 set); 0 = ok */
+static int bmp_read(const char *path, unsigned short *frame)
+{
+	unsigned char h[54], row[PW * 3];
+	int f = open(path, O_RDONLY), y, x;
+
+	if (f < 0)
+		return -1;
+	if (read(f, h, 54) != 54 || h[0] != 'B' || h[1] != 'M' || h[18] != (PW & 255) || h[19] != (PW >> 8) ||
+	    h[22] != PH || h[23] != 0 || h[28] != 24 || h[30] != 0) {
+		close(f);
+		return -2;
+	}
+	lseek(f, h[10] | (h[11] << 8), SEEK_SET);
+	for (y = PH - 1; y >= 0; y--) {
+		if (read(f, row, sizeof(row)) != (int)sizeof(row)) {
+			close(f);
+			return -3;
+		}
+		for (x = 0; x < PW; x++)
+			frame[y * PW + x] = 0x8000 | (row[x * 3 + 2] >> 3) | ((row[x * 3 + 1] >> 3) << 5) |
+					    ((row[x * 3 + 0] >> 3) << 10);
+	}
+	close(f);
+	return 0;
+}
+
+#endif
diff --git a/user/microwin/src/demos/nanox/dscam.c b/user/microwin/src/demos/nanox/dscam.c
new file mode 100644
index 000000000..94d145608
--- /dev/null
+++ b/user/microwin/src/demos/nanox/dscam.c
@@ -0,0 +1,207 @@
+/*
+ * dscam - camera test for the DSLinuxDSi desktop: a live preview of the DSi camera in a window, and photos.
+ * The kernel (NDSFB_CAM_CMD / NDSFB_CAM_FRAME, see drivers/video/ndsfb.c) switches the camera on and delivers 256x192 RGB555 frames;
+ * each frame is loaded as a texture and drawn on the 3D layer (dsgx.h), which is far faster than pushing pixels through Nano-X.
+ * Keys: space, Enter or a tap in the window = photo (saved as /home/photos/photoNNN.bmp), c = the other camera, f = flip the
+ * picture upside down, m = mirror it, b = swap red and blue (if the colours look wrong), q or Esc = quit.
+ * The overlay text says what is going on, including the numbers from the set-up if it fails.
+ */
+#include <errno.h>
+#include <sys/stat.h>
+#include <sys/time.h>
+#include "dsgx_win.h"
+#include "dsbmp.h"
+
+#define NDSFB_CAM_CMD	0x4e09
+#define NDSFB_CAM_FRAME	0x4e0a
+
+struct ndsfb_cam {
+	unsigned int cmd, arg;
+	unsigned int value, err;
+};
+
+static unsigned short frame[PW * PH] __attribute__((aligned(32)));
+
+static long usec(void)
+{
+	struct timeval tv;
+
+	gettimeofday(&tv, NULL);
+	return tv.tv_sec * 1000000L + tv.tv_usec;
+}
+
+static int cam_cmd(unsigned int cmd, unsigned int arg, struct ndsfb_cam *out)
+{
+	struct ndsfb_cam c;
+	int r;
+
+	c.cmd = cmd;
+	c.arg = arg;
+	c.value = c.err = 0;
+	r = ioctl(gx_fb, NDSFB_CAM_CMD, &c);
+	if (out)
+		*out = c;
+	return r;
+}
+
+static void draw_picture(int flipx, int flipy)
+{
+	double hw = 2.0, hh = 1.5;		/* a 4:3 quad at z = -2; the window's frustum is 2 wide at distance 1 */
+	double s0 = flipx ? PW : 0, s1 = flipx ? 0 : PW, t0 = flipy ? PH : 0, t1 = flipy ? 0 : PH;
+
+	gx_mode(GX_MODELVIEW);
+	gx_identity();
+	gx_polyattr(0, GX_CULL_NONE, 31);
+	gx_texture(0, 256, 256, 0);		/* the frame fills the upper 192 rows of a 256x256 texture */
+	gx_begin(GX_QUADS);
+	gx_color(31, 31, 31);
+	gx_texcoord(s0, t0); gx_vertex(-hw, hh, -2.0);
+	gx_texcoord(s0, t1); gx_vertex(-hw, -hh, -2.0);
+	gx_texcoord(s1, t1); gx_vertex(hw, -hh, -2.0);
+	gx_texcoord(s1, t0); gx_vertex(hw, hh, -2.0);
+	gx_end();
+	gx_swap();
+	gx_flush();
+}
+
+int main(int argc, char **argv)
+{
+	GR_EVENT ev;
+	struct gxw w;
+	struct ndsfb_cam c;
+	int running = 1, cam = 0, flipx = 0, flipy = 0, swap = 0, ready = 0, frames = 0, fails = 0, got_frame = 0;
+	long fps_t = 0, msg_until = 0;
+	char txt[48], msg[48];
+
+	if (gx_open() < 0)
+		return 1;
+	if (GrOpen() < 0) {
+		fprintf(stderr, "dscam: cannot connect to Nano-X\n");
+		return 1;
+	}
+	gxw_create(&w, "Camera", 30, 8, 160, 120, 1.0, 20.0);
+	GrSelectEvents(w.win, GR_EVENT_MASK_EXPOSURE | GR_EVENT_MASK_KEY_DOWN | GR_EVENT_MASK_CLOSE_REQ |
+		       GR_EVENT_MASK_BUTTON_DOWN);
+	gx_control(GX_CTRL_TEXTURE);
+	gx_flush();
+	gxw_text(&w, 0, "camera: starting...");
+
+	if (cam_cmd(0, 0, &c) < 0 || c.value != 0x2280) {
+		sprintf(txt, "init failed v%04x e%x", c.value & 0xffff, c.err & 0xffff);
+		gxw_text(&w, 0, txt);
+		sprintf(txt, "scfg %x", c.err >> 8);
+		gxw_text(&w, 1, txt);
+		strcpy(msg, "press q to quit");
+	} else if (cam_cmd(2, cam, &c) < 0) {
+		sprintf(txt, "select failed e%x", c.err & 0xffff);
+		gxw_text(&w, 0, txt);
+	} else {
+		ready = 1;
+		strcpy(msg, "space: photo");
+	}
+
+	while (running) {
+		int changed = 0;
+
+		GrCheckNextEvent(&ev);
+		if (gxw_event(&w, &ev))
+			running = 0;
+		if (ev.type == GR_EVENT_TYPE_BUTTON_DOWN && ready) {
+			ev.type = GR_EVENT_TYPE_KEY_DOWN;
+			ev.keystroke.ch = ' ';
+		}
+		if (ev.type == GR_EVENT_TYPE_KEY_DOWN) {
+			switch (ev.keystroke.ch) {
+			case MWKEY_ESCAPE:
+			case 'q':
+				running = 0;
+				break;
+			case 'c':
+				if (ready) {
+					cam = !cam;
+					got_frame = 0;
+					cam_cmd(2, cam, &c);
+					changed = 1;
+				}
+				break;
+			case 'f':
+				flipy = !flipy;
+				break;
+			case 'm':
+				flipx = !flipx;
+				break;
+			case 'b':
+				swap = !swap;
+				break;
+			case ' ':
+			case MWKEY_ENTER:
+				if (ready && got_frame) {
+					char path[64];
+					int n;
+
+					mkdir(PHOTO_DIR, 0755);
+					for (n = 1; n < 1000; n++) {
+						sprintf(path, PHOTO_DIR "/photo%03d.bmp", n);
+						if (access(path, F_OK) != 0)
+							break;
+					}
+					if (bmp_write(path, frame, flipx, flipy, swap) == 0) {
+						sprintf(msg, "saved photo%03d", n);
+					} else {
+						strcpy(msg, "cannot save photo");
+					}
+					msg_until = usec() + 3000000L;
+					changed = 1;
+				}
+				break;
+			}
+		}
+		gxw_update(&w);
+		if (!w.visible) {		/* minimised: do not keep the camera busy */
+			usleep(100000);
+			w.dirty = 1;
+			continue;
+		}
+		if (ready) {
+			int r = ioctl(gx_fb, NDSFB_CAM_FRAME, frame);
+
+			if (r == 0) {
+				fails = 0;
+				frames++;
+				got_frame = 1;
+				gx_texture_load(0, frame, sizeof(frame));
+				draw_picture(flipx, flipy);
+			} else if (++fails == 5) {
+				sprintf(txt, "no frames (%d)", errno);
+				gxw_text(&w, 0, txt);
+			} else if (fails > 5) {
+				usleep(100000);
+			}
+		} else {
+			usleep(50000);
+		}
+		if (fps_t == 0)
+			fps_t = usec();
+		if (changed || usec() - fps_t >= 1000000L) {
+			if (usec() - fps_t >= 1000000L) {
+				if (ready && fails < 5) {
+					sprintf(txt, "cam %d  %d fps", cam, frames);
+					gxw_text(&w, 0, txt);
+				}
+				frames = 0;
+				fps_t = usec();
+			}
+			if (msg_until && usec() > msg_until) {
+				msg_until = 0;
+				strcpy(msg, "space: photo");
+			}
+			gxw_text(&w, 1, msg);
+			gxw_text(&w, 2, "c:cam  f:flip");
+			gxw_text(&w, 3, "m:mirror  b:rb");
+		}
+	}
+	cam_cmd(1, 0, NULL);			/* cameras off (and the LED) */
+	gx_close();
+	GrClose();
+	return 0;
+}
