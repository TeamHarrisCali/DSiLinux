+/*
+ * Camera sensor control: ask the ARM7 (arm7/dsicam.c). sub 0 init, 1 deinit, 2 select camera arg, 3 sequencer command arg.
+ * Returns the ARM7's result code (0 = ok) or -1 if it did not answer; *value and *err are its answer (chip version etc.
+ * and a mask of timeouts). Setting up the sensors takes a while, so the wait is long.
+ */
+int dsisd_camera_cmd(unsigned int sub, unsigned int arg, unsigned int *value, unsigned int *err)
+{
+	long save;
+	int ret;
+
+	down(&sd_mutex);
+	save = sd_timeout;
+	sd_timeout = 10 * HZ;
+	ret = sd_request_locked(NDS_SD_CMD_CAMERA, arg, sub);
+	sd_timeout = save;
+	*value = ret == NDS_SD_OK ? sd_block.info[0] : 0;
+	*err = ret == NDS_SD_OK ? sd_block.info[1] : 0xffffffff;
+	up(&sd_mutex);
+	return ret;
+}
