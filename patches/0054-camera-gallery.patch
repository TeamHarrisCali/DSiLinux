--- a/linux-2.6.x/arch/arm/mach-nds/arm7/dsivol.c
+++ b/linux-2.6.x/arch/arm/mach-nds/arm7/dsivol.c
@@ -133,6 +133,29 @@ static int i2c_read_reg(u8 dev, u8 reg)
 	return -1;
 }
 
+/* one power management chip register write over I2C (libnds i2cWriteRegister sequence); 1 = done */
+int dsivol_pm_write(u8 reg, u8 value)
+{
+	int i, r;
+
+	for (i = 0; i < 4; i++) {
+		r = i2c_select_device(I2C_PM);
+		if (r < 0)
+			return 0;
+		if (r == 1 && i2c_select_register(reg) == 1) {
+			i2c_delay();
+			REG_I2CDATA = value;
+			REG_I2CCNT = I2C_ENABLE | I2C_IRQEN;
+			i2c_delay();
+			REG_I2CCNT = I2C_ENABLE | I2C_IRQEN | I2C_ERROR | I2C_STOP;
+			if (i2c_result() == 1)
+				return 1;
+		}
+		REG_I2CCNT = I2C_ENABLE | I2C_IRQEN | I2C_STOP | I2C_ERROR;
+	}
+	return 0;
+}
