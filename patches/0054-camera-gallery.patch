+/*
+ * DSi cameras. The ARM7 talks to the two Aptina sensors (arm7/dsicam.c, asked through dsisd_camera_cmd()); the ARM9 owns the camera
+ * interface (0x04004200) and its DMA. Derived from BlocksDS libnds source/arm9/peripherals/camera.twl.c (Copyright (C) 2023
+ * Adrian "asie" Siekierka, zlib licence), altered: Linux delays instead of BIOS calls, bounded waits.
+ *   NDSFB_CAM_CMD, struct ndsfb_cam: cmd 0 = switch the camera interface on and set the sensors up (value = chip version, 0x2280 is the
+ *   MT9V113), 1 = off, 2 = select camera arg (0 or 1, the sensor is woken up), the answer is in value/err (err: ARM7 timeout mask,
+ *   bits 8..: SCFG_EXT).
+ *   NDSFB_CAM_FRAME, user pointer: one preview frame, 256x192 pixels of RGB555 (the camera interface converts), 98304 bytes.
+ */
+struct ndsfb_cam {
+	unsigned int cmd, arg;
+	unsigned int value, err;
+};
+
+extern int dsisd_camera_cmd(unsigned int sub, unsigned int arg, unsigned int *value, unsigned int *err);
+
+#define REG_SCFG_CLK	(*(volatile u16 *)0x04004004)
+#define REG_SCFG_EXT	(*(volatile u32 *)0x04004008)
+#define SCFG_CLK_CAMIF	(1 << 2)
+#define SCFG_CLK_CAMEXT	(1 << 8)
+#define REG_CAM_MCNT	(*(volatile u16 *)0x04004200)
+#define REG_CAM_CNT	(*(volatile u16 *)0x04004202)
+#define CAM_MCNT_RESET_DISABLE	(1 << 1)
+#define CAM_MCNT_PWR_18V_IO	(1 << 5)
+#define CAM_CNT_FLUSH		(1 << 5)
+#define CAM_CNT_IRQ		(1 << 11)
+#define CAM_CNT_FORMAT_RGB	(1 << 13)
+#define CAM_CNT_ENABLE		(1 << 15)
+#define CAM_FRAME_W	256
+#define CAM_FRAME_H	192
+#define CAM_NDMA	3		/* the NDMA channel used for frames */
+#define NDMA_SRC(n)	(*(volatile u32 *)(0x04004104 + (n) * 0x1C))
+#define NDMA_DEST(n)	(*(volatile u32 *)(0x04004108 + (n) * 0x1C))
+#define NDMA_LENGTH(n)	(*(volatile u32 *)(0x0400410C + (n) * 0x1C))
+#define NDMA_BLENGTH(n)	(*(volatile u32 *)(0x04004110 + (n) * 0x1C))
+#define NDMA_BDELAY(n)	(*(volatile u32 *)(0x04004114 + (n) * 0x1C))
+#define NDMA_CR(n)	(*(volatile u32 *)(0x0400411C + (n) * 0x1C))
+
+static u16 cam_frame[CAM_FRAME_W * CAM_FRAME_H] __attribute__((aligned(32)));
+static DECLARE_MUTEX(cam_mutex);
+static int cam_preview_set;		/* the sensor has been told to preview since it was last selected */
+
+static void ndsfb_cam_off(void)
+{
+	unsigned int v, e;
+
+	if (REG_CAM_MCNT & CAM_MCNT_PWR_18V_IO)
+		dsisd_camera_cmd(1, 0, &v, &e);
+	REG_CAM_CNT &= ~0x8F00;
+	REG_CAM_CNT |= CAM_CNT_FLUSH;
+	REG_SCFG_CLK &= ~SCFG_CLK_CAMEXT;
+	udelay(200);
+	REG_CAM_MCNT = 0;
+	REG_SCFG_CLK &= ~SCFG_CLK_CAMIF;
+	udelay(200);
+	cam_preview_set = 0;
+}
+
+static int ndsfb_cam_cmd(struct ndsfb_cam __user *arg)
+{
+	struct ndsfb_cam c;
+	unsigned int v = 0, e = 0;
+	int ret = 0;
+
+	if (copy_from_user(&c, arg, sizeof(c)))
+		return -EFAULT;
+	down(&cam_mutex);
+	switch (c.cmd) {
+	case 0:
+		if (!(REG_SCFG_EXT & 1))		/* the new DMA unit has to be switched on */
+			REG_SCFG_EXT |= 1;
+		if (REG_CAM_MCNT || (REG_SCFG_CLK & (SCFG_CLK_CAMIF | SCFG_CLK_CAMEXT)))
+			ndsfb_cam_off();
+		REG_SCFG_CLK |= SCFG_CLK_CAMIF;
+		REG_CAM_MCNT = 0;
+		udelay(200);
+		REG_SCFG_CLK |= SCFG_CLK_CAMEXT;
+		udelay(200);
+		REG_CAM_MCNT |= CAM_MCNT_RESET_DISABLE | CAM_MCNT_PWR_18V_IO;
+		mdelay(5);
+		REG_SCFG_CLK &= ~SCFG_CLK_CAMEXT;
+		REG_CAM_CNT &= ~CAM_CNT_ENABLE;
+		REG_CAM_CNT |= CAM_CNT_FLUSH;
+		REG_CAM_CNT = (REG_CAM_CNT & ~0x0300) | 0x0200;
+		REG_CAM_CNT |= 0x0400;
+		REG_CAM_CNT |= CAM_CNT_IRQ;
+		REG_SCFG_CLK |= SCFG_CLK_CAMEXT;
+		udelay(200);
+		ret = dsisd_camera_cmd(0, 0, &v, &e);
+		REG_SCFG_CLK &= ~SCFG_CLK_CAMEXT;
+		REG_SCFG_CLK |= SCFG_CLK_CAMEXT;
+		udelay(200);
+		e |= REG_SCFG_EXT << 8;
+		break;
+	case 1:
+		ndsfb_cam_off();
+		break;
+	case 2:
+		cam_preview_set = 0;
+		ret = dsisd_camera_cmd(2, c.arg, &v, &e);
+		break;
+	default:
+		ret = -EINVAL;
+	}
+	up(&cam_mutex);
+	c.value = v;
+	c.err = e;
+	if (copy_to_user(arg, &c, sizeof(c)))
+		return -EFAULT;
+	return ret > 0 ? -EIO : ret;
+}
+
+static int ndsfb_cam_frame(void __user *dst)
+{
+	unsigned int v, e;
+	int ret = 0, i;
+
+	down(&cam_mutex);
+	if (!(REG_CAM_MCNT & CAM_MCNT_PWR_18V_IO)) {
+		ret = -ENODEV;			/* NDSFB_CAM_CMD 0 first */
+		goto out;
+	}
+	if (!cam_preview_set) {
+		if (dsisd_camera_cmd(3, 1, &v, &e) != NDS_SD_OK || !v) {
+			ret = -EIO;
+			goto out;
+		}
+		cam_preview_set = 1;
+	}
+	REG_CAM_CNT &= ~CAM_CNT_ENABLE;
+	REG_CAM_CNT &= ~0x200F;
+	REG_CAM_CNT |= CAM_CNT_FORMAT_RGB | 3;		/* RGB out, 4 scanlines per block */
+	REG_CAM_CNT |= CAM_CNT_FLUSH;
+	REG_CAM_CNT |= CAM_CNT_ENABLE;
+	dmac_flush_range((unsigned long)cam_frame, (unsigned long)cam_frame + sizeof(cam_frame));
+	NDMA_SRC(CAM_NDMA) = 0x04004204;		/* REG_CAM_DATA */
+	NDMA_DEST(CAM_NDMA) = (u32)cam_frame;
+	NDMA_LENGTH(CAM_NDMA) = (CAM_FRAME_W * CAM_FRAME_H) >> 1;
+	NDMA_BLENGTH(CAM_NDMA) = 512;
+	NDMA_BDELAY(CAM_NDMA) = 2;
+	NDMA_CR(CAM_NDMA) = (2 << 13) | (4 << 16) | (11 << 24) | (1u << 31);	/* source fixed, block scaler 4, start by camera, on */
+	for (i = 0; i < 300 && (NDMA_CR(CAM_NDMA) & (1u << 31)); i++)	/* up to ~600 ms */
+		msleep(2);
+	if (NDMA_CR(CAM_NDMA) & (1u << 31)) {
+		NDMA_CR(CAM_NDMA) = 0;
+		ret = -ETIMEDOUT;
+	}
+	REG_CAM_CNT &= ~CAM_CNT_ENABLE;
+	if (!ret) {
+		dmac_flush_range((unsigned long)cam_frame, (unsigned long)cam_frame + sizeof(cam_frame));
+		for (i = 0; i < CAM_FRAME_W * CAM_FRAME_H; i++)
+			cam_frame[i] |= 0x8000;		/* opaque: the frame is used as a texture and as a frame buffer picture */
+		if (copy_to_user(dst, cam_frame, sizeof(cam_frame)))
+			ret = -EFAULT;
+	}
+out:
+	up(&cam_mutex);
+	return ret;
+}
+
 static int gx_reg_ok(unsigned int off)
 {
 	return (off >= 0x400 && off < 0x600) || off == 0x060 || off == 0x350 || off == 0x354;
@@ -773,6 +938,14 @@ static int ndsfb_ioctl(struct inode *inode, struct file *file,
 				return -EINVAL;
 			ndsfb_gx_setup(arg != 0);
 			return 0;
+		case NDSFB_CAM_CMD:
+			if (info->par != 0)
+				return -EINVAL;
+			return ndsfb_cam_cmd((struct ndsfb_cam __user *)argp);
+		case NDSFB_CAM_FRAME:
+			if (info->par != 0)
+				return -EINVAL;
+			return ndsfb_cam_frame(argp);
 		case NDSFB_GX_TEXLOAD:
 			if (info->par != 0)
 				return -EINVAL;
