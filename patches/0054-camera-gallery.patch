diff --git a/linux-2.6.x/arch/arm/mach-nds/arm7/dsicam.c b/linux-2.6.x/arch/arm/mach-nds/arm7/dsicam.c
new file mode 100644
index 000000000..2296b2339
--- /dev/null
+++ b/linux-2.6.x/arch/arm/mach-nds/arm7/dsicam.c
@@ -0,0 +1,350 @@
+/*
+ * DSi camera sensors for the DSLinux ARM7: set-up and control of the two Aptina MT9V113 sensors over I2C.
+ * (The ARM9 side, the camera interface registers and the DMA, is in drivers/video/ndsfb.c.)
+ *
+ * Derived from BlocksDS libnds (source/arm7/camera.twl.c and camerai2c.twl.c, Copyright (C) 2023 Adrian "asie"
+ * Siekierka, (C) 2011 Dave Murphy (WinterMute), (C) 2023 Epicpkmn11; zlib licence). This version is altered: ported to
+ * the DSLinux ARM7 (no libnds, no FIFO helpers), every wait is bounded (a sensor that never answers cannot hang the
+ * ARM7), no BIOS delay calls, no interrupts. zlib notice: This software is provided 'as-is', without any express or
+ * implied warranty; the origin must not be misrepresented; altered source versions must be plainly marked as such;
+ * this notice may not be removed or altered.
+ */
+#define __DSLINUX_ARM7__
+
+#include "linux/config.h"
+#include "asm/types.h"
+
+#include "dsicam.h"
+#include "dsicam_regs.h"
+#include "dsivol.h"
+
+#define REG_I2CDATA	(*(volatile u8 *)0x04004500)
+#define REG_I2CCNT	(*(volatile u8 *)0x04004501)
+
+#define I2C_NONE	0x00
+#define I2C_STOP	0x01
+#define I2C_START	0x02
+#define I2C_ERROR	0x04
+#define I2C_ACK		0x10
+#define I2C_READ	0x20
+#define I2C_IRQEN	0x40
+#define I2C_ENABLE	0x80	/* writing; reading it back = busy */
+
+#define DEV_CAM0	0x7A
+#define DEV_CAM1	0x78
+
+static u32 cam_err;
+static u8 cam_active = 0xFF;
+
+static int cwait(void)
+{
+	int n = 200000;
+
+	while ((REG_I2CCNT & I2C_ENABLE) && --n)
+		;
+	if (!n)
+		cam_err |= 1;
+	return n;
+}
+
+static int cres(void)
+{
+	if (!cwait())
+		return -1;
+	return (REG_I2CCNT >> 4) & 1;
+}
+
+static int csel(u8 dev, u8 flags)
+{
+	if (!cwait())
+		return -1;
+	REG_I2CDATA = dev;
+	REG_I2CCNT = I2C_ENABLE | I2C_IRQEN | flags;
+	return cres();
+}
+
+static int creg(u8 reg, u8 flags)
+{
+	if (!cwait())
+		return -1;
+	REG_I2CDATA = reg;
+	REG_I2CCNT = I2C_ENABLE | I2C_IRQEN | flags;
+	return cres();
+}
+
+static int cdata(u8 data, u8 flags)
+{
+	REG_I2CDATA = data;
+	REG_I2CCNT = I2C_ENABLE | I2C_IRQEN | flags;
+	return cres();
+}
+
+static int cget(u8 flags)
+{
+	REG_I2CCNT = I2C_ENABLE | I2C_IRQEN | flags;
+	if (!cwait())
+		return -1;
+	return REG_I2CDATA;
+}
+
+/* 16 bit register write; 1 = done */
+static int apt_write(u8 dev, u16 reg, u16 data)
+{
+	int i;
+
+	for (i = 0; i < 8; i++) {
+		if (csel(dev, I2C_START) == 1 && creg(reg >> 8, I2C_NONE) == 1 && creg(reg & 0xFF, I2C_NONE) == 1) {
+			if (cdata(data >> 8, I2C_NONE) == 1 && cdata(data & 0xFF, I2C_STOP) == 1)
+				return 1;
+		}
+		REG_I2CCNT = I2C_ENABLE | I2C_IRQEN | I2C_ERROR | I2C_STOP;
+	}
+	return 0;
+}
+
+/* 16 bit register read; 0xFFFF = failed */
+static u16 apt_read(u8 dev, u16 reg)
+{
+	int i, hi, lo;
+
+	for (i = 0; i < 8; i++) {
+		if (csel(dev, I2C_START) == 1 && creg(reg >> 8, I2C_NONE) == 1 && creg(reg & 0xFF, I2C_STOP) == 1) {
+			if (csel(dev | 1, I2C_START) == 1) {
+				hi = cget(I2C_READ | I2C_ACK);
+				lo = cget(I2C_STOP | I2C_READ);
+				if (hi < 0 || lo < 0)
+					return 0xFFFF;
+				return (hi << 8) | lo;
+			}
+		}
+		REG_I2CCNT = I2C_ENABLE | I2C_IRQEN | I2C_ERROR | I2C_STOP;
+	}
+	return 0xFFFF;
+}
+
+#define WAIT_TRIES	1500	/* about a second at the worst */
+
+static void apt_wait_clear(u8 dev, u16 reg, u16 mask)
+{
+	int n;
+
+	for (n = 0; n < WAIT_TRIES; n++)
+		if (!(apt_read(dev, reg) & mask))
+			return;
+	cam_err |= 2;
+}
+
+static void apt_wait_set(u8 dev, u16 reg, u16 mask)
+{
+	int n;
+
+	for (n = 0; n < WAIT_TRIES; n++)
+		if ((apt_read(dev, reg) & mask) == mask)
+			return;
+	cam_err |= 2;
+}
+
+static void apt_clear_bits(u8 dev, u16 reg, u16 mask)
+{
+	apt_write(dev, reg, apt_read(dev, reg) & ~mask);
+}
+
+static void apt_set_bits(u8 dev, u16 reg, u16 mask)
+{
+	apt_write(dev, reg, apt_read(dev, reg) | mask);
+}
+
+static u16 mcu_read(u8 dev, u16 reg)
+{
+	apt_write(dev, I2CREG_APT_MCU_ADDRESS, reg);
+	return apt_read(dev, I2CREG_APT_MCU_DATA0);
+}
+
+static void mcu_write(u8 dev, u16 reg, u16 data)
+{
+	apt_write(dev, I2CREG_APT_MCU_ADDRESS, reg);
+	apt_write(dev, I2CREG_APT_MCU_DATA0, data);
+}
+
+static void mcu_wait_clear(u8 dev, u16 reg, u16 mask)
+{
+	int n;
+
+	for (n = 0; n < WAIT_TRIES; n++)
+		if (!(mcu_read(dev, reg) & mask))
+			return;
+	cam_err |= 2;
+}
+
+static void mcu_set_bits(u8 dev, u16 reg, u16 mask)
+{
+	mcu_write(dev, reg, mcu_read(dev, reg) | mask);
+}
+
+static void seq_cmd(u8 dev, u8 cmd)
+{
+	mcu_write(dev, MCUREG_APT_SEQ_CMD, cmd);
+	mcu_wait_clear(dev, MCUREG_APT_SEQ_CMD, MCUREG_APT_SEQ_CMD_MASK);
+}
+
+static void wakeup(u8 dev)
+{
+	apt_clear_bits(dev, I2CREG_APT_STANDBY_CNT, I2CREG_APT_STANDBY_ENABLE);
+	apt_wait_clear(dev, I2CREG_APT_STANDBY_CNT, I2CREG_APT_STANDBY_STATUS);
+	apt_wait_set(dev, 0x301A, 0x0004);
+}
+
+static void standby(u8 dev)
+{
+	apt_set_bits(dev, I2CREG_APT_STANDBY_CNT, I2CREG_APT_STANDBY_ENABLE);
+	apt_wait_set(dev, I2CREG_APT_STANDBY_CNT, I2CREG_APT_STANDBY_STATUS);
+	apt_wait_clear(dev, 0x301A, 0x0004);
+}
+
+static void cam_init(u8 dev)
+{
+	u16 read_mode;
+
+	/* reset */
+	apt_write(dev, I2CREG_APT_RESET_MISC_CNT, I2CREG_APT_MIPI_TX_RESET | I2CREG_APT_I2C_RESET);
+	apt_write(dev, I2CREG_APT_RESET_MISC_CNT, 0);
+
+	/* initial wakeup */
+	apt_write(dev, I2CREG_APT_STANDBY_CNT, I2CREG_APT_STANDBY_STATUS | I2CREG_APT_STANDBY_IRQ_ENABLE | (1 << 5));
+	apt_write(dev, I2CREG_APT_PAD_SLEW, I2CREG_APT_PARALLEL_OUT_SLEW_RATE(1) | I2CREG_APT_PCLK_SLEW_RATE(2));
+	apt_write(dev, I2CREG_APT_CLOCKS_CNT, I2CREG_APT_CLKIN_ENABLE | 0x40DF);
+
+	/* wait for wakeup */
+	apt_wait_clear(dev, I2CREG_APT_STANDBY_CNT, I2CREG_APT_STANDBY_STATUS);
+	apt_wait_set(dev, 0x301A, 0x0004);
+
+	mcu_write(dev, 0x02F0, 0x0000);
+	mcu_write(dev, 0x02F2, 0x0210);
+	mcu_write(dev, 0x02F4, 0x001A);
+	mcu_write(dev, 0x2145, 0x02F4);
+	mcu_write(dev, MCUREG_APT_8BIT | 0x2134, 0x01);
+
+	mcu_set_bits(dev, MCUREG_APT_SEQ_CAP_MODE, MCUREG_APT_SEQ_CAP_MODE_VIDEO_ENABLE);
+	mcu_write(dev, MCUREG_APT_MODE_A_OUTPUT_FORMAT,
+		  MCUREG_APT_MODE_OUTPUT_FORMAT_YUV | MCUREG_APT_MODE_OUTPUT_FORMAT_SWAP_LUMA_CHROMA);
+	mcu_write(dev, MCUREG_APT_MODE_B_OUTPUT_FORMAT,
+		  MCUREG_APT_MODE_OUTPUT_FORMAT_YUV | MCUREG_APT_MODE_OUTPUT_FORMAT_SWAP_LUMA_CHROMA);
+
+	/* match the PLL to the console's timings */
+	apt_write(dev, I2CREG_APT_PLL_CNT, 0x2044 | I2CREG_APT_PLL_RESET_CNTR | I2CREG_APT_PLL_BYPASS);
+	apt_write(dev, I2CREG_APT_PLL_DIVS, I2CREG_APT_PLL_M(17) | I2CREG_APT_PLL_N(1));
+	apt_write(dev, I2CREG_APT_PLL_P_DIVS, I2CREG_APT_PLL_P1(0) | I2CREG_APT_PLL_P3(0));
+	apt_write(dev, I2CREG_APT_PLL_CNT, 0x2448 | I2CREG_APT_PLL_ENABLE | I2CREG_APT_PLL_BYPASS);
+	apt_write(dev, I2CREG_APT_PLL_CNT, 0x3048 | I2CREG_APT_PLL_ENABLE | I2CREG_APT_PLL_BYPASS);
+	apt_wait_set(dev, I2CREG_APT_PLL_CNT, I2CREG_APT_PLL_LOCK);
+	apt_clear_bits(dev, I2CREG_APT_PLL_CNT, I2CREG_APT_PLL_BYPASS);
+
+	/* output sizes: mode A (preview) 256x192, mode B (capture) 640x480 */
+	mcu_write(dev, MCUREG_APT_MODE_A_OUTPUT_WIDTH, 256);
+	mcu_write(dev, MCUREG_APT_MODE_A_OUTPUT_HEIGHT, 192);
+	mcu_write(dev, MCUREG_APT_MODE_B_OUTPUT_WIDTH, 640);
+	mcu_write(dev, MCUREG_APT_MODE_B_OUTPUT_HEIGHT, 480);
+
+	/* sensors */
+	read_mode = MCUREG_APT_READ_X_ODD_INC(1) | MCUREG_APT_READ_Y_ODD_INC(1);
+	if (dev == DEV_CAM1)
+		read_mode |= MCUREG_APT_READ_X_MIRROR;
+
+	mcu_write(dev, MCUREG_APT_MODE_A_SENSOR_ROW_SPEED, 1);
+	mcu_write(dev, MCUREG_APT_MODE_A_SENSOR_FINE_CORRECTION, 26);
+	mcu_write(dev, MCUREG_APT_MODE_A_SENSOR_FINE_IT_MIN, 107);
+	mcu_write(dev, MCUREG_APT_MODE_A_SENSOR_FINE_IT_MAX_MARGIN, 107);
+	mcu_write(dev, MCUREG_APT_MODE_A_SENSOR_FRAME_LENGTH, 704);
+	mcu_write(dev, MCUREG_APT_MODE_A_SENSOR_LINE_LENGTH_PCK, 843);
+	mcu_write(dev, MCUREG_APT_AE_MIN_INDEX, 0);
+	mcu_write(dev, MCUREG_APT_AE_MAX_INDEX, 6);
+	mcu_write(dev, MCUREG_APT_MODE_B_SENSOR_ROW_SPEED, 1);
+	mcu_write(dev, MCUREG_APT_MODE_B_SENSOR_FINE_CORRECTION, 26);
+	mcu_write(dev, MCUREG_APT_MODE_B_SENSOR_FINE_IT_MIN, 107);
+	mcu_write(dev, MCUREG_APT_MODE_B_SENSOR_FINE_IT_MAX_MARGIN, 107);
+	mcu_write(dev, MCUREG_APT_MODE_B_SENSOR_FRAME_LENGTH, 704);
+	mcu_write(dev, MCUREG_APT_MODE_B_SENSOR_LINE_LENGTH_PCK, 843);
+	apt_set_bits(dev, I2CREG_APT_COLOR_PIPELINE_CNT, I2CREG_APT_PGA_PIXEL_SHADING_CORRECT_ENABLE);
+	mcu_write(dev, MCUREG_APT_8BIT | 0x2208, 0x00);
+	mcu_write(dev, MCUREG_APT_AE_TARGET_BUFFER_SPEED, 32);
+	mcu_write(dev, MCUREG_APT_AE_TARGET_BASE, 112);
+	mcu_write(dev, MCUREG_APT_MODE_A_SENSOR_READ_MODE, read_mode);
+	mcu_write(dev, MCUREG_APT_MODE_B_SENSOR_READ_MODE, read_mode);
+	if (dev == DEV_CAM0) {
+		mcu_write(dev, MCUREG_APT_AE_WINDOW_POS, MCUREG_APT_AE_WINDOW_X0(2) | MCUREG_APT_AE_WINDOW_Y0(2));
+		mcu_write(dev, MCUREG_APT_AE_WINDOW_SIZE, MCUREG_APT_AE_WINDOW_WIDTH(11) | MCUREG_APT_AE_WINDOW_HEIGHT(11));
+	} else {
+		mcu_write(dev, MCUREG_APT_AE_WINDOW_POS, MCUREG_APT_AE_WINDOW_X0(0) | MCUREG_APT_AE_WINDOW_Y0(0));
+		mcu_write(dev, MCUREG_APT_AE_WINDOW_SIZE, MCUREG_APT_AE_WINDOW_WIDTH(15) | MCUREG_APT_AE_WINDOW_HEIGHT(15));
+	}
+	apt_set_bits(dev, I2CREG_APT_CLOCKS_CNT, 1 << 5);
+	mcu_write(dev, MCUREG_APT_SEQ_CAP_MODE, 0x40 | MCUREG_APT_SEQ_CAP_MODE_VIDEO_HG_ENABLE |
+		  MCUREG_APT_SEQ_CAP_MODE_VIDEO_AWB_ENABLE | MCUREG_APT_SEQ_CAP_MODE_VIDEO_ENABLE);
+	mcu_write(dev, MCUREG_APT_SEQ_PREVIEW1_AWB, 0x01);
+	if (dev == DEV_CAM0) {
+		apt_write(dev, I2CREG_APT_APERTURE_PARAMS, I2CREG_APT_APERTURE_GAIN(1) | I2CREG_APT_APERTURE_GAIN_EXP(1));
+		mcu_write(dev, MCUREG_APT_HG_LL_AP_CORR1, 1);
+	} else {
+		apt_write(dev, I2CREG_APT_APERTURE_PARAMS, I2CREG_APT_APERTURE_GAIN(0) | I2CREG_APT_APERTURE_GAIN_EXP(2));
+		mcu_write(dev, MCUREG_APT_HG_LL_AP_CORR1, 2);
+	}
+
+	seq_cmd(dev, MCUREG_APT_SEQ_CMD_REFRESH_MODE);
+	seq_cmd(dev, MCUREG_APT_SEQ_CMD_REFRESH);
+}
+
+static void cam_activate(u8 dev)
+{
+	if (dev == 0xFF)
+		return;
+	wakeup(dev);
+	apt_set_bits(dev, I2CREG_APT_RESET_MISC_CNT, I2CREG_APT_PARALLEL_ENABLE);
+	if (dev == DEV_CAM1)
+		dsivol_pm_write(0x31, 1);		/* the camera LED */
+}
+
+static void cam_deactivate(u8 dev)
+{
+	if (dev == 0xFF)
+		return;
+	apt_clear_bits(dev, I2CREG_APT_RESET_MISC_CNT, I2CREG_APT_PARALLEL_ENABLE);
+	standby(dev);
+	if (dev == DEV_CAM1)
+		dsivol_pm_write(0x31, 0);
+}
+
+unsigned int dsicam_cmd(unsigned int sub, unsigned int arg, unsigned int *err)
+{
+	unsigned int ret = 1;
+
+	cam_err = 0;
+	switch (sub) {
+	case 0:
+		cam_init(DEV_CAM0);
+		cam_init(DEV_CAM1);
+		cam_deactivate(DEV_CAM0);
+		cam_deactivate(DEV_CAM1);
+		ret = apt_read(DEV_CAM0, I2CREG_APT_CHIP_VERSION);
+		cam_active = 0xFF;
+		break;
+	case 1:
+		cam_deactivate(cam_active);
+		cam_active = 0xFF;
+		break;
+	case 2:
+		cam_deactivate(cam_active);
+		cam_active = arg == 1 ? DEV_CAM1 : (arg == 0 ? DEV_CAM0 : 0xFF);
+		cam_activate(cam_active);
+		break;
+	case 3:
+		if (cam_active == 0xFF)
+			ret = 0;
+		else
+			seq_cmd(cam_active, arg & 0xFF);
+		break;
+	default:
+		ret = 0;
+	}
+	*err = cam_err;
+	return ret;
+}
diff --git a/linux-2.6.x/arch/arm/mach-nds/arm7/dsicam.h b/linux-2.6.x/arch/arm/mach-nds/arm7/dsicam.h
new file mode 100644
index 000000000..391634599
--- /dev/null
+++ b/linux-2.6.x/arch/arm/mach-nds/arm7/dsicam.h
@@ -0,0 +1,9 @@
+#ifndef _mach_nds_arm7_dsicam_h_
+#define _mach_nds_arm7_dsicam_h_
+
+/* Camera commands from the ARM9 (NDS_SD_CMD_CAMERA): sub 0 init both sensors (returns the chip version, 0x2280 for the
+ * MT9V113), 1 deinit, 2 select camera arg (0 or 1), 3 sequencer command arg (1 preview, 2 capture).
+ * *err gets a bit mask of timeouts that happened (1 I2C bus stuck, 2 a wait for a sensor bit ran out). */
+unsigned int dsicam_cmd(unsigned int sub, unsigned int arg, unsigned int *err);
+
+#endif
diff --git a/linux-2.6.x/arch/arm/mach-nds/arm7/dsicam_regs.h b/linux-2.6.x/arch/arm/mach-nds/arm7/dsicam_regs.h
new file mode 100644
index 000000000..317ae6bc0
--- /dev/null
+++ b/linux-2.6.x/arch/arm/mach-nds/arm7/dsicam_regs.h
@@ -0,0 +1,429 @@
+/* Aptina MT9V113 camera register names, from BlocksDS libnds include/nds/camera.h (Copyright (C) 2023 Adrian "asie" Siekierka, zlib licence; only the #defines, unaltered). */
+#define CAMERA_CMD_INIT             0x000
+#define CAMERA_CMD_DEINIT           0x001
+#define CAMERA_CMD_SELECT           0x002
+#define CAMERA_CMD_SEND_SEQ_CMD     0x003
+#define I2CREG_APT_CHIP_VERSION                 0x0000
+#define I2CREG_APT_PLL_DIVS                     0x0010
+#define I2CREG_APT_PLL_P_DIVS                   0x0012
+#define I2CREG_APT_PLL_CNT                      0x0014
+#define I2CREG_APT_CLOCKS_CNT                   0x0016
+#define I2CREG_APT_STANDBY_CNT                  0x0018
