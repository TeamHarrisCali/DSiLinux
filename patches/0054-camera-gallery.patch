diff --git a/user/microwin/src/demos/nanox/dsgallery.c b/user/microwin/src/demos/nanox/dsgallery.c
new file mode 100644
index 000000000..01ce2cb8f
--- /dev/null
+++ b/user/microwin/src/demos/nanox/dsgallery.c
@@ -0,0 +1,197 @@
+/*
+ * dsgallery - photo viewer for the DSLinuxDSi desktop: shows the photos of dscam (/home/photos/photoNNN.bmp, 256x192 BMP).
+ * Each photo is loaded as a texture and drawn on the 3D layer (dsgx.h), like the camera preview.
+ * Keys: left/right (or , and .) = previous/next, d = delete (press twice), c = open the camera, q or Esc = quit.
+ * A tap on the left third of the window goes to the previous photo, on the right third to the next one.
+ */
+#include <stdlib.h>
+#include <dirent.h>
+#include "dsgx_win.h"
+#include "dsbmp.h"
+
+#define MAXPHOTOS 200
+
+static char names[MAXPHOTOS][24];
+static int nphotos, sel;
+static unsigned short frame[PW * PH] __attribute__((aligned(32)));
+
+static int cmpnames(const void *a, const void *b)
+{
+	return strcmp((const char *)a, (const char *)b);
+}
+
+static void scan(void)
+{
+	DIR *d = opendir(PHOTO_DIR);
+	struct dirent *e;
+
+	nphotos = 0;
+	if (d) {
+		while ((e = readdir(d)) != NULL && nphotos < MAXPHOTOS) {
+			int n = strlen(e->d_name);
+
+			if (n > 8 && n < 24 && !strncmp(e->d_name, "photo", 5) && !strcmp(e->d_name + n - 4, ".bmp"))
+				strcpy(names[nphotos++], e->d_name);
+		}
+		closedir(d);
+	}
+	qsort(names, nphotos, sizeof(names[0]), cmpnames);
+	if (sel >= nphotos)
+		sel = nphotos - 1;
+	if (sel < 0)
+		sel = 0;
+}
+
+static int load(void)
+{
+	char path[64];
+
+	if (!nphotos)
+		return -1;
+	sprintf(path, PHOTO_DIR "/%s", names[sel]);
+	if (bmp_read(path, frame))
+		return -2;
+	return gx_texture_load(0, frame, sizeof(frame));
+}
+
+static void draw(int have)
+{
+	double hw = 2.0, hh = 1.5;
+
+	gx_mode(GX_MODELVIEW);
+	gx_identity();
+	gx_polyattr(0, GX_CULL_NONE, 31);
+	if (have) {
+		gx_texture(0, 256, 256, 0);
+		gx_begin(GX_QUADS);
+		gx_color(31, 31, 31);
+		gx_texcoord(0, 0); gx_vertex(-hw, hh, -2.0);
+		gx_texcoord(0, PH); gx_vertex(-hw, -hh, -2.0);
+		gx_texcoord(PW, PH); gx_vertex(hw, -hh, -2.0);
+		gx_texcoord(PW, 0); gx_vertex(hw, hh, -2.0);
+		gx_end();
+	} else {				/* nothing to show: a dark grey panel */
+		gx_cmd(GXR_TEXIMAGE, 0);
+		gx_begin(GX_QUADS);
+		gx_color(4, 4, 4);
+		gx_vertex(-hw, hh, -2.0);
+		gx_vertex(-hw, -hh, -2.0);
+		gx_vertex(hw, -hh, -2.0);
+		gx_vertex(hw, hh, -2.0);
+		gx_end();
+	}
+	gx_swap();
+	gx_flush();
+}
+
+static void label(struct gxw *w, int have, int armed)
+{
+	char t[40];
+
+	if (nphotos)
+		sprintf(t, "%s", names[sel]);
+	else
+		strcpy(t, "no photos yet");
+	gxw_text(w, 0, t);
+	sprintf(t, "%d / %d%s", nphotos ? sel + 1 : 0, nphotos, armed ? "  delete?" : "");
+	gxw_text(w, 1, t);
+	gxw_text(w, 2, have || !nphotos ? "< >  d:del  c:cam" : "cannot read photo");
+}
+
+int main(int argc, char **argv)
+{
+	GR_EVENT ev;
+	struct gxw w;
+	int running = 1, have = 0, armed = 0, redraw = 1;
+
+	if (gx_open() < 0)
+		return 1;
+	if (GrOpen() < 0) {
+		fprintf(stderr, "dsgallery: cannot connect to Nano-X\n");
+		return 1;
+	}
+	scan();
+	if (nphotos)
+		sel = nphotos - 1;			/* the newest photo first */
+	gxw_create(&w, "Photos", 30, 8, 160, 120, 1.0, 20.0);
+	GrSelectEvents(w.win, GR_EVENT_MASK_EXPOSURE | GR_EVENT_MASK_KEY_DOWN | GR_EVENT_MASK_CLOSE_REQ |
+		       GR_EVENT_MASK_BUTTON_DOWN);
+	gx_control(GX_CTRL_TEXTURE);
+	gx_flush();
+	have = load() == 0;
+
+	while (running) {
+		int key = 0;
+
+		GrGetNextEventTimeout(&ev, 200);
+		if (gxw_event(&w, &ev))
+			running = 0;
+		if (ev.type == GR_EVENT_TYPE_BUTTON_DOWN) {
+			if (ev.button.x < w.rw / 3)
+				key = MWKEY_LEFT;
+			else if (ev.button.x > w.rw * 2 / 3)
+				key = MWKEY_RIGHT;
+		} else if (ev.type == GR_EVENT_TYPE_KEY_DOWN) {
+			key = ev.keystroke.ch;
+		}
+		if (key != 'd' && armed) {
+			armed = 0;
+			redraw = 1;
+		}
+		switch (key) {
+		case MWKEY_ESCAPE:
+		case 'q':
+			running = 0;
+			break;
+		case MWKEY_LEFT:
+		case ',':
+			if (sel > 0) {
+				sel--;
+				have = load() == 0;
+				redraw = 1;
+			}
+			break;
+		case MWKEY_RIGHT:
+		case '.':
+			if (sel + 1 < nphotos) {
+				sel++;
+				have = load() == 0;
+				redraw = 1;
+			}
+			break;
+		case 'd':
+			if (!nphotos)
+				break;
+			if (!armed) {
+				armed = 1;
+			} else {
+				char path[64];
+
+				armed = 0;
+				sprintf(path, PHOTO_DIR "/%s", names[sel]);
+				unlink(path);
+				scan();
+				have = load() == 0;
+			}
+			redraw = 1;
+			break;
+		case 'c':
+			if (vfork() == 0) {
+				execl("/boot/dscam", "/boot/dscam", (char *)NULL);
+				_exit(127);
+			}
+			break;
+		}
+		gxw_update(&w);
+		if (!w.visible)
+			continue;
+		if (ev.type == GR_EVENT_TYPE_TIMEOUT || ev.type == GR_EVENT_TYPE_EXPOSURE || redraw) {
+			draw(have);			/* cheap: refresh the 3D picture, in case the window moved */
+			label(&w, have, armed);
+			redraw = 0;
+		}
+	}
+	gx_close();
+	GrClose();
+	return 0;
+}
