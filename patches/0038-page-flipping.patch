From 1b1a3aec85579280adc579ce0e804709512112a8 Mon Sep 17 00:00:00 2001
From: TeamHarrisCali <34009957+TeamHarrisCali@users.noreply.github.com>
Date: Wed, 11 Nov 2026 05:02:28 -0600
Subject: [PATCH] Page flipping on the DS main screen: kernel NDSFB_FLIP
 (scroll at vblank), Nano-X draws on the hidden page and flips when the server
 is idle; no flicker while windows repaint (NANOX_NODBUF=1 disables)

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 linux-2.6.x/drivers/video/ndsfb.c  | 54 ++++++++++++++++++++++++
 user/microwin/src/drivers/scr_fb.c | 68 ++++++++++++++++++++++++++++++
 user/microwin/src/nanox/srvmain.c  | 26 ++++++++++++
 3 files changed, 148 insertions(+)

diff --git a/linux-2.6.x/drivers/video/ndsfb.c b/linux-2.6.x/drivers/video/ndsfb.c
index 93a55f981..9c59cafd3 100644
--- a/linux-2.6.x/drivers/video/ndsfb.c
+++ b/linux-2.6.x/drivers/video/ndsfb.c
@@ -18,6 +18,9 @@
 #include <linux/vmalloc.h>
 #include <linux/delay.h>
 #include <linux/interrupt.h>
+#include <linux/wait.h>
+#include <asm/irq.h>
+#include <asm/arch/irqs.h>
 #include <asm/uaccess.h>
 #include <linux/fb.h>
 #include <linux/init.h>
@@ -226,6 +229,30 @@ static int ndsfb_pan_display(struct fb_var_screeninfo *var,
 static int ndsfb_mmap(struct fb_info *info, struct file *file,
 		      struct vm_area_struct *vma);
 static int ndsfb_blank(int blank_mode, struct fb_info *info);
+/*
+ * Page flipping for the main screen (fb0, 16 bit, 256x512 virtual): the two 256 row pages are shown by two
+ * bitmap layers, and scrolling by 256 rows swaps them. NDSFB_FLIP (argument: 0 or 256) makes that scroll take
+ * effect at the next vertical blank (no tearing) and returns once it has, so the caller may then draw on the
+ * page that was shown before. Not done by FBIOPAN_DISPLAY, because the console may call that where it cannot sleep.
+ */
+#define NDSFB_FLIP	0x4e01
+static DECLARE_WAIT_QUEUE_HEAD(ndsfb_flip_wq);
+static volatile int ndsfb_flip_pending;
+static int ndsfb_flip_y;
+static int ndsfb_irq_ready;
+static int ndsfb_flip_token;	/* dev_id of the shared interrupt */
+
+static irqreturn_t ndsfb_vblank_irq(int irq, void *dev_id, struct pt_regs *regs)
+{
+	if (ndsfb_flip_pending) {
+		BG2_CY = ndsfb_flip_y << 8;
+		BG3_CY = (ndsfb_flip_y - 256) << 8;
+		ndsfb_flip_pending = 0;
+		wake_up(&ndsfb_flip_wq);
+	}
+	return IRQ_HANDLED;
+}
+
 static int ndsfb_open(struct fb_info *info, int user);
 static int ndsfb_release(struct fb_info *info, int user);
 static int ndsfb_ioctl(struct inode *inode, struct file *file,unsigned int cmd, unsigned long arg, struct fb_info *info);
@@ -494,6 +521,33 @@ static int ndsfb_ioctl(struct inode *inode, struct file *file,
 	void __user *argp = (void __user *)arg;
  
 	switch (cmd) {
+		case NDSFB_FLIP:
+			{
+				int y;
+
+				if (info->par != 0 || info->var.yres_virtual < 512 || info->var.bits_per_pixel != 16)
+					return -EINVAL;
+				if (get_user(y, (int __user *)argp))
+					return -EFAULT;
+				if (y != 0 && y != 256)
+					return -EINVAL;
+				if (!ndsfb_irq_ready) {
+					if (request_irq(IRQ_VBLANK, ndsfb_vblank_irq, SA_SHIRQ, "ndsfb-flip", &ndsfb_flip_token))
+						return -EBUSY;
+					*(volatile u16 *)0x04000004 |= 1 << 3;	/* vblank interrupt enable in DISPSTAT */
+					ndsfb_irq_ready = 1;
+				}
+				ndsfb_flip_y = y;
+				info->var.yoffset = y;
+				ndsfb_flip_pending = 1;
+				if (!wait_event_timeout(ndsfb_flip_wq, !ndsfb_flip_pending, HZ / 10) && ndsfb_flip_pending) {
+					/* no vblank interrupt seen: scroll now */
+					BG2_CY = y << 8;
+					BG3_CY = (y - 256) << 8;
+					ndsfb_flip_pending = 0;
+				}
+				return 0;
+			}
 		case FBIOGET_VBLANK:
 			{
 				struct fb_vblank vblank;
diff --git a/user/microwin/src/drivers/scr_fb.c b/user/microwin/src/drivers/scr_fb.c
index b9396a0c7..1de649a71 100644
--- a/user/microwin/src/drivers/scr_fb.c
+++ b/user/microwin/src/drivers/scr_fb.c
@@ -85,6 +85,61 @@ static PSUBDRIVER pdrivers[4] = { /* portrait mode subdrivers*/
 /* local functions*/
 static void	set_directcolor_palette(PSD psd);
 
+#if NDSDRIVER
+/*
+ * Page flipping on the Nintendo DS main screen. The 16 bit frame buffer is two 256 row pages, drawn on the one
+ * that is not shown; fb_nds_flip() (called by the server when it has nothing more to do) shows it and copies it
+ * onto the other, so every page the user sees is complete: no flicker while windows repaint. VRAM must be
+ * written in 16 or 32 bit units, so the copy is done by hand. NANOX_NODBUF=1 turns it off.
+ */
+#define NDSFB_FLIP	0x4e01
+static unsigned char *nds_page[2];
+static int nds_linebytes, nds_rows;
+static int nds_dbuf, nds_front;
+
+static void nds_copy(unsigned char *dst, unsigned char *src, int bytes)
+{
+	volatile unsigned long *d = (volatile unsigned long *)dst;
+	volatile unsigned long *s = (volatile unsigned long *)src;
+
+	for (bytes /= 4; bytes > 0; bytes--)
+		*d++ = *s++;
+}
+
+static void nds_dbuf_init(PSD psd, int linebytes, int bpp, int yres, int yvirt)
+{
+	int y = 0;
+
+	nds_dbuf = 0;
+	if (getenv("NANOX_NODBUF") || bpp != 16 || yvirt < 512)
+		return;
+	if (ioctl(fb, NDSFB_FLIP, &y) < 0)	/* shows page 0 and proves the driver can flip */
+		return;
+	nds_linebytes = linebytes;
+	nds_rows = yres;
+	nds_page[0] = psd->addr;
+	nds_page[1] = psd->addr + 256 * linebytes;
+	nds_copy(nds_page[1], nds_page[0], nds_rows * nds_linebytes);
+	psd->addr = nds_page[1];		/* draw on the hidden page */
+	nds_front = 0;
+	nds_dbuf = 1;
+}
+
+void fb_nds_flip(PSD psd)
+{
+	int drawn = nds_front ^ 1, y;
+
+	if (!nds_dbuf)
+		return;
+	y = drawn ? 256 : 0;
+	if (ioctl(fb, NDSFB_FLIP, &y) < 0)
+		return;
+	nds_front = drawn;
+	nds_copy(nds_page[drawn ^ 1], nds_page[drawn], nds_rows * nds_linebytes);
+	psd->addr = nds_page[drawn ^ 1];
+}
+#endif
+
 /* init framebuffer*/
 static PSD
 fb_open(PSD psd)
@@ -284,6 +339,10 @@ fb_open(PSD psd)
 	}
 #endif
 
+#if NDSDRIVER
+	nds_dbuf_init(psd, fb_fix.line_length, fb_var.bits_per_pixel, fb_var.yres, fb_var.yres_virtual);
+#endif
+
 	/* save original palette*/
 	ioctl_getpalette(0, 16, saved_red, saved_green, saved_blue);
 
@@ -315,6 +374,15 @@ fb_close(PSD psd)
   	/* reset hw palette*/
 	ioctl_setpalette(0, 16, saved_red, saved_green, saved_blue);
   
+#if NDSDRIVER
+	if (nds_dbuf) {
+		int y = 0;
+
+		ioctl(fb, NDSFB_FLIP, &y);	/* leave page 0 shown for the text console */
+		psd->addr = nds_page[0];
+		nds_dbuf = 0;
+	}
+#endif
 	/* unmap framebuffer*/
 	munmap(psd->addr, psd->size);
   
diff --git a/user/microwin/src/nanox/srvmain.c b/user/microwin/src/nanox/srvmain.c
index d25120ff5..d56a9c65d 100644
--- a/user/microwin/src/nanox/srvmain.c
+++ b/user/microwin/src/nanox/srvmain.c
@@ -68,6 +68,11 @@ GR_CURSOR	*curcursor;		/* currently enabled cursor */
 GR_COORD	cursorx;		/* current x position of cursor */
 GR_COORD	cursory;		/* current y position of cursor */
 GR_BUTTON	curbuttons;		/* current state of buttons */
+#if NDSDRIVER
+int		nds_screen_dirty = 1;	/* something was drawn since the last page flip */
+static int	nds_polling;		/* this select() is only a check whether more work is waiting */
+extern void	fb_nds_flip(PSD psd);
+#endif
 GR_CLIENT	*curclient;		/* client currently executing for */
 GR_EVENT_LIST	*eventfree;		/* list of free events */
 GR_BOOL		focusfixed;		/* TRUE if focus is fixed on a window */
@@ -548,9 +553,22 @@ GsSelect(GR_TIMEOUT timeout)
 #endif /* MW_FEATURE_TIMERS */
 			to = NULL;
 	}
+#if NDSDRIVER
+	/* drawn but not shown yet: if nothing else is waiting, show it (page flip) instead of blocking */
+	if (nds_screen_dirty) {
+		tout.tv_sec = 0;
+		tout.tv_usec = 0;
+		to = &tout;
+		nds_polling = 1;
+	} else
+		nds_polling = 0;
+#endif
 
 	/* Wait for some input on any of the fds in the set or a timeout: */
 	if((e = select(setsize+1, &rfds, NULL, NULL, to)) > 0) {
+#if NDSDRIVER
+		nds_screen_dirty = 1;
+#endif
 		/* If data is present on the mouse fd, service it: */
 		if(mouse_fd >= 0 && FD_ISSET(mouse_fd, &rfds))
 			while(GsCheckMouseEvent())
@@ -595,6 +613,14 @@ GsSelect(GR_TIMEOUT timeout)
 #endif /* NONETWORK */
 	}
 	else if (e == 0) {
+#if NDSDRIVER
+		if (nds_polling) {
+			nds_screen_dirty = 0;
+			fb_nds_flip(rootwp->psd);
+			return;
+		}
+		nds_screen_dirty = 1;	/* a timer may draw */
+#endif
 #if NONETWORK
 		/* 
 		 * Timeout has occured.  Currently return
-- 
