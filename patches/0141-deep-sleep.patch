+#!/bin/sh
+# Deep sleep while the lid is closed (docs/SLEEP-LOCK-PLAN.md step 6). dsautolog runs this when Settings > "Lid closed" is "sleep"
+# (/proc/dslid lidsleep=1) and the lid has stayed closed for 5 seconds. By hand (over SSH): "sleep 5; /boot/sleep", then close the
+# lid; it refuses with the lid open.
+# The whole DSi stops (programs, the clock, SSH) until the lid opens. Before: Wi-Fi off (the chip may lose its firmware in sleep;
+# a fresh start afterwards is the safe way) and everything written to the card. After: the clock moves on by the time slept (the kernel asks the clock chip), and Wi-Fi reconnects
+# by itself if it was on and a network is set to Auto.
+L=/tmp/desktop.log
+[ -f /tmp/sleeping ] && exit 0
+: > /tmp/sleeping
+wifi=0
+if ifconfig wlan0 2>/dev/null | grep -q " UP "; then
+	wifi=1
+	killall udhcpc 2>/dev/null
+	ifconfig wlan0 down
+fi
+sync
+echo "sleep: $(date '+%H:%M:%S') going to sleep (wifi was $wifi)" >> $L
+sync
+if echo deepsleep > /proc/dsisettings 2>/dev/null; then r=ok; else r=refused; fi
+echo "sleep: $(date '+%H:%M:%S') awake ($r)" >> $L
+rm -f /tmp/sleeping
+if [ $wifi = 1 ] && [ -f /home/wifi.auto ] && [ -x /boot/dssettings ]; then
+	/boot/dssettings wifi auto > /tmp/wifi-auto.log 2>&1 &
+fi
+exit 0
