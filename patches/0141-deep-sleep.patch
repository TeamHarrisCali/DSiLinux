+int nds_lid_sleep;		/* 1: deep sleep when the lid stays closed (dsautolog reads it from /proc/dslid; Settings sets it) */
 static unsigned int lid_closes;	/* how often the lid was closed since boot: /proc/dslid, for the lock screen (dsdesk polls it) */
 static unsigned long last_input;
 static struct timer_list ss_timer;
@@ -110,10 +117,93 @@ void nds_lid(int closed)
 		nds_screen_on();
 }
 
-/* /proc/dslid: "lid=open|closed closes=N", cheap to read (no ARM7 request): the taskbar starts the lock screen when N goes up */
+/*
+ * Deep sleep (docs/SLEEP-LOCK-PLAN.md step 6). The ARM7 (arm7/main.c arm7_sleep) puts the whole system to sleep until the lid opens;
+ * the ARM9 waits here halted with only the FIFO interrupt enabled, holding the SD request lock (no card or Wi-Fi request in flight).
+ * The kernel's clock stands still meanwhile; afterwards it moves on by the time the clock chip saw pass. The caller (/boot/sleep) has
+ * synced the disks and taken Wi-Fi down (the Wi-Fi chip is restarted after wake). Returns 0 after a sleep, -EAGAIN with the lid open,
+ * -EIO when the ARM7 did not answer.
+ */
+#define ARM9_IE		(*(volatile u32*)0x04000210)
+#define ARM9_IF		(*(volatile u32*)0x04000214)
+#define ARM9_IME	(*(volatile u32*)0x04000208)
+extern void dsisd_lock(void), dsisd_unlock(void);	/* drivers/block/dldi_c.c */
+extern u32 nds_rtc_seconds(void);			/* rtc.c */
+extern void getnstimeofday(struct timespec *tv);	/* kernel/time.c (no header declares it in 2.6.14) */
+static volatile int sleep_state;			/* from the ARM7: 1 asleep now, 2 awake, 3 refused */
+unsigned int nds_sleeps;				/* deep sleeps since boot (/proc/dslid) */
+
+static void sleep_power_cb(u8 cmd, u32 data)
+{
+	if (cmd == FIFO_POWER_CMD_SLEEP)
+		sleep_state = data;
+}
+
+static struct fifo_cb sleep_fifocb = {
+	.type = FIFO_POWER,
+	.handler.power_handler = sleep_power_cb
+};
+
+int nds_deep_sleep(void)
+{
+	struct timespec t0, t1;
+	unsigned long flags;
+	u32 r0, r1, ie, ime;
+	long slept;
+	int i, res;
+
+	if (!nds_lid_closed)
+		return -EAGAIN;
+	dsisd_lock();
+	r0 = nds_rtc_seconds();
+	getnstimeofday(&t0);
+	nds_screen_off();
+	msleep(100);				/* the LCDs go off LCD_OFF_GAP after the backlights */
+	sleep_state = 0;
+	local_irq_save(flags);
+	ie = ARM9_IE;
+	ime = ARM9_IME;
+	ARM9_IE = 1 << IRQ_RECV;		/* only the ARM7's messages end the halt below */
+	ARM9_IME = 1;
+	nds_fifo_send(FIFO_POWER_CMD(FIFO_POWER_CMD_SLEEP, 0));
+	for (i = 0; sleep_state == 0 && i < 100000; i++) {	/* its answer within a second */
+		udelay(10);
+		nds_fifo_drain();
+	}
+	while (sleep_state == 1) {		/* asleep: wait for "awake", however long the lid stays closed */
+		ARM9_IF = 1 << IRQ_RECV;
+		if (NDS_REG_IPCFIFOCNT & FIFO_EMPTY)
+			asm volatile("mcr p15, 0, %0, c7, c0, 4" : : "r" (0) : "memory");	/* halt until an interrupt */
+		nds_fifo_drain();
+	}
+	res = sleep_state;
+	ARM9_IE = ie;
+	ARM9_IME = ime;
+	local_irq_restore(flags);
+	if (res == 2) {
+		nds_sleeps++;
+		r1 = nds_rtc_seconds();
+		getnstimeofday(&t1);
+		slept = (long)(r1 - r0) - (long)(t1.tv_sec - t0.tv_sec);	/* what the kernel's clock missed */
+		if (r1 > r0 && slept > 0 && slept < 400L * 86400) {
+			t1.tv_sec += slept;
+			do_settimeofday(&t1);
+		}
+		printk(KERN_INFO "deep sleep: %ld s\n", slept > 0 ? slept : 0);
+	} else {
+		printk(KERN_WARNING "deep sleep: %s\n", res == 3 ? "the lid was open" : "the ARM7 did not answer");
+	}
+	dsisd_unlock();
+	nds_screen_on();			/* only with the lid open; otherwise the lid's opening does it */
+	return res == 2 ? 0 : res == 3 ? -EAGAIN : -EIO;
+}
+
+/* /proc/dslid: "lid=open|closed closes=N lidsleep=0|1 sleeps=N", cheap to read (no ARM7 request): the taskbar starts the lock screen
+ * when closes goes up; dsautolog starts /boot/sleep when lidsleep is 1 and the lid stays closed */
 static int dslid_read_proc(char *page, char **start, off_t off, int count, int *eof, void *data)
 {
-	int len = sprintf(page, "lid=%s closes=%u\n", nds_lid_closed ? "closed" : "open", lid_closes);
+	int len = sprintf(page, "lid=%s closes=%u lidsleep=%d sleeps=%u\n", nds_lid_closed ? "closed" : "open", lid_closes,
+			  nds_lid_sleep, nds_sleeps);
 
 	*eof = 1;
 	if (off >= len)
@@ -147,6 +237,7 @@ static int __init nds_screensleep_init(void)
 	ss_timer.expires = jiffies + HZ;
 	add_timer(&ss_timer);
 	create_proc_read_entry("dslid", 0444, NULL, dslid_read_proc, NULL);
+	register_fifocb(&sleep_fifocb);
 	return 0;
 }
 
