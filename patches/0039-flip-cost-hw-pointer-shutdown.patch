 };
 #define NITEMS	(sizeof(items) / sizeof(items[0]))
 
diff --git a/user/microwin/src/drivers/scr_fb.c b/user/microwin/src/drivers/scr_fb.c
index 1de649a71..e25dd382e 100644
--- a/user/microwin/src/drivers/scr_fb.c
+++ b/user/microwin/src/drivers/scr_fb.c
@@ -17,6 +17,7 @@
 #include <linux/vt.h>
 #include <stdarg.h>
 #include <stdio.h>
+#include <string.h>
 #include <stdlib.h>
 #include <sys/ioctl.h>
 #include <sys/mman.h>
@@ -87,23 +88,148 @@ static void	set_directcolor_palette(PSD psd);
 
 #if NDSDRIVER
 /*
- * Page flipping on the Nintendo DS main screen. The 16 bit frame buffer is two 256 row pages, drawn on the one
- * that is not shown; fb_nds_flip() (called by the server when it has nothing more to do) shows it and copies it
- * onto the other, so every page the user sees is complete: no flicker while windows repaint. VRAM must be
- * written in 16 or 32 bit units, so the copy is done by hand. NANOX_NODBUF=1 turns it off.
+ * Nintendo DS main screen, three helpers (all off with NANOX_NODBUF=1 / NANOX_SWCURSOR=1):
+ *
+ * 1. Page flipping. The 16 bit frame buffer is two 256 row pages; drawing goes to the one that is not shown.
+ *    When the server has nothing more to do it calls fb_nds_flip(): the drawn page is shown (the kernel swaps
+ *    them at the next vertical blank) and the server goes on. Before the next drawing fb_nds_sync() waits for
+ *    that swap and copies the area that was drawn onto the other page, so the two stay equal.
+ * 2. The drawn area is found by wrapping the screen's drawing functions, so only that area is copied.
+ * 3. The pointer is a hardware sprite (NDSFB_CURSOR), not drawn into the pages at all.
+ *
+ * VRAM must be written in 16 or 32 bit units, so copies are done by hand.
  */
-#define NDSFB_FLIP	0x4e01
+#define NDSFB_FLIP		0x4e01
+#define NDSFB_FLIP_ASYNC	0x4e02
+#define NDSFB_FLIP_WAIT		0x4e03
+#define NDSFB_CURSOR		0x4e04
+
+struct ndsfb_cursor {
+	int x, y, visible, set_shape;
+	unsigned short pal[3];
+	unsigned short tiles[64];
+};
+
 static unsigned char *nds_page[2];
 static int nds_linebytes, nds_rows;
 static int nds_dbuf, nds_front;
+static PSD nds_psd;
+/* area drawn since the last flip, and the area drawn before the pending flip (empty when x1 > x2) */
+static int dirty_x1 = 1, dirty_y1, dirty_x2, dirty_y2;
+static int sync_pending, sync_x1, sync_y1, sync_x2, sync_y2;
+
+static void dirty_add(int x1, int y1, int x2, int y2)
+{
+	int t;
+
+	if (x1 > x2) { t = x1; x1 = x2; x2 = t; }
+	if (y1 > y2) { t = y1; y1 = y2; y2 = t; }
+	if (x1 < 0) x1 = 0;
+	if (y1 < 0) y1 = 0;
+	if (x2 > 255) x2 = 255;
+	if (y2 >= nds_rows) y2 = nds_rows - 1;
+	if (x1 > x2 || y1 > y2)
+		return;
+	if (dirty_x1 > dirty_x2) {
+		dirty_x1 = x1; dirty_y1 = y1; dirty_x2 = x2; dirty_y2 = y2;
+		return;
+	}
+	if (x1 < dirty_x1) dirty_x1 = x1;
+	if (y1 < dirty_y1) dirty_y1 = y1;
+	if (x2 > dirty_x2) dirty_x2 = x2;
+	if (y2 > dirty_y2) dirty_y2 = y2;
+}
+
+static void dirty_all(void)
+{
+	dirty_add(0, 0, 255, nds_rows - 1);
+}
+
+/* wrappers: note the area, then call the real drawing function */
+static void (*o_DrawPixel)(PSD, MWCOORD, MWCOORD, MWPIXELVAL);
+static MWPIXELVAL (*o_ReadPixel)(PSD, MWCOORD, MWCOORD);
+static void (*o_DrawHorzLine)(PSD, MWCOORD, MWCOORD, MWCOORD, MWPIXELVAL);
+static void (*o_DrawVertLine)(PSD, MWCOORD, MWCOORD, MWCOORD, MWPIXELVAL);
+static void (*o_FillRect)(PSD, MWCOORD, MWCOORD, MWCOORD, MWCOORD, MWPIXELVAL);
+static void (*o_Blit)(PSD, MWCOORD, MWCOORD, MWCOORD, MWCOORD, PSD, MWCOORD, MWCOORD, long);
+static void (*o_DrawArea)(PSD, driver_gc_t *, int);
+static void (*o_StretchBlit)(PSD, MWCOORD, MWCOORD, MWCOORD, MWCOORD, PSD, MWCOORD, MWCOORD, MWCOORD, MWCOORD, long);
+static void (*o_StretchBlitEx)(PSD, PSD, MWCOORD, MWCOORD, MWCOORD, MWCOORD, int, int, int, int, int, int, long);
+
+#define ONSCREEN(p)	((p)->flags & PSF_SCREEN)
+
+static void w_DrawPixel(PSD psd, MWCOORD x, MWCOORD y, MWPIXELVAL c)
+{
+	if (ONSCREEN(psd)) { if (psd->portrait) dirty_all(); else dirty_add(x, y, x, y); }
+	o_DrawPixel(psd, x, y, c);
+}
 
-static void nds_copy(unsigned char *dst, unsigned char *src, int bytes)
+static void w_DrawHorzLine(PSD psd, MWCOORD x1, MWCOORD x2, MWCOORD y, MWPIXELVAL c)
 {
-	volatile unsigned long *d = (volatile unsigned long *)dst;
-	volatile unsigned long *s = (volatile unsigned long *)src;
+	if (ONSCREEN(psd)) { if (psd->portrait) dirty_all(); else dirty_add(x1, y, x2, y); }
+	o_DrawHorzLine(psd, x1, x2, y, c);
+}
+
+static void w_DrawVertLine(PSD psd, MWCOORD x, MWCOORD y1, MWCOORD y2, MWPIXELVAL c)
+{
+	if (ONSCREEN(psd)) { if (psd->portrait) dirty_all(); else dirty_add(x, y1, x, y2); }
+	o_DrawVertLine(psd, x, y1, y2, c);
+}
 
-	for (bytes /= 4; bytes > 0; bytes--)
-		*d++ = *s++;
+static void w_FillRect(PSD psd, MWCOORD x1, MWCOORD y1, MWCOORD x2, MWCOORD y2, MWPIXELVAL c)
+{
+	if (ONSCREEN(psd)) { if (psd->portrait) dirty_all(); else dirty_add(x1, y1, x2, y2); }
+	o_FillRect(psd, x1, y1, x2, y2, c);
+}
+
+static void w_Blit(PSD dpsd, MWCOORD dx, MWCOORD dy, MWCOORD w, MWCOORD h, PSD spsd, MWCOORD sx, MWCOORD sy, long op)
+{
+	if (ONSCREEN(dpsd)) {
+		if (dpsd->portrait) dirty_all(); else dirty_add(dx, dy, dx + w - 1, dy + h - 1);
+	}
+	o_Blit(dpsd, dx, dy, w, h, spsd, sx, sy, op);
+}
+
+static void w_DrawArea(PSD psd, driver_gc_t *gc, int op)
+{
+	if (ONSCREEN(psd)) {
+		if (psd->portrait) dirty_all();
+		else dirty_add(gc->dstx, gc->dsty, gc->dstx + gc->dstw - 1, gc->dsty + gc->dsth - 1);
+	}
+	o_DrawArea(psd, gc, op);
+}
+
+static void w_StretchBlit(PSD dpsd, MWCOORD dx, MWCOORD dy, MWCOORD dw, MWCOORD dh, PSD spsd, MWCOORD sx,
+			  MWCOORD sy, MWCOORD sw, MWCOORD sh, long op)
+{
+	if (ONSCREEN(dpsd))
+		dirty_add(dx, dy, dx + dw - 1, dy + dh - 1);
+	o_StretchBlit(dpsd, dx, dy, dw, dh, spsd, sx, sy, sw, sh, op);
+}
+
+static void w_StretchBlitEx(PSD dpsd, PSD spsd, MWCOORD dx, MWCOORD dy, MWCOORD w, MWCOORD h, int xd, int yd,
+			    int sxf, int syf, int xsf, int ysf, long op)
+{
+	if (ONSCREEN(dpsd))
+		dirty_add(dx, dy, dx + w - 1, dy + h - 1);
+	o_StretchBlitEx(dpsd, spsd, dx, dy, w, h, xd, yd, sxf, syf, xsf, ysf, op);
+}
+
+static void nds_copy_rect(unsigned char *dst, unsigned char *src, int x1, int y1, int x2, int y2)
+{
+	int y, words;
+
+	x1 &= ~1;
+	x2 |= 1;
+	words = (x2 - x1 + 1) / 2;
+	for (y = y1; y <= y2; y++) {
+		volatile unsigned long *d = (volatile unsigned long *)(dst + y * nds_linebytes + x1 * 2);
+		volatile unsigned long *s = (volatile unsigned long *)(src + y * nds_linebytes + x1 * 2);
+		int n;
+
+		for (n = 0; n < words; n++)
+			*d++ = *s++;
+	}
 }
 
 static void nds_dbuf_init(PSD psd, int linebytes, int bpp, int yres, int yvirt)
@@ -111,33 +237,131 @@ static void nds_dbuf_init(PSD psd, int linebytes, int bpp, int yres, int yvirt)
 	int y = 0;
 
 	nds_dbuf = 0;
-	if (getenv("NANOX_NODBUF") || bpp != 16 || yvirt < 512)
+	if (getenv("NANOX_NODBUF") || bpp != 16 || yvirt < 512 || psd->portrait)
 		return;
 	if (ioctl(fb, NDSFB_FLIP, &y) < 0)	/* shows page 0 and proves the driver can flip */
 		return;
 	nds_linebytes = linebytes;
 	nds_rows = yres;
 	nds_page[0] = psd->addr;
-	nds_page[1] = psd->addr + 256 * linebytes;
-	nds_copy(nds_page[1], nds_page[0], nds_rows * nds_linebytes);
+	nds_page[1] = (unsigned char *)psd->addr + 256 * linebytes;
+	nds_copy_rect(nds_page[1], nds_page[0], 0, 0, 255, nds_rows - 1);
 	psd->addr = nds_page[1];		/* draw on the hidden page */
 	nds_front = 0;
 	nds_dbuf = 1;
+	nds_psd = psd;
+	dirty_x1 = 1;
+	dirty_x2 = 0;
+	sync_pending = 0;
+
+	/* from here on every pixel written to the screen is noted */
+	o_DrawPixel = psd->DrawPixel;		psd->DrawPixel = w_DrawPixel;
+	o_ReadPixel = psd->ReadPixel;
+	o_DrawHorzLine = psd->DrawHorzLine;	psd->DrawHorzLine = w_DrawHorzLine;
+	o_DrawVertLine = psd->DrawVertLine;	psd->DrawVertLine = w_DrawVertLine;
+	o_FillRect = psd->FillRect;		psd->FillRect = w_FillRect;
+	o_Blit = psd->Blit;			if (o_Blit) psd->Blit = w_Blit;
+	o_DrawArea = psd->DrawArea;		if (o_DrawArea) psd->DrawArea = w_DrawArea;
+	o_StretchBlit = psd->StretchBlit;	if (o_StretchBlit) psd->StretchBlit = w_StretchBlit;
+	o_StretchBlitEx = psd->StretchBlitEx;	if (o_StretchBlitEx) psd->StretchBlitEx = w_StretchBlitEx;
 }
 
+/* show what was drawn since the last flip; the other page is brought up to date later, by fb_nds_sync() */
 void fb_nds_flip(PSD psd)
 {
 	int drawn = nds_front ^ 1, y;
 
-	if (!nds_dbuf)
+	if (!nds_dbuf || sync_pending || dirty_x1 > dirty_x2)
 		return;
 	y = drawn ? 256 : 0;
-	if (ioctl(fb, NDSFB_FLIP, &y) < 0)
+	if (ioctl(fb, NDSFB_FLIP_ASYNC, &y) < 0)
 		return;
 	nds_front = drawn;
-	nds_copy(nds_page[drawn ^ 1], nds_page[drawn], nds_rows * nds_linebytes);
+	sync_x1 = dirty_x1; sync_y1 = dirty_y1; sync_x2 = dirty_x2; sync_y2 = dirty_y2;
+	sync_pending = 1;
+	dirty_x1 = 1;
+	dirty_x2 = 0;
 	psd->addr = nds_page[drawn ^ 1];
 }
+
+/* must run before anything draws again: wait for the swap, then copy the drawn area to the page we draw on */
+void fb_nds_sync(void)
+{
+	if (!sync_pending)
+		return;
+	ioctl(fb, NDSFB_FLIP_WAIT, 0);
+	nds_copy_rect(nds_page[nds_front ^ 1], nds_page[nds_front], sync_x1, sync_y1, sync_x2, sync_y2);
+	sync_pending = 0;
+}
+
+/* ---- hardware pointer ---- */
+static int nds_hwcur;
+static struct ndsfb_cursor nds_cur;
+static int nds_shape_new;
+
+static unsigned short rgb555(unsigned long c)
+{
+	return (unsigned short)(((c & 0xff) >> 3) | (((c >> 8) & 0xff) >> 3) << 5 | (((c >> 16) & 0xff) >> 3) << 10);
+}
+
+/* same colour rule as the software pointer: image bit set = background colour, else foreground, only where masked */
+static int nds_hw_shape(int w, int h, const MWIMAGEBITS *image, const MWIMAGEBITS *mask, unsigned long fg,
+			unsigned long bg)
+{
+	unsigned char px[16][16];
+	int x, y, wpr = (w + 15) / 16, t, r, n;
+
+	memset(px, 0, sizeof(px));
+	for (y = 0; y < h && y < 16; y++)
+		for (x = 0; x < w && x < 16; x++) {
+			MWIMAGEBITS bit = 0x8000 >> (x % 16);
+
+			if (mask[y * wpr + x / 16] & bit)
+				px[y][x] = (image[y * wpr + x / 16] & bit) ? 1 : 2;
+		}
+	nds_cur.pal[0] = 0;
