diff --git a/linux-2.6.x/drivers/video/ndsfb.c b/linux-2.6.x/drivers/video/ndsfb.c
index 9c59cafd3..e3cdc283f 100644
--- a/linux-2.6.x/drivers/video/ndsfb.c
+++ b/linux-2.6.x/drivers/video/ndsfb.c
@@ -231,11 +231,17 @@ static int ndsfb_mmap(struct fb_info *info, struct file *file,
 static int ndsfb_blank(int blank_mode, struct fb_info *info);
 /*
  * Page flipping for the main screen (fb0, 16 bit, 256x512 virtual): the two 256 row pages are shown by two
- * bitmap layers, and scrolling by 256 rows swaps them. NDSFB_FLIP (argument: 0 or 256) makes that scroll take
- * effect at the next vertical blank (no tearing) and returns once it has, so the caller may then draw on the
- * page that was shown before. Not done by FBIOPAN_DISPLAY, because the console may call that where it cannot sleep.
+ * bitmap layers, and scrolling by 256 rows swaps them. The scroll registers are written by a vertical blank
+ * interrupt handler, so a flip never tears. Private ioctls (not FBIOPAN_DISPLAY, which the console may call
+ * where it cannot sleep):
+ *   NDSFB_FLIP       (arg 0 or 256) request the flip and wait until it happened
+ *   NDSFB_FLIP_ASYNC (arg 0 or 256) request the flip and return at once
+ *   NDSFB_FLIP_WAIT  wait until a requested flip happened (returns at once if none is pending)
  */
 #define NDSFB_FLIP	0x4e01
+#define NDSFB_FLIP_ASYNC	0x4e02
+#define NDSFB_FLIP_WAIT	0x4e03
+#define NDSFB_CURSOR	0x4e04
 static DECLARE_WAIT_QUEUE_HEAD(ndsfb_flip_wq);
 static volatile int ndsfb_flip_pending;
 static int ndsfb_flip_y;
@@ -253,6 +259,93 @@ static irqreturn_t ndsfb_vblank_irq(int irq, void *dev_id, struct pt_regs *regs)
 	return IRQ_HANDLED;
 }
 
+static int ndsfb_flip_request(struct fb_info *info, int y)
+{
+	if (info->par != 0 || info->var.yres_virtual < 512 || info->var.bits_per_pixel != 16)
+		return -EINVAL;
+	if (y != 0 && y != 256)
+		return -EINVAL;
+	if (!ndsfb_irq_ready) {
+		if (request_irq(IRQ_VBLANK, ndsfb_vblank_irq, SA_SHIRQ, "ndsfb-flip", &ndsfb_flip_token))
+			return -EBUSY;
+		*(volatile u16 *)0x04000004 |= 1 << 3;	/* vblank interrupt enable in DISPSTAT */
+		ndsfb_irq_ready = 1;
+	}
+	ndsfb_flip_y = y;
+	info->var.yoffset = y;
+	ndsfb_flip_pending = 1;
+	return 0;
+}
+
+static void ndsfb_flip_wait(void)
+{
+	if (!ndsfb_flip_pending)
+		return;
+	if (!wait_event_timeout(ndsfb_flip_wq, !ndsfb_flip_pending, HZ / 10) && ndsfb_flip_pending) {
+		/* no vblank interrupt seen: scroll now */
+		BG2_CY = ndsfb_flip_y << 8;
+		BG3_CY = (ndsfb_flip_y - 256) << 8;
+		ndsfb_flip_pending = 0;
+	}
+}
+
+/*
+ * Hardware pointer: one 16x16 sprite on the main screen (OBJ in VRAM bank F, palette entries 1 and 2, OAM entry 0),
+ * so moving the pointer draws nothing into the frame buffer. NDSFB_CURSOR takes a struct ndsfb_cursor.
+ */
+struct ndsfb_cursor {
+	int x, y;			/* top left of the sprite on the screen (may be negative) */
+	int visible;
+	int set_shape;			/* 1: pal[] and tiles[] are new */
+	unsigned short pal[3];		/* OBJ palette entries 0..2, RGB555 (entry 0 is transparent) */
+	unsigned short tiles[64];	/* 16x16 pixels as four 8x8 tiles of 4 bit pixels, 1D order */
+};
+
+#define OBJ_PALETTE	((volatile u16 *)0x05000200)
+#define OAM		((volatile u16 *)0x07000000)
+#define OBJ_TILES	((volatile u16 *)0x06400000)
+static int ndsfb_cursor_ready;
+
+static void ndsfb_cursor_setup(void)
+{
+	int i;
+
+	writeb(VRAM_ENABLE | 2, VRAM_F_CR);	/* bank F: main screen OBJ memory at 0x06400000 */
+	for (i = 0; i < 128; i++) {		/* all sprites off */
+		OAM[i * 4 + 0] = 0x0200;
+		OAM[i * 4 + 1] = 0;
+		OAM[i * 4 + 2] = 0;
+	}
+	ndsfb_cursor_ready = 1;
+	DISPLAY_CR |= (1 << 12) | (1 << 4);	/* OBJ on, 1D tile layout */
+}
+
+static int ndsfb_cursor_ioctl(struct ndsfb_cursor __user *arg)
+{
+	struct ndsfb_cursor c;
+	int i;
+
+	if (copy_from_user(&c, arg, sizeof(c)))
+		return -EFAULT;
+	if (!ndsfb_cursor_ready)
+		ndsfb_cursor_setup();
+	if (c.set_shape) {
+		for (i = 0; i < 3; i++)
+			OBJ_PALETTE[i] = c.pal[i];
+		for (i = 0; i < 64; i++)
+			OBJ_TILES[i] = c.tiles[i];
+	}
+	/* attr0: y, normal, 16 colours, square; attr1: x, 16x16; attr2: tile 0, priority 0, palette 0 */
+	if (c.visible) {
+		OAM[0] = c.y & 0xff;
+		OAM[1] = (c.x & 0x1ff) | (1 << 14);
+		OAM[2] = 0;
+	} else {
+		OAM[0] = 0x0200;
+	}
+	return 0;
+}
+
 static int ndsfb_open(struct fb_info *info, int user);
 static int ndsfb_release(struct fb_info *info, int user);
 static int ndsfb_ioctl(struct inode *inode, struct file *file,unsigned int cmd, unsigned long arg, struct fb_info *info);
@@ -442,6 +535,8 @@ static int ndsfb_set_par(struct fb_info *info)
 		} else {
 			DISPLAY_CR = MODE_5_2D | DISPLAY_BG2_ACTIVE;
 		}
+		if (ndsfb_cursor_ready)
+			DISPLAY_CR |= (1 << 12) | (1 << 4);
 		writeb(VRAM_ENABLE | VRAM_A_MAIN_BG_0x6000000, VRAM_A_CR);
 		if (info->var.xres_virtual == 512)
 			if (info->fix.visual == FB_VISUAL_TRUECOLOR)
@@ -522,32 +617,26 @@ static int ndsfb_ioctl(struct inode *inode, struct file *file,
  
 	switch (cmd) {
 		case NDSFB_FLIP:
+		case NDSFB_FLIP_ASYNC:
 			{
-				int y;
+				int y, err;
 
-				if (info->par != 0 || info->var.yres_virtual < 512 || info->var.bits_per_pixel != 16)
-					return -EINVAL;
 				if (get_user(y, (int __user *)argp))
 					return -EFAULT;
-				if (y != 0 && y != 256)
-					return -EINVAL;
-				if (!ndsfb_irq_ready) {
-					if (request_irq(IRQ_VBLANK, ndsfb_vblank_irq, SA_SHIRQ, "ndsfb-flip", &ndsfb_flip_token))
-						return -EBUSY;
-					*(volatile u16 *)0x04000004 |= 1 << 3;	/* vblank interrupt enable in DISPSTAT */
-					ndsfb_irq_ready = 1;
-				}
-				ndsfb_flip_y = y;
-				info->var.yoffset = y;
-				ndsfb_flip_pending = 1;
-				if (!wait_event_timeout(ndsfb_flip_wq, !ndsfb_flip_pending, HZ / 10) && ndsfb_flip_pending) {
-					/* no vblank interrupt seen: scroll now */
-					BG2_CY = y << 8;
-					BG3_CY = (y - 256) << 8;
-					ndsfb_flip_pending = 0;
-				}
+				err = ndsfb_flip_request(info, y);
+				if (err)
+					return err;
+				if (cmd == NDSFB_FLIP)
+					ndsfb_flip_wait();
 				return 0;
 			}
+		case NDSFB_FLIP_WAIT:
+			ndsfb_flip_wait();
+			return 0;
+		case NDSFB_CURSOR:
+			if (info->par != 0)
+				return -EINVAL;
+			return ndsfb_cursor_ioctl((struct ndsfb_cursor __user *)argp);
 		case FBIOGET_VBLANK:
 			{
 				struct fb_vblank vblank;
