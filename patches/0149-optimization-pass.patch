-dldi-y  := dldi_c.o dldi_s.o
+dldi-y  := dldi_c.o
+# the DLDI stub (32 KB placeholder for a slot-1 driver, 4 KB buffers): unused with the DSi's own SD path (2026-11-19, 37 KB RAM)
+ifneq ($(CONFIG_NDS_DSISD),y)
+dldi-y  += dldi_s.o
+endif
 
