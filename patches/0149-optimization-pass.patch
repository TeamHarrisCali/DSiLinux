diff --git a/linux-2.6.x/drivers/block/dldi_c.c b/linux-2.6.x/drivers/block/dldi_c.c
index ef0c195ec..25b80f30e 100644
--- a/linux-2.6.x/drivers/block/dldi_c.c
+++ b/linux-2.6.x/drivers/block/dldi_c.c
@@ -53,6 +53,7 @@ struct IO_INTERFACE_STRUCT {
 	FN_MEDIUM_SHUTDOWN	fn_shutdown ;
 } ;
 
+#ifndef CONFIG_NDS_DSISD	/* the DLDI stub (dldi_s.S) is only built without the DSi's own SD path */
 extern struct IO_INTERFACE_STRUCT _io_dldi;
 
 struct dldi_params {
@@ -70,6 +71,7 @@ extern struct dldi_params _param_dldi;
 extern int _call_dldi(void);
 
 extern char _buf_dldi[];
+#endif
 
 /*
  * Minor number.
@@ -336,7 +338,7 @@ int dsisd_twlop_rx(unsigned int op, unsigned int addr, unsigned int arg, const u
 		out[3 + i] = sd_block.touch[i];
 		out[11 + i] = sd_block.diag[i];
 	}
-	if (op == 12 && ret == 0 && rxbuf)		/* a received mailbox packet */
+	if (op == 12 && ret == 0 && rxbuf && sd_block.info[1] != 5)	/* a received mailbox packet (5 = none: nothing to copy) */
 		memcpy(rxbuf, sd_block.data, sizeof(sd_block.data));
 	up(&sd_mutex);
 	return ret;
@@ -738,6 +740,7 @@ static void dldi_transfer(struct dldi_dev *dev, unsigned long sector,
 	dsisd_transfer(sector, nsect, buffer, write);
 	return;
 #endif
+#ifndef CONFIG_NDS_DSISD
 	while (nsect > 0) {
 		sectors = nsect;
 		if (sectors > (BUF_SIZE/SECTOR_SIZE))
@@ -768,6 +771,7 @@ static void dldi_transfer(struct dldi_dev *dev, unsigned long sector,
 		nsect  -= sectors;
 		buffer += (sectors * SECTOR_SIZE);
 	}
+#endif
 }
 
 /*
@@ -1067,12 +1071,14 @@ static void dldi_exit(void)
 		return;
 	cancel_delayed_work(&dev->dldi_work);
 
+#ifndef CONFIG_NDS_DSISD
 	/* Shutdown the interface */
 	_param_dldi.function = _io_dldi.fn_shutdown;
 	ret = _call_dldi();
 	if (ret == 0) {
 		printk(KERN_ERR "dldi: fn_shutdown failure\n");
 	}
+#endif
 
 	if (dev->gd) {
 		del_gendisk(dev->gd);
diff --git a/linux-2.6.x/drivers/video/ndsfb.c b/linux-2.6.x/drivers/video/ndsfb.c
index 7c2725f5d..177730068 100644
--- a/linux-2.6.x/drivers/video/ndsfb.c
+++ b/linux-2.6.x/drivers/video/ndsfb.c
@@ -269,7 +269,7 @@ static volatile unsigned int ndsfb_vblank_count;
  * and a picture that is being drawn then loses scanlines (black lines across it). The vertical blank gap is about 4 ms; a program
  * cannot hit it reliably, so it hands the data over and this interrupt does the copy at the very start of the gap. */
 #define TEX_STAGE_BYTES	32768
-static u32 tex_stage[TEX_STAGE_BYTES / 4];
+static u32 *tex_stage;		/* allocated at the first texture upload (2026-11-19: 32 KB of RAM only for programs that use 3D) */
 static volatile unsigned int tex_pend_bytes, tex_pend_off;
 
 static void ndsfb_tex_commit(void)
@@ -474,8 +474,11 @@ extern int dsisd_camera_cmd(unsigned int sub, unsigned int arg, unsigned int *va
 #define NDMA_BDELAY(n)	(*(volatile u32 *)(0x04004114 + (n) * 0x1C))
 #define NDMA_CR(n)	(*(volatile u32 *)(0x0400411C + (n) * 0x1C))
 
-/* two frame buffers: while the user program gets one, the next frame is already being captured into the other */
-static u16 cam_frame[2][CAM_FRAME_W * CAM_FRAME_H] __attribute__((aligned(32)));
+/* two frame buffers: while the user program gets one, the next frame is already being captured into the other. Allocated at the
+ * first frame and freed when the camera is switched off (2026-11-19: 192 KB of RAM was reserved all the time; kmalloc gives page
+ * aligned blocks, so the 32 byte DMA alignment holds) */
+#define CAM_FRAME_BYTES	(CAM_FRAME_W * CAM_FRAME_H * 2)
+static u16 *cam_frame[2];
 static int cam_cur;			/* the buffer being filled by the running capture */
 static int cam_armed;			/* a capture is running (or finished and not yet collected) */
 static unsigned long cam_t_arm_us, cam_t_done_us;
@@ -497,7 +500,7 @@ static void cam_arm(int b)
 	REG_CAM_CNT |= CAM_CNT_FORMAT_RGB | 3;		/* RGB out, 4 scanlines per block */
 	REG_CAM_CNT |= CAM_CNT_FLUSH;
 	REG_CAM_CNT |= CAM_CNT_ENABLE;
-	dmac_flush_range((unsigned long)cam_frame[b], (unsigned long)cam_frame[b] + sizeof(cam_frame[b]));
+	dmac_flush_range((unsigned long)cam_frame[b], (unsigned long)cam_frame[b] + CAM_FRAME_BYTES);
 	NDMA_SRC(CAM_NDMA) = 0x04004204;		/* REG_CAM_DATA */
 	NDMA_DEST(CAM_NDMA) = (u32)cam_frame[b];
 	NDMA_LENGTH(CAM_NDMA) = (CAM_FRAME_W * CAM_FRAME_H) >> 1;
@@ -533,6 +536,9 @@ static void ndsfb_cam_off(void)
 	udelay(200);
 	cam_preview_set = 0;
 	cam_disarm();
+	kfree(cam_frame[0]);			/* the frame buffers go back until the camera is used again */
+	kfree(cam_frame[1]);
+	cam_frame[0] = cam_frame[1] = NULL;
 }
 
 static int ndsfb_cam_cmd(struct ndsfb_cam __user *arg)
@@ -608,6 +614,20 @@ static int ndsfb_cam_frame(void __user *dst)
 		}
 		cam_preview_set = 1;
 	}
+	if (!cam_frame[0] || !cam_frame[1]) {
+		kfree(cam_frame[0]);
+		kfree(cam_frame[1]);
+		cam_frame[0] = kmalloc(CAM_FRAME_BYTES, GFP_KERNEL);
+		cam_frame[1] = kmalloc(CAM_FRAME_BYTES, GFP_KERNEL);
+		if (!cam_frame[0] || !cam_frame[1]) {
+			kfree(cam_frame[0]);
+			kfree(cam_frame[1]);
+			cam_frame[0] = cam_frame[1] = NULL;
+			printk(KERN_WARNING "ndsfb: no memory for the camera's frame buffers\n");
+			ret = -ENOMEM;
+			goto out;
+		}
+	}
 	if (!cam_armed)
 		cam_arm(cam_cur);
 	/* wait for the capture. Frames come about every 66 ms; sleep for most of it, then poll closely, so the next capture is
@@ -634,10 +654,10 @@ static int ndsfb_cam_frame(void __user *dst)
 	filled = cam_cur;
 	cam_cur ^= 1;
 	cam_arm(cam_cur);			/* the next frame starts at once, into the other buffer */
-	dmac_flush_range((unsigned long)cam_frame[filled], (unsigned long)cam_frame[filled] + sizeof(cam_frame[filled]));
+	dmac_flush_range((unsigned long)cam_frame[filled], (unsigned long)cam_frame[filled] + CAM_FRAME_BYTES);
 	for (i = 0; i < CAM_FRAME_W * CAM_FRAME_H; i++)
 		cam_frame[filled][i] |= 0x8000;		/* opaque: the frame is used as a texture and as a frame buffer picture */
-	if (copy_to_user(dst, cam_frame[filled], sizeof(cam_frame[filled])))
+	if (copy_to_user(dst, cam_frame[filled], CAM_FRAME_BYTES))
 		ret = -EFAULT;
 out:
 	up(&cam_mutex);
@@ -660,6 +680,8 @@ static int ndsfb_gx_texload_vbl(struct ndsfb_gx_tex __user *arg)
 	wait_event_timeout(ndsfb_flip_wq, !tex_pend_bytes, HZ / 10);
 	if (tex_pend_bytes)
 		return -ETIMEDOUT;
+	if (!tex_stage && !(tex_stage = kmalloc(TEX_STAGE_BYTES, GFP_KERNEL)))
+		return -ENOMEM;
 	if (copy_from_user(tex_stage, (void __user *)t.data, t.bytes))
 		return -EFAULT;
 	tex_pend_off = t.offset;
