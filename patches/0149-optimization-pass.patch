diff --git a/linux-2.6.x/arch/arm/mach-nds/arm7/dsitouch.c b/linux-2.6.x/arch/arm/mach-nds/arm7/dsitouch.c
index dfeb69f25..95b32280e 100644
--- a/linux-2.6.x/arch/arm/mach-nds/arm7/dsitouch.c
+++ b/linux-2.6.x/arch/arm/mach-nds/arm7/dsitouch.c
@@ -187,11 +187,15 @@ int dsitouch_active(void)
 int dsitouch_pen_down(void)
 {
 	u8 status = cdc_read(CDC_TOUCHCNT, R_STATUS);
-	u8 pen = cdc_read(CDC_TOUCHCNT, R_PEN_DOWN);
-	int down = (status & 0xC0) != 0x40 && !(pen & 0x02);
+	u8 pen;
+	int down;
 
 	st_pen_calls++;
 	st_status = status;
+	if ((status & 0xC0) == 0x40)		/* not down, whatever the pen register says: one SPI read per frame instead of two */
+		return 0;
+	pen = cdc_read(CDC_TOUCHCNT, R_PEN_DOWN);
+	down = !(pen & 0x02);
 	st_penreg = pen;
 	if (down)
 		st_pen_true++;
diff --git a/linux-2.6.x/arch/arm/mach-nds/arm7/dsivol.c b/linux-2.6.x/arch/arm/mach-nds/arm7/dsivol.c
index 0b5c46d2e..e6187565c 100644
--- a/linux-2.6.x/arch/arm/mach-nds/arm7/dsivol.c
+++ b/linux-2.6.x/arch/arm/mach-nds/arm7/dsivol.c
@@ -207,10 +207,10 @@ void dsivol_poll(void)
 	static int count;
 	int v;
 
-	if (++count < 12)
+	if (++count < 24)		/* 2.5 times a second (was 5): an I2C read with deliberate delays each time */
 		return;
 	if (mic_running()) {		/* a recording is more important than the volume popup: the I2C read takes ms */
-		count = 11;
+		count = 23;	/* try again next frame */
 		return;
 	}
 	count = 0;
