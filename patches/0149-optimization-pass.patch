 			memset(fb, 0, sizeof(fb));
 			mbox_out(1, 1, WMI_SET_BSS_FILTER_CMD, fb, 8, &bad);
 		}
-		/* every 3 s: the firmware's failure state (host interest +0x04, non-zero after a crash in the chip) */
-		if (cur_hi && time_after(jiffies, health_at + 3 * HZ)) {
+		/* every 30 s: the firmware's failure state (host interest +0x04, non-zero after a crash in the chip) */
+		if (cur_hi && time_after(jiffies, health_at + 30 * HZ)) {	/* every 30 s (was 3 s: an SDIO read each time) */
 			unsigned int f = op(13, cur_hi + 0x04, 0, 0, 0, &bad);
 
 			health_at = jiffies;
diff --git a/linux-2.6.x/arch/arm/mach-nds/volume.c b/linux-2.6.x/arch/arm/mach-nds/volume.c
index e088562c8..426a84f0b 100644
--- a/linux-2.6.x/arch/arm/mach-nds/volume.c
+++ b/linux-2.6.x/arch/arm/mach-nds/volume.c
@@ -113,6 +113,10 @@ static int settings_read_proc(char *page, char **start, off_t off, int count, in
 	unsigned int o[3] = { 0xffffffff, 0xffffffff, 0xffffffff };
 	int len, bat, chg, vol, bl;
 
+	if (off > 0) {			/* the read after the line (end of file): no second ARM7 request (3 I2C reads) for nothing */
+		*eof = 1;
+		return 0;
+	}
 	if (dsisd_pm(0, 0, o) != 0)
 		o[0] = o[1] = o[2] = 0xffffffff;
 	bat = o[0] == 0xffffffff ? -1 : (int)(o[0] & 15);
diff --git a/linux-2.6.x/drivers/block/Makefile b/linux-2.6.x/drivers/block/Makefile
index 581783a9d..8ffa53b5a 100644
--- a/linux-2.6.x/drivers/block/Makefile
