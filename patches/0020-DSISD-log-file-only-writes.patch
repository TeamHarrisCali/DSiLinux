From 026bfc0f33c898b05ac8c213ab0defd604172c25 Mon Sep 17 00:00:00 2001
From: TeamHarrisCali <noreply@example.invalid>
Date: Tue, 10 Nov 2026 21:48:46 -0600
Subject: [PATCH] DSISD: write ONLY to the preallocated sd:/linux/DSILOG.TXT
 (ARM7 finds its sectors from the FAT32 and refuses all other writes);
 /dev/dsilog; /boot/savelog saves the boot log

---
 linux-2.6.x/arch/arm/mach-nds/Kconfig        |  15 +-
 linux-2.6.x/arch/arm/mach-nds/arm7/sdmmc.c   | 218 ++++++++++++++++++-
 linux-2.6.x/drivers/block/dldi_c.c           | 132 +++++++++++
 linux-2.6.x/include/asm-arm/arch-nds/dsisd.h |   4 +-
 vendors/Nintendo/DSI/Makefile                |   2 +
 vendors/Nintendo/DSI/config.linux-2.6.x      |   1 +
 vendors/Nintendo/DSI/rc                      |   2 +
 vendors/Nintendo/DSI/savelog                 |  19 ++
 vendors/Nintendo/DSI/selftest                |   1 +
 9 files changed, 390 insertions(+), 4 deletions(-)
 create mode 100644 vendors/Nintendo/DSI/savelog

diff --git a/linux-2.6.x/arch/arm/mach-nds/Kconfig b/linux-2.6.x/arch/arm/mach-nds/Kconfig
index 03dc93bbf..d15f94689 100644
--- a/linux-2.6.x/arch/arm/mach-nds/Kconfig
+++ b/linux-2.6.x/arch/arm/mach-nds/Kconfig
@@ -24,8 +24,21 @@ config NDS_DSISD
 	  flash cards, not the DSi's SD slot. Needs a DSi in DSi mode.
 	  If unsure, say N.
 
+config NDS_DSISD_LOGFILE
+	bool "Allow writing ONLY to the preallocated file sd:/linux/DSILOG.TXT (/dev/dsilog)"
+	depends on NDS_DSISD
+	default n
+	help
+	  The ARM7 reads the card's FAT32 itself at boot, finds sd:/linux/DSILOG.TXT and
+	  refuses every write that is not inside that file's sectors. The file never grows,
+	  so no directory entry or FAT entry is changed. Create the file (a multiple of 512
+	  bytes, e.g. 1 MiB of zeros, short name DSILOG.TXT) on a PC. /dev/dsilog
+	  (character device 241:0) writes into it. This is the only write this driver does.
+	  If unsure, say N.
+
 config NDS_DSISD_WRITE
-	bool "Allow writing to the DSi SD card"
+	bool "Allow writing to the DSi SD card (unused: no unrestricted write path exists)"
+
 	depends on NDS_DSISD
 	default n
 	help
diff --git a/linux-2.6.x/arch/arm/mach-nds/arm7/sdmmc.c b/linux-2.6.x/arch/arm/mach-nds/arm7/sdmmc.c
index 7788dacbc..050f5ed7b 100644
--- a/linux-2.6.x/arch/arm/mach-nds/arm7/sdmmc.c
+++ b/linux-2.6.x/arch/arm/mach-nds/arm7/sdmmc.c
@@ -509,6 +509,212 @@ static void wait_not_busy(void)
 }
 
 /* Handle one request block. The caller (main.c) sends the reply FIFO word. */
+#ifdef CONFIG_NDS_DSISD_LOGFILE
+/*
+ * The ONLY place this driver may write: the preallocated file sd:/linux/DSILOG.TXT.
+ * At LOGINIT the ARM7 reads the card's FAT32 itself (MBR, boot sector, root directory, "linux" folder, the file's
+ * directory entry, the file's cluster chain) and keeps the file's sector ranges ("extents") in g_ext_*. A write is
+ * only carried out if every sector of it lies inside those extents; everything else is refused. The file never
+ * grows, so no directory entry and no FAT entry is ever modified.
+ */
+#define NEXT 32
+static u32 g_ext_lba[NEXT];
+static u32 g_ext_cnt[NEXT];
+static u32 g_next;
+static u32 g_log_sectors;
+
+struct fatinfo {
+	u32 fat_lba;
+	u32 data_lba;
+	u32 spc;
+	u32 root;
+};
+
+static u32 le16(const u8 *p)
+{
+	return p[0] | (p[1] << 8);
+}
+
+static u32 le32(const u8 *p)
+{
+	return p[0] | (p[1] << 8) | (p[2] << 16) | ((u32)p[3] << 24);
+}
+
+static int rd1(u32 sector, u8 *buf)
+{
+	u32 a = (g_inited == 1) ? sector * 512 : sector;
+
+	return tmio_cmd(CMD_RESP_R1 | CMD_DATA_EN | CMD_DATA_R | SD_READ_SINGLE, a, 1, buf) ? -1 : 0;
+}
+
+static u32 clus_lba(const struct fatinfo *f, u32 c)
+{
+	return f->data_lba + (c - 2) * f->spc;
+}
+
+/* next cluster in the chain, or 0 at the end / on error */
+static u32 fat_next(const struct fatinfo *f, u32 c, u8 *tmp)
+{
+	u32 off = c * 4;
+
+	if (rd1(f->fat_lba + (off >> 9), tmp))
+		return 0;
+	c = le32(tmp + (off & 511)) & 0x0FFFFFFFu;
+	if (c < 2 || c >= 0x0FFFFFF0u)
+		return 0;
+	return c;
+}
+
+/* find the 11 byte short name in the directory that starts at cluster dc */
+static int dir_find(const struct fatinfo *f, u32 dc, const char *name, u32 *cl, u32 *attr, u32 *size,
+		    u8 *d, u8 *tmp)
+{
+	u32 c = dc;
+	u32 guard = 0;
+
+	while (c && guard++ < 4096) {
+		u32 s, i, k;
+
+		for (s = 0; s < f->spc; s++) {
+			if (rd1(clus_lba(f, c) + s, d))
+				return -1;
+			for (i = 0; i < 512; i += 32) {
+				const u8 *e = d + i;
+
+				if (e[0] == 0)
+					return -1;		/* end of directory */
+				if (e[0] == 0xE5 || (e[11] & 0x3F) == 0x0F)
+					continue;		/* deleted entry / long name part */
+				for (k = 0; k < 11; k++)
+					if (e[k] != (u8)name[k])
+						break;
+				if (k == 11) {
+					*cl = (le16(e + 20) << 16) | le16(e + 26);
+					*attr = e[11];
+					*size = le32(e + 28);
+					return 0;
+				}
+			}
+		}
+		c = fat_next(f, c, tmp);
+	}
+	return -1;
+}
+
+/* failing step, reported in info[2] with NDS_SD_ERR_NOLOG */
+#define LSTEP_MBR	1
+#define LSTEP_BPB	2
+#define LSTEP_LINUX	3
+#define LSTEP_FILE	4
+#define LSTEP_CHAIN	5
+
+static u32 log_init(struct nds_sd_block *b)
+{
+	u8 *d = b->data;		/* 2048 byte scratch: sector 0..511 = data, 512.. = FAT sector */
+	u8 *tmp = b->data + 512;
+	struct fatinfo f;
+	u32 part, rsv, nfat, fatsz, cl, attr, size, c, nsec, nclu, i, total;
+	u32 *o;
+
+	g_next = 0;
+	g_log_sectors = 0;
+	if (!g_inited)
+		return NDS_SD_ERR_NOINIT;
+
+	b->info[2] = LSTEP_MBR;
+	if (rd1(0, d) || d[510] != 0x55 || d[511] != 0xAA)
+		return NDS_SD_ERR_NOLOG;
+	part = le32(d + 0x1BE + 8);			/* first partition */
+
+	b->info[2] = LSTEP_BPB;
+	if (rd1(part, d) || d[510] != 0x55 || d[511] != 0xAA)
+		return NDS_SD_ERR_NOLOG;
+	if (le16(d + 11) != 512 || d[13] == 0 || (d[13] & (d[13] - 1)) || le16(d + 17) != 0)
+		return NDS_SD_ERR_NOLOG;		/* not 512 byte sectors / not FAT32 */
+	f.spc = d[13];
+	rsv = le16(d + 14);
+	nfat = d[16];
+	fatsz = le32(d + 36);
+	f.root = le32(d + 44);
+	f.fat_lba = part + rsv;
+	f.data_lba = f.fat_lba + nfat * fatsz;
+	if (f.root < 2 || fatsz == 0)
+		return NDS_SD_ERR_NOLOG;
+
+	b->info[2] = LSTEP_LINUX;
+	if (dir_find(&f, f.root, "LINUX      ", &cl, &attr, &size, d, tmp) || !(attr & 0x10) || cl < 2)
+		return NDS_SD_ERR_NOLOG;
+
+	b->info[2] = LSTEP_FILE;
+	if (dir_find(&f, cl, "DSILOG  TXT", &cl, &attr, &size, d, tmp) || (attr & 0x18) || cl < 2 || size < 512)
+		return NDS_SD_ERR_NOLOG;
+
+	b->info[2] = LSTEP_CHAIN;
+	nsec = size / 512;
+	nclu = (nsec + f.spc - 1) / f.spc;
+	c = cl;
+	for (i = 0; i < nclu && c; i++) {
+		u32 lba = clus_lba(&f, c);
+
+		if (g_next && g_ext_lba[g_next - 1] + g_ext_cnt[g_next - 1] == lba) {
+			g_ext_cnt[g_next - 1] += f.spc;
+		} else {
+			if (g_next == NEXT)
+				break;
+			g_ext_lba[g_next] = lba;
+			g_ext_cnt[g_next] = f.spc;
+			g_next++;
+		}
+		c = fat_next(&f, c, tmp);
+	}
+	total = 0;
+	for (i = 0; i < g_next; i++)
+		total += g_ext_cnt[i];
+	if (total > nsec) {			/* the last cluster is only partly used by the file */
+		g_ext_cnt[g_next - 1] -= total - nsec;
+		total = nsec;
+	}
+	if (g_next == 0 || total == 0) {
+		g_next = 0;
+		return NDS_SD_ERR_NOLOG;
+	}
+	g_log_sectors = total;
+
+	o = (u32 *)b->data;
+	o[0] = g_next;
+	o[1] = g_log_sectors;
+	for (i = 0; i < g_next; i++) {
+		o[2 + 2 * i] = g_ext_lba[i];
+		o[3 + 2 * i] = g_ext_cnt[i];
+	}
+	b->info[2] = 0;
+	return NDS_SD_OK;
+}
+
+/* every sector of [sector, sector + count) must lie inside the log file's extents */
+static int write_allowed(u32 sector, u32 count)
+{
+	u32 j, i;
+
+	if (!g_next)
+		return 0;
+	for (j = 0; j < count; j++) {
+		u32 s = sector + j;
+		int found = 0;
+
+		for (i = 0; i < g_next; i++) {
+			if (s >= g_ext_lba[i] && s - g_ext_lba[i] < g_ext_cnt[i]) {
+				found = 1;
+				break;
+			}
+		}
+		if (!found)
+			return 0;
+	}
+	return 1;
+}
+#endif /* CONFIG_NDS_DSISD_LOGFILE */
+
 static void nds_sd_request_inner(struct nds_sd_block *b)
 {
 	u32 res;
@@ -535,8 +741,10 @@ static void nds_sd_request_inner(struct nds_sd_block *b)
 			cmd = CMD_RESP_R1 | CMD_DATA_EN | CMD_DATA_R |
 				(b->count == 1 ? SD_READ_SINGLE : SD_READ_MULTI);
 		} else {
-#ifdef CONFIG_NDS_DSISD_WRITE
-			if (!(R32(SD_STATUS) & STATUS_NO_WRPROT)) {
+#ifdef CONFIG_NDS_DSISD_LOGFILE
+			/* the only write this driver does: inside the preallocated log file, and only with the write
+			 * protect slider open */
+			if (!(R32(SD_STATUS) & STATUS_NO_WRPROT) || !write_allowed(b->sector, b->count)) {
 				b->result = NDS_SD_ERR_WRPROT;
 				return;
 			}
@@ -583,6 +791,12 @@ static void nds_sd_request_inner(struct nds_sd_block *b)
 		}
 		return;
 
+#ifdef CONFIG_NDS_DSISD_LOGFILE
+	case NDS_SD_CMD_LOGINIT:
+		b->result = log_init(b);
+		return;
+#endif
+
 	case NDS_SD_CMD_LASTERR:
 		b->diag[0] = g_req_sector;
 		b->diag[1] = g_req_count | (g_req_cmd << 16);
diff --git a/linux-2.6.x/drivers/block/dldi_c.c b/linux-2.6.x/drivers/block/dldi_c.c
index d2c0d69a0..9ef225af8 100644
--- a/linux-2.6.x/drivers/block/dldi_c.c
+++ b/linux-2.6.x/drivers/block/dldi_c.c
@@ -29,6 +29,7 @@
 #include <asm/arch/fifo.h>
 #include <asm/arch/dsisd.h>
 #include <asm/semaphore.h>
+#include <asm/uaccess.h>
 #endif
 
 MODULE_LICENSE("GPL");
@@ -191,6 +192,134 @@ static void tdiag_fn(void *unused)
 #endif
 }
 
+#ifdef CONFIG_NDS_DSISD_LOGFILE
+/*
+ * /dev/dsilog: write-only access to the preallocated file sd:/linux/DSILOG.TXT. The ARM7 found the file's sector
+ * extents itself (NDS_SD_CMD_LOGINIT) and refuses every write outside them, so this is the only part of the card
+ * that can ever be written. Each open starts at the beginning of the file; the rest of the last sector is zero padded
+ * on close. The file never grows (no FAT or directory change).
+ */
+#define LOG_NEXT	32
+static u32 log_ext_lba[LOG_NEXT];
+static u32 log_ext_cnt[LOG_NEXT];
+static u32 log_next, log_sectors;
+static DECLARE_MUTEX(log_mutex);		/* one writer at a time, held from open to close */
+static u8 log_buf[SECTOR_SIZE];
+static u32 log_fill, log_sector;
+
+static int sd_write_sector(u32 lba, const u8 *src)
+{
+	int ret;
+
+	down(&sd_mutex);
+	memcpy(sd_block.data, src, SECTOR_SIZE);
+	ret = sd_request_locked(NDS_SD_CMD_WRITE, lba, 1);
+	up(&sd_mutex);
+	return ret;
+}
+
+/* file sector index -> card sector, or 0xffffffff if beyond the file */
+static u32 log_lba(u32 idx)
+{
+	u32 i;
+
+	for (i = 0; i < log_next; i++) {
+		if (idx < log_ext_cnt[i])
+			return log_ext_lba[i] + idx;
+		idx -= log_ext_cnt[i];
+	}
+	return 0xffffffffu;
+}
+
+static int log_flush(void)
+{
+	u32 lba = log_lba(log_sector);
+
+	if (!log_next || lba == 0xffffffffu)
+		return -ENOSPC;
+	if (sd_write_sector(lba, log_buf) != NDS_SD_OK)
+		return -EIO;
+	log_sector++;
+	log_fill = 0;
+	return 0;
+}
+
+static int dsilog_open(struct inode *inode, struct file *filp)
+{
+	if (!log_next)
+		return -ENODEV;			/* no DSILOG.TXT in sd:/linux */
+	if (down_trylock(&log_mutex))
+		return -EBUSY;
+	log_fill = 0;
+	log_sector = 0;
+	return 0;
+}
+
+static ssize_t dsilog_write(struct file *filp, const char __user *buf, size_t count, loff_t *ppos)
+{
+	size_t done = 0;
+
+	while (done < count) {
+		size_t n = SECTOR_SIZE - log_fill;
+		int ret;
+
+		if (n > count - done)
+			n = count - done;
+		if (copy_from_user(log_buf + log_fill, buf + done, n))
+			return done ? done : -EFAULT;
+		log_fill += n;
+		done += n;
+		if (log_fill == SECTOR_SIZE) {
+			ret = log_flush();
+			if (ret)
+				return done ? done : ret;
+		}
+	}
+	return done;
+}
+
+static int dsilog_release(struct inode *inode, struct file *filp)
+{
+	if (log_fill) {
+		memset(log_buf + log_fill, 0, SECTOR_SIZE - log_fill);
+		log_flush();
+	}
+	up(&log_mutex);
+	return 0;
+}
+
+static struct file_operations dsilog_fops = {
+	.owner = THIS_MODULE,
+	.open = dsilog_open,
+	.write = dsilog_write,
+	.release = dsilog_release,
+};
+
+static void dsisd_log_setup(void)
+{
+	int ret = sd_request(NDS_SD_CMD_LOGINIT, 0, 0);
+
+	if (ret == NDS_SD_OK) {
+		const u32 *o = (const u32 *)sd_block.data;
+		u32 i;
+
+		log_next = o[0] > LOG_NEXT ? LOG_NEXT : o[0];
+		log_sectors = o[1];
+		for (i = 0; i < log_next; i++) {
+			log_ext_lba[i] = o[2 + 2 * i];
+			log_ext_cnt[i] = o[3 + 2 * i];
+		}
+		printk(KERN_INFO "dsisd: log file sd:/linux/DSILOG.TXT: %u sectors in %u extents, first at %u\n",
+		       log_sectors, log_next, log_next ? log_ext_lba[0] : 0);
+	} else {
+		printk(KERN_INFO "dsisd: no log file (sd:/linux/DSILOG.TXT): result %d step %u\n",
+		       ret, sd_block.info[2]);
+	}
+	if (register_chrdev(241, "dsilog", &dsilog_fops))
+		printk(KERN_WARNING "dsisd: cannot register /dev/dsilog (char major 241)\n");
+}
+#endif /* CONFIG_NDS_DSISD_LOGFILE */
+
 static int dsisd_start(void)
 {
 	int ret;
@@ -214,6 +343,9 @@ static int dsisd_start(void)
 	if (ret != NDS_SD_OK)
 		return -EIO;
 	nsectors = sd_block.sectors;
+#ifdef CONFIG_NDS_DSISD_LOGFILE
+	dsisd_log_setup();
+#endif
 	return 0;
 }
 
diff --git a/linux-2.6.x/include/asm-arm/arch-nds/dsisd.h b/linux-2.6.x/include/asm-arm/arch-nds/dsisd.h
index db3e2dbf7..6ad068cb8 100644
--- a/linux-2.6.x/include/asm-arm/arch-nds/dsisd.h
+++ b/linux-2.6.x/include/asm-arm/arch-nds/dsisd.h
@@ -19,6 +19,7 @@
 #define NDS_SD_CMD_INIT		0
 #define NDS_SD_CMD_READ		1
 #define NDS_SD_CMD_WRITE	2
+#define NDS_SD_CMD_LOGINIT	5	/* not SD I/O: locate sd:/linux/DSILOG.TXT, answer with its sector extents in data[] */
 #define NDS_SD_CMD_LASTERR	4	/* not SD: report what the last request was doing (diag[]) */
 #define NDS_SD_CMD_TOUCHDIAG	3	/* not SD: fetch the DSi touch reader's counters into touch[] */
 
@@ -29,7 +30,8 @@
 #define NDS_SD_ERR_INIT		3	/* card init failed, info[3] has the step */
 #define NDS_SD_ERR_RW		4	/* command failed, info[3] has TMIO status */
 #define NDS_SD_ERR_NOINIT	5
-#define NDS_SD_ERR_WRPROT	6	/* write refused (read-only build/slider) */
+#define NDS_SD_ERR_WRPROT	6	/* write refused (read-only build/slider, or outside the log file) */
+#define NDS_SD_ERR_NOLOG	7	/* LOGINIT: log file not found/usable, info[2] = step (see sdmmc.c) */
 
 struct nds_sd_block {
 	unsigned int cmd;
