diff --git a/user/microwin/src/demos/nanox/dsgb_apu.h b/user/microwin/src/demos/nanox/dsgb_apu.h
new file mode 100644
index 000000000..5db3fd201
--- /dev/null
+++ b/user/microwin/src/demos/nanox/dsgb_apu.h
@@ -0,0 +1,315 @@
+/*
+ * dsgb_apu.h - a small Game Boy sound chip for dsgb (own code, integer maths only, mono, free running like minigb_apu: the registers are
+ * written by the game through audio_write(), and apu_mix() makes the samples for the time that has passed). Four channels: two squares
+ * (the first with sweep), the wave channel and noise; length counters, envelopes and the 512 Hz frame sequencer are there, the oddities of
+ * the real chip (zombie mode, obscure trigger behaviour) are not.
+ */
+#ifndef DSGB_APU_H
+#define DSGB_APU_H
+
+#include <stdint.h>
+#include <string.h>
+
+#define APU_RATE	16000			/* output samples per second */
+#define APU_CPS		262			/* Game Boy cycles per output sample (4194304 / 16000 = 262.1) */
+
+struct apu_sq {
+	int on, dac, timer, pos, vol, env_dir, env_period, env_cnt, len, len_en, freq, duty;
+	int sweep_en, sweep_period, sweep_cnt, sweep_shadow, sweep_shift, sweep_neg;
+};
+
+static struct {
+	uint8_t r[0x30];			/* 0xFF10 .. 0xFF3F as written */
+	struct apu_sq sq[2];
+	struct { int on, dac, timer, pos, len, len_en, freq, vol; } wave;
+	struct { int on, dac, timer, vol, env_dir, env_period, env_cnt, len, len_en, lfsr, width7, shift, div; } noise;
+	int power, fs_acc, fs_step, hp_x, hp_y;
+} apu;
+
+uint8_t audio_read(uint16_t addr);
+void audio_write(uint16_t addr, uint8_t val);
+
+static const uint8_t apu_duty[4] = { 0x01, 0x81, 0x87, 0x7E };
+static const uint8_t apu_ortab[0x30] = {
+	0x80, 0x3f, 0x00, 0xff, 0xbf, 0xff, 0x3f, 0x00, 0xff, 0xbf, 0x7f, 0xff, 0x9f, 0xff, 0xbf, 0xff,
+	0xff, 0x00, 0x00, 0xbf, 0x00, 0x00, 0x70, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
+	0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00
+};
+
+static void apu_reset_channels(void)
+{
+	memset(&apu.sq, 0, sizeof(apu.sq));
+	memset(&apu.wave, 0, sizeof(apu.wave));
+	memset(&apu.noise, 0, sizeof(apu.noise));
+	apu.noise.lfsr = 0x7fff;
+}
+
+static void apu_init(void)
+{
+	memset(&apu, 0, sizeof(apu));
+	apu_reset_channels();
+	apu.power = 1;
+	audio_write(0xFF26, 0xF1);
+	audio_write(0xFF24, 0x77);
+	audio_write(0xFF25, 0xF3);
+	apu.r[0x01] = 0xBF;
+	apu.r[0x02] = 0xF3;
+}
+
+static int apu_sweep_calc(struct apu_sq *c)
+{
+	int d = c->sweep_shadow >> c->sweep_shift, n = c->sweep_neg ? c->sweep_shadow - d : c->sweep_shadow + d;
+
+	if (n > 2047)
+		c->on = 0;
+	return n;
+}
+
+static void apu_trigger_sq(int i)
+{
+	struct apu_sq *c = &apu.sq[i];
+	const uint8_t *r = &apu.r[i * 6];		/* NR10.. or NR21.. (NR20 does not exist: index 5 is NR20, so channel 2 starts at 6) */
+
+	c->dac = (r[2] & 0xF8) != 0;
+	c->on = c->dac;
+	if (c->len == 0)
+		c->len = 64;
+	c->timer = (2048 - c->freq) * 4;
+	c->vol = r[2] >> 4;
+	c->env_dir = (r[2] >> 3) & 1;
+	c->env_period = r[2] & 7;
+	c->env_cnt = c->env_period ? c->env_period : 8;
+	if (i == 0) {
+		c->sweep_shadow = c->freq;
+		c->sweep_period = (r[0] >> 4) & 7;
+		c->sweep_shift = r[0] & 7;
+		c->sweep_neg = (r[0] >> 3) & 1;
+		c->sweep_cnt = c->sweep_period ? c->sweep_period : 8;
+		c->sweep_en = c->sweep_period || c->sweep_shift;
+		if (c->sweep_shift)
+			apu_sweep_calc(c);
+	}
+}
+
+void audio_write(uint16_t addr, uint8_t val)
+{
+	int i = addr - 0xFF10;
+
+	if (addr >= 0xFF30) {			/* wave RAM */
+		apu.r[i] = val;
+		return;
+	}
+	if (addr == 0xFF26) {
+		int was = apu.power;
+
+		apu.power = (val & 0x80) != 0;
+		if (was && !apu.power) {
+			memset(apu.r, 0, 0x20);
+			apu_reset_channels();
+		}
+		apu.r[0x16] = val & 0x80;
+		return;
+	}
+	if (!apu.power)
+		return;
+	apu.r[i] = val;
+	switch (addr) {
+	case 0xFF11: apu.sq[0].duty = val >> 6; apu.sq[0].len = 64 - (val & 63); break;
+	case 0xFF16: apu.sq[1].duty = val >> 6; apu.sq[1].len = 64 - (val & 63); break;
+	case 0xFF12: if ((val & 0xF8) == 0) { apu.sq[0].on = 0; apu.sq[0].dac = 0; } break;
+	case 0xFF17: if ((val & 0xF8) == 0) { apu.sq[1].on = 0; apu.sq[1].dac = 0; } break;
+	case 0xFF13: apu.sq[0].freq = (apu.sq[0].freq & 0x700) | val; break;
+	case 0xFF18: apu.sq[1].freq = (apu.sq[1].freq & 0x700) | val; break;
+	case 0xFF14:
+		apu.sq[0].freq = (apu.sq[0].freq & 0xFF) | ((val & 7) << 8);
+		apu.sq[0].len_en = (val >> 6) & 1;
+		if (val & 0x80) apu_trigger_sq(0);
+		break;
+	case 0xFF19:
+		apu.sq[1].freq = (apu.sq[1].freq & 0xFF) | ((val & 7) << 8);
+		apu.sq[1].len_en = (val >> 6) & 1;
+		if (val & 0x80) apu_trigger_sq(1);
+		break;
+	case 0xFF1A: apu.wave.dac = val >> 7; if (!apu.wave.dac) apu.wave.on = 0; break;
+	case 0xFF1B: apu.wave.len = 256 - val; break;
+	case 0xFF1C: apu.wave.vol = (val >> 5) & 3; break;
+	case 0xFF1D: apu.wave.freq = (apu.wave.freq & 0x700) | val; break;
+	case 0xFF1E:
+		apu.wave.freq = (apu.wave.freq & 0xFF) | ((val & 7) << 8);
+		apu.wave.len_en = (val >> 6) & 1;
+		if (val & 0x80) {
+			apu.wave.on = apu.wave.dac;
+			if (apu.wave.len == 0) apu.wave.len = 256;
+			apu.wave.timer = (2048 - apu.wave.freq) * 2;
+			apu.wave.pos = 0;
+		}
+		break;
+	case 0xFF20: apu.noise.len = 64 - (val & 63); break;
+	case 0xFF21: if ((val & 0xF8) == 0) { apu.noise.on = 0; apu.noise.dac = 0; } break;
+	case 0xFF22:
+		apu.noise.shift = val >> 4;
+		apu.noise.width7 = (val >> 3) & 1;
+		apu.noise.div = (val & 7) ? (val & 7) * 16 : 8;
+		break;
+	case 0xFF23:
+		apu.noise.len_en = (val >> 6) & 1;
+		if (val & 0x80) {
+			uint8_t e = apu.r[0x11];
+
+			apu.noise.dac = (e & 0xF8) != 0;
+			apu.noise.on = apu.noise.dac;
+			if (apu.noise.len == 0) apu.noise.len = 64;
+			apu.noise.vol = e >> 4;
+			apu.noise.env_dir = (e >> 3) & 1;
+			apu.noise.env_period = e & 7;
+			apu.noise.env_cnt = apu.noise.env_period ? apu.noise.env_period : 8;
+			apu.noise.lfsr = 0x7fff;
+			apu.noise.timer = apu.noise.div << apu.noise.shift;
+		}
+		break;
+	}
+}
+
+uint8_t audio_read(uint16_t addr)
+{
+	int i = addr - 0xFF10;
+
+	if (addr == 0xFF26)
+		return 0x70 | (apu.power ? 0x80 : 0) | apu.sq[0].on | (apu.sq[1].on << 1) | (apu.wave.on << 2) | (apu.noise.on << 3);
+	if (addr >= 0xFF30)
+		return apu.r[i];
+	return apu.r[i] | apu_ortab[i];
+}
+
+/* the 512 Hz frame sequencer: length (256 Hz), sweep (128 Hz), envelope (64 Hz) */
+static void apu_sequencer_step(int step)
+{
+	int i;
+
+	if (!(step & 1)) {
+		for (i = 0; i < 2; i++)
+			if (apu.sq[i].len_en && apu.sq[i].len > 0 && --apu.sq[i].len == 0)
+				apu.sq[i].on = 0;
+		if (apu.wave.len_en && apu.wave.len > 0 && --apu.wave.len == 0)
+			apu.wave.on = 0;
+		if (apu.noise.len_en && apu.noise.len > 0 && --apu.noise.len == 0)
+			apu.noise.on = 0;
+	}
+	if (step == 2 || step == 6) {
+		struct apu_sq *c = &apu.sq[0];
+
+		if (c->sweep_en && c->sweep_period && --c->sweep_cnt == 0) {
+			int n;
+
+			c->sweep_cnt = c->sweep_period ? c->sweep_period : 8;
+			n = apu_sweep_calc(c);
+			if (n <= 2047 && c->sweep_shift) {
+				c->sweep_shadow = c->freq = n;
+				apu.r[0x03] = n & 0xFF;
+				apu.r[0x04] = (apu.r[0x04] & ~7) | (n >> 8);
+				apu_sweep_calc(c);
+			}
+		}
+	}
+	if (step == 7) {
+		for (i = 0; i < 2; i++) {
+			struct apu_sq *c = &apu.sq[i];
+
+			if (c->env_period && --c->env_cnt == 0) {
+				c->env_cnt = c->env_period;
+				if (c->env_dir && c->vol < 15) c->vol++;
+				else if (!c->env_dir && c->vol > 0) c->vol--;
+			}
+		}
+		if (apu.noise.env_period && --apu.noise.env_cnt == 0) {
+			apu.noise.env_cnt = apu.noise.env_period;
+			if (apu.noise.env_dir && apu.noise.vol < 15) apu.noise.vol++;
+			else if (!apu.noise.env_dir && apu.noise.vol > 0) apu.noise.vol--;
+		}
+	}
+}
+
+/* n samples of mono 16 bit sound at APU_RATE */
+static void apu_mix(int16_t *out, int n)
+{
+	static const uint8_t wshift[4] = { 4, 0, 1, 2 };
+	int k;
+
+	for (k = 0; k < n; k++) {
+		int v[4] = { 0, 0, 0, 0 }, i, sl = 0, sr = 0, x, y;
+		uint8_t nr51 = apu.r[0x15], nr50 = apu.r[0x14];
+
+		apu.fs_acc += APU_CPS;
+		while (apu.fs_acc >= 8192) {
+			apu.fs_acc -= 8192;
+			apu_sequencer_step(apu.fs_step);
+			apu.fs_step = (apu.fs_step + 1) & 7;
+		}
+		for (i = 0; i < 2; i++) {
+			struct apu_sq *c = &apu.sq[i];
+			int period = (2048 - c->freq) * 4;
+
+			c->timer -= APU_CPS;
+			if (c->timer <= 0) {
+				if (period <= 0)
+					period = 4;
+				c->timer += period;
+				c->pos = (c->pos + 1) & 7;
+				if (c->timer <= 0) {			/* high notes: several steps in one sample */
+					int steps = 1 - c->timer / period;
+
+					c->timer += steps * period;
+					c->pos = (c->pos + steps) & 7;
+				}
+			}
+			if (c->on)
+				v[i] = ((apu_duty[c->duty] >> (7 - c->pos)) & 1) ? c->vol : 0;
+		}
+		if (apu.wave.on) {
+			int period = (2048 - apu.wave.freq) * 2, b;
+
+			apu.wave.timer -= APU_CPS;
+			if (apu.wave.timer <= 0) {
+				int steps;
+
+				if (period <= 0)
+					period = 2;
+				steps = 1 + (-apu.wave.timer) / period;
+				apu.wave.timer += steps * period;
+				apu.wave.pos = (apu.wave.pos + steps) & 31;
+			}
+			b = apu.r[0x20 + (apu.wave.pos >> 1)];
+			b = (apu.wave.pos & 1) ? (b & 15) : (b >> 4);
+			v[2] = b >> wshift[apu.wave.vol];
+		}
+		if (apu.noise.on) {
+			int period = apu.noise.div << apu.noise.shift, guard = 0;
+
+			if (period < 8)
+				period = 8;
+			apu.noise.timer -= APU_CPS;
+			while (apu.noise.timer <= 0 && guard++ < 24) {
+				int xr = (apu.noise.lfsr ^ (apu.noise.lfsr >> 1)) & 1;
+
+				apu.noise.timer += period;
+				apu.noise.lfsr = (apu.noise.lfsr >> 1) | (xr << 14);
+				if (apu.noise.width7)
+					apu.noise.lfsr = (apu.noise.lfsr & ~0x40) | (xr << 6);
+			}
+			if (apu.noise.timer <= 0)
+				apu.noise.timer = period;
+			v[3] = (apu.noise.lfsr & 1) ? 0 : apu.noise.vol;
+		}
+		for (i = 0; i < 4; i++) {
+			if (nr51 & (0x10 << i)) sl += v[i];
+			if (nr51 & (1 << i)) sr += v[i];
+		}
+		x = (sl * (((nr50 >> 4) & 7) + 1) + sr * ((nr50 & 7) + 1)) * 20;
+		y = x - apu.hp_x + ((apu.hp_y * 252) >> 8);		/* takes out the constant part (and the pop of a channel starting) */
+		apu.hp_x = x;
+		apu.hp_y = y;
+		out[k] = (int16_t)(y > 32767 ? 32767 : (y < -32768 ? -32768 : y));
+	}
+}
