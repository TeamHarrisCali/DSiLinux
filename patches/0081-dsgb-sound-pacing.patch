  * place is read when the window manager says something moved. A pointer drawn by the hardware sprite is not in the way.
  */
 #define NDSFB_VSYNC	0x4e07
+#define NDSFB_VBLCOUNT	0x4e0c
+
+/* OSS: 16 bit mono at APU_RATE; blocks when the sound buffer is full, which is fine (the game is paced by the screen anyway) */
+#define SNDCTL_DSP_SPEED	0xC0045002
+#define SNDCTL_DSP_SETFMT	0xC0045005
+#define SNDCTL_DSP_CHANNELS	0xC0045006
+#define AFMT_S16_LE_	0x10
+
+static int sound_open(void)
+{
+	int fd = open("/dev/dsp", O_WRONLY), fmt = AFMT_S16_LE_, ch = 1, rate = APU_RATE;
+
+	if (fd < 0) {
+		fprintf(stderr, "dsgb: no sound (/dev/dsp: %d)\n", errno);
+		return -1;
+	}
+	if (ioctl(fd, SNDCTL_DSP_SETFMT, &fmt) < 0 || ioctl(fd, SNDCTL_DSP_CHANNELS, &ch) < 0 || ioctl(fd, SNDCTL_DSP_SPEED, &rate) < 0) {
+		fprintf(stderr, "dsgb: /dev/dsp refused the format\n");
+		close(fd);
+		return -1;
+	}
+	fprintf(stderr, "dsgb: sound at %d Hz (asked %d)\n", rate, APU_RATE);
+	return fd;
+}
 
