+/*
+ * DSi internal SD card: instead of calling the DLDI driver on the ARM9, ask
+ * the ARM7 (which owns the SD controller) through a shared request block.
+ */
+static struct nds_sd_block sd_block;	/* 32 byte aligned, see dsisd.h */
+static DECLARE_WAIT_QUEUE_HEAD(sd_wait);
+static volatile int sd_done;
+static int dldi_xfer_err;
+
+static void sd_fifo_cb(u8 cmd)
+{
+	if (cmd == FIFO_FIRMWARE_CMD_SD_REQUEST) {
+		sd_done = 1;
+		wake_up(&sd_wait);
+	}
+}
+
+static struct fifo_cb sd_cb = {
+	.type = FIFO_FIRMWARE,
+	.handler.firmware_handler = sd_fifo_cb
+};
+
+/* Returns the ARM7's result code (0 = ok), or -1 if it did not answer. */
+static int sd_request(unsigned int cmd, unsigned int sector, unsigned int count)
+{
+	sd_block.cmd = cmd;
+	sd_block.sector = sector;
+	sd_block.count = count;
+	sd_block.result = 0xffffffff;
+	sd_done = 0;
+	/* write back our data, and drop stale lines so we see the ARM7's data */
+	dmac_flush_range((unsigned long)&sd_block,
+			 (unsigned long)&sd_block + sizeof(sd_block));
+	nds_fifo_send(FIFO_FIRMWARE_CMD(FIFO_FIRMWARE_CMD_SD_REQUEST, 0));
+	if (!wait_event_timeout(sd_wait, sd_done, 10 * HZ)) {
+		printk(KERN_ERR "dsisd: ARM7 did not answer (cmd %u)\n", cmd);
+		return -1;
+	}
+	dmac_flush_range((unsigned long)&sd_block,
+			 (unsigned long)&sd_block + sizeof(sd_block));
+	return (int)sd_block.result;
+}
+
+static int dsisd_start(void)
+{
+	int ret;
+
+	register_fifocb(&sd_cb);
+	nds_fifo_send(FIFO_FIRMWARE_CMD(FIFO_FIRMWARE_CMD_SD_ADDRESS,
+					(u32)&sd_block));
+	ret = sd_request(NDS_SD_CMD_INIT, 0, 0);
+	printk(KERN_INFO "dsisd: init result %d, SCFG_EXT %08x, TMIO rev %04x, "
+	       "info %08x, sectors %u\n", ret, sd_block.info[0],
+	       sd_block.info[1], sd_block.info[2], sd_block.sectors);
+	if (ret != NDS_SD_OK)
+		return -EIO;
+	nsectors = sd_block.sectors;
+	return 0;
+}
+
+static void dsisd_transfer(unsigned long sector, unsigned long nsect,
+			   char *buffer, int write)
+{
+	while (nsect > 0) {
+		unsigned int n = nsect;
+		int ret;
+
+		if (n > NDS_SD_MAX_SECTORS)
+			n = NDS_SD_MAX_SECTORS;
+		if (write)
+			memcpy(sd_block.data, buffer, n * SECTOR_SIZE);
+		ret = sd_request(write ? NDS_SD_CMD_WRITE : NDS_SD_CMD_READ,
+				 sector, n);
+		if (ret != NDS_SD_OK) {
+			printk(KERN_ERR "dsisd: %s sector %lu x%u failed: "
+			       "result %d, TMIO status %08x\n",
+			       write ? "write" : "read", sector, n, ret,
+			       sd_block.info[0]);
+			dldi_xfer_err = 1;
+			return;
+		}
+		if (!write)
+			memcpy(buffer, sd_block.data, n * SECTOR_SIZE);
+		sector += n;
+		nsect -= n;
+		buffer += n * SECTOR_SIZE;
+	}
+}
+#endif
