From a5362618244c258f423e39b5be2d4afb9a1bcc86 Mon Sep 17 00:00:00 2001
From: TeamHarrisCali <noreply@example.invalid>
Date: Tue, 10 Nov 2026 18:18:33 -0600
Subject: [PATCH] nds: DSi internal SD card via the ARM7 (CONFIG_NDS_DSISD),
 read-only by default

ARM7: polling SD-card driver derived from profi200/dsi_sdmmc (MIT), reached through a
shared request block and two new commands on the FIFO_FIRMWARE channel. ARM9: the DLDI
block device (/dev/dldi) gets a DSISD backend instead of calling the DLDI blob.
Writes are compiled out unless CONFIG_NDS_DSISD_WRITE. ARM7 IRQ stack 256 B -> 1 KB.
---
 linux-2.6.x/arch/arm/mach-nds/Kconfig        |  20 +
 linux-2.6.x/arch/arm/mach-nds/Makefile       |   3 +-
 linux-2.6.x/arch/arm/mach-nds/arm7/arm7.lds  |   2 +-
 linux-2.6.x/arch/arm/mach-nds/arm7/main.c    |  14 +
 linux-2.6.x/arch/arm/mach-nds/arm7/sdmmc.c   | 501 +++++++++++++++++++
 linux-2.6.x/arch/arm/mach-nds/arm7/sdmmc.h   |   9 +
 linux-2.6.x/drivers/block/dldi_c.c           | 115 +++++
 linux-2.6.x/include/asm-arm/arch-nds/dsisd.h |  45 ++
 linux-2.6.x/include/asm-arm/arch-nds/fifo.h  |   8 +-
 vendors/Nintendo/DSI/config.linux-2.6.x      |   2 +
 10 files changed, 716 insertions(+), 3 deletions(-)
 create mode 100644 linux-2.6.x/arch/arm/mach-nds/arm7/sdmmc.c
 create mode 100644 linux-2.6.x/arch/arm/mach-nds/arm7/sdmmc.h
 create mode 100644 linux-2.6.x/include/asm-arm/arch-nds/dsisd.h

diff --git a/linux-2.6.x/arch/arm/mach-nds/Kconfig b/linux-2.6.x/arch/arm/mach-nds/Kconfig
index d1352fbe7..097f1eccb 100644
--- a/linux-2.6.x/arch/arm/mach-nds/Kconfig
+++ b/linux-2.6.x/arch/arm/mach-nds/Kconfig
@@ -14,6 +14,26 @@ config NDS_DSI
 	  A kernel built this way does NOT boot on a DS or a DSi in DS mode.
 	  If unsure, say N.
 
+config NDS_DSISD
+	bool "DSi internal SD card (replaces the DLDI card driver)"
+	depends on ARCH_NDS && NDS_DSI && NDS_DLDI
+	default n
+	help
+	  Use the DSi's internal SD slot, through the ARM7, as the DLDI block
+	  device (/dev/dldi). The stock DLDI driver in the .nds only supports
+	  flash cards, not the DSi's SD slot. Needs a DSi in DSi mode.
+	  If unsure, say N.
+
+config NDS_DSISD_WRITE
+	bool "Allow writing to the DSi SD card"
+	depends on NDS_DSISD
+	default n
+	help
+	  Without this the card is read-only (writes fail with an I/O error),
+	  which is the safe default while the driver is young. A bug in a
+	  write path can corrupt the card's FAT, so use a spare or backed-up
+	  card when you say Y.
+
 config NDS_TEXT_CONSOLE
 	bool "Nintendo DS text console"
 	depends on ARCH_NDS
