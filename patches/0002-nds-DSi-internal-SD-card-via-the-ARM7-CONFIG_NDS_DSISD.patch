diff --git a/linux-2.6.x/include/asm-arm/arch-nds/dsisd.h b/linux-2.6.x/include/asm-arm/arch-nds/dsisd.h
new file mode 100644
index 000000000..9d7eea553
--- /dev/null
+++ b/linux-2.6.x/include/asm-arm/arch-nds/dsisd.h
@@ -0,0 +1,45 @@
+/*
+ * include/asm-arm/arch-nds/dsisd.h
+ *
+ * Shared ARM9 <-> ARM7 request block for the Nintendo DSi internal SD card.
+ * The ARM7 owns the SD/MMC controller (TMIO at 0x04004800); the ARM9 kernel
+ * driver (drivers/block/dldi_c.c with CONFIG_NDS_DSISD) fills in this block,
+ * flushes its data cache and sends FIFO_FIRMWARE_CMD_SD_REQUEST; the ARM7
+ * answers with the same command after it has written the result.
+ *
+ * The block is 32 byte aligned and a multiple of 32 bytes so that the ARM9
+ * can flush/invalidate it without touching neighbouring data.
+ */
+#ifndef __ASM_ARCH_DSISD_H
+#define __ASM_ARCH_DSISD_H
+
+#define NDS_SD_SECTOR_SIZE	512
+#define NDS_SD_MAX_SECTORS	4	/* sectors per request (2048 bytes) */
+
+#define NDS_SD_CMD_INIT		0
+#define NDS_SD_CMD_READ		1
+#define NDS_SD_CMD_WRITE	2
+
+/* result codes, 0 = success */
+#define NDS_SD_OK		0
+#define NDS_SD_ERR_PARAM	1
+#define NDS_SD_ERR_NOCARD	2	/* controller not reachable or no card */
+#define NDS_SD_ERR_INIT		3	/* card init failed, info[3] has the step */
+#define NDS_SD_ERR_RW		4	/* command failed, info[3] has TMIO status */
+#define NDS_SD_ERR_NOINIT	5
+#define NDS_SD_ERR_WRPROT	6	/* write refused (read-only build/slider) */
+
+struct nds_sd_block {
+	unsigned int cmd;
+	unsigned int sector;
+	unsigned int count;
+	unsigned int result;
+	unsigned int sectors;	/* INIT: card capacity in 512 byte sectors */
+	unsigned int info[3];	/* INIT: [0] SCFG_EXT [1] TMIO revision reg
+				 *       [2] card type, 1=SDSC 2=SDHC
+				 * (on error info[2] = failing step, see sdmmc.c)
+				 * ERR_RW: [0] TMIO status bits */
+	unsigned char data[NDS_SD_MAX_SECTORS * NDS_SD_SECTOR_SIZE];
+} __attribute__((aligned(32)));
+
+#endif
diff --git a/linux-2.6.x/include/asm-arm/arch-nds/fifo.h b/linux-2.6.x/include/asm-arm/arch-nds/fifo.h
index e0aa5d6e1..07173397d 100644
--- a/linux-2.6.x/include/asm-arm/arch-nds/fifo.h
+++ b/linux-2.6.x/include/asm-arm/arch-nds/fifo.h
@@ -72,7 +72,13 @@ enum FIFO_POWER_CMDS {
 
 enum FIFO_FIRMWARE_CMDS {
 	FIFO_FIRMWARE_CMD_BUFFER_ADDRESS,
-	FIFO_FIRMWARE_CMD_READ
+	FIFO_FIRMWARE_CMD_READ,
+	/* DSi internal SD card (see asm/arch/dsisd.h). All 8 FIFO types are
+	 * taken, so these share the firmware type with distinct commands.
+	 * ARM9 -> ARM7: SD_ADDRESS carries the request block address, SD_REQUEST
+	 * starts it. ARM7 -> ARM9: SD_REQUEST means "block has been processed". */
+	FIFO_FIRMWARE_CMD_SD_ADDRESS,
+	FIFO_FIRMWARE_CMD_SD_REQUEST
 };
 	
