 {
@@ -115,7 +118,7 @@ static int settings_read_proc(char *page, char **start, off_t off, int count, in
 
 static int settings_write_proc(struct file *file, const char __user *buffer, unsigned long count, void *data)
 {
-	char buf[32];
+	char buf[48];
 	unsigned int o[3];
 	unsigned long n;
 
@@ -129,6 +132,21 @@ static int settings_write_proc(struct file *file, const char __user *buffer, uns
 		if (n < 1 || n > 5)
 			return -EINVAL;
 		dsisd_pm(1, n - 1, o);
+	} else if (!strncmp(buf, "rtc ", 4)) {
+		unsigned int y, mo, d, wd, h, mi, s;
+		unsigned char v[7];
+
+		if (sscanf(buf + 4, "%u %u %u %u %u %u %u", &y, &mo, &d, &wd, &h, &mi, &s) != 7 || y < 2000 || y > 2099)
+			return -EINVAL;
+		v[0] = y - 2000;
+		v[1] = mo;
+		v[2] = d;
+		v[3] = wd;
+		v[4] = h;
+		v[5] = mi;
+		v[6] = s;
+		if (dsisd_rtc(v, NULL) != 0)
+			return -EIO;
 	} else if (!strncmp(buf, "padgain ", 8)) {
 		n = simple_strtoul(buf + 8, NULL, 10);
 		if (n < 1 || n > 8)
diff --git a/linux-2.6.x/drivers/block/dldi_c.c b/linux-2.6.x/drivers/block/dldi_c.c
index c2226a3b3..106f62610 100644
--- a/linux-2.6.x/drivers/block/dldi_c.c
+++ b/linux-2.6.x/drivers/block/dldi_c.c
@@ -331,6 +331,23 @@ int dsisd_twlop_rx(unsigned int op, unsigned int addr, unsigned int arg, const u
 	return ret;
 }
 
+/* The RTC: with v (7 numbers: year 0..99, month, day, weekday 0..6, hour 0..23, minute, second) set it; out[0..7] = status register 1
+ * and the chip's 7 date/time bytes (BCD) as read afterwards. 0 = ok. */
+int dsisd_rtc(const unsigned char *v, unsigned char *out)
+{
+	int ret, i;
+
+	down(&sd_mutex);
+	for (i = 0; i < 8; i++)
+		sd_block.data[i] = v && i < 7 ? v[i] : 0;
+	ret = sd_request_locked(NDS_SD_CMD_RTC, 0, v ? 1 : 0);
+	if (ret == NDS_SD_OK && out)
+		for (i = 0; i < 8; i++)
+			out[i] = sd_block.data[i];
+	up(&sd_mutex);
+	return ret;
+}
+
 /* Power chip status (and the backlight): op 1 sets the backlight register to val (0..4). out[0] battery register, out[1] volume register,
  * out[2] backlight register (0xffffffff = unreadable). 0 = ok. */
 int dsisd_pm(unsigned int op, unsigned int val, unsigned int *out)
