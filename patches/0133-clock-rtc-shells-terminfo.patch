diff --git a/linux-2.6.x/arch/arm/mach-nds/arm7/sdmmc.c b/linux-2.6.x/arch/arm/mach-nds/arm7/sdmmc.c
index 5f092037d..abf332601 100644
--- a/linux-2.6.x/arch/arm/mach-nds/arm7/sdmmc.c
+++ b/linux-2.6.x/arch/arm/mach-nds/arm7/sdmmc.c
@@ -765,6 +765,107 @@ static int region_ok(u32 sector, u32 count)
 
 extern void dsi_poweroff_diag(volatile unsigned int *diag);
 
+/*
+ * The RTC (date and time), for NDS_SD_CMD_RTC. The same serial protocol as arm7/time.c's rtcTransaction (the command byte goes most
+ * significant bit first, data least significant bit first), but with a busy loop instead of swiDelay: SD requests run in the ARM7's
+ * interrupt handler, where a BIOS call lost the context before (twlwifi.c's rtc_write2 does the same).
+ */
+#define RTC_CR8_REG	0x04000138
+#define RTC_CS0		(1 << 6)
+#define RTC_CS1		((1 << 6) | (1 << 2))
+#define RTC_SCK0	(1 << 5)
+#define RTC_SCK1	((1 << 5) | (1 << 1))
+#define RTC_SIOOUT	(1 << 4)
+
+static void rtc_wait(void)
+{
+	volatile u32 i;
+
+	for (i = 0; i < 50; i++)
+		;
+}
+
+static void rtc_io(u8 cmd, const u8 *out, int nout, u8 *in, int nin)
+{
+	int i, bit;
+
+	*(volatile u8 *)RTC_CR8_REG = RTC_CS0 | RTC_SCK1 | RTC_SIOOUT | 1;
+	rtc_wait();
+	*(volatile u8 *)RTC_CR8_REG = RTC_CS1 | RTC_SCK1 | RTC_SIOOUT | 1;
+	rtc_wait();
+	for (bit = 0; bit < 8; bit++) {			/* the command byte: bit 7 first */
+		*(volatile u8 *)RTC_CR8_REG = RTC_CS1 | RTC_SCK0 | RTC_SIOOUT | ((cmd >> 7) & 1);
+		rtc_wait();
+		*(volatile u8 *)RTC_CR8_REG = RTC_CS1 | RTC_SCK1 | RTC_SIOOUT | ((cmd >> 7) & 1);
+		rtc_wait();
+		cmd <<= 1;
+	}
+	for (i = 0; i < nout; i++)			/* data: bit 0 first */
+		for (bit = 0; bit < 8; bit++) {
+			*(volatile u8 *)RTC_CR8_REG = RTC_CS1 | RTC_SCK0 | RTC_SIOOUT | ((out[i] >> bit) & 1);
+			rtc_wait();
+			*(volatile u8 *)RTC_CR8_REG = RTC_CS1 | RTC_SCK1 | RTC_SIOOUT | ((out[i] >> bit) & 1);
+			rtc_wait();
+		}
+	for (i = 0; i < nin; i++) {
+		in[i] = 0;
+		for (bit = 0; bit < 8; bit++) {
+			*(volatile u8 *)RTC_CR8_REG = RTC_CS1 | RTC_SCK0;
+			rtc_wait();
+			*(volatile u8 *)RTC_CR8_REG = RTC_CS1 | RTC_SCK1;
+			rtc_wait();
+			if (*(volatile u8 *)RTC_CR8_REG & 1)
+				in[i] |= 1 << bit;
+		}
+	}
+	*(volatile u8 *)RTC_CR8_REG = RTC_CS0 | RTC_SCK1;
+	rtc_wait();
+}
+
+static u8 to_bcd(u32 v)
+{
+	return (u8)(((v / 10) << 4) | (v % 10));
+}
+
+/* count 1: set from b->data[0..6]; then read back status register 1 and the 7 date/time bytes into b->data[0..7] */
+static void rtc_request(struct nds_sd_block *b)
+{
+	u8 st, t[7];
+
+	if (b->count == 1) {
+		u32 h = b->data[4];
+
+		if (b->data[0] > 99 || b->data[1] < 1 || b->data[1] > 12 || b->data[2] < 1 || b->data[2] > 31 || b->data[3] > 6 ||
+		    h > 23 || b->data[5] > 59 || b->data[6] > 59) {
+			b->result = NDS_SD_ERR_PARAM;
+			return;
+		}
+		rtc_io(0x61, 0, 0, &st, 1);		/* status register 1: bit 1 = 24 hour mode */
+		t[0] = to_bcd(b->data[0]);
+		t[1] = to_bcd(b->data[1]);
+		t[2] = to_bcd(b->data[2]);
+		t[3] = b->data[3];
+		if (st & 2)				/* 24 h: 0..23, bit 6 = afternoon */
+			t[4] = to_bcd(h) | (h >= 12 ? 0x40 : 0);
+		else					/* 12 h: 0..11 and the PM bit */
+			t[4] = to_bcd(h % 12) | (h >= 12 ? 0x40 : 0);
+		t[5] = to_bcd(b->data[5]);
+		t[6] = to_bcd(b->data[6]);
+		rtc_io(0x64, t, 7, 0, 0);		/* write date and time */
+	}
+	rtc_io(0x61, 0, 0, &st, 1);
+	rtc_io(0x65, 0, 0, t, 7);			/* read date and time */
+	b->data[0] = st;
+	b->data[1] = t[0];
+	b->data[2] = t[1];
+	b->data[3] = t[2];
+	b->data[4] = t[3];
+	b->data[5] = t[4];
+	b->data[6] = t[5];
+	b->data[7] = t[6];
+	b->result = NDS_SD_OK;
+}
+
 static void nds_sd_request_inner(struct nds_sd_block *b)
 {
 	u32 res;
@@ -869,6 +970,10 @@ static void nds_sd_request_inner(struct nds_sd_block *b)
 		b->result = NDS_SD_OK;
 		return;
 
+	case NDS_SD_CMD_RTC:
+		rtc_request(b);
+		return;
+
 	case NDS_SD_CMD_PM:
 		if (!dsitouch_active()) {			/* DS mode: no I2C power chip */
 			b->result = NDS_SD_ERR_PARAM;
