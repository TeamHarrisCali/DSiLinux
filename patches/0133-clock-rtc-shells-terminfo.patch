diff --git a/vendors/Nintendo/DSI/dsautolog.c b/vendors/Nintendo/DSI/dsautolog.c
new file mode 100644
index 000000000..4a98fdee3
--- /dev/null
+++ b/vendors/Nintendo/DSI/dsautolog.c
@@ -0,0 +1,83 @@
+/*
+ * dsautolog - keeps sd:/linux/DSILOG.TXT up to date: runs "/boot/savelog quiet" when something changed, at most every 10 seconds.
+ * Replaces the /boot/autolog shell loop, which cost about 650 KB all the time (a shell plus the "sleep" it ran, memreport w99b) and
+ * started savelog every 10 s: two more shells and some twenty programs each time, several copied from the card into RAM, even when
+ * nothing had changed. Here a change means: the kernel's messages (a checksum) or the size or time of one of the logs savelog
+ * collects; otherwise it saves every 5 minutes. savelog still skips while a recording runs (/tmp/rec.lock).
+ * Started by /boot/rc in the background; prints nothing (text from a background program would be drawn over the desktop).
+ * Built by scripts/build-tools.sh.
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <fcntl.h>
+#include <errno.h>
+#include <time.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <sys/wait.h>
+#include <sys/klog.h>
+
+static const char *logs[] = {
+	"/tmp/desktop.log", "/tmp/dsnet.log", "/tmp/dsnet-dhcp.log", "/tmp/wifi-auto.log", "/tmp/wifi-ssh.log", "/tmp/clock.log",
+	"/tmp/rc.common.log", "/home/wlan0-test.log", NULL
+};
+
+static char kbuf[16384];
+
+/* a checksum over the kernel's messages and the logs' sizes and times */
+static unsigned long signature(void)
+{
+	unsigned long h = 2166136261UL;
+	struct stat st;
+	int n, i;
+
+	n = klogctl(3, kbuf, sizeof(kbuf));		/* read the whole kernel log buffer, without clearing it */
+	for (i = 0; i < n; i++)
+		h = (h ^ (unsigned char)kbuf[i]) * 16777619UL;
+	for (i = 0; logs[i]; i++)
+		if (stat(logs[i], &st) == 0)
+			h = (h ^ (unsigned long)st.st_size ^ ((unsigned long)st.st_mtime << 7)) * 16777619UL;
+	return h;
+}
+
+static void save(void)
+{
+	pid_t pid = vfork();
+	int status;
+
+	if (pid == 0) {
+		execl("/boot/savelog", "savelog", "quiet", (char *)0);
+		_exit(127);
+	}
+	if (pid > 0)
+		while (waitpid(pid, &status, 0) < 0 && errno == EINTR)
+			;
+}
+
+int main(void)
+{
+	unsigned long last = 0, sig;
+	time_t saved = time(NULL);
+	int fd = open("/dev/null", O_RDWR);
+
+	if (fd >= 0) {				/* nothing may reach the console */
+		dup2(fd, 0);
+		dup2(fd, 1);
+		dup2(fd, 2);
+		if (fd > 2)
+			close(fd);
+	}
+	last = signature();
+	for (;;) {
+		sleep(10);
+		sig = signature();
+		if (sig != last || time(NULL) - saved >= 300) {
+			save();
+			last = signature();	/* what savelog itself changed does not count */
+			saved = time(NULL);
+		}
+	}
+	return 0;
+}
diff --git a/vendors/Nintendo/DSI/httpdate.c b/vendors/Nintendo/DSI/httpdate.c
new file mode 100644
index 000000000..ad6cc4e90
--- /dev/null
+++ b/vendors/Nintendo/DSI/httpdate.c
@@ -0,0 +1,280 @@
+/*
+ * httpdate - the date and time from the network, the time zone, and the DSi's own clock chip.
+ * NTP (ntpclient, UDP port 123) is blocked on guest networks such as GuestNet: ntpclient waited forever and the clock stayed at the DSi's
+ * December 2016. A web server's "Date:" header (HTTP, port 80) works wherever wget does; it is UTC, accurate to about a second.
+ *   httpdate [-z] [-s] [-w] [host ...]   the Wi-Fi window runs "httpdate -z -s -w" after each connection
+ *     -z  find the time zone from where the network is (worldtimeapi.org, then ip-api.com; both free, plain HTTP, and they see the
+ *         DSi's public address) and write it to /etc/config/TZ. Skipped when /etc/config/TZ.manual exists (scripts/set-timezone.sh).
+ *     -s  set the clock (root); without -s: only print
+ *     -w  write the local time into the DSi's clock chip (/proc/dsisettings "rtc ..."): the DSi's own menu shows it, and the next boot
+ *         starts with the right time even before Wi-Fi
+ *     hosts for the Date header: default www.google.com, example.com
+ *   httpdate -L   at boot (/boot/rc): the clock chip holds local time (the DS/DSi convention), the kernel took it as UTC: convert
+ * The time zone is /etc/config/TZ (POSIX form, uClibc reads it). Built by scripts/build-tools.sh.
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <signal.h>
+#include <time.h>
+#include <sys/time.h>
+#include <sys/socket.h>
+#include <netinet/in.h>
+#include <netdb.h>
+#include <sys/stat.h>
+
+#define TZFILE	"/etc/config/TZ"
+
+/* IANA zone -> POSIX TZ for uClibc (which has no zone database). Unknown zones keep the TZ file as it is. */
+static const char *zones[][2] = {
+	{ "America/New_York", "EST5EDT,M3.2.0,M11.1.0" }, { "America/Detroit", "EST5EDT,M3.2.0,M11.1.0" },
+	{ "America/Toronto", "EST5EDT,M3.2.0,M11.1.0" }, { "America/Indiana/Indianapolis", "EST5EDT,M3.2.0,M11.1.0" },
+	{ "America/Kentucky/Louisville", "EST5EDT,M3.2.0,M11.1.0" },
+	{ "America/Chicago", "CST6CDT,M3.2.0,M11.1.0" }, { "America/Winnipeg", "CST6CDT,M3.2.0,M11.1.0" },
+	{ "America/Indiana/Knox", "CST6CDT,M3.2.0,M11.1.0" }, { "America/Menominee", "CST6CDT,M3.2.0,M11.1.0" },
