+
+static void timeout(int sig)
+{
+	(void)sig;
+	fprintf(stderr, "httpdate: no answer within 15 s\n");
+	exit(1);
+}
+
+/* days since 1970-01-01 of a civil date (proleptic Gregorian) */
+static long days_from_civil(int y, int m, int d)
+{
+	long era, yoe, doy, doe;
+
+	y -= m <= 2;
+	era = (y >= 0 ? y : y - 399) / 400;
+	yoe = y - era * 400;
+	doy = (153 * (m + (m > 2 ? -3 : 9)) + 2) / 5 + d - 1;
+	doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
+	return era * 146097 + doe - 719468;
+}
+
+/* "Wed, 18 Nov 2026 15:26:00 GMT" -> seconds since 1970 (UTC), -1 if not that form */
+static long parse_date(const char *s)
+{
+	static const char *mon = "JanFebMarAprMayJunJulAugSepOctNovDec";
+	char wd[8], mn[8];
+	int d, y, h, mi, se;
+	const char *p;
+
+	if (sscanf(s, "%7[^,], %d %7s %d %d:%d:%d", wd, &d, mn, &y, &h, &mi, &se) != 7)
+		return -1;
+	p = strstr(mon, mn);
+	if (!p || strlen(mn) != 3 || (p - mon) % 3 || y < 2020)
+		return -1;
+	return days_from_civil(y, (p - mon) / 3 + 1, d) * 86400L + h * 3600L + mi * 60L + se;
+}
+
+/* METHOD http://host/path into buf (headers and body); bytes read, -1 on failure */
+static int http(const char *method, const char *host, const char *path, char *buf, int size)
+{
+	struct hostent *he = gethostbyname(host);
+	struct sockaddr_in sa;
+	char req[200];
+	int fd, n, len = 0;
+
+	if (!he) {
+		fprintf(stderr, "httpdate: %s: name not found\n", host);
+		return -1;
+	}
+	if ((fd = socket(AF_INET, SOCK_STREAM, 0)) < 0)
+		return -1;
+	memset(&sa, 0, sizeof(sa));
+	sa.sin_family = AF_INET;
+	sa.sin_port = htons(80);
+	memcpy(&sa.sin_addr, he->h_addr, sizeof(sa.sin_addr));
+	if (connect(fd, (struct sockaddr *)&sa, sizeof(sa)) < 0) {
+		fprintf(stderr, "httpdate: %s: no connection\n", host);
+		close(fd);
+		return -1;
+	}
+	snprintf(req, sizeof(req), "%s %s HTTP/1.0\r\nHost: %s\r\nUser-Agent: httpdate (DSLinuxDSi)\r\n\r\n", method, path, host);
+	write(fd, req, strlen(req));
+	while (len < size - 1 && (n = read(fd, buf + len, size - 1 - len)) > 0)
+		len += n;
+	close(fd);
+	buf[len] = 0;
+	return len;
+}
+
+static long ask(const char *host)
+{
+	char buf[1024];
+	char *p;
+
+	if (http("HEAD", host, "/", buf, sizeof(buf)) <= 0)
+		return -1;
+	for (p = buf; p && *p; p = strchr(p, '\n')) {
+		if (*p == '\n')
+			p++;
+		if (!strncasecmp(p, "Date:", 5))
+			return parse_date(p + 5 + strspn(p + 5, " "));
+	}
+	fprintf(stderr, "httpdate: %s: no Date header\n", host);
+	return -1;
+}
+
+/* the IANA zone of where the network is, "" if neither service answers */
+static void find_zone(char *zone, int size)
+{
+	char buf[2048], *p;
+
+	zone[0] = 0;
+	/* worldtimeapi.org: "timezone: America/Chicago" in a text body */
+	if (http("GET", "worldtimeapi.org", "/api/ip.txt", buf, sizeof(buf)) > 0 && (p = strstr(buf, "\ntimezone: "))) {
+		sscanf(p + 11, "%63s", zone);
+		return;
+	}
+	/* ip-api.com: the zone alone as the body */
+	if (http("GET", "ip-api.com", "/line/?fields=timezone", buf, sizeof(buf)) > 0 && (p = strstr(buf, "\r\n\r\n")))
+		sscanf(p + 4, "%63s", zone);
+	(void)size;
+}
+
+/* -z: the zone into /etc/config/TZ (and this process's TZ); 0 if the zone is known */
+static int set_zone(void)
+{
+	char zone[64], cur[64] = "";
+	const char *tz = NULL;
+	FILE *f;
+	int i;
+
+	if (access(TZFILE ".manual", F_OK) == 0)
+		return 0;			/* chosen by hand (scripts/set-timezone.sh) */
+	find_zone(zone, sizeof(zone));
+	for (i = 0; zone[0] && zones[i][0]; i++)
+		if (!strcmp(zones[i][0], zone))
+			tz = zones[i][1];
+	if (!tz) {
+		fprintf(stderr, "httpdate: time zone %s not known here: %s unchanged\n", zone[0] ? zone : "(no answer)", TZFILE);
+		return -1;
+	}
+	if ((f = fopen(TZFILE, "r"))) {
+		if (fgets(cur, sizeof(cur), f))
+			cur[strcspn(cur, "\n")] = 0;
+		fclose(f);
+	}
+	if (strcmp(cur, tz)) {
+		mkdir("/etc/config", 0755);
+		if ((f = fopen(TZFILE, "w"))) {
+			fprintf(f, "%s\n", tz);
+			fclose(f);
+		}
+	}
+	setenv("TZ", tz, 1);		/* this process: uClibc reads the file only once */
+	printf("time zone: %s (%s)\n", zone, tz);
+	return 0;
+}
+
+/* -w: the local time into the DSi's clock chip */
+static int write_rtc(time_t t)
+{
+	struct tm *lt = localtime(&t);
+	FILE *f = fopen("/proc/dsisettings", "w");
+	int bad;
+
+	if (!f)
+		return -1;
+	bad = fprintf(f, "rtc %d %d %d %d %d %d %d\n", lt->tm_year + 1900, lt->tm_mon + 1, lt->tm_mday, lt->tm_wday, lt->tm_hour,
+		      lt->tm_min, lt->tm_sec) < 0;
+	bad |= fclose(f) != 0;
+	if (bad)
+		fprintf(stderr, "httpdate: could not write the DSi's clock chip\n");
+	return bad ? -1 : 0;
+}
+
+/* -L: the kernel took the clock chip's local time as UTC: shift by the time zone's offset (needs /etc/config/TZ) */
+static int rtc_local_to_utc(void)
+{
+	time_t t = time(NULL), u;
+	struct tm g = *gmtime(&t);
+	struct timeval tv;
+
+	if (access(TZFILE, R_OK) != 0)
+		return 0;			/* no time zone yet: leave it */
+	g.tm_isdst = -1;
+	u = mktime(&g);			/* the same wall clock, read as local time */
+	if (u == (time_t)-1 || u == t)
+		return 0;
+	tv.tv_sec = u;
+	tv.tv_usec = 0;
+	return settimeofday(&tv, NULL);
+}
+
+int main(int argc, char **argv)
+{
+	static const char *defaults[] = { "www.google.com", "example.com", NULL };
+	const char *hosts[8];
+	int set = 0, zone = 0, wrtc = 0, nh = 0, i;
+	long t = -1;
+
+	for (i = 1; i < argc; i++) {
+		if (!strcmp(argv[i], "-L"))
+			return rtc_local_to_utc() ? 1 : 0;
+		else if (!strcmp(argv[i], "-s"))
+			set = 1;
+		else if (!strcmp(argv[i], "-z"))
+			zone = 1;
+		else if (!strcmp(argv[i], "-w"))
+			wrtc = 1;
+		else if (nh < 7)
+			hosts[nh++] = argv[i];
+	}
+	if (!nh)
+		for (i = 0; defaults[i]; i++)
+			hosts[nh++] = defaults[i];
+	signal(SIGALRM, timeout);
+	alarm(zone ? 30 : 15);
+	if (zone)
+		set_zone();
+	for (i = 0; i < nh && t < 0; i++)
+		t = ask(hosts[i]);
+	if (t < 0)
+		return 1;
+	if (set) {
+		struct timeval tv;
+
+		tv.tv_sec = t;
+		tv.tv_usec = 0;
+		if (settimeofday(&tv, NULL) != 0) {
+			perror("httpdate: settimeofday");
+			return 1;
+		}
+	}
+	if (set && wrtc)
+		write_rtc(t);
+	{
+		time_t tt = t;
+
+		printf("%s%s", set ? "clock set: " : "", ctime(&tt));
+	}
+	return 0;
+}
