+	$(ROMFSINST) -p +x /boot/wifi-connect
+	$(ROMFSINST) -p +x /boot/wifi-status
+	$(ROMFSINST) -p +x /boot/wifi-ssh
 	$(ROMFSINST) -p +x /boot/desktop
