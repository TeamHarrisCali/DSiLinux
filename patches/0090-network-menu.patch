 static const struct item system_items[] = {
 	{ "Settings", "/boot/dssettings" },
 	{ "Bench", "/boot/dsbench" },
@@ -71,6 +77,7 @@ static const struct item root_items[] = {
 	{ "Multimedia", NULL, NULL, multimedia, COUNT(multimedia) },
 	{ "Games", NULL, NULL, games, COUNT(games) },
 	{ "Puzzles", NULL, NULL, puzzles, COUNT(puzzles) },
+	{ "Network", NULL, NULL, network_items, COUNT(network_items) },
