 vendors/Nintendo/DSI/Makefile          |  4 ++++
 vendors/Nintendo/DSI/logbody           |  7 ++++++
 vendors/Nintendo/DSI/wifi-connect      | 33 ++++++++++++++++++++++++++
 vendors/Nintendo/DSI/wifi-scan         |  8 +++++++
 vendors/Nintendo/DSI/wifi-ssh          | 18 ++++++++++++++
 vendors/Nintendo/DSI/wifi-status       |  7 ++++++
 7 files changed, 84 insertions(+)
 create mode 100755 vendors/Nintendo/DSI/wifi-connect
 create mode 100755 vendors/Nintendo/DSI/wifi-scan
 create mode 100755 vendors/Nintendo/DSI/wifi-ssh
 create mode 100755 vendors/Nintendo/DSI/wifi-status

diff --git a/user/microwin/src/demos/nanox/dsdesk.c b/user/microwin/src/demos/nanox/dsdesk.c
index 68d6afde4..5eea7051f 100644
--- a/user/microwin/src/demos/nanox/dsdesk.c
+++ b/user/microwin/src/demos/nanox/dsdesk.c
@@ -58,6 +58,12 @@ static const struct item puzzles[] = {
 	{ "Sudoku", "/boot/dsarcade", "sudoku" },
 	{ "Life", "/boot/dsarcade", "life" },
 };
+static const struct item network_items[] = {
+	{ "Wi-Fi scan", "/boot/nxterm", "/boot/wifi-scan" },
+	{ "Wi-Fi connect", "/boot/nxterm", "/boot/wifi-connect" },
