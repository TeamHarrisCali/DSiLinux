diff --git a/user/microwin/src/demos/nanox/w95.h b/user/microwin/src/demos/nanox/w95.h
new file mode 100644
index 000000000..f61a3e96c
--- /dev/null
+++ b/user/microwin/src/demos/nanox/w95.h
@@ -0,0 +1,98 @@
+/*
+ * w95.h - a Windows 95 look for the DSLinuxDSi desktop programs (dsdesk, dsnotes, dsfiles).
+ * 3D bevels in the classic grey, navy highlights, teal desktop.
+ */
+#ifndef W95_H
+#define W95_H
+
+#include "nano-X.h"
+
+#define W95_FACE	GR_RGB(192, 192, 192)
+#define W95_LIGHT	GR_RGB(255, 255, 255)
+#define W95_SHADOW	GR_RGB(128, 128, 128)
+#define W95_DARK	GR_RGB(0, 0, 0)
+#define W95_NAVY	GR_RGB(0, 0, 128)
+#define W95_TEAL	GR_RGB(0, 128, 128)
+
+static void w95_fill(GR_WINDOW_ID w, GR_GC_ID g, GR_COLOR c, int x, int y, int wd, int h)
+{
+	GrSetGCForeground(g, c);
+	GrFillRect(w, g, x, y, wd, h);
+}
+
+static void w95_hline(GR_WINDOW_ID w, GR_GC_ID g, GR_COLOR c, int x1, int x2, int y)
+{
+	GrSetGCForeground(g, c);
+	GrLine(w, g, x1, y, x2, y);
+}
+
+static void w95_vline(GR_WINDOW_ID w, GR_GC_ID g, GR_COLOR c, int x, int y1, int y2)
+{
+	GrSetGCForeground(g, c);
+	GrLine(w, g, x, y1, x, y2);
+}
+
+/* a raised (sunken = 0) or sunken (sunken = 1) box with a two pixel bevel, filled with the grey face */
+static void w95_box(GR_WINDOW_ID w, GR_GC_ID g, int x, int y, int wd, int h, int sunken, int fill)
+{
+	GR_COLOR tl_out = sunken ? W95_SHADOW : W95_LIGHT;
+	GR_COLOR br_out = sunken ? W95_LIGHT : W95_DARK;
+	GR_COLOR tl_in = sunken ? W95_DARK : W95_FACE;
+	GR_COLOR br_in = sunken ? W95_FACE : W95_SHADOW;
+	int r = x + wd - 1, b = y + h - 1;
+
+	if (fill)
+		w95_fill(w, g, W95_FACE, x, y, wd, h);
+	w95_hline(w, g, tl_out, x, r - 1, y);
+	w95_vline(w, g, tl_out, x, y, b - 1);
+	w95_hline(w, g, br_out, x, r, b);
+	w95_vline(w, g, br_out, r, y, b);
+	w95_hline(w, g, tl_in, x + 1, r - 2, y + 1);
+	w95_vline(w, g, tl_in, x + 1, y + 1, b - 2);
+	w95_hline(w, g, br_in, x + 1, r - 1, b - 1);
+	w95_vline(w, g, br_in, r - 1, y + 1, b - 1);
+}
+
+/* text without a background box; (x, y) is the top left of the text */
+static void w95_text(GR_WINDOW_ID w, GR_GC_ID g, GR_COLOR c, int x, int y, const char *s)
+{
+	GrSetGCForeground(g, c);
+	GrSetGCUseBackground(g, GR_FALSE);
+	GrText(w, g, x, y, (void *)s, -1, GR_TFASCII | GR_TFTOP);
+}
+
+static int w95_textw(GR_GC_ID g, const char *s)
+{
+	GR_SIZE wd, h, base;
+
+	GrGetGCTextSize(g, (void *)s, -1, GR_TFASCII | GR_TFTOP, &wd, &h, &base);
+	return wd;
+}
+
+static int w95_texth(GR_GC_ID g)
+{
+	GR_SIZE wd, h, base;
+
+	GrGetGCTextSize(g, (void *)"Mg", -1, GR_TFASCII | GR_TFTOP, &wd, &h, &base);
+	return h;
+}
+
+/* a push button with a centred label */
+static void w95_button(GR_WINDOW_ID w, GR_GC_ID g, int x, int y, int wd, int h, const char *label, int down)
+{
+	int tw = w95_textw(g, label), th = w95_texth(g);
+
+	w95_box(w, g, x, y, wd, h, down, 1);
+	w95_text(w, g, W95_DARK, x + (wd - tw) / 2 + (down ? 1 : 0), y + (h - th) / 2 + (down ? 1 : 0), label);
+}
+
+/* the four colour flag of the Start button, 8x7 pixels */
+static void w95_flag(GR_WINDOW_ID w, GR_GC_ID g, int x, int y)
+{
+	w95_fill(w, g, GR_RGB(255, 0, 0), x, y, 4, 3);
+	w95_fill(w, g, GR_RGB(0, 160, 0), x + 4, y, 4, 3);
+	w95_fill(w, g, GR_RGB(0, 0, 255), x, y + 4, 4, 3);
+	w95_fill(w, g, GR_RGB(255, 255, 0), x + 4, y + 4, 4, 3);
+}
+
+#endif
