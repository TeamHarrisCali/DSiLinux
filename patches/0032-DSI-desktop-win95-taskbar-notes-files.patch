diff --git a/user/microwin/src/demos/nanox/dsdesk.c b/user/microwin/src/demos/nanox/dsdesk.c
new file mode 100644
index 000000000..4196d644f
--- /dev/null
+++ b/user/microwin/src/demos/nanox/dsdesk.c
@@ -0,0 +1,239 @@
+/*
+ * dsdesk - the DSLinuxDSi desktop panel: a Windows 95 style taskbar with a Start button, a Start menu and a clock.
+ * Programs are started from the menu; "Shut down" stops the desktop.
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <signal.h>
+#include <time.h>
+#include <sys/types.h>
+#include <sys/wait.h>
+#include "nano-X.h"
+#include "w95.h"
+
+struct item {
+	const char *name;
+	const char *prog;
+	const char *arg;
+};
+
+static struct item items[] = {
+	{ "Terminal", "/boot/nxterm", NULL },
+	{ "Notes", "/boot/dsnotes", NULL },
+	{ "Files", "/boot/dsfiles", NULL },
+	{ "Clock", "/usr/bin/nxclock", NULL },
+	{ "Shut down", "/boot/desktop", "stop" },
+};
+#define NITEMS	(sizeof(items) / sizeof(items[0]))
+
+#define MENU_SECONDS	8	/* the menu closes itself after this long */
+
+static GR_WINDOW_ID bar, menu;
+static GR_GC_ID gc;
+static GR_SCREEN_INFO si;
+static int th, barh, startw, itemh, menuw, menuh;
+static int menu_open, hot = -1, start_down;
+static time_t menu_since;
+
+static void reap(int sig)
+{
+	while (waitpid(-1, NULL, WNOHANG) > 0)
+		;
+}
+
+static void launch(const char *prog, const char *arg)
+{
+	pid_t pid = vfork();
+
+	if (pid == 0) {
+		if (arg)
+			execl(prog, prog, arg, (char *)NULL);
+		else
+			execl(prog, prog, (char *)NULL);
+		_exit(127);
+	}
+}
+
+static void draw_bar(void)
+{
+	char clk[16];
+	time_t now = time(NULL);
+	struct tm *tm = localtime(&now);
+	int cw, x;
+
+	w95_fill(bar, gc, W95_FACE, 0, 0, si.cols, barh);
+	w95_hline(bar, gc, W95_LIGHT, 0, si.cols - 1, 0);
+
+	/* Start button: flag and bold text */
+	w95_box(bar, gc, 2, 3, startw, barh - 5, start_down, 1);
+	w95_flag(bar, gc, 6 + start_down, 3 + (barh - 5 - 7) / 2 + start_down);
+	w95_text(bar, gc, W95_DARK, 17 + start_down, 3 + (barh - 5 - th) / 2 + start_down, "Start");
+	w95_text(bar, gc, W95_DARK, 18 + start_down, 3 + (barh - 5 - th) / 2 + start_down, "Start");
+
+	/* clock in a sunken field */
+	if (tm)
+		sprintf(clk, "%02d:%02d", tm->tm_hour, tm->tm_min);
+	else
+		strcpy(clk, "--:--");
+	cw = w95_textw(gc, clk) + 12;
+	x = si.cols - cw - 3;
+	w95_box(bar, gc, x, 3, cw, barh - 5, 1, 0);
+	w95_text(bar, gc, W95_DARK, x + 6, 3 + (barh - 5 - th) / 2, clk);
+}
+
+static void draw_menu(void)
+{
+	unsigned i;
+
+	w95_box(menu, gc, 0, 0, menuw, menuh, 0, 1);
+	for (i = 0; i < NITEMS; i++) {
+		int y = 3 + i * itemh;
+
+		if (i == NITEMS - 1) {	/* separator above Shut down */
+			w95_hline(menu, gc, W95_SHADOW, 3, menuw - 4, y);
+			w95_hline(menu, gc, W95_LIGHT, 3, menuw - 4, y + 1);
+			y += 3;
+		}
+		if ((int)i == hot) {
+			w95_fill(menu, gc, W95_NAVY, 3, y, menuw - 6, itemh);
+			w95_text(menu, gc, W95_LIGHT, 22, y + (itemh - th) / 2, items[i].name);
+		} else {
+			w95_text(menu, gc, W95_DARK, 22, y + (itemh - th) / 2, items[i].name);
+		}
+		/* a small icon square per entry */
+		w95_fill(menu, gc, (int)i == NITEMS - 1 ? GR_RGB(255, 0, 0) : GR_RGB(0, 128, 128), 7, y + (itemh - 8) / 2, 8, 8);
+	}
+}
+
+static int menu_item_at(int y)
+{
+	unsigned i;
+
+	for (i = 0; i < NITEMS; i++) {
+		int top = 3 + i * itemh + (i == NITEMS - 1 ? 3 : 0);
+
+		if (y >= top && y < top + itemh)
+			return i;
+	}
+	return -1;
+}
+
+static void open_menu(void)
+{
+	if (menu_open)
+		return;
+	menu = GrNewWindowEx(GR_WM_PROPS_NODECORATE | GR_WM_PROPS_NOFOCUS | GR_WM_PROPS_NOMOVE,
+			     "menu", GR_ROOT_WINDOW_ID, 2, si.rows - barh - menuh, menuw, menuh, W95_FACE);
+	GrSelectEvents(menu, GR_EVENT_MASK_EXPOSURE | GR_EVENT_MASK_BUTTON_UP | GR_EVENT_MASK_BUTTON_DOWN |
+		       GR_EVENT_MASK_MOUSE_POSITION | GR_EVENT_MASK_MOUSE_EXIT);
+	GrMapWindow(menu);
+	menu_open = 1;
+	hot = -1;
+	menu_since = time(NULL);
+}
+
+static void close_menu(void)
+{
+	if (!menu_open)
+		return;
+	GrDestroyWindow(menu);
+	menu_open = 0;
+	start_down = 0;
+	draw_bar();
+}
+
+int main(int argc, char **argv)
+{
+	GR_EVENT ev;
+	GR_FONT_ID font;
+	unsigned i;
+	int maxw = 0, w;
+
+	signal(SIGCHLD, reap);
+	if (GrOpen() < 0) {
+		fprintf(stderr, "dsdesk: cannot connect to Nano-X\n");
+		return 1;
+	}
+	GrGetScreenInfo(&si);
+	gc = GrNewGC();
+	font = GrCreateFont(GR_FONT_SYSTEM_VAR, 0, NULL);
+	GrSetGCFont(gc, font);
+	th = w95_texth(gc);
+	barh = th + 8;
+	startw = w95_textw(gc, "Start") + 24;
+	itemh = th + 6;
+	for (i = 0; i < NITEMS; i++) {
+		w = w95_textw(gc, items[i].name);
+		if (w > maxw)
+			maxw = w;
+	}
+	menuw = maxw + 30;
+	menuh = NITEMS * itemh + 6 + 3;
+
+	bar = GrNewWindowEx(GR_WM_PROPS_NODECORATE | GR_WM_PROPS_NOFOCUS | GR_WM_PROPS_NOMOVE | GR_WM_PROPS_NORAISE,
+			    "taskbar", GR_ROOT_WINDOW_ID, 0, si.rows - barh, si.cols, barh, W95_FACE);
+	GrSelectEvents(bar, GR_EVENT_MASK_EXPOSURE | GR_EVENT_MASK_BUTTON_DOWN | GR_EVENT_MASK_BUTTON_UP);
+	GrMapWindow(bar);
+
+	for (;;) {
+		GrGetNextEventTimeout(&ev, 5000);
+		switch (ev.type) {
+		case GR_EVENT_TYPE_EXPOSURE:
+			if (ev.exposure.wid == bar)
+				draw_bar();
+			else if (menu_open && ev.exposure.wid == menu)
+				draw_menu();
+			break;
+		case GR_EVENT_TYPE_BUTTON_DOWN:
+			if (ev.button.wid == bar && ev.button.x < startw + 2) {
+				if (menu_open) {
+					close_menu();
+				} else {
+					start_down = 1;
+					draw_bar();
+					open_menu();
+				}
+			}
+			break;
+		case GR_EVENT_TYPE_MOUSE_POSITION:
+			if (menu_open && ev.mouse.wid == menu) {
+				int h = menu_item_at(ev.mouse.y);
+
+				if (h != hot) {
+					hot = h;
+					draw_menu();
+				}
+			}
+			break;
+		case GR_EVENT_TYPE_BUTTON_UP:
+			if (menu_open && ev.button.wid == menu) {
+				int h = menu_item_at(ev.button.y);
+
+				if (h >= 0) {
+					const char *p = items[h].prog, *a = items[h].arg;
+
+					close_menu();
+					launch(p, a);
+				}
+			}
+			break;
+		case GR_EVENT_TYPE_MOUSE_EXIT:
+			if (menu_open && ev.general.wid == menu && hot != -1) {
+				hot = -1;
+				draw_menu();
+			}
+			break;
+		case GR_EVENT_TYPE_TIMEOUT:
+			break;
+		}
+		if (menu_open && time(NULL) - menu_since > MENU_SECONDS && hot == -1)
+			close_menu();
+		else if (menu_open && hot != -1)
+			menu_since = time(NULL);
+		if (ev.type == GR_EVENT_TYPE_TIMEOUT)
+			draw_bar();	/* the clock */
+	}
+	return 0;
+}
diff --git a/user/microwin/src/demos/nanox/dsfiles.c b/user/microwin/src/demos/nanox/dsfiles.c
new file mode 100644
index 000000000..b0f4459bf
--- /dev/null
+++ b/user/microwin/src/demos/nanox/dsfiles.c
@@ -0,0 +1,219 @@
+/*
+ * dsfiles - a small file browser for the DSLinuxDSi desktop (Windows 95 look).
+ * dsfiles [directory]   tap a folder to open it, tap a file to open it in Notes.
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <dirent.h>
+#include <sys/types.h>
+#include <sys/stat.h>
+#include "nano-X.h"
+#include "w95.h"
+
+#define WIN_W	236
+#define WIN_H	150
+#define MAXENT	256
+#define NAMELEN	64
+
+struct ent {
+	char name[NAMELEN];
+	int isdir;
+	long size;
+};
+
+static struct ent ents[MAXENT];
+static int nent, top;
+static char cwd[256] = "/home";
+
+static GR_WINDOW_ID win;
+static GR_GC_ID gc;
+static int fw, fh, headh, rowh, rows;
+
+static int cmp(const void *a, const void *b)
+{
+	const struct ent *x = a, *y = b;
+
+	if (x->isdir != y->isdir)
+		return y->isdir - x->isdir;
+	return strcmp(x->name, y->name);
+}
+
+static void read_dir(void)
+{
+	DIR *d = opendir(cwd);
+	struct dirent *de;
+	char full[320];
+	struct stat st;
+
+	nent = 0;
+	top = 0;
+	if (!d)
+		return;
+	while ((de = readdir(d)) != NULL && nent < MAXENT) {
+		if (!strcmp(de->d_name, "."))
+			continue;
+		snprintf(ents[nent].name, NAMELEN, "%s", de->d_name);
+		snprintf(full, sizeof(full), "%s/%s", cwd, de->d_name);
+		ents[nent].isdir = 0;
+		ents[nent].size = 0;
+		if (stat(full, &st) == 0) {
+			ents[nent].isdir = S_ISDIR(st.st_mode) ? 1 : 0;
+			ents[nent].size = (long)st.st_size;
+		}
+		nent++;
+	}
+	closedir(d);
+	qsort(ents, nent, sizeof(ents[0]), cmp);
+}
+
+static void go_up(void)
+{
+	char *p = strrchr(cwd, '/');
+
+	if (!p || p == cwd)
+		strcpy(cwd, "/");
+	else
+		*p = 0;
+	read_dir();
+}
+
+static void draw(void)
+{
+	int i, y;
+	char sz[16];
+
+	w95_fill(win, gc, W95_FACE, 0, 0, WIN_W, WIN_H);
+
+	/* header: Up button, path field, scroll buttons */
+	w95_button(win, gc, 3, 3, 28, headh - 6, "Up", 0);
+	w95_box(win, gc, 34, 3, WIN_W - 34 - 40, headh - 6, 1, 0);
+	w95_text(win, gc, W95_DARK, 38, 3 + (headh - 6 - fh) / 2, cwd);
+	w95_button(win, gc, WIN_W - 37, 3, 17, headh - 6, "^", 0);
+	w95_button(win, gc, WIN_W - 19, 3, 17, headh - 6, "v", 0);
+
+	/* list */
+	w95_fill(win, gc, W95_LIGHT, 3, headh, WIN_W - 6, WIN_H - headh - 3);
+	w95_box(win, gc, 2, headh - 1, WIN_W - 4, WIN_H - headh + 1, 1, 0);
+	for (i = 0; i < rows && top + i < nent; i++) {
+		struct ent *e = &ents[top + i];
+		char name[NAMELEN + 2];
+
+		y = headh + 1 + i * rowh;
+		if (e->isdir) {
+			snprintf(name, sizeof(name), "%s/", e->name);
+			w95_text(win, gc, W95_NAVY, 6, y, name);
+		} else {
+			w95_text(win, gc, W95_DARK, 6, y, e->name);
+			if (e->size >= 1024)
+				snprintf(sz, sizeof(sz), "%ldK", e->size / 1024);
+			else
+				snprintf(sz, sizeof(sz), "%ld", e->size);
+			w95_text(win, gc, W95_SHADOW, WIN_W - 8 - w95_textw(gc, sz), y, sz);
+		}
+	}
+	if (nent == 0)
+		w95_text(win, gc, W95_SHADOW, 6, headh + 1, "(empty or unreadable)");
+}
+
+static void open_entry(int i)
+{
+	struct ent *e;
+
+	if (i < 0 || i >= nent)
+		return;
+	e = &ents[i];
+	if (!strcmp(e->name, "..")) {
+		go_up();
+	} else if (e->isdir) {
+		if (strlen(cwd) + strlen(e->name) + 2 < sizeof(cwd)) {
+			if (strcmp(cwd, "/"))
+				strcat(cwd, "/");
+			strcat(cwd, e->name);
+			read_dir();
+		}
+	} else if (e->size < 4000) {
+		char full[320];
+		pid_t pid;
+
+		snprintf(full, sizeof(full), "%s/%s", cwd, e->name);
+		pid = vfork();
+		if (pid == 0) {
+			execl("/boot/dsnotes", "/boot/dsnotes", full, (char *)NULL);
+			_exit(127);
+		}
+	}
+}
+
+int main(int argc, char **argv)
+{
+	GR_EVENT ev;
+	GR_FONT_ID font;
+	GR_FONT_INFO fi;
+
+	if (argc > 1)
+		snprintf(cwd, sizeof(cwd), "%s", argv[1]);
+	if (access(cwd, R_OK) != 0)
+		strcpy(cwd, "/");
+	if (GrOpen() < 0) {
+		fprintf(stderr, "dsfiles: cannot connect to Nano-X\n");
+		return 1;
+	}
+	gc = GrNewGC();
+	font = GrCreateFont(GR_FONT_SYSTEM_FIXED, 0, NULL);
+	GrSetGCFont(gc, font);
+	GrGetFontInfo(font, &fi);
+	fw = fi.maxwidth;
+	fh = fi.height;
+	headh = fh + 10;
+	rowh = fh + 1;
+	rows = (WIN_H - headh - 3) / rowh;
+	read_dir();
+
+	win = GrNewWindowEx(GR_WM_PROPS_APPFRAME | GR_WM_PROPS_CAPTION | GR_WM_PROPS_CLOSEBOX, "Files",
+			    GR_ROOT_WINDOW_ID, 12, 8, WIN_W, WIN_H, W95_FACE);
+	GrSelectEvents(win, GR_EVENT_MASK_EXPOSURE | GR_EVENT_MASK_BUTTON_DOWN | GR_EVENT_MASK_KEY_DOWN |
+		       GR_EVENT_MASK_CLOSE_REQ);
+	GrMapWindow(win);
+
+	for (;;) {
+		GrGetNextEvent(&ev);
+		switch (ev.type) {
+		case GR_EVENT_TYPE_EXPOSURE:
+			draw();
+			break;
+		case GR_EVENT_TYPE_CLOSE_REQ:
+			GrClose();
+			return 0;
+		case GR_EVENT_TYPE_BUTTON_DOWN: {
+			int x = ev.button.x, y = ev.button.y;
+
+			if (y < headh) {
+				if (x >= 3 && x < 31)
+					go_up();
+				else if (x >= WIN_W - 37 && x < WIN_W - 20 && top > 0)
+					top -= rows > 1 ? rows - 1 : 1;
+				else if (x >= WIN_W - 19 && top + rows < nent)
+					top += rows > 1 ? rows - 1 : 1;
+				if (top < 0)
+					top = 0;
+			} else {
+				open_entry(top + (y - headh - 1) / rowh);
+			}
+			draw();
+			break;
+		}
+		case GR_EVENT_TYPE_KEY_DOWN:
+			if (ev.keystroke.ch == MWKEY_BACKSPACE)
+				go_up();
+			else if (ev.keystroke.ch == MWKEY_DOWN && top + rows < nent)
+				top++;
+			else if (ev.keystroke.ch == MWKEY_UP && top > 0)
+				top--;
+			draw();
+			break;
+		}
+	}
+	return 0;
+}
diff --git a/user/microwin/src/demos/nanox/dsnotes.c b/user/microwin/src/demos/nanox/dsnotes.c
new file mode 100644
index 000000000..43ac74f0a
--- /dev/null
