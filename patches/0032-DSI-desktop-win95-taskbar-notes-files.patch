@@ -0,0 +1,285 @@
+/*
+ * dsnotes - a small text editor for the DSLinuxDSi desktop (Windows 95 look).
+ * dsnotes [file]   default file /home/notes.txt. Buttons: New, Save, Load.
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include "nano-X.h"
+#include "w95.h"
+
+#define BUFSZ	4096
+#define WIN_W	236
+#define WIN_H	150
+
+static char buf[BUFSZ];
+static int len, cur, topline, modified;
+static const char *path = "/home/notes.txt";
+static char status[40];
+
+static GR_WINDOW_ID win;
+static GR_GC_ID gc;
+static int fw, fh, cols, rows, areah, barh;
+
+/* layout: where does character index i (0..len) sit once lines are wrapped at `cols` columns */
+static void pos_to_rc(int idx, int *row, int *col)
+{
+	int r = 0, c = 0, i;
+
+	for (i = 0; i < idx && i < len; i++) {
+		if (buf[i] == '\n') {
+			r++;
+			c = 0;
+		} else if (++c >= cols) {
+			r++;
+			c = 0;
+		}
+	}
+	*row = r;
+	*col = c;
+}
+
+/* the index closest to (row, col) */
+static int rc_to_pos(int row, int col)
+{
+	int r = 0, c = 0, i;
+
+	for (i = 0; i < len; i++) {
+		if (r == row && c >= col)
+			return i;
+		if (r > row)
+			return i - 1 < 0 ? 0 : i - 1;
+		if (buf[i] == '\n') {
+			if (r == row)
+				return i;
+			r++;
+			c = 0;
+		} else if (++c >= cols) {
+			if (r == row && c >= col)
+				return i + 1;
+			r++;
+			c = 0;
+		}
+	}
+	return len;
+}
+
+static void draw_buttons(void)
+{
+	int y = WIN_H - barh;
+	char name[40];
+	const char *p = strrchr(path, '/');
+
+	w95_fill(win, gc, W95_FACE, 0, y, WIN_W, barh);
+	w95_button(win, gc, 3, y + 3, 32, barh - 6, "New", 0);
+	w95_button(win, gc, 38, y + 3, 36, barh - 6, "Save", 0);
+	w95_button(win, gc, 77, y + 3, 36, barh - 6, "Load", 0);
+	snprintf(name, sizeof(name), "%s%s", p ? p + 1 : path, modified ? " *" : "");
+	w95_box(win, gc, 118, y + 3, WIN_W - 121, barh - 6, 1, 0);
+	w95_text(win, gc, W95_DARK, 122, y + 3 + (barh - 6 - fh) / 2, name);
+	if (status[0])
+		w95_text(win, gc, W95_SHADOW, 122 + w95_textw(gc, name) + 6, y + 3 + (barh - 6 - fh) / 2, status);
+}
+
+/* draw one wrapped line */
+static void put_line(int r, char *line, int n)
+{
+	if (r < topline || r >= topline + rows)
+		return;
+	line[n] = 0;
+	w95_text(win, gc, W95_DARK, 3, 3 + (r - topline) * fh, line);
+}
+
+static void draw_text(void)
+{
+	int row, col, i, r = 0, c = 0;
+	char line[128];
+
+	pos_to_rc(cur, &row, &col);
+	if (row < topline)
+		topline = row;
+	if (row >= topline + rows)
+		topline = row - rows + 1;
+
+	w95_fill(win, gc, W95_LIGHT, 2, 2, WIN_W - 4, areah - 4);
+	w95_box(win, gc, 0, 0, WIN_W, areah, 1, 0);	/* sunken frame */
+
+	/* same wrapping as pos_to_rc(): a line breaks right after its cols-th character */
+	for (i = 0; i < len; i++) {
+		if (buf[i] == '\n') {
+			put_line(r, line, c);
+			r++;
+			c = 0;
+			continue;
+		}
+		line[c++] = buf[i];
+		if (c >= cols) {
+			put_line(r, line, c);
+			r++;
+			c = 0;
+		}
+	}
+	put_line(r, line, c);
+
+	/* caret */
+	if (row >= topline && row < topline + rows)
+		w95_fill(win, gc, W95_DARK, 3 + col * fw, 3 + (row - topline) * fh, 2, fh);
+}
+
+static void redraw(void)
+{
+	draw_text();
+	draw_buttons();
+}
+
+static void load_file(void)
+{
+	FILE *f = fopen(path, "r");
+
+	len = 0;
+	cur = 0;
+	topline = 0;
+	if (f) {
+		len = fread(buf, 1, BUFSZ - 1, f);
+		fclose(f);
+		snprintf(status, sizeof(status), "loaded");
+	} else {
+		snprintf(status, sizeof(status), "new");
+	}
+	modified = 0;
+}
+
+static void save_file(void)
+{
+	FILE *f = fopen(path, "w");
+
+	if (f && fwrite(buf, 1, len, f) == (size_t)len) {
+		fclose(f);
+		modified = 0;
+		snprintf(status, sizeof(status), "saved");
+	} else {
+		if (f)
+			fclose(f);
+		snprintf(status, sizeof(status), "save failed");
+	}
+}
+
+static void insert(char ch)
+{
+	if (len >= BUFSZ - 1)
+		return;
+	memmove(buf + cur + 1, buf + cur, len - cur);
+	buf[cur++] = ch;
+	len++;
+	modified = 1;
+	status[0] = 0;
+}
+
+static void erase(int at)
+{
+	if (at < 0 || at >= len)
+		return;
+	memmove(buf + at, buf + at + 1, len - at - 1);
+	len--;
+	if (cur > at)
+		cur--;
+	modified = 1;
+	status[0] = 0;
+}
+
+int main(int argc, char **argv)
+{
+	GR_EVENT ev;
+	GR_FONT_ID font;
+	GR_FONT_INFO fi;
+	int row, col;
+
+	if (argc > 1)
+		path = argv[1];
+	if (GrOpen() < 0) {
+		fprintf(stderr, "dsnotes: cannot connect to Nano-X\n");
+		return 1;
+	}
+	gc = GrNewGC();
+	font = GrCreateFont(GR_FONT_SYSTEM_FIXED, 0, NULL);
+	GrSetGCFont(gc, font);
+	GrGetFontInfo(font, &fi);
+	fw = fi.maxwidth;
+	fh = fi.height;
+	barh = fh + 10;
+	areah = WIN_H - barh;
+	cols = (WIN_W - 6) / fw;
+	rows = (areah - 6) / fh;
+
+	load_file();
+	win = GrNewWindowEx(GR_WM_PROPS_APPFRAME | GR_WM_PROPS_CAPTION | GR_WM_PROPS_CLOSEBOX, "Notes",
+			    GR_ROOT_WINDOW_ID, 8, 4, WIN_W, WIN_H, W95_FACE);
+	GrSelectEvents(win, GR_EVENT_MASK_EXPOSURE | GR_EVENT_MASK_BUTTON_DOWN | GR_EVENT_MASK_BUTTON_UP |
+		       GR_EVENT_MASK_KEY_DOWN | GR_EVENT_MASK_CLOSE_REQ);
+	GrMapWindow(win);
+
+	for (;;) {
+		GrGetNextEvent(&ev);
+		switch (ev.type) {
+		case GR_EVENT_TYPE_EXPOSURE:
+			redraw();
+			break;
+		case GR_EVENT_TYPE_CLOSE_REQ:
+			GrClose();
+			return 0;
+		case GR_EVENT_TYPE_BUTTON_DOWN:
+			if (ev.button.y >= WIN_H - barh) {
+				int x = ev.button.x;
+
+				if (x >= 3 && x < 35) {
+					len = cur = topline = 0;
+					modified = 0;
+					snprintf(status, sizeof(status), "new");
+				} else if (x >= 38 && x < 74) {
+					save_file();
+				} else if (x >= 77 && x < 113) {
+					load_file();
+				}
+				redraw();
+			}
+			break;
+		case GR_EVENT_TYPE_KEY_DOWN:
+			switch (ev.keystroke.ch) {
+			case MWKEY_BACKSPACE:
+				erase(cur - 1);
+				break;
+			case MWKEY_DELETE:
+				erase(cur);
+				break;
+			case MWKEY_ENTER:
+				insert('\n');
+				break;
+			case MWKEY_LEFT:
+				if (cur > 0)
+					cur--;
+				break;
+			case MWKEY_RIGHT:
+				if (cur < len)
+					cur++;
+				break;
+			case MWKEY_UP:
+				pos_to_rc(cur, &row, &col);
+				if (row > 0)
+					cur = rc_to_pos(row - 1, col);
+				break;
+			case MWKEY_DOWN:
+				pos_to_rc(cur, &row, &col);
+				cur = rc_to_pos(row + 1, col);
+				break;
+			default:
+				if (ev.keystroke.ch >= 32 && ev.keystroke.ch < 127)
+					insert((char)ev.keystroke.ch);
+				break;
+			}
+			redraw();
+			break;
+		}
+	}
+	return 0;
+}
