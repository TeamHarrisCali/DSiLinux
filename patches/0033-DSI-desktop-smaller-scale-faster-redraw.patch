index 000000000..43ee1337e
--- /dev/null
+++ b/user/microwin/src/demos/nanox/dsbench.c
@@ -0,0 +1,87 @@
+/*
+ * dsbench - how fast is drawing on this console? Prints milliseconds for a few drawing jobs on the desktop
+ * (and into /tmp/bench.log). Run it from the terminal window: /boot/dsbench
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <sys/time.h>
+#include "nano-X.h"
+#include "w95.h"
+
+static long now_ms(void)
+{
+	struct timeval tv;
+
+	gettimeofday(&tv, NULL);
+	return tv.tv_sec * 1000L + tv.tv_usec / 1000;
+}
+
+int main(void)
+{
+	GR_WINDOW_ID w;
+	GR_GC_ID gc;
+	GR_FONT_ID font;
+	GR_EVENT ev;
+	long t, r[6];
+	int i;
+	FILE *f;
+	char line[80];
+
+	if (GrOpen() < 0)
+		return 1;
+	gc = GrNewGC();
+	font = GrCreateFont("Tiny", 0, NULL);
+	GrSetGCFont(gc, font);
+	w = GrNewWindowEx(GR_WM_PROPS_APPFRAME | GR_WM_PROPS_CAPTION | GR_WM_PROPS_CLOSEBOX, "Bench",
+			  GR_ROOT_WINDOW_ID, 20, 12, 200, 100, W95_FACE);
+	GrSelectEvents(w, GR_EVENT_MASK_EXPOSURE | GR_EVENT_MASK_CLOSE_REQ);
+	GrMapWindow(w);
+	do
+		GrGetNextEvent(&ev);
+	while (ev.type != GR_EVENT_TYPE_EXPOSURE);
+
+	t = now_ms();
+	for (i = 0; i < 20; i++)
+		w95_fill(w, gc, i & 1 ? W95_LIGHT : W95_NAVY, 0, 0, 100, 100);	/* 10000 pixels each */
+	GrFlush();
+	GrGetNextEventTimeout(&ev, 1);	/* a round trip to the server, so the work is really done */
+	r[0] = now_ms() - t;
+
+	t = now_ms();
+	for (i = 0; i < 100; i++)
+		w95_text(w, gc, W95_DARK, 2, 2 + (i % 10) * 8, "The quick brown fox jumps");
+	GrFlush();
+	GrGetNextEventTimeout(&ev, 1);
+	r[1] = now_ms() - t;
+
+	t = now_ms();
+	for (i = 0; i < 100; i++)
+		w95_box(w, gc, 10, 10, 60, 20, i & 1, 1);
+	GrFlush();
+	GrGetNextEventTimeout(&ev, 1);
+	r[2] = now_ms() - t;
+
+	sprintf(line, "20 fills of 10000 px: %ld ms", r[0]);
+	f = fopen("/tmp/bench.log", "w");
+	if (f) {
+		fprintf(f, "%s\n", line);
+		fprintf(f, "100 text lines of 25 chars: %ld ms\n", r[1]);
+		fprintf(f, "100 bevel boxes 60x20: %ld ms\n", r[2]);
+		fclose(f);
+	}
+	w95_fill(w, gc, W95_FACE, 0, 0, 200, 100);
+	w95_text(w, gc, W95_DARK, 4, 4, line);
+	sprintf(line, "100 text lines: %ld ms", r[1]);
+	w95_text(w, gc, W95_DARK, 4, 16, line);
+	sprintf(line, "100 bevel boxes: %ld ms", r[2]);
+	w95_text(w, gc, W95_DARK, 4, 28, line);
+	w95_text(w, gc, W95_DARK, 4, 44, "(saved in /tmp/bench.log)");
+
+	for (;;) {
+		GrGetNextEvent(&ev);
+		if (ev.type == GR_EVENT_TYPE_CLOSE_REQ) {
+			GrClose();
+			return 0;
+		}
+	}
+}
