+			/usr/bin/tar -cf - -C /media/linux $d | /usr/bin/tar -xmf - -C /tmp >> $LOG 2>&1
+		else
+			/usr/bin/mkdir /tmp/$d >> $LOG 2>&1
+		fi
+		# never hide the card's files behind an empty copy
+		if [ -d /tmp/$d ]
