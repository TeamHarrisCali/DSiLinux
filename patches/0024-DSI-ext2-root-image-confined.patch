+# /media/linux and /mnt is unmounted again, so nothing outside linux/ is reachable by path. If any step fails the
+# card is unmounted instead of being left visible.
+CARD=no
+if mount -t vfat -o ro,noatime /dev/dldi1 /mnt
+then
+	CARD=yes
+else
+	# some cards have no partition table: try the whole device
+	if mount -t vfat -o ro,noatime /dev/dldi /mnt
+	then
+		CARD=yes
+	else
+		echo "Sorry, failed to mount DLDI device."
+	fi
+fi
+if [ "$CARD" = "yes" ]
+then
+	if mount -o bind /mnt/linux /media/linux
+	then
+		umount /mnt || umount -l /mnt
+	else
+		echo "Card has no usable linux/ folder (or bind mount failed): card NOT mounted."
+		umount /mnt || umount -l /mnt
+	fi
+fi
+# The card is mounted read-only (see above) but DSLinux writes to /etc, /var and /home while it runs. Give those three
+# folders RAM copies: copy them from the card, then bind-mount the copy over the card's folder. Changes are lost at power-off.
+# The card itself is never written. (Skipped per folder if the copy fails, so a failed copy never hides the card's files.)
+for d in etc var home
+do
+	if [ -d /media/linux/$d ]
+	then
+		# copy with tar through a pipe (cp -a of a folder fails on this system: "not a directory"); -m: do not restore the
+		# file dates (the console's clock is years behind the PC's, which made tar print a warning per file)
+		echo "tar $d" >> $LOG
+		if ls /media/linux/$d | grep -q .
