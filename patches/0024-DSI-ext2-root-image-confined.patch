diff --git a/vendors/Nintendo/DSI/rc b/vendors/Nintendo/DSI/rc
index 99c4f55bc..1ac0b3d8d 100644
--- a/vendors/Nintendo/DSI/rc
+++ b/vendors/Nintendo/DSI/rc
@@ -1,82 +1,29 @@
 #!/bin/sh
-
+# DSLinuxDSi boot script.
+#  1. /tmp is RAM.
+#  2. Preferred root: an ext2 image file sd:/linux/ROOTFS.IMG, seen as /dev/dsiroot, mounted read-write at /media/linux. The ARM7
