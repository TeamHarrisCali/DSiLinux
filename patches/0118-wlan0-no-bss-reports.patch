From 5c6d4ebc7729c58174b32f91c78da89ca7ddc577 Mon Sep 17 00:00:00 2001
From: TeamHarrisCali <34009957+TeamHarrisCali@users.noreply.github.com>
Date: Fri, 13 Nov 2026 11:51:19 -0600
Subject: [PATCH] wlan0: no BSS reports after the scan, faster receive, longer
 test wait

w98p connected on the third connect, after more than 40 s: 291 mailbox
packets had arrived, mostly BSS info events (227 before the first retry),
and data packets flowed once connected (33 to the stack). The scan kept
reporting beacons and the byte-by-byte receive could not keep up.
- BSS filter "none" after the scan and during connect (dswifi's 4 asks for
  a report per beacon).
- The thread takes up to 16 packets per round and does not pause while
  more are waiting.
- The test waits up to 90 s for CONNECTED, then DHCP with one retry.
- Helpers called from upload() are noinline: inlined, they made upload()
  crash gcc 4.0.4 again.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 linux-2.6.x/arch/arm/mach-nds/dsiwifi.c | 28 +++++++++++++++----------
 vendors/Nintendo/DSI/wifi-dsi-test      |  7 ++++---
 2 files changed, 21 insertions(+), 14 deletions(-)

diff --git a/linux-2.6.x/arch/arm/mach-nds/dsiwifi.c b/linux-2.6.x/arch/arm/mach-nds/dsiwifi.c
index 17c58744e..cd8ba155e 100644
--- a/linux-2.6.x/arch/arm/mach-nds/dsiwifi.c
+++ b/linux-2.6.x/arch/arm/mach-nds/dsiwifi.c
@@ -129,7 +129,7 @@ static unsigned int op(unsigned int o, unsigned int addr, unsigned int arg, cons
 }
 
 /* read back the first 32 bytes of a written part and compare them with the file */
-static void verify(unsigned int addr, const unsigned char *p, unsigned int size, int *bad)
+static noinline void verify(unsigned int addr, const unsigned char *p, unsigned int size, int *bad)
 {
 	unsigned int n = size < 32 ? size : 32;
 	int b2 = 0;
@@ -148,7 +148,7 @@ static void verify(unsigned int addr, const unsigned char *p, unsigned int size,
 	}
 }
 
-static void write_part(const char *name, unsigned int addr, const unsigned char *p, unsigned int size, int *bad)
+static noinline void write_part(const char *name, unsigned int addr, const unsigned char *p, unsigned int size, int *bad)
 {
 	unsigned int done;
 
@@ -206,7 +206,7 @@ static int nnets;
 static unsigned char mac[6];
 static int wmi_ready, reg_domain, scan_done;
 
-static void mbox_out_x(int endpoint, int ack, unsigned int word, unsigned int id, const void *data, unsigned int len, int *bad)
+static noinline void mbox_out_x(int endpoint, int ack, unsigned int word, unsigned int id, const void *data, unsigned int len, int *bad)
 {
 	unsigned int full = (len + 8 + 0x7F) & ~0x7Fu;
 
@@ -234,7 +234,7 @@ static int wifi_mhz_to_channel(unsigned int mhz)
 	return mhz == 2484 ? 14 : 1 + (int)(mhz - 2412) / 5;
 }
 
-static void bss_info(const unsigned char *d, int len)
+static noinline void bss_info(const unsigned char *d, int len)
 {
 	/* u16 channel (MHz), u8 frame type, u8 snr, s16 rssi, u8 bssid[6], u32 ieMask; then the beacon: u64 timestamp, u16 interval,
 	 * u16 capability, elements */
@@ -410,7 +410,7 @@ static int pump(int ms, int *flag, int *bad)
 	return *flag;
 }
 
-static void wmi_scan(int *bad)
+static noinline void wmi_scan(int *bad)
 {
 	unsigned char b[40];
 	int i;
@@ -445,6 +445,10 @@ static void wmi_scan(int *bad)
 	mbox_out(1, 1, WMI_START_SCAN_CMD, b, 20, bad);
 	scan_done = 0;
 	pump(6000, &scan_done, bad);
+	/* the scan keeps reporting beacons (w98p: 227 BSS info events before the first connect retry, the connect delayed by the backlog
+	 * of byte-by-byte transfers): no more BSS reports from here on */
+	memset(b, 0, sizeof(b));
+	mbox_out(1, 1, WMI_SET_BSS_FILTER_CMD, b, 8, bad);
 	lg(scan_done ? "  scan complete: %u networks\n" : "  scan did not report completion: %u networks\n", nnets, 0, 0);
 	for (i = 0; i < nnets && i < 16; i++) {
 		char line[96];
@@ -456,7 +460,7 @@ static void wmi_scan(int *bad)
 }
 
 /* after the firmware started: HTC services, WMI ready, then a scan */
-static void htc_wmi(unsigned int hi, int *bad)
+static noinline void htc_wmi(unsigned int hi, int *bad)
 {
 	static const unsigned char svc[5][6] = {
 		{ 0x0, 0x1, 0x0, 0, 0, 0 }, { 0x1, 0x1, 0x5, 0, 0, 0 }, { 0x2, 0x1, 0x5, 0, 0, 0 },
@@ -501,7 +505,8 @@ static void htc_wmi(unsigned int hi, int *bad)
 	wmi_scan(bad);
 }
 
-/* the firmware parts of the chosen blob (static: gcc 4.0.4 crashed compiling upload() with them on the stack) */
+/* the firmware parts of the chosen blob (static: gcc 4.0.4 crashed compiling upload() with them on the stack; the helpers upload()
+ * calls are noinline for the same reason: inlined, they made upload() big enough to crash the compiler again) */
 static const unsigned char *part[6];
 static unsigned int paddr[6], psize[6];
 
@@ -657,7 +662,7 @@ static int wifi_channel_to_mhz(int ch)
 }
 
 /* dswifi's wmi_connect() for an open network */
-static void do_connect(void)
+static noinline void do_connect(void)
 {
 	unsigned char b[64];
 	struct net2 *n = 0;
@@ -681,8 +686,7 @@ static void do_connect(void)
 		snprintf(line, sizeof(line), "connect: %s, channel %d, signal %d\n", n->ssid, n->channel, n->rssi);
 		lgs(line);
 	}
-	memset(b, 0, sizeof(b));
-	b[0] = 4;						/* BSS filter: the current beacon */
+	memset(b, 0, sizeof(b));				/* BSS filter: none (dswifi uses 4, "current beacon": a report per beacon) */
 	mbox_out(1, 1, WMI_SET_BSS_FILTER_CMD, b, 8, &bad);
 	memset(b, 0, sizeof(b));				/* scan params 5, 200, 200, 200 */
 	for (i = 0; i < 6; i++)
@@ -821,13 +825,15 @@ static int wthread(void *arg)
 			disc_pending = 0;
 			mbox_out(1, 1, WMI_DISCONNECT_CMD, 0, 0, &bad);
 		}
-		for (i = 0; i < 8; i++) {			/* whatever arrived: at most 8 packets per round */
+		for (i = 0; i < 16; i++) {			/* whatever arrived: at most 16 packets per round */
 			unsigned int out[19];
 
 			if (dsisd_twlop_rx(12, 0, 0, 0, 0, out, rx) != 0 || out[1] == 5)
 				break;
 			handle_pkt(out[0], 0);
 		}
+		if (i == 16)					/* more waiting: no pause */
+			continue;
 		wait_event_interruptible_timeout(thr_wait, !thr_run || skb_queue_len(&txq) || conn_pending || disc_pending, 2);
 	}
 	complete_and_exit(&thr_done, 0);
diff --git a/vendors/Nintendo/DSI/wifi-dsi-test b/vendors/Nintendo/DSI/wifi-dsi-test
index 4282f1aaa..227834470 100644
--- a/vendors/Nintendo/DSI/wifi-dsi-test
+++ b/vendors/Nintendo/DSI/wifi-dsi-test
@@ -24,7 +24,7 @@ ifconfig wlan0 up >> $L 2>&1
 echo "connecting to ${1:-the strongest open network}..."
 echo "connect $1" > /proc/dsiwifi2
 N=0
-while [ $N -lt 20 ]
+while [ $N -lt 45 ]
 do
 	grep -q CONNECTED /proc/dsiwifi2 && break
 	sleep 2
@@ -32,9 +32,10 @@ do
 done
 T=`expr $N \* 2`
 grep -q CONNECTED /proc/dsiwifi2 && echo "connected after about $T s" >> $L
-grep -q CONNECTED /proc/dsiwifi2 || echo "NOT connected after 40 s" >> $L
+grep -q CONNECTED /proc/dsiwifi2 || echo "NOT connected after 90 s" >> $L
 echo "DHCP..."
-udhcpc -n -q -i wlan0 >> $L 2>&1
+sleep 2
+udhcpc -n -q -i wlan0 >> $L 2>&1 || udhcpc -n -q -i wlan0 >> $L 2>&1
 ifconfig wlan0 >> $L 2>&1
 /usr/bin/cat /proc/net/route >> $L 2>&1
 echo "ping..."
-- 
2.56.0

