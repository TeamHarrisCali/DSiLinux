From 39ec4585f8b0414a8248b943577e722de5db9140 Mon Sep 17 00:00:00 2001
From: TeamHarrisCali <34009957+TeamHarrisCali@users.noreply.github.com>
Date: Fri, 13 Nov 2026 01:21:47 -0600
Subject: [PATCH] Latching Ctrl/Alt on the touch keyboard, no L+R server quit,
 msh >> appends

- Touch keyboard: a tap on Ctrl or Alt keeps it down until the next key is
  typed (one finger cannot hold Ctrl and press C), so Ctrl+C works.
- nano-X: drop upstream's "both mouse buttons quit the server"; on the DSi
  those are R and L, and the desktop vanished (looked like a freeze).
- msh: open >> files with O_APPEND instead of open + seek to the end, so
  several programs appending to one log no longer overwrite each other.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../drivers/input/touchscreen/nds_ts.c        | 30 +++++++++++++++++--
 user/busybox/shell/msh.c                      |  6 ++--
 user/microwin/src/nanox/srvevent.c            |  4 +--
 3 files changed, 32 insertions(+), 8 deletions(-)

diff --git a/linux-2.6.x/drivers/input/touchscreen/nds_ts.c b/linux-2.6.x/drivers/input/touchscreen/nds_ts.c
index 177d1de6c..32f8e41a0 100644
--- a/linux-2.6.x/drivers/input/touchscreen/nds_ts.c
+++ b/linux-2.6.x/drivers/input/touchscreen/nds_ts.c
@@ -560,6 +560,17 @@ static void draw_pad(void)
 	draw_arrows();
 }
 
+/*
+ * Ctrl and Alt on the touch keyboard latch: one finger cannot hold Ctrl and press C, so a tap on Ctrl/Alt keeps it down until the next key
+ * has been typed (a second tap on it lets it go). Ctrl+C stops a program in the terminal, which was impossible before.
+ */
+static u16 held_mod = KEY_RESERVED;
+
+static int is_latch_key(u16 key)
+{
+	return key == KEY_LEFTCTRL || key == KEY_RIGHTCTRL || key == KEY_LEFTALT || key == KEY_RIGHTALT;
+}
+
 static void update_keyboard(u16 pressedKey)
 {
 	int x,y ;
@@ -586,7 +597,7 @@ static void update_keyboard(u16 pressedKey)
 				keysym = plain_map[key];
 				type = KTYP(keysym) ;
 				type -= 0xf0;
-				if ( key == pressedKey || 
+				if ( key == pressedKey || key == held_mod ||
 						( type == KT_SLOCK &&
 						  ( 1 << (keysym & 0xff) ) & kbd->slockstate ) )
 				{
@@ -720,8 +731,17 @@ static void ndstouch_input_event(u8 touched, u8 x, u8 y)
 						switch_to_mouse_mode();
 						break ;
 					}
-					currentKey = key ;
-					input_report_key(dev, currentKey, 1 ) ;
+					if (is_latch_key(key)) {
+						if (held_mod != KEY_RESERVED)
+							input_report_key(dev, held_mod, 0);
+						held_mod = held_mod == key ? KEY_RESERVED : key;
+						if (held_mod != KEY_RESERVED)
+							input_report_key(dev, held_mod, 1);
+						currentKey = KEY_RESERVED;	/* nothing to let go when the finger lifts */
+					} else {
+						currentKey = key ;
+						input_report_key(dev, currentKey, 1 ) ;
+					}
 				}
 			}
 			else if ( wasTouched )
@@ -730,6 +750,10 @@ static void ndstouch_input_event(u8 touched, u8 x, u8 y)
 				{
 					input_report_key(dev, currentKey, 0 ) ;
 					currentKey = KEY_RESERVED ;
+					if (held_mod != KEY_RESERVED) {		/* the latched Ctrl/Alt was used: let it go */
+						input_report_key(dev, held_mod, 0);
+						held_mod = KEY_RESERVED;
+					}
 				}
 				wasTouched = FALSE ;
 			}
diff --git a/user/busybox/shell/msh.c b/user/busybox/shell/msh.c
index bb1219cd2..7cd9cc71d 100644
--- a/user/busybox/shell/msh.c
+++ b/user/busybox/shell/msh.c
@@ -3122,10 +3122,10 @@ int pipein, pipeout;
 		break;
 
 	case IOWRITE | IOCAT:
-		if ((u = open(cp, 1)) >= 0) {
-			lseek(u, (long) 0, 2);
+		/* O_APPEND, not open + seek to the end: several programs append to one log at once (the desktop's), and with a seek they
+		 * wrote over each other's lines */
+		if ((u = open(cp, O_WRONLY | O_APPEND)) >= 0)
 			break;
-		}
 	case IOWRITE:
 		u = creat(cp, 0666);
 		break;
diff --git a/user/microwin/src/nanox/srvevent.c b/user/microwin/src/nanox/srvevent.c
index 6506c19da..de90924f6 100644
--- a/user/microwin/src/nanox/srvevent.c
+++ b/user/microwin/src/nanox/srvevent.c
@@ -275,8 +275,8 @@ void GsHandleMouseStatus(GR_COORD newx, GR_COORD newy, int newbuttons)
 	 */
 	changebuttons = (~curbuttons & newbuttons);
 	if (changebuttons) {
-if ((newbuttons&(GR_BUTTON_L|GR_BUTTON_R)) == (GR_BUTTON_L|GR_BUTTON_R))
-GsTerminate();
+/* DSLinuxDSi: upstream quit the whole server when both mouse buttons were down together. On the DSi those are the R and L shoulder
+ * buttons (and L+R is the Game Boy emulator's "quit"): the desktop vanished and the screen looked frozen. Exit desktop is in the Start menu. */
 		GsResetScreenSaver();
 		GsDeliverButtonEvent(GR_EVENT_TYPE_BUTTON_DOWN,
 			newbuttons, changebuttons, modifiers);
-- 
2.56.0

