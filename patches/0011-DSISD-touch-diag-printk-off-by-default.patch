From 58207a800b323e966f47cc6d5551912ad3a55ca3 Mon Sep 17 00:00:00 2001
From: TeamHarrisCali <noreply@example.invalid>
Date: Tue, 10 Nov 2026 20:57:20 -0600
Subject: [PATCH] DSISD: touch diagnostics printk behind
 CONFIG_NDS_DSISD_TOUCHDIAG (default off)

---
 linux-2.6.x/arch/arm/mach-nds/Kconfig   | 10 ++++++++++
 linux-2.6.x/drivers/block/dldi_c.c      |  4 ++++
 vendors/Nintendo/DSI/config.linux-2.6.x |  1 +
 3 files changed, 15 insertions(+)

diff --git a/linux-2.6.x/arch/arm/mach-nds/Kconfig b/linux-2.6.x/arch/arm/mach-nds/Kconfig
index 097f1eccb..03dc93bbf 100644
--- a/linux-2.6.x/arch/arm/mach-nds/Kconfig
+++ b/linux-2.6.x/arch/arm/mach-nds/Kconfig
@@ -34,6 +34,16 @@ config NDS_DSISD_WRITE
 	  write path can corrupt the card's FAT, so use a spare or backed-up
 	  card when you say Y.
 
+config NDS_DSISD_TOUCHDIAG
+	bool "Print DSi touch diagnostics to the console"
+	depends on NDS_DSISD
+	default n
+	help
+	  Prints a 'dsitouch:' line to the console every 2 seconds while the DSi
+	  touch reader's counters change, i.e. a new line each time you touch the
+	  screen. Only useful when debugging the DSi touch reader.
+	  If unsure, say N.
+
 config NDS_TEXT_CONSOLE
 	bool "Nintendo DS text console"
 	depends on ARCH_NDS
diff --git a/linux-2.6.x/drivers/block/dldi_c.c b/linux-2.6.x/drivers/block/dldi_c.c
index 4cf629ddd..32e0abfa7 100644
--- a/linux-2.6.x/drivers/block/dldi_c.c
+++ b/linux-2.6.x/drivers/block/dldi_c.c
@@ -177,7 +177,9 @@ static void tdiag_fn(void *unused)
 			tdiag_first = 0;
 		}
 	}
+#ifdef CONFIG_NDS_DSISD_TOUCHDIAG
 	schedule_delayed_work(&tdiag_work, 2 * HZ);
+#endif
 }
 
 static int dsisd_start(void)
@@ -188,8 +190,10 @@ static int dsisd_start(void)
 	nds_fifo_send(FIFO_FIRMWARE_CMD(FIFO_FIRMWARE_CMD_SD_ADDRESS,
 					(u32)&sd_block));
 	ret = sd_request(NDS_SD_CMD_INIT, 0, 0);
+#ifdef CONFIG_NDS_DSISD_TOUCHDIAG
 	INIT_WORK(&tdiag_work, tdiag_fn, NULL);
 	schedule_delayed_work(&tdiag_work, 2 * HZ);
+#endif
 	printk(KERN_INFO "dsisd: init result %d, SCFG_EXT %08x, TMIO rev %04x, "
 	       "info %08x, sectors %u\n", ret, sd_block.info[0],
 	       sd_block.info[1], sd_block.info[2], sd_block.sectors);
diff --git a/vendors/Nintendo/DSI/config.linux-2.6.x b/vendors/Nintendo/DSI/config.linux-2.6.x
index ff90eead7..a2b1b83de 100644
--- a/vendors/Nintendo/DSI/config.linux-2.6.x
+++ b/vendors/Nintendo/DSI/config.linux-2.6.x
@@ -99,6 +99,7 @@ CONFIG_FLASH_SIZE=0x00800000
 CONFIG_NDS_DSI=y
 CONFIG_NDS_DSISD=y
 # CONFIG_NDS_DSISD_WRITE is not set
+# CONFIG_NDS_DSISD_TOUCHDIAG is not set
 # CONFIG_NDS_TEXT_CONSOLE is not set
 # CONFIG_NDS_FASTGBA is not set
 # CONFIG_NDS_SOUNDTEST is not set
-- 
2.56.0

