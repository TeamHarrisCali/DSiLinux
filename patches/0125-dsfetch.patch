From 1bac71dc82dc6a4a784355ab61a60e303e51db4f Mon Sep 17 00:00:00 2001
From: TeamHarrisCali <34009957+TeamHarrisCali@users.noreply.github.com>
Date: Tue, 17 Nov 2026 01:23:54 -0600
Subject: [PATCH] dsfetch: neofetch for the DSi

neofetch needs bash (DSLinux has msh) and fastfetch a current compiler.
dsfetch is plain C: a DSi XL in ASCII beside (wide terminal) or above
(the desktop's 42-column Terminal) OS, host, kernel, uptime, programs,
shell, display, desktop, CPU, memory, disk, Wi-Fi (chip, network,
address) and battery, with colour blocks; -n for no colours.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 vendors/Nintendo/DSI/dsfetch.c | 273 +++++++++++++++++++++++++++++++++
 1 file changed, 273 insertions(+)
 create mode 100644 vendors/Nintendo/DSI/dsfetch.c

diff --git a/vendors/Nintendo/DSI/dsfetch.c b/vendors/Nintendo/DSI/dsfetch.c
new file mode 100644
index 000000000..d9fb3998d
--- /dev/null
+++ b/vendors/Nintendo/DSI/dsfetch.c
@@ -0,0 +1,273 @@
+/*
+ * dsfetch - neofetch for the DSi: a DSi XL in ASCII and the system's facts beside it, in colour.
+ * neofetch needs bash (DSLinux has msh) and fastfetch a current compiler; this is plain C for gcc 4.0.4 and uClibc.
+ * Built and put on the card by scripts/build-dsfetch.sh; run "dsfetch" in the Terminal or over SSH ("dsfetch -n": no colours).
+ * Sources: uname, /proc/uptime, /proc/meminfo, /proc/cpuinfo, statfs("/"), /proc/dsisettings (battery 0-15), the interfaces
+ * wlan0 (the DSi's own Wi-Fi chip) and nds (the DS chip), /tmp/wifi.current (the network the Wi-Fi window joined), /proc (Nano-X).
+ * The logo goes beside the facts in a wide terminal (SSH) and above them in a narrow one (the desktop's Terminal, 42 columns).
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <dirent.h>
+#include <sys/utsname.h>
+#include <sys/vfs.h>
+#include <sys/ioctl.h>
+#include <termios.h>
+#include <sys/socket.h>
+#include <net/if.h>
+#include <netinet/in.h>
+#include <arpa/inet.h>
+
+static const char *logo[] = {
+	" .-----------. ",
+	" | .-------. | ",
+	" | |       | | ",
+	" | |  DSi  | | ",
+	" | '-------' | ",
+	" '-----------' ",
+	" .-----------. ",
+	" | + .---. o | ",
+	" |   |   | o | ",
+	" |   '---'   | ",
+	" '-----------' ",
+};
+#define LOGO_LINES	(int)(sizeof(logo) / sizeof(logo[0]))
+
+static int color = 1;
+static char lines[20][96];
+static int nlines;
+
+static void add(const char *key, const char *val)
+{
+	if (nlines >= 20 || !val || !val[0])
+		return;
+	if (color)
+		snprintf(lines[nlines++], sizeof(lines[0]), "\033[1;36m%s\033[0m: %s", key, val);
+	else
+		snprintf(lines[nlines++], sizeof(lines[0]), "%s: %s", key, val);
+}
+
+/* the first line of a file that starts with key, value after it (spaces and ':' skipped) */
+static int file_value(const char *path, const char *key, char *out, int n)
+{
+	FILE *f = fopen(path, "r");
+	char line[160];
+	int found = 0, k = strlen(key);
+
+	out[0] = 0;
+	if (!f)
+		return 0;
+	while (fgets(line, sizeof(line), f)) {
+		if (!strncmp(line, key, k)) {
+			char *v = line + k, *nl;
+
+			while (*v == ' ' || *v == '\t' || *v == ':')
+				v++;
+			if ((nl = strchr(v, '\n')))
+				*nl = 0;
+			snprintf(out, n, "%s", v);
+			found = 1;
+			break;
+		}
+	}
+	fclose(f);
+	return found;
+}
+
+static long meminfo_kb(const char *key)
+{
+	char v[64];
+
+	return file_value("/proc/meminfo", key, v, sizeof(v)) ? atol(v) : -1;
+}
+
+/* the IPv4 address of an interface that is up, as text, or "" */
+static void if_addr(const char *name, char *out)
+{
+	struct ifreq ifr;
+	int fd = socket(AF_INET, SOCK_DGRAM, 0);
+
+	out[0] = 0;
+	if (fd < 0)
+		return;
+	memset(&ifr, 0, sizeof(ifr));
+	strcpy(ifr.ifr_name, name);
+	if (ioctl(fd, SIOCGIFFLAGS, &ifr) == 0 && (ifr.ifr_flags & IFF_UP)) {
+		ifr.ifr_addr.sa_family = AF_INET;
+		if (ioctl(fd, SIOCGIFADDR, &ifr) == 0) {
+			struct in_addr a = ((struct sockaddr_in *)&ifr.ifr_addr)->sin_addr;
+
+			strcpy(out, a.s_addr ? inet_ntoa(a) : "up, no address");
+		}
+	}
+	close(fd);
+}
+
+/* a process of this name runs (its /proc/PID/stat names it) */
+static int running(const char *name)
+{
+	DIR *d = opendir("/proc");
+	struct dirent *e;
+	char path[64], buf[96], want[40];
+	int found = 0;
+
+	if (!d)
+		return 0;
+	snprintf(want, sizeof(want), "(%s)", name);
+	while (!found && (e = readdir(d))) {
+		FILE *f;
+
+		if (e->d_name[0] < '1' || e->d_name[0] > '9')
+			continue;
+		snprintf(path, sizeof(path), "/proc/%s/stat", e->d_name);
+		if ((f = fopen(path, "r"))) {
+			if (fgets(buf, sizeof(buf), f) && strstr(buf, want))
+				found = 1;
+			fclose(f);
+		}
+	}
+	closedir(d);
+	return found;
+}
+
+static int count_files(const char *dir)
+{
+	DIR *d = opendir(dir);
+	struct dirent *e;
+	int n = 0;
+
+	if (!d)
+		return 0;
+	while ((e = readdir(d)))
+		if (e->d_name[0] != '.')
+			n++;
+	closedir(d);
+	return n;
+}
+
+int main(int argc, char **argv)
+{
+	struct utsname u;
+	struct statfs fs;
+	char t[96], v[96], host[64], ip[32];
+	double up = 0;
+	long total, avail;
+	int i, n;
+	FILE *f;
+
+	if (argc > 1 && !strcmp(argv[1], "-n"))
+		color = 0;
+
+	if (gethostname(host, sizeof(host)) != 0)
+		strcpy(host, "dsi");
+	snprintf(t, sizeof(t), color ? "\033[1;36m%s\033[0m@\033[1;36m%s\033[0m" : "%s@%s", getenv("USER") ? getenv("USER") : "root",
+		 host);
+	snprintf(lines[nlines++], sizeof(lines[0]), "%s", t);
+	strcpy(lines[nlines++], "-----------------");
+
+	add("OS", "DSLinuxDSi (uClinux, DSi mode)");
+	add("Host", "Nintendo DSi XL");
+	if (uname(&u) == 0) {
+		snprintf(t, sizeof(t), "%s %s", u.sysname, u.release);
+		add("Kernel", t);
+	}
+	if ((f = fopen("/proc/uptime", "r"))) {
+		if (fscanf(f, "%lf", &up) == 1) {
+			long s = (long)up;
+
+			if (s >= 3600)
+				snprintf(t, sizeof(t), "%ld h %ld min", s / 3600, s / 60 % 60);
+			else
+				snprintf(t, sizeof(t), "%ld min %ld s", s / 60, s % 60);
+			add("Uptime", t);
+		}
+		fclose(f);
+	}
+	snprintf(t, sizeof(t), "%d (/usr/bin), %d (/boot)", count_files("/usr/bin"), count_files("/boot"));
+	add("Programs", t);
+	add("Shell", "msh (BusyBox)");
+	add("Display", "256x192 top + 256x192 touch");
+	add("Desktop", running("nano-X") ? (running("dsdesk") ? "Nano-X + dsdesk (Windows 95 style)" : "Nano-X") : "text console");
+	if (file_value("/proc/cpuinfo", "Processor", v, sizeof(v)) || file_value("/proc/cpuinfo", "model name", v, sizeof(v))) {
+		snprintf(t, sizeof(t), "%s + ARM7", v);
+		add("CPU", t);
+	}
+	total = meminfo_kb("MemTotal");
+	if (total > 0) {
+		long used = total - meminfo_kb("MemFree") - meminfo_kb("Buffers") - meminfo_kb("Cached");
+
+		snprintf(t, sizeof(t), "%ld.%ld / %ld.%ld MiB (%ld%%)", used / 1024, used % 1024 * 10 / 1024, total / 1024,
+			 total % 1024 * 10 / 1024, used * 100 / total);
+		add("Memory", t);
+	}
+	if (statfs("/", &fs) == 0 && fs.f_blocks) {
+		total = (long)(fs.f_blocks * (fs.f_bsize / 1024));
+		avail = (long)(fs.f_bfree * (fs.f_bsize / 1024));
+		snprintf(t, sizeof(t), "%ld / %ld MiB", (total - avail) / 1024, total / 1024);
+		add("Disk (/)", t);
+	}
+	if_addr("wlan0", ip);
+	if (ip[0]) {
+		char net[40] = "";
+
+		if ((f = fopen("/tmp/wifi.current", "r"))) {
+			if (fgets(net, sizeof(net), f))
+				net[strcspn(net, "\n")] = 0;
+			fclose(f);
+		}
+		snprintf(t, sizeof(t), "%s%s%s (DSi chip)", net, net[0] ? " " : "", ip);
+	} else {
+		if_addr("nds", ip);
+		if (ip[0])
+			snprintf(t, sizeof(t), "%s (DS chip)", ip);
+		else
+			strcpy(t, "off");
+	}
+	add("Wi-Fi", t);
+	if ((f = fopen("/proc/dsisettings", "r"))) {
+		int b = -1, c = 0;
+
+		if (fscanf(f, "battery=%d charger=%d", &b, &c) >= 1 && b >= 0) {
+			snprintf(t, sizeof(t), "%d%%%s", b * 100 / 15, c ? " (charging)" : "");
+			add("Battery", t);
+		}
+		fclose(f);
+	}
+	if (color) {
+		t[0] = 0;
+		for (i = 0; i < 8; i++)
+			snprintf(t + strlen(t), sizeof(t) - strlen(t), "\033[4%dm   ", i);
+		strcat(t, "\033[0m");
+		nlines++;			/* an empty line, then the colour blocks */
+		snprintf(lines[nlines++], sizeof(lines[0]), "%s", t);
+	}
+
+	{
+		struct winsize ws;
+
+		if (ioctl(1, TIOCGWINSZ, &ws) == 0 && ws.ws_col > 0 && ws.ws_col < 58) {	/* narrow: logo, then the facts */
+			printf("\n");
+			for (i = 0; i < LOGO_LINES; i++)
+				printf(color ? "\033[1;37m%s\033[0m\n" : "%s\n", logo[i]);
+			printf("\n");
+			for (i = 0; i < nlines; i++)
+				printf("%s\n", lines[i]);
+			printf("\n");
+			return 0;
+		}
+	}
+	n = nlines > LOGO_LINES ? nlines : LOGO_LINES;
+	printf("\n");
+	for (i = 0; i < n; i++) {
+		const char *l = i < LOGO_LINES ? logo[i] : "               ";
+
+		if (color)
+			printf("\033[1;37m%s\033[0m %s\n", l, i < nlines ? lines[i] : "");
+		else
+			printf("%s %s\n", l, i < nlines ? lines[i] : "");
+	}
+	printf("\n");
+	return 0;
+}
-- 
2.56.1

