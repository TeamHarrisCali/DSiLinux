 static irqreturn_t ndsbutton_interrupt(int irq, void *dev_id, struct pt_regs *regs)
 {
 	int i;
 	u16 state = readw(REG_KEYINPUT);
+	u16 pr = ~state & 0x3ff;
 
+	if ((pr & ~prev_main) && nds_screen_activity())
+		eat_main |= pr;			/* this press only woke the screen */
+	prev_main = pr;
+	eat_main &= pr;				/* released: forgotten */
+	state |= eat_main;			/* held back: reported as not pressed */
 	ndsbutton_raw = (ndsbutton_raw & 0xc00) | (~state & 0x3ff);
 	if (ndsbutton_game)
 		return IRQ_HANDLED;
@@ -89,6 +100,16 @@ static void ndsbutton_xkeys(u32 state)
 		nds_volume_msg(state);
 		return;
 	}
+	{
+		u16 pr = ~state & 3;		/* X, Y */
+
+		if ((pr & ~prev_x) && nds_screen_activity())
+			eat_x |= pr;
+		prev_x = pr;
+		eat_x &= pr;
+		state |= eat_x;
+	}
+	nds_lid((state >> 7) & 1);		/* the hinge: 1 = closed */
 	ndsbutton_raw = (ndsbutton_raw & 0x3ff) | ((~state & 3) << 10);
 	for (i = 0 ; i < (sizeof(ndsbuttons2)/sizeof(ndsbuttons2[0])) ; i++)
 	{
diff --git a/linux-2.6.x/arch/arm/mach-nds/screensleep.c b/linux-2.6.x/arch/arm/mach-nds/screensleep.c
new file mode 100644
index 000000000..3dd7caed4
--- /dev/null
+++ b/linux-2.6.x/arch/arm/mach-nds/screensleep.c
@@ -0,0 +1,84 @@
+/*
+ * Screen sleep and the lid (docs/SLEEP-LOCK-PLAN.md, steps 2 and 3): the backlights go off after a time without local input, and at
+ * once when the lid closes; any touch or button brings them back (the lid must be open). Programs keep running: Wi-Fi, SSH and
+ * downloads go on. The input drivers (button.c, nds_ts.c) report every new press with nds_screen_activity(), and drop the press that
+ * woke the screen, so waking never clicks or types. Input over SSH does not count: it is not someone in front of the DSi.
+ * The backlights are switched with the ARM7's FIFO_POWER_CMD_BACKLIGHT_POWER (the power chip's backlight bits, as DSLinux's ndsbl).
+ * /proc/dsisettings (volume.c): "sleep N" seconds without input before the screen goes off (0 = never; default 120), "screen off" /
+ * "screen on"; the read line gains sleep=N screen=on|off lid=open|closed.
+ */
+#include <linux/kernel.h>
+#include <linux/init.h>
+#include <linux/timer.h>
+#include <linux/jiffies.h>
+#include <asm/arch/fifo.h>
+
+int nds_sleep_secs = 120;
+int nds_screen_is_off;
+int nds_lid_closed;
+static unsigned long last_input;
+static struct timer_list ss_timer;
+
+static void backlights(int on)
+{
+	nds_fifo_send(FIFO_POWER_CMD(FIFO_POWER_CMD_BACKLIGHT_POWER, on ? 1 : 0));
+}
+
+void nds_screen_off(void)
+{
+	if (!nds_screen_is_off) {
+		nds_screen_is_off = 1;
+		backlights(0);
+	}
+}
+
+void nds_screen_on(void)
+{
+	last_input = jiffies;
+	if (nds_screen_is_off && !nds_lid_closed) {
+		nds_screen_is_off = 0;
+		backlights(1);
+	}
+}
+
+/* a new local press (touch or button): 1 if the screen was off, then the caller drops this press */
+int nds_screen_activity(void)
+{
+	last_input = jiffies;
+	if (nds_screen_is_off && !nds_lid_closed) {
+		nds_screen_on();
+		return 1;
+	}
+	return 0;
+}
+
+/* the lid switch (button.c, from the ARM7's hinge bit): closed = screen off at once, opened = on */
+void nds_lid(int closed)
+{
+	if (closed == nds_lid_closed)
+		return;
+	nds_lid_closed = closed;
+	if (closed)
+		nds_screen_off();
+	else
+		nds_screen_on();
+}
+
+static void ss_tick(unsigned long data)
+{
+	if (nds_sleep_secs > 0 && !nds_screen_is_off && time_after(jiffies, last_input + (unsigned long)nds_sleep_secs * HZ))
+		nds_screen_off();
+	mod_timer(&ss_timer, jiffies + HZ);
+}
+
+static int __init nds_screensleep_init(void)
+{
+	last_input = jiffies;
+	init_timer(&ss_timer);
+	ss_timer.function = ss_tick;
+	ss_timer.expires = jiffies + HZ;
+	add_timer(&ss_timer);
+	return 0;
+}
+
+module_init(nds_screensleep_init);
