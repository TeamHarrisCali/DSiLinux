+extern void nds_screen_on(void);
 extern int ndspad_gain;
 
 /*
@@ -96,6 +99,8 @@ extern int ndspad_gain;
  *   write: "backlight N" (1..5, never off) or "padgain N" (1..8)
  *          or "rtc YYYY MM DD WD hh mm ss": the DSi's clock chip (local time, as the DSi's own menu shows it; WD = weekday 0..6, Sunday 0).
  *          httpdate -w writes it after setting the clock from the network.
+ *          or "sleep N" (seconds without local input before the screen goes off, 0 = never) or "screen off" / "screen on"
+ *   the read line also has sleep=N screen=on|off lid=open|closed (screensleep.c)
  */
 static int settings_read_proc(char *page, char **start, off_t off, int count, int *eof, void *data)
 {
@@ -108,7 +113,8 @@ static int settings_read_proc(char *page, char **start, off_t off, int count, in
 	chg = o[0] == 0xffffffff ? 0 : (int)((o[0] >> 7) & 1);
 	vol = o[1] == 0xffffffff ? -1 : (int)(o[1] & 0x1f);
 	bl = o[2] == 0xffffffff ? -1 : (int)(o[2] & 7) + 1;
-	len = sprintf(page, "battery=%d charger=%d volume=%d backlight=%d padgain=%d\n", bat, chg, vol, bl, ndspad_gain);
+	len = sprintf(page, "battery=%d charger=%d volume=%d backlight=%d padgain=%d sleep=%d screen=%s lid=%s\n", bat, chg, vol, bl,
+		      ndspad_gain, nds_sleep_secs, nds_screen_is_off ? "off" : "on", nds_lid_closed ? "closed" : "open");
 	*eof = 1;
 	if (off >= len)
 		return 0;
@@ -147,6 +153,15 @@ static int settings_write_proc(struct file *file, const char __user *buffer, uns
 		v[6] = s;
 		if (dsisd_rtc(v, NULL) != 0)
 			return -EIO;
+	} else if (!strncmp(buf, "sleep ", 6)) {
+		n = simple_strtoul(buf + 6, NULL, 10);
+		if (n > 3600)
+			return -EINVAL;
+		nds_sleep_secs = n;
+	} else if (!strncmp(buf, "screen off", 10)) {
+		nds_screen_off();
+	} else if (!strncmp(buf, "screen on", 9)) {
+		nds_screen_on();
 	} else if (!strncmp(buf, "padgain ", 8)) {
 		n = simple_strtoul(buf + 8, NULL, 10);
 		if (n < 1 || n > 8)
