 }
 
+extern int nds_screen_activity(void);	/* screen sleep (arch/arm/mach-nds/screensleep.c) */
+
 static void ndstouch_input_event(u8 touched, u8 x, u8 y)
 {
 	struct input_dev* dev = &ndstouch_dev;
 	static int wasTouched = FALSE ;
 	static u16 currentKey = KEY_RESERVED ;
+	static int eat_touch, prev_touched;
 	u16 key ;
 
+	/* a touch that wakes the screen does nothing else, until the stylus is lifted */
+	if (touched && !prev_touched && nds_screen_activity())
+		eat_touch = 1;
+	prev_touched = touched;
+	if (eat_touch) {
+		if (!touched)
+			eat_touch = 0;
+		return;
+	}
+
 	switch(mode) {
 		case KEYBOARD_MODE:
 			/* a touch that starts on the trackpad only moves the pointer, one that starts on the keyboard only types */
