diff --git a/linux-2.6.x/drivers/block/dldi_c.c b/linux-2.6.x/drivers/block/dldi_c.c
index a37e35655..50bf55c1a 100644
--- a/linux-2.6.x/drivers/block/dldi_c.c
+++ b/linux-2.6.x/drivers/block/dldi_c.c
@@ -288,6 +288,37 @@ int dsisd_twlwifi(unsigned int *out, int report)
 	return ret;
 }
 
+/* One firmware upload operation on the ARM7 (arm7/twlwifi.c, twl_wifi_op): op 2..9, addr, arg (a length for 2 and 4, else the argument),
+ * up to 2048 data bytes. out[0..2] = info (answer, status, flags); with op 8 (finish) also out[3..18] like a run (touch, diag). 0 = ok. */
+int dsisd_twlop(unsigned int op, unsigned int addr, unsigned int arg, const unsigned char *data, unsigned int len, unsigned int *out)
+{
+	int ret, i, save;
+
+	if (len > sizeof(sd_block.data))
+		return -2;
+	down(&sd_mutex);
+	for (i = 0; i < 8; i++)
+		sd_block.touch[i] = sd_block.diag[i] = 0;
+	for (i = 0; i < 3; i++)
+		sd_block.info[i] = 0;
+	sd_block.touch[0] = arg;
+	if (data && len)
+		memcpy(sd_block.data, data, len);
+	save = sd_timeout;
+	sd_timeout = 10 * HZ;
+	ret = sd_request_locked(NDS_SD_CMD_TWLWIFI, addr, op);
+	sd_timeout = save;
+	dmac_flush_range((unsigned long)&sd_block, (unsigned long)&sd_block + sizeof(sd_block));
+	for (i = 0; i < 3; i++)
+		out[i] = sd_block.info[i];
+	for (i = 0; i < 8; i++) {
+		out[3 + i] = sd_block.touch[i];
+		out[11 + i] = sd_block.diag[i];
+	}
+	up(&sd_mutex);
+	return ret;
+}
+
 /* Power chip status (and the backlight): op 1 sets the backlight register to val (0..4). out[0] battery register, out[1] volume register,
  * out[2] backlight register (0xffffffff = unreadable). 0 = ok. */
 int dsisd_pm(unsigned int op, unsigned int val, unsigned int *out)
