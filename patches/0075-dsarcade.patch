+/* ------------------------------------------------------------------- Sokoban */
+#define SK_T 14
+static struct sokoban sk;
+static unsigned char sk_floor[SK_MAXH][SK_MAXW];
+static int sk_level, sk_ox, sk_oy, sk_done;
+#define SK_FLOOR	GR_RGB(214, 196, 150)
+#define SK_BRICK	GR_RGB(150, 70, 40)
+#define SK_BOX		GR_RGB(220, 140, 30)
+#define SK_BOXOK	GR_RGB(70, 190, 70)
+#define SK_GOAL		GR_RGB(200, 40, 40)
+#define SK_ME		GR_RGB(40, 80, 220)
+
+static void sk_find_floor(void)
+{
+	int st[SK_MAXW * SK_MAXH][2], sp = 0, i;
+
+	memset(sk_floor, 0, sizeof(sk_floor));
+	st[sp][0] = sk.px;
+	st[sp++][1] = sk.py;
+	sk_floor[sk.py][sk.px] = 1;
+	while (sp) {
+		int x = st[--sp][0], y = st[sp][1];
+
+		for (i = 0; i < 4; i++) {
+			int nx = x + sk_dx[i], ny = y + sk_dy[i];
+
+			if (nx >= 0 && ny >= 0 && nx < SK_MAXW && ny < SK_MAXH && !sk.wall[ny][nx] && !sk_floor[ny][nx]) {
+				sk_floor[ny][nx] = 1;
+				st[sp][0] = nx;
+				st[sp++][1] = ny;
+			}
+		}
+	}
+}
+
+static void sk_cell(int x, int y)
+{
+	int px = sk_ox + x * SK_T, py = sk_oy + y * SK_T;
+
+	if (x < 0 || y < 0 || x >= sk.w || y >= sk.h)
+		return;
+	if (sk.wall[y][x]) {
+		fillc(SK_BRICK, px, py, SK_T, SK_T);
+		fillc(W95_DARK, px, py + SK_T / 2, SK_T, 1);
+		return;
+	}
+	if (!sk_floor[y][x]) {
+		fillc(W95_DARK, px, py, SK_T, SK_T);
+		return;
+	}
+	fillc(SK_FLOOR, px, py, SK_T, SK_T);
+	if (sk.goal[y][x])
+		fillc(SK_GOAL, px + 5, py + 5, 4, 4);
+	if (sk.box[y][x]) {
+		fillc(W95_DARK, px + 1, py + 1, SK_T - 2, SK_T - 2);
+		fillc(sk.goal[y][x] ? SK_BOXOK : SK_BOX, px + 2, py + 2, SK_T - 4, SK_T - 4);
+		fillc(W95_DARK, px + 5, py + 2, 1, SK_T - 4);
+	}
+	if (x == sk.px && y == sk.py) {
+		fillc(SK_ME, px + 3, py + 5, SK_T - 6, SK_T - 7);
+		fillc(W95_LIGHT, px + 4, py + 2, SK_T - 8, 4);
+	}
+}
+
+static void sk_panel(void)
+{
+	char s[24];
+
+	fillc(W95_FACE, 134, 0, WW - 134, 80);
+	text(W95_NAVY, 138, 4, "Sokoban");
+	sprintf(s, "level %d/%d", sk_level + 1, SK_LEVELS);
+	text(W95_DARK, 138, 18, s);
+	sprintf(s, "moves  %d", sk.moves);
+	text(W95_DARK, 138, 30, s);
+	sprintf(s, "pushes %d", sk.pushes);
+	text(W95_DARK, 138, 42, s);
+	if (sk_done)
+		text(GR_RGB(0, 140, 0), 138, 58, sk_level + 1 < SK_LEVELS ? "Solved! Next:" : "All solved!");
+}
+
+static void draw_sk(void)
+{
+	int x, y;
+
+	fillc(W95_DARK, 4, 4, 126, 126);
+	for (y = 0; y < sk.h; y++)
+		for (x = 0; x < sk.w; x++)
+			sk_cell(x, y);
+	sk_panel();
+}
+
+static void sk_start(int level)
+{
+	if (level < 0)
+		level = 0;
+	if (level >= SK_LEVELS)
+		level = SK_LEVELS - 1;
+	sk_level = level;
+	sk_load(&sk, level);
+	sk_find_floor();
+	sk_done = 0;
+	sk_ox = 4 + (126 - sk.w * SK_T) / 2;
+	sk_oy = 4 + (126 - sk.h * SK_T) / 2;
+}
+
+static void sk_line(void)
+{
+	int x, y;
+
+	for (y = 0; y < sk.h; y++)
+		for (x = 0; x < sk.w; x++)
+			if ((x - sk.px) * (x - sk.px) + (y - sk.py) * (y - sk.py) <= 4)
+				sk_cell(x, y);
+}
+
+static void key_sk(int k)
+{
+	int dir = -1, r;
+
+	switch (k) {
+	case MWKEY_UP: case 'w': dir = 0; break;
+	case MWKEY_RIGHT: case 'd': dir = 1; break;
+	case MWKEY_DOWN: case 's': dir = 2; break;
+	case MWKEY_LEFT: case 'a': dir = 3; break;
+	case ' ':
+	case 'u':
+		if (!sk_done && sk_undo(&sk)) {
+			sk_line();
+			sk_panel();
+		}
+		return;
+	case 'r':
+		sk_start(sk_level);
+		redraw_all(cur2d);
+		return;
+	case 'p':
+	case MWKEY_PAGEUP:
+		sk_start(sk_level - 1);
+		redraw_all(cur2d);
+		return;
+	case 'n':
+	case MWKEY_PAGEDOWN:
+		sk_start(sk_level + 1);
+		redraw_all(cur2d);
+		return;
+	case MWKEY_ENTER:
+		if (sk_done && sk_level + 1 < SK_LEVELS)
+			sk_start(sk_level + 1);
+		else
+			sk_start(sk_level);
+		redraw_all(cur2d);
+		return;
+	}
+	if (dir < 0 || sk_done)
+		return;
+	r = sk_move(&sk, dir);
+	if (r) {
+		sk_line();
+		if (sk_won(&sk)) {
+			sk_done = 1;
+			if (sk_level + 1 > load_int("/home/sokoban.lvl", 0))
+				save_int("/home/sokoban.lvl", sk_level + 1 < SK_LEVELS ? sk_level + 1 : sk_level);
+		}
+		sk_panel();
+	}
+}
+
+static void mouse_sk(int x, int y, int kind)
+{
+	int dx, dy;
+
+	if (kind != 1 || x >= 134)
+		return;
+	dx = (x - sk_ox) / SK_T - sk.px;
+	dy = (y - sk_oy) / SK_T - sk.py;
+	if (!dx && !dy)
+		return;
+	if (abs(dx) >= abs(dy))
+		key_sk(dx < 0 ? MWKEY_LEFT : MWKEY_RIGHT);
+	else
+		key_sk(dy < 0 ? MWKEY_UP : MWKEY_DOWN);
+}
+
+static void init_sk(void)
+{
+	sk_start(load_int("/home/sokoban.lvl", 0));
+}
+
+static const struct btn btn_sk[] = {
+	{ 138, 84, 56, 14, "Undo", 'u' }, { 138, 100, 56, 14, "Restart", 'r' },
+	{ 138, 116, 26, 14, "<", 'p' }, { 168, 116, 26, 14, ">", 'n' },
+};
+static const struct game2d game_sokoban = { "Sokoban", init_sk, draw_sk, key_sk, mouse_sk, NULL, NULL, btn_sk, 4, 0 };
