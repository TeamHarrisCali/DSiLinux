+/* ---------------------------------------------------------------------- Life */
+#define LW 40
+#define LH 30
+#define LC 4
+static unsigned char life_a[LW * LH], life_b[LW * LH];
+static int life_run, life_speed = 2, life_gen, life_cx = 20, life_cy = 15;
+static long life_next;
+static const int life_rate[4] = { 1, 3, 6, 12 };
+static char life_lab[8];
+#define LIFE_BG		GR_RGB(30, 30, 40)
+#define LIFE_ON		GR_RGB(90, 230, 90)
+#define LIFE_CUR	GR_RGB(255, 220, 0)
+
+static void life_cell(int x, int y)
+{
+	int px = 4 + x * LC, py = 4 + y * LC;
+
+	fillc(LIFE_BG, px, py, LC, LC);
+	if (life_a[y * LW + x])
+		fillc(LIFE_ON, px, py, LC - 1, LC - 1);
+	if (x == life_cx && y == life_cy) {
+		w95_hline(win, gc, LIFE_CUR, px, px + LC - 1, py);
+		w95_hline(win, gc, LIFE_CUR, px, px + LC - 1, py + LC - 1);
+		w95_vline(win, gc, LIFE_CUR, px, py, py + LC - 1);
+		w95_vline(win, gc, LIFE_CUR, px + LC - 1, py, py + LC - 1);
+	}
+}
+
+static void life_status(void)
+{
+	char s[32];
+
+	fillc(W95_FACE, 4, 126, 130, 10);
+	sprintf(s, "gen %d  %s  speed %d", life_gen, life_run ? "running" : "paused", life_speed + 1);
+	text(W95_DARK, 4, 126, s);
+	strcpy(life_lab, life_run ? "Pause" : "Run");
+}
+
+static void draw_life(void)
+{
+	int x, y;
+
+	fillc(LIFE_BG, 4, 4, LW * LC, LH * LC);
+	for (y = 0; y < LH; y++)
+		for (x = 0; x < LW; x++)
+			if (life_a[y * LW + x] || (x == life_cx && y == life_cy))
+				life_cell(x, y);
+	life_status();
+}
+
+static void life_random(void)
+{
+	int i;
+
+	for (i = 0; i < LW * LH; i++)
+		life_a[i] = arc_rnd(4) == 0;
+	life_gen = 0;
+}
+
+static void life_generation(void)
+{
+	int i, changed = 0, x, y;
+
+	life_step(life_a, life_b, LW, LH);
+	for (i = 0; i < LW * LH; i++)
+		if (life_a[i] != life_b[i])
+			changed++;
+	if (changed > 150) {
+		memcpy(life_a, life_b, sizeof(life_a));
+		draw_life();
+	} else {
+		unsigned char old[LW * LH];
+
+		memcpy(old, life_a, sizeof(old));
+		memcpy(life_a, life_b, sizeof(life_a));
+		for (y = 0; y < LH; y++)
+			for (x = 0; x < LW; x++)
+				if (old[y * LW + x] != life_a[y * LW + x])
+					life_cell(x, y);
+	}
+	life_gen++;
+	life_status();
+}
+
+static void life_move(int dx, int dy)
+{
+	int ox = life_cx, oy = life_cy;
+
+	life_cx = (life_cx + dx + LW) % LW;
+	life_cy = (life_cy + dy + LH) % LH;
+	life_cell(ox, oy);
+	life_cell(life_cx, life_cy);
+}
+
+static void life_toggle(int x, int y)
+{
+	life_a[y * LW + x] ^= 1;
+	life_cell(x, y);
+}
+
+static void key_life(int k)
+{
+	switch (k) {
+	case MWKEY_UP: life_move(0, -1); return;
+	case MWKEY_DOWN: life_move(0, 1); return;
+	case MWKEY_LEFT: life_move(-1, 0); return;
+	case MWKEY_RIGHT: life_move(1, 0); return;
+	case ' ':
+		life_toggle(life_cx, life_cy);
+		return;
+	case MWKEY_ENTER:
+	case 'p':
+		life_run = !life_run;
+		life_next = usec();
+		life_status();
+		redraw_all(cur2d);
+		return;
+	case 's':
+		life_generation();
+		return;
+	case 'r':
+		life_random();
+		draw_life();
+		return;
+	case 'c':
+		memset(life_a, 0, sizeof(life_a));
+		life_gen = 0;
+		draw_life();
+		return;
+	case '+':
+	case MWKEY_PAGEUP:
+		if (life_speed < 3) life_speed++;
+		life_status();
+		return;
+	case '-':
+	case MWKEY_PAGEDOWN:
+		if (life_speed > 0) life_speed--;
+		life_status();
+		return;
+	}
+}
+
+static void mouse_life(int x, int y, int kind)
+{
+	int cx = (x - 4) / LC, cy = (y - 4) / LC, ox = life_cx, oy = life_cy;
+
+	if (x < 4 || y < 4 || cx >= LW || cy >= LH)
+		return;
+	if (kind == 1) {
+		life_cx = cx;
+		life_cy = cy;
+		life_toggle(cx, cy);
+		life_cell(ox, oy);
+	} else if (kind == 2 && (cx != life_cx || cy != life_cy)) {	/* dragging draws */
+		life_cx = cx;
+		life_cy = cy;
+		if (!life_a[cy * LW + cx])
+			life_toggle(cx, cy);
+		life_cell(ox, oy);
+	}
+}
+
+static void tick_life(void)
+{
+	long now = usec();
+
+	if (life_run && now >= life_next) {
+		life_generation();
+		life_next = now + 1000000L / life_rate[life_speed];
+	}
+}
+
+static void init_life(void)
+{
+	life_random();
+	strcpy(life_lab, "Run");
+}
+
+static const struct btn btn_life[] = {
+	{ 168, 4, 30, 14, life_lab, MWKEY_ENTER }, { 168, 20, 30, 14, "Step", 's' },
+	{ 168, 36, 30, 14, "Rand", 'r' }, { 168, 52, 30, 14, "Clear", 'c' },
+	{ 168, 68, 30, 14, "Fast", '+' }, { 168, 84, 30, 14, "Slow", '-' },
+};
+static const struct game2d game_life = { "Life", init_life, draw_life, key_life, mouse_life, tick_life, NULL, btn_life, 6, 1 };
