+/* ------------------------------------------------------------------ Breakout */
+static struct breakout br;
+static int br_best, br_dead;
+static double br_spin;
+
+static void br_init(void)
+{
+	br_best = load_int("/home/breakout.best", 0);
+	br_new(&br);
+	br_dead = 0;
+}
+
+static void br_key(int k)
+{
+	switch (k) {
+	case MWKEY_LEFT: case 'a':
+		br.px -= 0.55;
+		break;
+	case MWKEY_RIGHT: case 'd':
+		br.px += 0.55;
+		break;
+	case ' ': case MWKEY_ENTER: case MWKEY_UP:
+		if (br_dead) {
+			br_new(&br);
+			br_dead = 0;
+		} else {
+			br_launch(&br);
+		}
+		break;
+	}
+	if (br.px < -BR_HALFW + BR_PADDLE_HALF) br.px = -BR_HALFW + BR_PADDLE_HALF;
+	if (br.px > BR_HALFW - BR_PADDLE_HALF) br.px = BR_HALFW - BR_PADDLE_HALF;
+}
+
+static void br_mouse(struct gxw *w, int x)
+{
+	br.px = (x / (double)w->rw * 2.0 - 1.0) * (BR_HALFW + 0.3);
+	br_key(0);
+}
+
+static void br_update(double dt)
+{
+	br_spin += dt * 220.0;
+	if (br_dead)
+		return;
+	br_step(&br, dt);
+	if (br.score > br_best) {
+		br_best = br.score;
+		save_int("/home/breakout.best", br_best);
+	}
+	if (br.lives <= 0)
+		br_dead = 1;
+}
