+/* the 2D event loop */
+static int run2d(const struct game2d *g)
+{
+	GR_EVENT ev;
+	GR_FONT_ID font;
+	int mask;
+
+	if (GrOpen() < 0) {
+		fprintf(stderr, "dsarcade: cannot connect to Nano-X\n");
+		return 1;
+	}
+	srand((unsigned)time(NULL));
+	gc = GrNewGC();
+	font = GrCreateFont("Tiny", 0, NULL);
+	GrSetGCFont(gc, font);
+	w95_init(font);
+	cur2d = g;
+	g->init();
+	win = GrNewWindowEx(GR_WM_PROPS_APPFRAME | GR_WM_PROPS_CAPTION | GR_WM_PROPS_CLOSEBOX, (GR_CHAR *)g->title,
+			    GR_ROOT_WINDOW_ID, 14, 4, WW, WH, W95_FACE);
+	mask = GR_EVENT_MASK_EXPOSURE | GR_EVENT_MASK_KEY_DOWN | GR_EVENT_MASK_CLOSE_REQ | GR_EVENT_MASK_BUTTON_DOWN |
+	       GR_EVENT_MASK_BUTTON_UP;
+	if (g->want_motion)
+		mask |= GR_EVENT_MASK_MOUSE_POSITION;
+	GrSelectEvents(win, mask);
+	GrMapWindow(win);
+	GrSetFocus(win);
+
+	while (running) {
+		int key = 0;
+
+		if (g->tick) {					/* a game with a clock: poll */
+			GrCheckNextEvent(&ev);
+			if (ev.type == GR_EVENT_TYPE_NONE) {
+				g->tick();
+				usleep(30000);
+				continue;
+			}
+		} else {
+			GrGetNextEvent(&ev);
+		}
+		switch (ev.type) {
+		case GR_EVENT_TYPE_EXPOSURE:
+			redraw_all(g);
+			break;
+		case GR_EVENT_TYPE_CLOSE_REQ:
+			running = 0;
+			break;
+		case GR_EVENT_TYPE_KEY_DOWN:
+			key = ev.keystroke.ch;
+			if (key == MWKEY_ESCAPE || key == 'q')
+				running = 0;
+			else
+				g->key(key);
+			break;
+		case GR_EVENT_TYPE_BUTTON_DOWN: {
+			int i, hit = 0;
+
+			for (i = 0; i < g->nbtns; i++)
+				if (ev.button.x >= g->btns[i].x && ev.button.x < g->btns[i].x + g->btns[i].w &&
+				    ev.button.y >= g->btns[i].y && ev.button.y < g->btns[i].y + g->btns[i].h) {
+					g->key(g->btns[i].key);
+					draw_buttons(g);	/* labels can change (Run / Pause) */
+					hit = 1;
+					break;
+				}
+			if (!hit && g->mouse)
+				g->mouse(ev.button.x, ev.button.y, 1);
+			break;
+		}
+		case GR_EVENT_TYPE_BUTTON_UP:
+			if (g->mouse)
+				g->mouse(ev.button.x, ev.button.y, 0);
+			break;
+		case GR_EVENT_TYPE_MOUSE_POSITION:
+			if (g->mouse && ev.mouse.buttons)
+				g->mouse(ev.mouse.x, ev.mouse.y, 2);
+			break;
+		}
+	}
+	if (g->done)
+		g->done();
+	GrClose();
+	return 0;
+}
