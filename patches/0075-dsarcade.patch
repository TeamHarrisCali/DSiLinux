+	GR_RGB(30, 60, 230), GR_RGB(150, 40, 200), GR_RGB(255, 130, 190), GR_RGB(130, 80, 30)
+};
+static char psize_lab[8], pfill_lab[8];
+
+static void paint_labels(void)
+{
+	sprintf(psize_lab, "Size %d", psize);
+	strcpy(pfill_lab, pfill ? "Fill *" : "Fill");
+}
+
+static void paint_swatch(int i)
+{
+	int x = 168 + (i % 2) * 16, y = 4 + (i / 2) * 13;
+
+	fillc(i == pcol ? W95_DARK : W95_FACE, x, y, 16, 13);
+	fillc(pal[i], x + 2, y + 2, 12, 9);
+}
+
+static void paint_dot(int lx, int ly, int c, int draw)
+{
+	int x0 = lx - (psize - 1) / 2, y0 = ly - (psize - 1) / 2, x, y;
+
+	for (y = y0; y < y0 + psize; y++)
+		for (x = x0; x < x0 + psize; x++)
+			if (x >= 0 && y >= 0 && x < PX && y < PY)
+				canvas[y * PX + x] = c;
+	if (x0 < 0) x0 = 0;
+	if (y0 < 0) y0 = 0;
+	if (draw)
+		fillc(pal[c], 4 + x0 * PS, 4 + y0 * PS, psize * PS, psize * PS);
+}
+
+static void paint_line(int x0, int y0, int x1, int y1)
+{
+	int dx = abs(x1 - x0), dy = -abs(y1 - y0), sx = x0 < x1 ? 1 : -1, sy = y0 < y1 ? 1 : -1, err = dx + dy;
+
+	for (;;) {
+		paint_dot(x0, y0, pcol, 1);
+		if (x0 == x1 && y0 == y1)
+			break;
+		if (2 * err >= dy) { err += dy; x0 += sx; }
+		if (2 * err <= dx) { err += dx; y0 += sy; }
+	}
+}
+
+static void draw_paint(void)
+{
+	int i, x, y;
+
+	fillc(pal[1], 4, 4, PX * PS, PY * PS);
+	for (y = 0; y < PY; y++) {
+		for (x = 0; x < PX; ) {
+			int c = canvas[y * PX + x], n = 1;
+
+			while (x + n < PX && canvas[y * PX + x + n] == c)
+				n++;
+			if (c != 1)
+				fillc(pal[c], 4 + x * PS, 4 + y * PS, n * PS, PS);
+			x += n;
+		}
+	}
+	for (i = 0; i < 12; i++)
+		paint_swatch(i);
+	paint_labels();
+}
+
+static void paint_flood(int x, int y)
+{
+	static short stack[PX * PY];
+	int sp = 0, from = canvas[y * PX + x];
+
+	if (from == pcol)
+		return;
+	stack[sp++] = y * PX + x;
+	canvas[y * PX + x] = pcol;
+	while (sp) {
+		int p = stack[--sp], px = p % PX, py = p / PX, k;
+
+		for (k = 0; k < 4; k++) {
+			int nx = px + sk_dx[k], ny = py + sk_dy[k];
+
+			if (nx >= 0 && ny >= 0 && nx < PX && ny < PY && canvas[ny * PX + nx] == from && sp < PX * PY - 1) {
+				canvas[ny * PX + nx] = pcol;
+				stack[sp++] = ny * PX + nx;
+			}
+		}
+	}
+	draw_paint();
+}
+
+static void key_paint(int k)
+{
+	switch (k) {
+	case 'z':
+	case 'c':
+		memset(canvas, 1, sizeof(canvas));
+		draw_paint();
+		break;
+	case 's':
+		psize = psize % 3 + 1;
+		paint_labels();
+		draw_buttons(cur2d);
+		break;
+	case 'f':
+		pfill = !pfill;
+		paint_labels();
+		draw_buttons(cur2d);
+		break;
+	case MWKEY_PAGEUP:
+	case MWKEY_RIGHT: {
+		int old = pcol;
+
+		pcol = (pcol + 1) % 12;
+		paint_swatch(old);
+		paint_swatch(pcol);
+		break;
+	}
+	case MWKEY_PAGEDOWN:
+	case MWKEY_LEFT: {
+		int old = pcol;
+
+		pcol = (pcol + 11) % 12;
+		paint_swatch(old);
+		paint_swatch(pcol);
+		break;
+	}
+	}
+}
+
+static void mouse_paint(int x, int y, int kind)
+{
+	int lx = (x - 4) / PS, ly = (y - 4) / PS, i;
+
+	if (kind == 0) {
+		pdown = 0;
+		return;
+	}
+	if (kind == 1 && x >= 168) {				/* palette */
+		i = (x - 168) / 16 + 2 * ((y - 4) / 13);
+		if (y >= 4 && i >= 0 && i < 12 && (x - 168) / 16 < 2) {
+			int old = pcol;
+
+			pcol = i;
+			paint_swatch(old);
+			paint_swatch(pcol);
+		}
+		return;
+	}
+	if (x < 4 || y < 4 || lx >= PX || ly >= PY)
+		return;
+	if (kind == 1) {
+		if (pfill) {
+			paint_flood(lx, ly);
+			return;
+		}
+		pdown = 1;
+		paint_dot(lx, ly, pcol, 1);
+	} else if (kind == 2 && pdown && !pfill) {
+		paint_line(plx, ply, lx, ly);
+	}
+	plx = lx;
+	ply = ly;
+}
+
+static void init_paint(void)
+{
+	FILE *f = fopen("/home/paint.dat", "r");
+
+	memset(canvas, 1, sizeof(canvas));
+	if (f) {
+		if (fread(canvas, 1, sizeof(canvas), f) != sizeof(canvas))
+			memset(canvas, 1, sizeof(canvas));
+		fclose(f);
+	}
+	paint_labels();
+}
+
+static void done_paint(void)
+{
+	FILE *f = fopen("/home/paint.dat", "w");
+
+	if (f) {
+		fwrite(canvas, 1, sizeof(canvas), f);
+		fclose(f);
+	}
+}
