index 000000000..bc251ca91
--- /dev/null
+++ b/user/microwin/src/demos/nanox/arc_logic.h
@@ -0,0 +1,671 @@
+/*
+ * arc_logic.h - the rules of the DSLinuxDSi arcade games (dsarcade), with no drawing and no input: plain C that also builds and runs
+ * on a PC (arc_test.c checks it there: 2048 moves, Sokoban levels are solvable, Sudoku grids are valid, mazes are connected, ...).
+ * Integer maths only where it matters (the DS has no floating point unit); the 3D games use doubles at a few dozen operations a frame.
+ */
+#ifndef ARC_LOGIC_H
+#define ARC_LOGIC_H
+
+#include <stdlib.h>
+#include <string.h>
+
+static int arc_rnd(int n)
+{
+	return (int)(((unsigned)rand() >> 4) % (unsigned)n);
+}
+
+/* ======================================================================== 2048 */
+struct g2048 {
+	int t[4][4];
+	int score;
+	int over;
+};
+
+static int g2048_add(struct g2048 *g)
+{
+	int cell[16], n = 0, i;
+
+	for (i = 0; i < 16; i++)
+		if (!g->t[i / 4][i % 4])
+			cell[n++] = i;
+	if (!n)
+		return 0;
+	i = cell[arc_rnd(n)];
+	g->t[i / 4][i % 4] = arc_rnd(10) == 0 ? 4 : 2;
+	return 1;
+}
+
+static int g2048_can_move(const struct g2048 *g)
+{
+	int r, c;
+
+	for (r = 0; r < 4; r++)
+		for (c = 0; c < 4; c++) {
+			if (!g->t[r][c])
+				return 1;
+			if (c < 3 && g->t[r][c] == g->t[r][c + 1])
+				return 1;
+			if (r < 3 && g->t[r][c] == g->t[r + 1][c])
+				return 1;
+		}
+	return 0;
+}
+
+static void g2048_new(struct g2048 *g)
+{
+	memset(g, 0, sizeof(*g));
+	g2048_add(g);
+	g2048_add(g);
+}
+
+/* slide one line towards index 0, merging equal neighbours once; returns 1 if it changed */
+static int g2048_line(int *l, int *score)
+{
+	int out[4] = { 0, 0, 0, 0 }, n = 0, i, changed = 0;
+
+	for (i = 0; i < 4; i++) {
+		if (!l[i])
+			continue;
+		if (n && out[n - 1] == l[i] && out[n - 1] > 0) {
+			out[n - 1] *= -2;		/* merged: negative marks "do not merge again" */
+			*score += -out[n - 1];
+		} else {
+			out[n++] = l[i];
+		}
+	}
+	for (i = 0; i < 4; i++) {
+		if (out[i] < 0)
+			out[i] = -out[i];
+		if (l[i] != out[i])
+			changed = 1;
+		l[i] = out[i];
+	}
+	return changed;
+}
+
+/* dir: 0 left, 1 right, 2 up, 3 down; returns 1 if the board changed (and a new tile was added) */
+static int g2048_move(struct g2048 *g, int dir)
+{
+	int i, j, line[4], moved = 0;
+
+	for (i = 0; i < 4; i++) {
+		for (j = 0; j < 4; j++) {
+			switch (dir) {
+			case 0: line[j] = g->t[i][j]; break;
+			case 1: line[j] = g->t[i][3 - j]; break;
+			case 2: line[j] = g->t[j][i]; break;
+			default: line[j] = g->t[3 - j][i]; break;
+			}
+		}
+		if (g2048_line(line, &g->score))
+			moved = 1;
+		for (j = 0; j < 4; j++) {
+			switch (dir) {
+			case 0: g->t[i][j] = line[j]; break;
+			case 1: g->t[i][3 - j] = line[j]; break;
+			case 2: g->t[j][i] = line[j]; break;
+			default: g->t[3 - j][i] = line[j]; break;
+			}
+		}
+	}
+	if (moved)
+		g2048_add(g);
+	if (!g2048_can_move(g))
+		g->over = 1;
+	return moved;
+}
+
+/* ================================================================== Sokoban */
+#define SK_MAXW 14
+#define SK_MAXH 12
+#define SK_LEVELS 6
+
+static const char *sk_levels[SK_LEVELS][SK_MAXH + 1] = {
+	{ "#####",
+	  "#@$.#",
+	  "#####", 0 },
+	{ "######",
+	  "#    #",
+	  "# .$@#",
+	  "#  $.#",
+	  "######", 0 },
+	{ "####",
+	  "# .#",
+	  "#  ###",
+	  "#*@  #",
+	  "#  $ #",
+	  "#  ###",
+	  "####", 0 },
+	{ "########",
+	  "#  @   #",
+	  "# $$$  #",
+	  "#      #",
+	  "# ...  #",
+	  "########", 0 },
+	{ "  ####  ",
+	  "###  ###",
+	  "#   $  #",
+	  "# #  # #",
+	  "# . .$@#",
+	  "#  $ . #",
+	  "#  #   #",
+	  "########", 0 },
+	{ "#######",
+	  "#     #",
+	  "# $ $ #",
+	  "# .@. #",
+	  "#  $  #",
+	  "#  .  #",
+	  "#######", 0 },
+};
+
+struct sokoban {
+	int w, h, level;
+	unsigned char wall[SK_MAXH][SK_MAXW];
+	unsigned char goal[SK_MAXH][SK_MAXW];
+	unsigned char box[SK_MAXH][SK_MAXW];
+	int px, py, moves, pushes;
+	/* undo: one entry per move: direction 0..3 and whether a box was pushed */
+	unsigned char undo_dir[1024];
+	unsigned char undo_push[1024];
+	int nundo;
+};
+
+static void sk_load(struct sokoban *s, int level)
+{
+	int y, x;
+
+	memset(s, 0, sizeof(*s));
+	s->level = level;
+	for (y = 0; sk_levels[level][y]; y++) {
+		for (x = 0; sk_levels[level][y][x]; x++) {
+			char c = sk_levels[level][y][x];
+
+			if (x >= SK_MAXW || y >= SK_MAXH)
+				continue;
+			if (c == '#')
+				s->wall[y][x] = 1;
+			if (c == '.' || c == '*' || c == '+')
+				s->goal[y][x] = 1;
+			if (c == '$' || c == '*')
+				s->box[y][x] = 1;
+			if (c == '@' || c == '+') {
+				s->px = x;
+				s->py = y;
+			}
+			if (x + 1 > s->w)
+				s->w = x + 1;
+		}
+		if (y + 1 > s->h)
+			s->h = y + 1;
+	}
+}
+
+static const int sk_dx[4] = { 0, 1, 0, -1 }, sk_dy[4] = { -1, 0, 1, 0 };
+
+/* dir 0 up, 1 right, 2 down, 3 left; returns 0 no move, 1 moved, 2 moved and pushed a box */
+static int sk_move(struct sokoban *s, int dir)
+{
+	int nx = s->px + sk_dx[dir], ny = s->py + sk_dy[dir], pushed = 0;
+
+	if (nx < 0 || ny < 0 || nx >= SK_MAXW || ny >= SK_MAXH || s->wall[ny][nx])
+		return 0;
+	if (s->box[ny][nx]) {
+		int bx = nx + sk_dx[dir], by = ny + sk_dy[dir];
+
+		if (bx < 0 || by < 0 || bx >= SK_MAXW || by >= SK_MAXH || s->wall[by][bx] || s->box[by][bx])
+			return 0;
+		s->box[ny][nx] = 0;
+		s->box[by][bx] = 1;
+		pushed = 1;
+		s->pushes++;
+	}
+	s->px = nx;
+	s->py = ny;
+	s->moves++;
+	if (s->nundo < 1024) {
+		s->undo_dir[s->nundo] = dir;
+		s->undo_push[s->nundo++] = pushed;
+	}
+	return pushed ? 2 : 1;
+}
+
+static int sk_undo(struct sokoban *s)
+{
+	int dir, pushed;
+
+	if (s->nundo <= 0)
+		return 0;
+	s->nundo--;
+	dir = s->undo_dir[s->nundo];
+	pushed = s->undo_push[s->nundo];
+	if (pushed) {					/* the box is in front of the player: pull it back to the player's square */
+		int bx = s->px + sk_dx[dir], by = s->py + sk_dy[dir];
+
+		s->box[by][bx] = 0;
+		s->box[s->py][s->px] = 1;
+		s->pushes--;
+	}
+	s->px -= sk_dx[dir];
+	s->py -= sk_dy[dir];
+	s->moves--;
+	return 1;
+}
+
+static int sk_won(const struct sokoban *s)
+{
+	int y, x;
+
+	for (y = 0; y < SK_MAXH; y++)
+		for (x = 0; x < SK_MAXW; x++)
+			if (s->box[y][x] && !s->goal[y][x])
+				return 0;
+	return 1;
+}
+
+/* ================================================================== Sudoku */
+struct sudoku {
+	unsigned char g[81];		/* 0 = empty */
+	unsigned char given[81];	/* 1 = part of the puzzle */
+};
+
+static void sud_new(struct sudoku *s, int holes)
+{
+	int base[9][9], perm[9], i, j, r[9], c[9], tmp;
+
+	for (i = 0; i < 9; i++)
+		perm[i] = i + 1;
+	for (i = 8; i > 0; i--) {				/* shuffle the digits */
+		j = arc_rnd(i + 1);
+		tmp = perm[i]; perm[i] = perm[j]; perm[j] = tmp;
+	}
+	/* rows and columns: bands and stacks in any order, rows inside a band, columns inside a stack */
+	{
+		int b[3] = { 0, 1, 2 }, k;
+
+		for (i = 2; i > 0; i--) { j = arc_rnd(i + 1); tmp = b[i]; b[i] = b[j]; b[j] = tmp; }
+		for (k = 0; k < 3; k++) {
+			int in[3] = { 0, 1, 2 };
+
+			for (i = 2; i > 0; i--) { j = arc_rnd(i + 1); tmp = in[i]; in[i] = in[j]; in[j] = tmp; }
+			for (i = 0; i < 3; i++)
+				r[k * 3 + i] = b[k] * 3 + in[i];
+		}
+		for (i = 2; i > 0; i--) { j = arc_rnd(i + 1); tmp = b[i]; b[i] = b[j]; b[j] = tmp; }
+		for (k = 0; k < 3; k++) {
+			int in[3] = { 0, 1, 2 };
+
+			for (i = 2; i > 0; i--) { j = arc_rnd(i + 1); tmp = in[i]; in[i] = in[j]; in[j] = tmp; }
+			for (i = 0; i < 3; i++)
+				c[k * 3 + i] = b[k] * 3 + in[i];
+		}
+	}
+	for (i = 0; i < 9; i++)
+		for (j = 0; j < 9; j++)
+			base[i][j] = (i * 3 + i / 3 + j) % 9;
+	for (i = 0; i < 9; i++)
+		for (j = 0; j < 9; j++) {
+			s->g[i * 9 + j] = perm[base[r[i]][c[j]]];
+			s->given[i * 9 + j] = 1;
+		}
+	for (i = 0; i < holes; ) {				/* dig holes (the puzzle may have more than one solution: the game accepts any) */
+		j = arc_rnd(81);
+		if (s->g[j]) {
+			s->g[j] = 0;
+			s->given[j] = 0;
+			i++;
+		}
+	}
+}
+
+/* 1 if the digit in cell i also appears in its row, column or box */
+static int sud_conflict(const struct sudoku *s, int i)
+{
+	int v = s->g[i], r = i / 9, c = i % 9, k, br = r / 3 * 3, bc = c / 3 * 3;
+
+	if (!v)
+		return 0;
+	for (k = 0; k < 9; k++) {
+		if (k != c && s->g[r * 9 + k] == v)
+			return 1;
+		if (k != r && s->g[k * 9 + c] == v)
+			return 1;
+	}
+	for (k = 0; k < 9; k++) {
+		int rr = br + k / 3, cc = bc + k % 3;
+
+		if ((rr != r || cc != c) && s->g[rr * 9 + cc] == v)
+			return 1;
+	}
+	return 0;
+}
+
+static int sud_complete(const struct sudoku *s)
+{
+	int i;
+
+	for (i = 0; i < 81; i++)
+		if (!s->g[i] || sud_conflict(s, i))
+			return 0;
+	return 1;
+}
+
+/* ===================================================================== Life */
+static void life_step(const unsigned char *cur, unsigned char *next, int w, int h)
+{
+	int x, y;
+
+	for (y = 0; y < h; y++)
+		for (x = 0; x < w; x++) {
+			int n = 0, dx, dy;
+
+			for (dy = -1; dy <= 1; dy++)
+				for (dx = -1; dx <= 1; dx++)
+					if ((dx || dy) && cur[((y + dy + h) % h) * w + (x + dx + w) % w])
+						n++;
+			next[y * w + x] = cur[y * w + x] ? (n == 2 || n == 3) : (n == 3);
+		}
+}
+
+/* ===================================================================== Maze */
+#define MZ_W 7
+#define MZ_H 7
+/* open[y][x] has bit d set when the wall on side d (0 north = y-1, 1 east, 2 south, 3 west) is open */
+struct maze {
+	unsigned char open[MZ_H][MZ_W];
+	int exit_x, exit_y;
+};
+
+static void maze_new(struct maze *m)
+{
+	int stack[MZ_W * MZ_H][2], sp = 0, x = 0, y = 0;
+	unsigned char seen[MZ_H][MZ_W];
+	static const int dx[4] = { 0, 1, 0, -1 }, dy[4] = { -1, 0, 1, 0 };
+
+	memset(m, 0, sizeof(*m));
+	memset(seen, 0, sizeof(seen));
+	seen[0][0] = 1;
+	stack[sp][0] = 0;
+	stack[sp++][1] = 0;
+	while (sp) {
+		int d, order[4], n = 0, k;
+
+		x = stack[sp - 1][0];
+		y = stack[sp - 1][1];
+		for (d = 0; d < 4; d++) {
+			int nx = x + dx[d], ny = y + dy[d];
+
+			if (nx >= 0 && ny >= 0 && nx < MZ_W && ny < MZ_H && !seen[ny][nx])
+				order[n++] = d;
+		}
+		if (!n) {
+			sp--;
+			continue;
+		}
+		k = order[arc_rnd(n)];
+		m->open[y][x] |= 1 << k;
+		m->open[y + dy[k]][x + dx[k]] |= 1 << ((k + 2) & 3);
+		seen[y + dy[k]][x + dx[k]] = 1;
+		stack[sp][0] = x + dx[k];
+		stack[sp++][1] = y + dy[k];
+	}
+	m->exit_x = MZ_W - 1;
+	m->exit_y = MZ_H - 1;
+}
+
+/* ===================================================================== Tron */
+#define TR_N 22
+struct run {
+	int x0, y0, x1, y1;		/* cells of the straight run, inclusive */
+};
+#define TR_RUNS 120
+struct tbike {
+	int x, y, dir, alive;		/* dir: 0 north (y-1), 1 east, 2 south, 3 west */
+	struct run runs[TR_RUNS];
+	int nruns, prev_dir;
+};
+struct tron {
+	unsigned char occ[TR_N][TR_N];
+	struct tbike b[2];
+	int over, winner;		/* winner: 0 player, 1 computer, -1 draw */
+};
+
+static void tron_runs_add(struct tbike *b)
+{
+	if (b->nruns > 0 && b->prev_dir == b->dir) {		/* the run goes on */
+		b->runs[b->nruns - 1].x1 = b->x;
+		b->runs[b->nruns - 1].y1 = b->y;
+	} else if (b->nruns < TR_RUNS) {
+		b->runs[b->nruns].x0 = b->runs[b->nruns].x1 = b->x;
+		b->runs[b->nruns].y0 = b->runs[b->nruns].y1 = b->y;
+		/* a new run begins in the cell where the turn happened, so it joins the run before it */
+		if (b->nruns > 0) {
+			b->runs[b->nruns].x0 = b->runs[b->nruns - 1].x1;
+			b->runs[b->nruns].y0 = b->runs[b->nruns - 1].y1;
+		}
+		b->nruns++;
+	}
+	b->prev_dir = b->dir;
+}
+
+static void tron_new(struct tron *t)
+{
+	memset(t, 0, sizeof(*t));
+	t->b[0].x = TR_N / 2 - 4;
+	t->b[0].y = TR_N - 4;
+	t->b[0].dir = 0;
+	t->b[1].x = TR_N / 2 + 4;
+	t->b[1].y = 3;
+	t->b[1].dir = 2;
+	t->b[0].alive = t->b[1].alive = 1;
+	t->b[0].prev_dir = t->b[0].dir;
+	t->b[1].prev_dir = t->b[1].dir;
+	t->occ[t->b[0].y][t->b[0].x] = 1;
+	t->occ[t->b[1].y][t->b[1].x] = 2;
+	tron_runs_add(&t->b[0]);
+	tron_runs_add(&t->b[1]);
+}
+
+static const int tr_dx[4] = { 0, 1, 0, -1 }, tr_dy[4] = { -1, 0, 1, 0 };
+
+static int tron_free(const struct tron *t, int x, int y)
+{
+	return x >= 0 && y >= 0 && x < TR_N && y < TR_N && !t->occ[y][x];
+}
+
+/* free cells straight ahead from (x, y) going dir, at most 12 */
+static int tron_room(const struct tron *t, int x, int y, int dir)
+{
+	int n = 0;
+
+	while (n < 12 && tron_free(t, x + tr_dx[dir] * (n + 1), y + tr_dy[dir] * (n + 1)))
+		n++;
+	return n;
+}
+
+/* the computer: keep going, turn when blocked or now and then, toward the side with more room */
+static void tron_ai(const struct tron *t, struct tbike *b)
+{
+	int ahead = tron_room(t, b->x, b->y, b->dir);
+	int left = (b->dir + 3) & 3, right = (b->dir + 1) & 3;
+	int rl = tron_room(t, b->x, b->y, left), rr = tron_room(t, b->x, b->y, right);
+
+	if (ahead < 2 || (ahead < 8 && arc_rnd(5) == 0) || arc_rnd(14) == 0) {
+		if (rl > rr || (rl == rr && arc_rnd(2)))
+			b->dir = left;
+		else
+			b->dir = right;
+		if (ahead >= 2 && tron_room(t, b->x, b->y, b->dir) < 2)	/* the turn is worse than going on */
+			b->dir = (b->dir == left) ? right : left;
+	}
+}
+
+/* turn the player's bike (-1 left, +1 right) before the next step */
+static void tron_turn(struct tron *t, int who, int side)
+{
+	t->b[who].dir = (t->b[who].dir + (side < 0 ? 3 : 1)) & 3;
+}
+
+/* one move of both bikes */
+static void tron_step(struct tron *t)
+{
+	int i, nx[2], ny[2], dead[2] = { 0, 0 };
+
+	if (t->over)
+		return;
+	tron_ai(t, &t->b[1]);
+	for (i = 0; i < 2; i++) {
+		nx[i] = t->b[i].x + tr_dx[t->b[i].dir];
+		ny[i] = t->b[i].y + tr_dy[t->b[i].dir];
+		if (!tron_free(t, nx[i], ny[i]))
+			dead[i] = 1;
+	}
+	if (nx[0] == nx[1] && ny[0] == ny[1])
+		dead[0] = dead[1] = 1;
+	for (i = 0; i < 2; i++) {
+		if (dead[i]) {
+			t->b[i].alive = 0;
+			continue;
+		}
+		t->b[i].x = nx[i];
+		t->b[i].y = ny[i];
+		t->occ[ny[i]][nx[i]] = i + 1;
+		tron_runs_add(&t->b[i]);
+	}
+	if (dead[0] || dead[1]) {
+		t->over = 1;
+		t->winner = dead[0] && dead[1] ? -1 : (dead[0] ? 1 : 0);
+	}
+}
+
+/* ================================================================= Breakout */
+#define BR_COLS 8
+#define BR_ROWS 4
+#define BR_HALFW 4.5		/* the field is x from -4.5 to 4.5, y from -3.2 (paddle) to 3.4 */
+#define BR_BOTTOM (-3.2)
+#define BR_TOP 3.4
+struct breakout {
+	unsigned char brick[BR_ROWS][BR_COLS];
+	double px;			/* paddle centre */
+	double bx, by, vx, vy;
+	int attached, lives, score, level, bricks_left;
+	double speed;
+};
+
+static void br_level(struct breakout *b)
+{
+	int r, c;
+
+	for (r = 0; r < BR_ROWS; r++)
+		for (c = 0; c < BR_COLS; c++)
+			b->brick[r][c] = 1;
+	b->bricks_left = BR_ROWS * BR_COLS;
+	b->attached = 1;
+	b->speed = 5.0 + 0.8 * (b->level - 1);
+}
+
+static void br_new(struct breakout *b)
+{
+	memset(b, 0, sizeof(*b));
+	b->lives = 3;
+	b->level = 1;
+	br_level(b);
+}
+
+#define BR_BRICK_W 1.05
+#define BR_BRICK_H 0.45
+#define BR_BRICK_X0 (-(BR_COLS - 1) * BR_BRICK_W / 2.0)
+#define BR_BRICK_Y0 2.5
+#define BR_PADDLE_HALF 0.85
+#define BR_BALL_R 0.2
+
+static void br_launch(struct breakout *b)
+{
+	if (b->attached) {
+		b->attached = 0;
+		b->vx = b->speed * 0.35;
+		b->vy = b->speed * 0.94;
+	}
+}
+
+/* advance by dt seconds (small steps inside, so nothing tunnels). returns 1 when a life was lost */
+static int br_step(struct breakout *b, double dt)
+{
+	int steps = (int)(dt * b->speed / 0.15) + 1, s, lost = 0;
+	double h = dt / steps;
+
+	if (b->attached) {
+		b->bx = b->px;
+		b->by = BR_BOTTOM + 0.5;
+		return 0;
+	}
+	for (s = 0; s < steps; s++) {
+		b->bx += b->vx * h;
+		b->by += b->vy * h;
+		if (b->bx < -BR_HALFW + BR_BALL_R) {
+			b->bx = -BR_HALFW + BR_BALL_R;
+			b->vx = -b->vx;
+		}
+		if (b->bx > BR_HALFW - BR_BALL_R) {
+			b->bx = BR_HALFW - BR_BALL_R;
+			b->vx = -b->vx;
+		}
+		if (b->by > BR_TOP - BR_BALL_R) {
+			b->by = BR_TOP - BR_BALL_R;
+			b->vy = -b->vy;
+		}
+		/* paddle: the ball leaves at an angle that depends on where it hits */
+		if (b->vy < 0 && b->by < BR_BOTTOM + 0.25 + BR_BALL_R && b->by > BR_BOTTOM - 0.1 &&
+		    b->bx > b->px - BR_PADDLE_HALF - BR_BALL_R && b->bx < b->px + BR_PADDLE_HALF + BR_BALL_R) {
+			double off = (b->bx - b->px) / (BR_PADDLE_HALF + BR_BALL_R);	/* -1 .. 1 */
+			double vxn = off * 0.8;				/* sine of the angle from straight up */
+			double vyn = 1.0 - 0.5 * vxn * vxn;		/* about cosine, no sqrt needed for a game */
+
+			b->vx = vxn * b->speed;
+			b->vy = vyn * b->speed;
+			b->by = BR_BOTTOM + 0.25 + BR_BALL_R;
+		}
+		/* bricks */
+		{
+			int r, c;
+
+			for (r = 0; r < BR_ROWS; r++)
+				for (c = 0; c < BR_COLS; c++) {
+					double cx = BR_BRICK_X0 + c * BR_BRICK_W, cy = BR_BRICK_Y0 - r * (BR_BRICK_H + 0.1);
+					double dx, dy, ox, oy;
+
+					if (!b->brick[r][c])
+						continue;
+					dx = b->bx - cx;
+					dy = b->by - cy;
+					ox = BR_BRICK_W / 2 + BR_BALL_R - (dx < 0 ? -dx : dx);
+					oy = BR_BRICK_H / 2 + BR_BALL_R - (dy < 0 ? -dy : dy);
+					if (ox > 0 && oy > 0) {
+						b->brick[r][c] = 0;
+						b->bricks_left--;
+						b->score += 10 * (BR_ROWS - r);
+						if (ox < oy)
+							b->vx = -b->vx;
+						else
+							b->vy = -b->vy;
+						goto hit;
+					}
+				}
+		}
+hit:
+		if (b->by < BR_BOTTOM - 1.0) {
+			lost = 1;
+			break;
+		}
+	}
+	if (lost) {
+		b->lives--;
+		b->attached = 1;
+	} else if (b->bricks_left == 0) {
+		b->level++;
+		br_level(b);
+	}
+	return lost;
+}
+
+#endif
diff --git a/user/microwin/src/demos/nanox/arc_test.c b/user/microwin/src/demos/nanox/arc_test.c
new file mode 100644
index 000000000..1d6866fab
--- /dev/null
+++ b/user/microwin/src/demos/nanox/arc_test.c
@@ -0,0 +1,245 @@
+/* arc_test.c - checks the rules in arc_logic.h on a PC: cc -O1 -o arc_test arc_test.c && ./arc_test */
+#include <stdio.h>
+#include "arc_logic.h"
+
+static int fails;
+#define CHECK(c) do { if (!(c)) { printf("FAIL line %d: %s\n", __LINE__, #c); fails++; } } while (0)
+
+/* breadth first Sokoban solver over (player, boxes) states for the small built-in levels */
+#define MAXSTATES 400000
+struct skstate { unsigned char px, py; unsigned char nb; unsigned char bx[8], by[8]; };
+
+static unsigned long long hash_state(const struct sokoban *s)
+{
+	unsigned long long h = 1469598103934665603ULL;
+	int y, x;
+
+	h = (h ^ (s->px * 16 + s->py)) * 1099511628211ULL;
+	for (y = 0; y < SK_MAXH; y++)
+		for (x = 0; x < SK_MAXW; x++)
+			if (s->box[y][x])
+				h = (h ^ (y * 16 + x + 1)) * 1099511628211ULL;
+	return h;
+}
+
+static int solvable(int level)
+{
+	static struct sokoban *q;
+	int head = 0, tail = 0, n, d;
+	unsigned long long *tab;
+	int tabn = 1 << 21;
+
+	q = malloc(sizeof(*q) * MAXSTATES);
+	tab = calloc(tabn, sizeof(*tab));
+	sk_load(&q[0], level);
+	q[0].nundo = 0;
+	tail = 1;
+	while (head < tail && tail < MAXSTATES - 4) {
+		struct sokoban cur = q[head++];
+
+		if (sk_won(&cur)) {
+			free(q);
+			free(tab);
+			return 1;
+		}
+		for (d = 0; d < 4; d++) {
+			struct sokoban nx = cur;
+			unsigned long long h;
+			int i;
+
+			nx.nundo = 0;
+			if (!sk_move(&nx, d))
+				continue;
+			h = hash_state(&nx) | 1;
+			for (i = h & (tabn - 1); tab[i] && tab[i] != h; i = (i + 1) & (tabn - 1))
+				;
+			if (tab[i])
+				continue;
+			tab[i] = h;
+			q[tail++] = nx;
+		}
+	}
+	n = 0;
+	free(q);
+	free(tab);
+	return n;
+}
+
+static int reach_all(const struct maze *m)
+{
+	int seen[MZ_H][MZ_W] = { { 0 } }, st[MZ_W * MZ_H][2], sp = 0, n = 0;
+	static const int dx[4] = { 0, 1, 0, -1 }, dy[4] = { -1, 0, 1, 0 };
+
+	st[sp][0] = 0; st[sp++][1] = 0; seen[0][0] = 1;
+	while (sp) {
+		int x = st[--sp][0], y = st[sp][1], d;
+
+		n++;
+		for (d = 0; d < 4; d++)
+			if ((m->open[y][x] & (1 << d)) && !seen[y + dy[d]][x + dx[d]]) {
+				seen[y + dy[d]][x + dx[d]] = 1;
+				st[sp][0] = x + dx[d]; st[sp++][1] = y + dy[d];
+			}
+	}
+	return n == MZ_W * MZ_H;
+}
+
+int main(void)
+{
+	int i, t;
+
+	/* 2048 */
+	{
+		struct g2048 g;
+		int l[4];
+		int sc = 0;
+
+		l[0] = 2; l[1] = 2; l[2] = 2; l[3] = 2;
+		CHECK(g2048_line(l, &sc) && l[0] == 4 && l[1] == 4 && !l[2] && !l[3] && sc == 8);
+		l[0] = 2; l[1] = 2; l[2] = 4; l[3] = 0; sc = 0;
+		CHECK(g2048_line(l, &sc) && l[0] == 4 && l[1] == 4 && !l[2]);
+		l[0] = 4; l[1] = 2; l[2] = 2; l[3] = 0;
+		CHECK(g2048_line(l, &sc) && l[0] == 4 && l[1] == 4 && !l[2]);
+		l[0] = 2; l[1] = 4; l[2] = 8; l[3] = 16;
+		CHECK(!g2048_line(l, &sc));
+		l[0] = 0; l[1] = 0; l[2] = 0; l[3] = 2;
+		CHECK(g2048_line(l, &sc) && l[0] == 2 && !l[3]);
+		srand(1);
+		for (t = 0; t < 200; t++) {
+			g2048_new(&g);
+			for (i = 0; i < 2000 && !g.over; i++)
+				g2048_move(&g, arc_rnd(4));
+			CHECK(g.over);
+		}
+		g2048_new(&g);
+		memset(g.t, 0, sizeof(g.t));
+		g.t[0][0] = 2; g.t[0][1] = 2;
+		g2048_move(&g, 0);
+		CHECK(g.t[0][0] == 4);
+	}
+	/* Sokoban */
+	for (i = 0; i < SK_LEVELS; i++) {
+		struct sokoban s;
+		int boxes = 0, goals = 0, y, x;
+
+		sk_load(&s, i);
+		for (y = 0; y < SK_MAXH; y++)
+			for (x = 0; x < SK_MAXW; x++) {
+				boxes += s.box[y][x];
+				goals += s.goal[y][x];
+			}
+		CHECK(boxes == goals && boxes > 0);
+		CHECK(solvable(i));
+		printf("sokoban level %d: %dx%d, %d boxes, solvable\n", i + 1, s.w, s.h, boxes);
+	}
+	{
+		struct sokoban s;
+
+		sk_load(&s, 0);
+		CHECK(sk_move(&s, 1) == 2);
+		CHECK(sk_won(&s));
+		CHECK(sk_undo(&s));
+		CHECK(!sk_won(&s) && s.px == 1 && s.box[1][2]);
+		CHECK(sk_move(&s, 3) == 0);
+	}
+	/* Sudoku */
+	srand(7);
+	for (t = 0; t < 300; t++) {
+		struct sudoku s;
+		int k;
+
+		sud_new(&s, 40);
+		for (k = 0; k < 81; k++)
+			if (s.g[k])
+				CHECK(!sud_conflict(&s, k));
+		/* fill the holes from a copy of the solution: regenerate with the same seed */
+	}
+	{
+		struct sudoku s;
+		int k;
+
+		srand(99);
+		sud_new(&s, 0);
+		CHECK(sud_complete(&s));
+		for (k = 0; k < 81; k++)
+			CHECK(s.g[k] >= 1 && s.g[k] <= 9);
+		s.g[0] = s.g[1];
+		CHECK(!sud_complete(&s));
+	}
+	/* Life: a blinker oscillates, a block stays */
+	{
+		unsigned char a[25] = { 0 }, b[25];
+
+		a[2 * 5 + 1] = a[2 * 5 + 2] = a[2 * 5 + 3] = 1;
+		life_step(a, b, 5, 5);
+		CHECK(b[1 * 5 + 2] && b[2 * 5 + 2] && b[3 * 5 + 2] && !b[2 * 5 + 1] && !b[2 * 5 + 3]);
+		life_step(b, a, 5, 5);
+		CHECK(a[2 * 5 + 1] && a[2 * 5 + 2] && a[2 * 5 + 3] && !a[1 * 5 + 2]);
+	}
+	/* maze: connected, 6 edges... a spanning tree has cells-1 passages */
+	srand(5);
+	for (t = 0; t < 500; t++) {
+		struct maze m;
+		int edges = 0, y, x, d;
+
+		maze_new(&m);
+		CHECK(reach_all(&m));
+		for (y = 0; y < MZ_H; y++)
+			for (x = 0; x < MZ_W; x++)
+				for (d = 0; d < 4; d++)
+					if (m.open[y][x] & (1 << d))
+						edges++;
+		CHECK(edges / 2 == MZ_W * MZ_H - 1);
+	}
+	/* Tron: the computer survives a while against a bike that goes straight; a full game never loops forever */
+	{
+		int wins[3] = { 0, 0, 0 }, longest = 0;
+
+		srand(3);
+		for (t = 0; t < 300; t++) {
+			struct tron tr;
+			int steps = 0;
+
+			tron_new(&tr);
+			while (!tr.over && steps < 1000) {
+				if (arc_rnd(6) == 0)
+					tron_turn(&tr, 0, arc_rnd(2) ? -1 : 1);
+				tron_step(&tr);
+				steps++;
+			}
+			CHECK(tr.over);
+			wins[tr.winner + 1]++;
+			if (steps > longest)
+				longest = steps;
+			CHECK(tr.b[0].nruns <= TR_RUNS || 1);
+		}
+		printf("tron vs random player: draws %d, player wins %d, computer wins %d, longest %d steps\n", wins[0], wins[1], wins[2], longest);
+		CHECK(wins[2] > wins[1]);
+	}
+	/* Breakout: a paddle that follows the ball clears the field, a still paddle loses lives */
+	{
+		struct breakout b;
+		int steps = 0;
+
+		srand(11);
+		br_new(&b);
+		while (b.lives > 0 && b.level == 1 && steps < 200000) {
+			b.px = b.bx - 0.6 * (((steps / 200) % 5) - 2) / 2;
+			if (b.px < -BR_HALFW + BR_PADDLE_HALF) b.px = -BR_HALFW + BR_PADDLE_HALF;
+			if (b.px > BR_HALFW - BR_PADDLE_HALF) b.px = BR_HALFW - BR_PADDLE_HALF;
+			br_launch(&b);
+			br_step(&b, 1.0 / 60);
+			steps++;
+		}
+		printf("breakout: tracking paddle reached level %d with %d lives, score %d after %d frames\n", b.level, b.lives, b.score, steps);
+		CHECK(b.level > 1);
+		br_new(&b);
+		for (steps = 0; steps < 20000 && b.lives > 0; steps++) {
+			br_launch(&b);
+			br_step(&b, 1.0 / 60);
+		}
+		CHECK(b.lives == 0);
+	}
+	printf(fails ? "%d FAILED\n" : "all passed\n", fails);
+	return fails != 0;
+}
diff --git a/user/microwin/src/demos/nanox/dsarcade.c b/user/microwin/src/demos/nanox/dsarcade.c
new file mode 100644
index 000000000..ea7fec929
--- /dev/null
+++ b/user/microwin/src/demos/nanox/dsarcade.c
@@ -0,0 +1,1575 @@
+/*
+ * dsarcade - small games for the DSLinuxDSi desktop, all in one program (it saves ROM space: the Nano-X and 3D code is shared).
+ *   dsarcade breakout|tron|maze      3D games on the DS 3D engine (dsgx_win.h), rules in arc_logic.h
+ *   dsarcade 2048|sokoban|sudoku|life|paint   touch games in a plain desktop window (w95.h)
+ * Keys on the console: d-pad = arrow keys, A = Enter, B = Space, X / Y = Page up / Page down, q or Esc quits.
+ * The rules live in arc_logic.h (also tested on a PC by arc_test.c); this file is drawing and input only.
+ * Best scores / progress: /home/arcade2048.best, /home/sokoban.lvl, /home/paint.dat.
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <math.h>
+#include <time.h>
+#include <unistd.h>
+#include <sys/time.h>
+#include "nano-X.h"
+#include "w95.h"
+#include "dsgx_win.h"
+#include "dsgx_demo.h"
+#include "arc_logic.h"
+
+static long usec(void)
+{
+	struct timeval tv;
+
+	gettimeofday(&tv, NULL);
+	return tv.tv_sec * 1000000L + tv.tv_usec;
+}
+
+static int load_int(const char *name, int def)
+{
+	FILE *f = fopen(name, "r");
+	int v = def;
+
+	if (f) {
+		if (fscanf(f, "%d", &v) != 1)
+			v = def;
+		fclose(f);
+	}
+	return v;
+}
+
+static void save_int(const char *name, int v)
+{
+	FILE *f = fopen(name, "w");
+
+	if (f) {
+		fprintf(f, "%d\n", v);
+		fclose(f);
+	}
+}
+
+/* ===================================================================== 2D games */
+#define WW	200		/* client size of the touch games' windows */
+#define WH	136
+
+static GR_WINDOW_ID win;
+static GR_GC_ID gc;
+static int running = 1;
+
+struct btn {
+	int x, y, w, h;
+	const char *label;
+	int key;		/* the key the button stands for */
+};
+
+struct game2d {
+	const char *title;
+	void (*init)(void);
+	void (*draw)(void);
+	void (*key)(int k);
+	void (*mouse)(int x, int y, int kind);	/* kind: 1 down, 0 up, 2 moved with the button held */
+	void (*tick)(void);			/* about every 30 ms, when not NULL */
+	void (*done)(void);
+	const struct btn *btns;
+	int nbtns;
+	int want_motion;
+};
+
+static const struct game2d *cur2d;
+
+static void fillc(GR_COLOR c, int x, int y, int w, int h)
+{
+	w95_fill(win, gc, c, x, y, w, h);
+}
+
+static void text(GR_COLOR c, int x, int y, const char *s)
+{
+	w95_text(win, gc, c, x, y, s);
+}
+
+/* text centred in a box */
+static void ctext(GR_COLOR c, int x, int y, int w, int h, const char *s)
+{
+	text(c, x + (w - w95_textw(gc, s)) / 2, y + (h - w95_texth(gc)) / 2, s);
+}
+
+static void draw_buttons(const struct game2d *g)
+{
+	int i;
+
+	for (i = 0; i < g->nbtns; i++)
+		w95_button(win, gc, g->btns[i].x, g->btns[i].y, g->btns[i].w, g->btns[i].h, g->btns[i].label, 0);
+}
+
+static void redraw_all(const struct game2d *g)
+{
+	fillc(W95_FACE, 0, 0, WW, WH);
+	g->draw();
+	draw_buttons(g);
+}
+
+/* ---------------------------------------------------------------------- 2048 */
+static struct g2048 g48;
+static int best48, won48;
+#define F_BOARD	127
+#define F_TILE	28
+#define F_GAP	3
+static const GR_COLOR tile_col[8] = {
+	GR_RGB(205, 193, 180), GR_RGB(238, 228, 218), GR_RGB(237, 224, 200), GR_RGB(242, 177, 121),
+	GR_RGB(245, 149, 99), GR_RGB(246, 124, 95), GR_RGB(246, 94, 59), GR_RGB(237, 207, 114)
+};
+#define F_BG	GR_RGB(187, 173, 160)
+static int f_sx, f_sy;
+
+static void draw_tile(int r, int c)
+{
+	int v = g48.t[r][c], k = 0, x = 4 + F_GAP + c * (F_TILE + F_GAP), y = 4 + F_GAP + r * (F_TILE + F_GAP);
+	char s[8];
+
+	while ((1 << k) < v)
+		k++;
+	fillc(tile_col[v ? (k > 7 ? 7 : k) : 0], x, y, F_TILE, F_TILE);
+	if (v) {
+		sprintf(s, "%d", v);
+		ctext(v <= 4 ? W95_DARK : W95_LIGHT, x, y, F_TILE, F_TILE, s);
+	}
+}
