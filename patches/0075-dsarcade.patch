+/* ---------------------------------------------------------------------- Tron */
+#define TR_STEP 0.20
+static struct tron tr;
+static double tr_acc, tr_cam;
+static int tr_q[2], tr_nq, tr_wins[2];
+
+static void tr_init(void)
+{
+	tron_new(&tr);
+	tr_acc = 0.0;
+	tr_nq = 0;
+	tr_cam = 0.0;
+}
+
+static void tr_key(int k)
+{
+	int side = 0;
+
+	switch (k) {
+	case MWKEY_LEFT: case 'a': side = -1; break;
+	case MWKEY_RIGHT: case 'd': side = 1; break;
+	case ' ': case MWKEY_ENTER:
+		if (tr.over)
+			tr_init();
+		return;
+	}
+	if (side && !tr.over && tr_nq < 2)
+		tr_q[tr_nq++] = side;
+}
+
+static void tr_update(double dt)
+{
+	double target = 90.0 * tr.b[0].dir, diff;
+
+	if (!tr.over) {
+		tr_acc += dt;
+		while (tr_acc >= TR_STEP && !tr.over) {
+			if (tr_nq) {
+				tron_turn(&tr, 0, tr_q[0]);
+				tr_q[0] = tr_q[1];
+				tr_nq--;
+			}
+			tron_step(&tr);
+			tr_acc -= TR_STEP;
+			if (tr.over && tr.winner >= 0)
+				tr_wins[tr.winner]++;
+		}
+	}
+	diff = target - tr_cam;
+	while (diff > 180.0) diff -= 360.0;
+	while (diff < -180.0) diff += 360.0;
+	tr_cam += diff * (dt * 9.0 > 1.0 ? 1.0 : dt * 9.0);
+}
+
+/* the wall of one bike's trail: a long thin box per straight run, the last one ending at the bike's smooth position */
+static void tr_trail(int who, double hx, double hz, int r, int g, int b)
+{
+	const struct tbike *bk = &tr.b[who];
+	int i;
+
+	for (i = 0; i < bk->nruns; i++) {
+		double x0 = bk->runs[i].x0, z0 = bk->runs[i].y0, x1 = bk->runs[i].x1, z1 = bk->runs[i].y1;
+
+		if (i == bk->nruns - 1 && bk->alive) {
+			x1 = hx;
+			z1 = hz;
+		}
+		box((x0 + x1) / 2 + 0.5, 0.35, (z0 + z1) / 2 + 0.5, fabs(x1 - x0) / 2 + 0.15, 0.35, fabs(z1 - z0) / 2 + 0.15, r, g, b);
+	}
+}
+
+static void tr_draw(void)
+{
+	double f = tr.over ? 1.0 : tr_acc / TR_STEP, hx[2], hz[2];
+	int i;
+
+	if (f > 1.0)
+		f = 1.0;
+	for (i = 0; i < 2; i++) {
+		hx[i] = tr.b[i].x - tr_dx[tr.b[i].dir] * (tr.b[i].alive ? 1.0 - f : 0.0);
+		hz[i] = tr.b[i].y - tr_dy[tr.b[i].dir] * (tr.b[i].alive ? 1.0 - f : 0.0);
+	}
+	scene_begin();
+	gx_rotate('x', 32.0);
+	gx_translate(0.0, -3.4, -5.2);
+	gx_rotate('y', tr_cam);
+	gx_translate(-(hx[0] + 0.5), 0.0, -(hz[0] + 0.5));
+	box(TR_N / 2.0, -0.1, TR_N / 2.0, TR_N / 2.0, 0.1, TR_N / 2.0, 3, 4, 10);			/* floor */
+	box(TR_N / 2.0, 0.5, -0.2, TR_N / 2.0 + 0.3, 0.5, 0.2, 6, 18, 31);				/* arena walls */
+	box(TR_N / 2.0, 0.5, TR_N + 0.2, TR_N / 2.0 + 0.3, 0.5, 0.2, 6, 18, 31);
+	box(-0.2, 0.5, TR_N / 2.0, 0.2, 0.5, TR_N / 2.0 + 0.3, 6, 18, 31);
+	box(TR_N + 0.2, 0.5, TR_N / 2.0, 0.2, 0.5, TR_N / 2.0 + 0.3, 6, 18, 31);
+	for (i = 1; i < TR_N / 3 + 1; i++) {								/* a few lines on the floor to show the speed */
+		box(i * 3.0, 0.0, TR_N / 2.0, 0.03, 0.02, TR_N / 2.0, 6, 8, 20);
+		box(TR_N / 2.0, 0.0, i * 3.0, TR_N / 2.0, 0.02, 0.03, 6, 8, 20);
+	}
+	tr_trail(0, hx[0], hz[0], 4, 26, 31);
+	tr_trail(1, hx[1], hz[1], 31, 14, 3);
+	box(hx[0] + 0.5, 0.3, hz[0] + 0.5, 0.35, 0.3, 0.35, tr.b[0].alive ? 20 : 31, tr.b[0].alive ? 31 : 4, 31);
+	box(hx[1] + 0.5, 0.3, hz[1] + 0.5, 0.35, 0.3, 0.35, 31, tr.b[1].alive ? 24 : 31, 6);
+	scene_end();
+}
+
+static void tr_hud(struct gxw *w, int force)
+{
+	char s[40];
+
+	sprintf(s, "you %d   cpu %d", tr_wins[0], tr_wins[1]);
+	hud_line(w, 0, s, force);
+	hud_line(w, 1, tr.over ? (tr.winner == 0 ? "YOU WIN! Enter" : (tr.winner == 1 ? "CRASH! Enter" : "DRAW. Enter")) : "left / right", force);
+}
+
+/* ---------------------------------------------------------------------- Maze */
+#define MZ_C 3.0		/* cell size */
+#define MZ_R 0.75		/* the player's radius */
+static struct maze mz;
+static double mz_x, mz_z, mz_yaw, mz_walk, mz_turn, mz_time;
+static int mz_n, mz_won, mz_map = 1, mz_pcx = -1, mz_pcy = -1;
+static double mz_cube;
+
+static void mz_start(void)
+{
+	maze_new(&mz);
+	mz_x = MZ_C / 2;
+	mz_z = MZ_C / 2;
+	mz_yaw = (mz.open[0][0] & 2) ? 90.0 : 180.0;
+	mz_walk = mz_turn = mz_time = 0.0;
+	mz_won = 0;
+	mz_pcx = -1;
+}
+
+static void mz_init(void)
+{
+	mz_n = 1;
+	mz_start();
+}
+
+static void mz_key(int k)
+{
+	switch (k) {
+	case MWKEY_UP: case 'w': mz_walk = 0.35; break;
+	case MWKEY_DOWN: case 's': mz_walk = -0.35; break;
+	case MWKEY_LEFT: case 'a': mz_turn = -0.3; break;
+	case MWKEY_RIGHT: case 'd': mz_turn = 0.3; break;
+	case 'm': mz_map = !mz_map; mz_pcx = -2; break;
+	case ' ': case MWKEY_ENTER:
+		if (mz_won) {
+			mz_n++;
+			mz_start();
+		}
+		break;
+	}
+}
+
+/* move with walls: x then z separately, so the player slides along a wall */
+static void mz_try(double dx, double dz)
+{
+	int cx, cz;
+	double nx = mz_x + dx, nz = mz_z + dz, lx, lz;
+
+	cx = (int)(mz_x / MZ_C);
+	cz = (int)(mz_z / MZ_C);
+	if (dx != 0.0) {
+		lx = nx - cx * MZ_C;
+		if (lx < MZ_R && !(mz.open[cz][cx] & 8)) lx = MZ_R;
+		if (lx > MZ_C - MZ_R && !(mz.open[cz][cx] & 2)) lx = MZ_C - MZ_R;
+		mz_x = cx * MZ_C + lx;
+	}
+	cx = (int)(mz_x / MZ_C);
+	if (dz != 0.0) {
+		lz = nz - cz * MZ_C;
+		if (lz < MZ_R && !(mz.open[cz][cx] & 1)) lz = MZ_R;
+		if (lz > MZ_C - MZ_R && !(mz.open[cz][cx] & 4)) lz = MZ_C - MZ_R;
+		mz_z = cz * MZ_C + lz;
+	}
+	if (mz_x < 0.1) mz_x = 0.1;
+	if (mz_z < 0.1) mz_z = 0.1;
+	if (mz_x > MZ_W * MZ_C - 0.1) mz_x = MZ_W * MZ_C - 0.1;
+	if (mz_z > MZ_H * MZ_C - 0.1) mz_z = MZ_H * MZ_C - 0.1;
+}
+
+static void mz_update(double dt)
+{
+	double a, ex, ez;
+
+	mz_cube += dt * 140.0;
+	if (mz_won)
+		return;
+	mz_time += dt;
+	if (mz_turn != 0.0) {
+		double s = mz_turn > 0 ? 1.0 : -1.0;
+
+		mz_yaw += s * 130.0 * dt;
+		mz_turn -= s * dt;
+		if (mz_turn * s < 0.0)
+			mz_turn = 0.0;
+	}
+	if (mz_walk != 0.0) {
+		double s = mz_walk > 0 ? 1.0 : -1.0, step = s * 4.0 * dt;
+
+		a = mz_yaw * M_PI / 180.0;
+		mz_try(sin(a) * step, -cos(a) * step);
+		mz_walk -= s * dt;
+		if (mz_walk * s < 0.0)
+			mz_walk = 0.0;
+	}
+	ex = (mz.exit_x + 0.5) * MZ_C;
+	ez = (mz.exit_y + 0.5) * MZ_C;
+	if (fabs(mz_x - ex) < 0.9 && fabs(mz_z - ez) < 0.9)
+		mz_won = 1;
+}
+
+static void mz_draw(void)
+{
+	int x, y;
+	double sz = MZ_W * MZ_C / 2;
+
+	scene_begin();
+	gx_rotate('y', mz_yaw);
+	gx_translate(-mz_x, -1.1, -mz_z);
+	box(sz, -0.1, sz, sz + 0.3, 0.1, sz + 0.3, 8, 8, 12);					/* floor */
+	box(sz, 2.5, sz, sz + 0.3, 0.1, sz + 0.3, 5, 5, 9);						/* ceiling */
+	for (y = 0; y < MZ_H; y++)
+		for (x = 0; x < MZ_W; x++) {
+			unsigned char o = mz.open[y][x];
+			int shade = 16 + ((x + y) & 1) * 4;
+			double cx = x * MZ_C, cz = y * MZ_C;
+
+			if (!(o & 1))
+				box(cx + MZ_C / 2, 1.2, cz, MZ_C / 2 + 0.1, 1.3, 0.1, shade + 8, shade, 8);
+			if (!(o & 8))
+				box(cx, 1.2, cz + MZ_C / 2, 0.1, 1.3, MZ_C / 2 + 0.1, 8, shade, shade + 8);
+			if (y == MZ_H - 1 && !(o & 4))
+				box(cx + MZ_C / 2, 1.2, cz + MZ_C, MZ_C / 2 + 0.1, 1.3, 0.1, shade + 8, shade, 8);
+			if (x == MZ_W - 1 && !(o & 2))
+				box(cx + MZ_C, 1.2, cz + MZ_C / 2, 0.1, 1.3, MZ_C / 2 + 0.1, 8, shade, shade + 8);
+		}
+	gx_push();									/* the exit: a spinning green cube */
+	gx_translate((mz.exit_x + 0.5) * MZ_C, 1.1, (mz.exit_y + 0.5) * MZ_C);
+	gx_rotate('y', mz_cube);
+	gx_rotate('x', 30.0);
+	gx_scale(0.45, 0.45, 0.45);
+	gx_material(GX_RGB(4, 31, 6), GX_RGB(2, 14, 4));
+	gx_mesh_draw(&cubem);
+	gx_pop(1);
+	scene_end();
+}
+
+static void mz_rect(struct gxw *w, GR_COLOR c, int x, int y, int ww, int hh)
+{
+	GrSetGCForeground(w->gc, c);
+	GrFillRect(w->win, w->gc, x, y, ww, hh);
+}
+
+/* the map: 5 pixel cells, passages as one pixel bridges; the cell you are in is red, the exit green */
+static void mz_map_cell(struct gxw *w, int x, int y, int mx, int my)
+{
+	unsigned char o = mz.open[y][x];
+	GR_COLOR c = (x == mz_pcx && y == mz_pcy) ? GR_RGB(255, 40, 40) : (x == mz.exit_x && y == mz.exit_y ? GR_RGB(40, 230, 60) : GR_RGB(200, 200, 215));
+
+	mz_rect(w, c, mx + 1 + x * 5, my + 1 + y * 5, 4, 4);
+	if (o & 2)
+		mz_rect(w, GR_RGB(120, 120, 140), mx + 5 + x * 5, my + 2 + y * 5, 1, 2);
+	if (o & 4)
+		mz_rect(w, GR_RGB(120, 120, 140), mx + 2 + x * 5, my + 5 + y * 5, 2, 1);
+}
+
+static void mz_hud(struct gxw *w, int force)
+{
+	char s[40];
+	int x, y, cx = (int)(mz_x / MZ_C), cy = (int)(mz_z / MZ_C), mx = w->rw - MZ_W * 5 - 3, my = 2;
+
+	if (cx >= MZ_W) cx = MZ_W - 1;
+	if (cy >= MZ_H) cy = MZ_H - 1;
+	sprintf(s, "maze %d  %ds", mz_n, (int)mz_time);
+	hud_line(w, 0, s, force);
+	hud_line(w, 1, mz_won ? "FOUND IT! Enter" : "arrows walk", force);
+	if (!mz_map) {
+		if (force || mz_pcx != -2) {
+			mz_rect(w, GXW_KEY, mx - 1, my - 1, MZ_W * 5 + 2, MZ_H * 5 + 2);
+			mz_pcx = -2;
+		}
+		return;
+	}
+	if (force || mz_pcx == -1 || mz_pcx == -2) {
+		mz_rect(w, GR_RGB(30, 30, 50), mx - 1, my - 1, MZ_W * 5 + 2, MZ_H * 5 + 2);
+		mz_pcx = cx;
+		mz_pcy = cy;
+		for (y = 0; y < MZ_H; y++)
+			for (x = 0; x < MZ_W; x++)
+				mz_map_cell(w, x, y, mx, my);
+	} else if (cx != mz_pcx || cy != mz_pcy) {
+		int ox = mz_pcx, oy = mz_pcy;
+
+		mz_pcx = cx;
+		mz_pcy = cy;
+		mz_map_cell(w, ox, oy, mx, my);
+		mz_map_cell(w, cx, cy, mx, my);
+	}
+}
+
+static const struct g3d game_breakout = { "3D Breakout", 176, 132, 1.0, 60.0, br_init, br_key, br_mouse, br_update, br_draw, br_hud };
+static const struct g3d game_tron = { "Tron", 176, 132, 1.0, 80.0, tr_init, tr_key, NULL, tr_update, tr_draw, tr_hud };
+static const struct g3d game_maze = { "3D Maze", 176, 132, 0.7, 60.0, mz_init, mz_key, NULL, mz_update, mz_draw, mz_hud };
+
+static int run3d(const struct g3d *g)
+{
+	GR_EVENT ev;
+	struct gxw w;
+	long last_us = 0;
+	int force_hud = 1;
+
+	if (gx_open() < 0)
+		return 1;
+	if (GrOpen() < 0) {
+		fprintf(stderr, "dsarcade: cannot connect to Nano-X\n");
+		return 1;
+	}
+	srand((unsigned)time(NULL));
+	cube(&cubem);
+	g->init();
+	gxw_create(&w, g->title, 30, 4, g->w, g->h, g->znear, g->zfar);
+	GrSelectEvents(w.win, GR_EVENT_MASK_EXPOSURE | GR_EVENT_MASK_KEY_DOWN | GR_EVENT_MASK_CLOSE_REQ | GR_EVENT_MASK_BUTTON_DOWN |
+		       (g->mouse ? GR_EVENT_MASK_MOUSE_POSITION : 0));
+	gx_control(GX_CTRL_AA);
+	gx_flush();
+
+	while (running) {
+		int n;
+		double dt;
+		long now;
+
+		for (n = 0; n < 16; n++) {
+			GrCheckNextEvent(&ev);
+			if (ev.type == GR_EVENT_TYPE_NONE)
+				break;
+			if (gxw_event(&w, &ev))
+				running = 0;
+			if (ev.type == GR_EVENT_TYPE_EXPOSURE)
+				force_hud = 1;
+			if (ev.type == GR_EVENT_TYPE_KEY_DOWN) {
+				if (ev.keystroke.ch == MWKEY_ESCAPE || ev.keystroke.ch == 'q')
+					running = 0;
+				else
+					g->key(ev.keystroke.ch);
+			} else if (ev.type == GR_EVENT_TYPE_BUTTON_DOWN) {
+				if (g->mouse)
+					g->mouse(&w, ev.button.x);
+				g->key(g == &game_breakout ? ' ' : (ev.button.x < w.rw / 2 ? MWKEY_LEFT : MWKEY_RIGHT));
+			} else if (ev.type == GR_EVENT_TYPE_MOUSE_POSITION && g->mouse) {
+				g->mouse(&w, ev.mouse.x);
+			}
+		}
+		gxw_update(&w);
+		if (!w.visible) {
+			usleep(100000);
+			w.dirty = 1;
+			last_us = 0;
+			continue;
+		}
+		gx_vsync();
+		now = usec();
+		dt = last_us ? (now - last_us) / 1e6 : 1.0 / 60.0;
+		last_us = now;
+		if (dt > 0.05)
+			dt = 0.05;
+		now_t += dt;
+		g->update(dt);
+		g->draw();
+		g->hud(&w, force_hud);
+		force_hud = 0;
+	}
+	gx_close();
+	GrClose();
+	return 0;
+}
+
+int main(int argc, char **argv)
+{
+	const char *name = argc > 1 ? argv[1] : "";
+
+	if (!strcmp(name, "breakout")) return run3d(&game_breakout);
+	if (!strcmp(name, "tron")) return run3d(&game_tron);
+	if (!strcmp(name, "maze")) return run3d(&game_maze);
+	if (!strcmp(name, "2048")) return run2d(&game_2048);
+	if (!strcmp(name, "sokoban")) return run2d(&game_sokoban);
+	if (!strcmp(name, "sudoku")) return run2d(&game_sudoku);
+	if (!strcmp(name, "life")) return run2d(&game_life);
+	if (!strcmp(name, "paint")) return run2d(&game_paint);
+	fprintf(stderr, "usage: dsarcade breakout|tron|maze|2048|sokoban|sudoku|life|paint\n");
+	return 1;
+}
