+static void draw_panel48(void)
+{
+	char s[24];
+
+	fillc(W95_FACE, 134, 0, WW - 134, 70);
+	text(W95_NAVY, 138, 4, "2048");
+	sprintf(s, "score %d", g48.score);
+	text(W95_DARK, 138, 18, s);
+	sprintf(s, "best  %d", best48);
+	text(W95_DARK, 138, 30, s);
+	if (g48.over)
+		text(GR_RGB(200, 0, 0), 138, 46, "No moves left");
+	else if (won48)
+		text(GR_RGB(0, 140, 0), 138, 46, "2048 reached!");
+	else
+		text(W95_SHADOW, 138, 46, "swipe or arrows");
+}
+
+static void draw48(void)
+{
+	int r, c;
+
+	fillc(F_BG, 4, 4, F_BOARD, F_BOARD);
+	for (r = 0; r < 4; r++)
+		for (c = 0; c < 4; c++)
+			draw_tile(r, c);
+	draw_panel48();
+}
+
+static void key48(int k)
+{
+	int dir = -1, r, c;
+
+	switch (k) {
+	case MWKEY_LEFT: dir = 0; break;
+	case MWKEY_RIGHT: dir = 1; break;
+	case MWKEY_UP: dir = 2; break;
+	case MWKEY_DOWN: dir = 3; break;
+	case 'n':
+	case MWKEY_ENTER:
+		if (g48.over || k == 'n') {
+			g2048_new(&g48);
+			won48 = 0;
+			draw48();
+		}
+		return;
+	}
+	if (dir < 0 || g48.over)
+		return;
+	if (g2048_move(&g48, dir)) {
+		for (r = 0; r < 4; r++)
+			for (c = 0; c < 4; c++)
+				if (g48.t[r][c] >= 2048)
+					won48 = 1;
+		if (g48.score > best48) {
+			best48 = g48.score;
+			save_int("/home/arcade2048.best", best48);
+		}
+		draw48();
+	}
+}
+
+static void mouse48(int x, int y, int kind)
+{
+	int dx, dy;
+
+	if (kind == 1) {
+		f_sx = x;
+		f_sy = y;
+		return;
+	}
+	if (kind != 0 || x >= 134)
+		return;
+	dx = x - f_sx;
+	dy = y - f_sy;
+	if (dx * dx + dy * dy < 100) {			/* a tap: towards that side of the middle of the board */
+		dx = x - (4 + F_BOARD / 2);
+		dy = y - (4 + F_BOARD / 2);
+	}
+	if (abs(dx) > abs(dy))
+		key48(dx < 0 ? MWKEY_LEFT : MWKEY_RIGHT);
+	else
+		key48(dy < 0 ? MWKEY_UP : MWKEY_DOWN);
+}
