+
+	scene_begin();
+	gx_translate(0.0, 0.0, -6.6);
+	gx_rotate('x', -18.0);
+	gx_translate(0.0, -0.1, 0.0);
+	box(0.0, 0.1, -0.6, 4.9, 3.8, 0.05, 4, 5, 14);						/* floor */
+	box(-BR_HALFW - 0.25, 0.1, 0.0, 0.25, 3.8, 0.3, 14, 14, 22);				/* walls */
+	box(BR_HALFW + 0.25, 0.1, 0.0, 0.25, 3.8, 0.3, 14, 14, 22);
+	box(0.0, BR_TOP + 0.25, 0.0, BR_HALFW + 0.5, 0.25, 0.3, 14, 14, 22);
+	for (r = 0; r < BR_ROWS; r++)
+		for (c = 0; c < BR_COLS; c++)
+			if (br.brick[r][c])
+				box(BR_BRICK_X0 + c * BR_BRICK_W, BR_BRICK_Y0 - r * (BR_BRICK_H + 0.1), 0.0, BR_BRICK_W / 2 - 0.04, BR_BRICK_H / 2, 0.25,
+				    rowc[r][0], rowc[r][1], rowc[r][2]);
+	box(br.px, BR_BOTTOM + 0.125, 0.0, BR_PADDLE_HALF, 0.125, 0.25, 8, 24, 31);			/* paddle */
+	gx_push();
+	gx_translate(br.bx, br.by, 0.0);
+	gx_rotate('y', br_spin);
+	gx_rotate('x', br_spin * 0.6);
+	gx_scale(BR_BALL_R, BR_BALL_R, BR_BALL_R);
+	gx_material(GX_RGB(31, 31, 31), GX_RGB(14, 14, 14));
+	gx_mesh_draw(&cubem);
