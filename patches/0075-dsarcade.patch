+/* ------------------------------------------------------------------- Sudoku */
+#define SU_C	13
+static struct sudoku su;
+static int su_sel, su_solved;
+#define SU_SEL	GR_RGB(255, 255, 160)
+#define SU_RED	GR_RGB(200, 0, 0)
+
+static void su_cell(int i)
+{
+	int x = 4 + (i % 9) * SU_C + 1, y = 4 + (i / 9) * SU_C + 1;
+	char s[2];
+
+	fillc(i == su_sel ? SU_SEL : W95_LIGHT, x, y, SU_C - 1, SU_C - 1);
+	if (su.g[i]) {
+		s[0] = '0' + su.g[i];
+		s[1] = 0;
+		ctext(sud_conflict(&su, i) ? SU_RED : (su.given[i] ? W95_DARK : W95_NAVY), x, y, SU_C - 1, SU_C - 1, s);
+	}
+}
+
+static void su_status(void)
+{
+	fillc(W95_FACE, 126, 92, WW - 126, 40);
+	if (su_solved)
+		text(GR_RGB(0, 140, 0), 130, 96, "Solved!");
+	else
+		text(W95_SHADOW, 130, 96, "red = clash");
+}
+
+static void su_lines(void)
+{
+	int k;
+
+	for (k = 0; k <= 3; k++) {
+		fillc(W95_DARK, 4 + k * 3 * SU_C, 4, 1, 9 * SU_C + 1);
+		fillc(W95_DARK, 4, 4 + k * 3 * SU_C, 9 * SU_C + 1, 1);
+	}
+}
+
+static void draw_su(void)
+{
+	int i;
+
+	fillc(W95_SHADOW, 4, 4, 9 * SU_C + 1, 9 * SU_C + 1);
+	for (i = 0; i < 81; i++)
+		su_cell(i);
+	su_lines();
+	su_status();
+}
+
+static void su_set(int v)
+{
+	int i;
+
+	if (su.given[su_sel] || su_solved)
+		return;
+	su.g[su_sel] = v;
+	for (i = 0; i < 81; i++)				/* a changed digit can change the red clashes anywhere in its row, column, box */
+		su_cell(i);
+	su_lines();
+	if (v && sud_complete(&su))
+		su_solved = 1;
+	su_status();
+}
+
+static void su_move(int d)
+{
+	int old = su_sel, r = su_sel / 9, c = su_sel % 9;
+
+	if (d == 0 && r > 0) r--;
+	if (d == 1 && c < 8) c++;
+	if (d == 2 && r < 8) r++;
+	if (d == 3 && c > 0) c--;
+	su_sel = r * 9 + c;
+	if (su_sel != old) {
+		su_cell(old);
+		su_cell(su_sel);
+		su_lines();
+	}
+}
+
+static void su_new(void)
+{
+	sud_new(&su, 38);
+	su_sel = 40;
+	su_solved = 0;
+}
+
+static void key_su(int k)
+{
+	switch (k) {
+	case MWKEY_UP: su_move(0); return;
+	case MWKEY_RIGHT: su_move(1); return;
+	case MWKEY_DOWN: su_move(2); return;
+	case MWKEY_LEFT: su_move(3); return;
+	case '0': case MWKEY_BACKSPACE: case MWKEY_DELETE: case 'c':
+		su_set(0);
+		return;
+	case 'n':
+		su_new();
+		redraw_all(cur2d);
+		return;
+	case MWKEY_PAGEUP:					/* X / Y on the console: the digit under the cursor up or down */
+		su_set(su.g[su_sel] % 9 + 1);
+		return;
+	case MWKEY_PAGEDOWN:
+		su_set(su.g[su_sel] <= 1 ? 9 : su.g[su_sel] - 1);
+		return;
+	}
+	if (k >= '1' && k <= '9')
+		su_set(k - '0');
+}
+
+static void mouse_su(int x, int y, int kind)
+{
+	int c = (x - 4) / SU_C, r = (y - 4) / SU_C, old;
+
+	if (kind != 1 || x < 4 || y < 4 || c > 8 || r > 8)
+		return;
+	old = su_sel;
+	su_sel = r * 9 + c;
+	su_cell(old);
+	su_cell(su_sel);
+	su_lines();
+}
+
+static void init_su(void)
+{
+	su_new();
+}
+
+static const struct btn btn_su[] = {
+	{ 128, 4, 22, 16, "1", '1' }, { 152, 4, 22, 16, "2", '2' }, { 176, 4, 22, 16, "3", '3' },
+	{ 128, 22, 22, 16, "4", '4' }, { 152, 22, 22, 16, "5", '5' }, { 176, 22, 22, 16, "6", '6' },
+	{ 128, 40, 22, 16, "7", '7' }, { 152, 40, 22, 16, "8", '8' }, { 176, 40, 22, 16, "9", '9' },
+	{ 128, 58, 70, 14, "Clear", '0' }, { 128, 74, 70, 14, "New puzzle", 'n' },
+};
+static const struct game2d game_sudoku = { "Sudoku", init_su, draw_su, key_su, mouse_su, NULL, NULL, btn_su, 11, 0 };
