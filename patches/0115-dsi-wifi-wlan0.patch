-/* receive and handle packets until "want" happened or ms ran out; returns 1 if it happened */
+/* wlan0 (step 5): the net device, its state and the data path */
+static struct net_device *wdev;
+static struct net_device_stats wstats;
+static int session;		/* the chip runs its firmware and holds the antenna */
+static int connected;
+static int unknown_logged;
+
+/* a received data packet (endpoint 2..5): rssi, 0, dst[6], src[6], length (BE), LLC/SNAP AA AA 03 00 00 00, EtherType, data */
+static void rx_data(const unsigned char *p, int len)
+{
+	struct sk_buff *skb;
+	int dl = len - 24;
+
+	if (!wdev || !connected || dl < 0 || dl > 1600)
+		return;
+	if (p[16] != 0xAA || p[17] != 0xAA || p[18] != 0x03 || p[19] || p[20] || p[21]) {
+		wstats.rx_frame_errors++;
+		return;
+	}
+	skb = dev_alloc_skb(dl + 14 + 2);
+	if (!skb) {
+		wstats.rx_dropped++;
+		return;
+	}
+	skb_reserve(skb, 2);
+	memcpy(skb_put(skb, 6), p + 2, 6);		/* destination */
+	memcpy(skb_put(skb, 6), p + 8, 6);		/* source */
+	memcpy(skb_put(skb, 2), p + 22, 2);		/* EtherType */
+	memcpy(skb_put(skb, dl), p + 24, dl);
+	skb->dev = wdev;
+	skb->protocol = eth_type_trans(skb, wdev);
+	wstats.rx_packets++;
+	wstats.rx_bytes += dl + 14;
+	netif_rx_ni(skb);
+}
+
+/* one received packet (in rx[], header word hdr); "flag" is set when the event it stands for arrives */
+static void handle_pkt(unsigned int hdr, int *ev_scan_done)
+{
+	unsigned int len = hdr >> 16, alen, id, ep = hdr & 0xff;
+
+	alen = (hdr >> 8) & 0xff ? rx[4] : 0;		/* trailer (acknowledgements, lookahead) */
+	if (len < alen + 2 || len > 2040)
+		return;
+	len -= alen;
+	if (ep >= 2 && ep <= 5) {			/* data */
+		rx_data(rx + 6, len);
+		return;
+	}
+	id = rx[6] | (rx[7] << 8);
+	if (ep == 0) {					/* HTC */
+		if (id == HTC_MSG_READY)
+			lg("  HTC ready (%u bytes: credits %u of %u bytes)\n", len - 2, rx[8] | (rx[9] << 8), rx[10] | (rx[11] << 8));
+		else if (id == HTC_MSG_CONN_SVC_RESP)
+			lg("  HTC service connected: service %04x status %u endpoint %u\n", rx[8] | (rx[9] << 8), rx[10], rx[11]);
+		return;
+	}
+	if (ep != 1)
+		return;
+	switch (id) {					/* WMI */
+	case WMI_READY_EVENT:
+		memcpy(mac, rx + 8, 6);
+		wmi_ready = 1;
+		lg("  WMI ready, MAC %02x:%02x:%02x:..\n", mac[0], mac[1], mac[2]);
+		break;
+	case WMI_REG_DOMAIN_EVENT:
+		reg_domain = 1;
+		lg("  WMI regulatory domain %08x\n", w32(rx + 8), 0, 0);
+		break;
+	case WMI_BSS_INFO_EVENT:
+		bss_info(rx + 8, len - 2);
+		break;
+	case WMI_SCAN_COMPLETE_EVENT:
+		scan_done = 1;
+		if (ev_scan_done)
+			*ev_scan_done = 1;
+		break;
+	case WMI_CMD_ERROR_EVENT:
+		lg("  WMI command error: command %04x error %u\n", rx[8] | (rx[9] << 8), rx[10], 0);
+		break;
+	case WMI_CONNECT_EVENT:				/* u16 channel (MHz), bssid[6], ... */
+		connected = 1;
+		lg("  CONNECTED on channel %u, BSSID ..:%02x:%02x\n", wifi_mhz_to_channel(rx[8] | (rx[9] << 8)), rx[14], rx[15]);
+		if (wdev)
+			netif_carrier_on(wdev);
+		break;
+	case WMI_DISCONNECT_EVENT:			/* u16 protocol reason, bssid[6], u8 reason */
+		connected = 0;
+		lg("  disconnected: reason %u (protocol reason %u)\n", rx[16], rx[8] | (rx[9] << 8), 0);
+		if (wdev)
+			netif_carrier_off(wdev);
+		break;
+	default:
+		if (unknown_logged < 12) {		/* what else the firmware says (the scan question of w98m) */
+			unknown_logged++;
+			lg("  WMI event %04x (%u bytes)\n", id, len - 2, 0);
+		}
+	}
+}
