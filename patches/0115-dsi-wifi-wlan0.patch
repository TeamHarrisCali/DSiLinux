+/* the worker thread: every SD request (ARM7 operation) for wlan0 happens here, never in the network stack's own context */
+static DECLARE_WAIT_QUEUE_HEAD(thr_wait);
+static DECLARE_COMPLETION(thr_done);
+static struct sk_buff_head txq;
+static volatile int thr_run;
+static char conn_req[33];
+static volatile int conn_pending, disc_pending;
+
+static int wifi_channel_to_mhz(int ch)
+{
+	return ch == 14 ? 2484 : 2412 + (ch - 1) * 5;
+}
+
+/* dswifi's wmi_connect() for an open network */
+static void do_connect(void)
+{
+	unsigned char b[64];
+	struct net2 *n = 0;
+	int i, bad = 0;
+
+	for (i = 0; i < nnets; i++) {
+		if (strcmp(nets[i].sec, "open"))
+			continue;
+		if (conn_req[0] && strcmp(nets[i].ssid, conn_req))
+			continue;
+		if (!n || nets[i].rssi > n->rssi)
+			n = &nets[i];
+	}
+	if (!n) {
+		lg(conn_req[0] ? "connect: no open network of that name in the scan\n" : "connect: no open network in the scan\n", 0, 0, 0);
+		return;
+	}
+	lg("connect: channel %u, signal %d, %u-character name\n", n->channel, n->rssi, strlen(n->ssid));
+	lgs("  name: ");
+	lgs(n->ssid);
+	lgs("\n");
+	memset(b, 0, sizeof(b));
+	b[0] = 4;						/* BSS filter: the current beacon */
+	mbox_out(1, 1, WMI_SET_BSS_FILTER_CMD, b, 8, &bad);
+	memset(b, 0, sizeof(b));				/* scan params 5, 200, 200, 200 */
+	for (i = 0; i < 6; i++)
+		b[i] = 0xFF;
+	b[6] = 200;
+	b[8] = 200;
+	b[10] = 3;
+	b[11] = 5;
+	b[12] = 200;
+	mbox_out(1, 1, WMI_SET_SCAN_PARAMS_CMD, b, 20, &bad);
+	memset(b, 0, sizeof(b));				/* channel params: 11g, the AP's channel */
+	b[2] = 2;
+	b[3] = 1;
+	b[4] = wifi_channel_to_mhz(n->channel) & 0xff;
+	b[5] = wifi_channel_to_mhz(n->channel) >> 8;
+	mbox_out(1, 1, WMI_SET_CHANNEL_PARAMS_CMD, b, 6, &bad);
+	b[0] = 0;
+	mbox_out_x(1, 1, 0x2008, WMI_SYNCHRONIZE_CMD, b, 1, &bad);
+	b[0] = 2;						/* power mode: maximum performance */
+	mbox_out(1, 1, WMI_SET_POWER_MODE_CMD, b, 1, &bad);
+	b[0] = 0;
+	mbox_out(1, 1, WMI_SYNCHRONIZE_CMD, b, 1, &bad);
+	{
+		/* create pstream: 13 words, 2 halfwords, 7 bytes (dswifi's values) */
+		static const unsigned int wv[13] = { 20, 20, 9999999, 0xFFFFFFFF, 0, 83200, 83200, 83200, 0, 0, 6000000, 8192, 0 };
+		unsigned char ps[63];
+		int k;
+
+		for (k = 0; k < 13; k++) {
+			ps[k * 4] = wv[k];
+			ps[k * 4 + 1] = wv[k] >> 8;
+			ps[k * 4 + 2] = wv[k] >> 16;
+			ps[k * 4 + 3] = wv[k] >> 24;
+		}
+		ps[52] = 0xD0; ps[53] = 0x80;			/* nominal MSDU 0x80D0 */
+		ps[54] = 0xD0; ps[55] = 0x00;			/* max MSDU 0x00D0 */
+		ps[56] = 0; ps[57] = 2; ps[58] = 0xFF; ps[59] = 1; ps[60] = 0; ps[61] = 5; ps[62] = 0;
+		mbox_out(1, 1, WMI_CREATE_PSTREAM_CMD, ps, 63, &bad);
+	}
+	b[0] = 0;
+	mbox_out(1, 1, WMI_SET_WSC_STATUS_CMD, b, 1, &bad);
+	b[0] = 5;						/* disconnect timeout 5 s */
+	mbox_out(1, 1, WMI_SET_DISCONNECT_TIMEOUT_CMD, b, 1, &bad);
+	b[0] = 0;
+	mbox_out(1, 1, WMI_SET_KEEPALIVE_CMD, b, 1, &bad);
+	/* connect: infrastructure, open, no auth, no ciphers, the name, channel (MHz), BSSID, control flags 0x20 (follow the AP's
+	 * channel switches) */
+	memset(b, 0, sizeof(b));
+	b[0] = 1; b[1] = 1; b[2] = 1; b[3] = 1; b[4] = 0; b[5] = 1; b[6] = 0;
+	b[7] = strlen(n->ssid);
+	memcpy(b + 8, n->ssid, b[7]);
+	b[40] = wifi_channel_to_mhz(n->channel) & 0xff;
+	b[41] = wifi_channel_to_mhz(n->channel) >> 8;
+	memcpy(b + 42, n->bssid, 6);
+	b[48] = 0x20;
+	mbox_out(1, 1, WMI_CONNECT_CMD, b, 52, &bad);
+	lg(bad ? "connect: sending the commands FAILED\n" : "connect: commands sent, waiting for the connect event\n", 0, 0, 0);
+}
+
+/* an Ethernet frame from the stack into a mailbox data packet (endpoint 2) */
+static void tx_one(struct sk_buff *skb)
+{
+	unsigned int dl, pl, full;
+	int bad = 0;
+
+	if (skb->len < 14) {
+		wstats.tx_errors++;
+		return;
+	}
+	dl = skb->len - 14;
+	pl = 24 + dl;
+	full = (6 + pl + 0x7F) & ~0x7Fu;
+	if (full > sizeof(pkt)) {
+		wstats.tx_dropped++;
+		return;
+	}
+	memset(pkt, 0, full);
+	pkt[0] = 2;					/* best effort data */
+	pkt[2] = pl & 0xff;
+	pkt[3] = pl >> 8;
+	pkt[4] = 0x08;					/* 0x2008, as dswifi's data_send_pkt_idk() */
+	pkt[5] = 0x20;
+	memcpy(pkt + 8, skb->data, 6);			/* destination */
+	memcpy(pkt + 14, skb->data + 6, 6);		/* source */
+	pkt[20] = (dl + 8) >> 8;			/* length after this field, big endian */
+	pkt[21] = (dl + 8) & 0xff;
+	pkt[22] = 0xAA; pkt[23] = 0xAA; pkt[24] = 0x03;
+	memcpy(pkt + 28, skb->data + 12, 2);		/* EtherType */
+	memcpy(pkt + 30, skb->data + 14, dl);
+	op(11, 0, full, pkt, full, &bad);
+	if (bad) {
+		wstats.tx_errors++;
+	} else {
+		wstats.tx_packets++;
+		wstats.tx_bytes += skb->len;
+	}
+}
+
+static int wthread(void *arg)
+{
+	daemonize("dsiwifi");
+	while (thr_run) {
+		struct sk_buff *skb;
+		int i, bad = 0;
+
+		while ((skb = skb_dequeue(&txq))) {
+			tx_one(skb);
+			dev_kfree_skb(skb);
+		}
+		if (wdev && netif_queue_stopped(wdev) && skb_queue_len(&txq) < 8)
+			netif_wake_queue(wdev);
+		if (conn_pending) {
+			conn_pending = 0;
+			do_connect();
+		}
+		if (disc_pending) {
+			disc_pending = 0;
+			mbox_out(1, 1, WMI_DISCONNECT_CMD, 0, 0, &bad);
+		}
+		for (i = 0; i < 8; i++) {			/* whatever arrived: at most 8 packets per round */
