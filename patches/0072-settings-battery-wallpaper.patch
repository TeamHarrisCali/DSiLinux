diff --git a/user/microwin/src/demos/nanox/dssettings.c b/user/microwin/src/demos/nanox/dssettings.c
new file mode 100644
index 000000000..763ed33af
--- /dev/null
+++ b/user/microwin/src/demos/nanox/dssettings.c
@@ -0,0 +1,558 @@
+/*
+ * dssettings - the Settings window of the DSLinuxDSi desktop (Windows 95 look).
+ *   Brightness     the DSi backlight, levels 1..5 (never off). /proc/dsisettings -> the ARM7 writes the power chip.
+ *   Pointer speed  how far the pointer moves for a drag on the trackpad, 1..8. /proc/dsisettings.
+ *   Desktop        the colour or wallpaper behind the windows: 6 colours, 3 built in patterns, and every BMP in /home/wallpapers
+ *                  and every photo in /home/photos (256x192, 24 bit BMP). The desktop panel (dsdesk) does the drawing: this
+ *                  program writes the choice to /home/settings.conf and tells dsdesk (SIGUSR1).
+ *   Clock          sets the system clock (hours, minutes, day, month, year). It is kept by the kernel until power off.
+ *   Info           battery level, volume level of the DSi's volume buttons, free memory.
+ * Choices are saved at once in /home/settings.conf and applied again at every desktop start (dssettings apply).
+ * Keys: up/down choose a row, left/right change it, q or Esc closes. Buttons and the trackpad pointer work too.
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <fcntl.h>
+#include <signal.h>
+#include <dirent.h>
+#include <time.h>
+#include <sys/time.h>
+#include "nano-X.h"
+#include "w95.h"
+
+#define CONF		"/home/settings.conf"
+#define PROC		"/proc/dsisettings"
+#define WIN_W		224
+#define WIN_H		150
+#define NCOLOURS	6
+#define NPATTERNS	3
+#define MAXWALL		48
+
+static const char *colour_names[NCOLOURS] = { "Teal", "Navy", "Green", "Grey", "Purple", "Black" };
+static const char *pattern_names[NPATTERNS] = { "Sky", "Dusk", "Grid" };
+
+/* the desktop choices: colours, patterns, files */
+static char wall_label[MAXWALL][24];
+static char wall_path[MAXWALL][96];
+static int nwall;
+
+static int brightness = 3, padgain = 2, desk = 0;	/* desk: index into the choices */
+static int have_brightness, have_padgain;
+static int focus, applying;			/* applying: only write the hardware, do not rewrite the saved file */
+#define FIXED_BTNS	7			/* the three spin rows (6 buttons) and the Sound test button */
+static GR_WINDOW_ID win;
+static GR_GC_ID gc;
+static int th;
+
+/* ---- the proc file ---- */
+struct info {
+	int battery, charger, volume, backlight, padgain;
+};
+
+static int proc_info(struct info *i)
+{
+	FILE *f = fopen(PROC, "r");
+	int n;
+
+	i->battery = i->volume = i->backlight = -1;
+	i->charger = 0;
+	i->padgain = 2;
+	if (!f)
+		return -1;
+	n = fscanf(f, "battery=%d charger=%d volume=%d backlight=%d padgain=%d", &i->battery, &i->charger, &i->volume, &i->backlight,
+		   &i->padgain);
+	fclose(f);
+	return n >= 4 ? 0 : -1;
+}
+
+static void proc_set(const char *cmd)
+{
+	int f = open(PROC, O_WRONLY);
+
+	if (f >= 0) {
+		write(f, cmd, strlen(cmd));
+		close(f);
+	}
+}
+
+/* ---- the choices for the desktop ---- */
+static int cmp_labels(const void *a, const void *b)
+{
+	return strcmp((const char *)a, (const char *)b);
+}
+
+static void add_files(const char *dir, const char *prefix)
+{
+	DIR *d = opendir(dir);
+	struct dirent *e;
+
+	if (!d)
+		return;
+	while ((e = readdir(d)) != NULL && nwall < NCOLOURS + NPATTERNS + MAXWALL - 1) {
+		int n = strlen(e->d_name);
+
+		if (n > 4 && n < 20 && !strcmp(e->d_name + n - 4, ".bmp")) {
+			int k = nwall - (NCOLOURS + NPATTERNS);
+
+			if (k < 0 || k >= MAXWALL)
+				break;
+			snprintf(wall_label[k], sizeof(wall_label[k]), "%s%s", prefix, e->d_name);
+			snprintf(wall_path[k], sizeof(wall_path[k]), "%s/%s", dir, e->d_name);
+			nwall++;
+		}
+	}
+	closedir(d);
+}
+
+static int nchoices(void)
+{
+	return nwall;
+}
+
+static void choice_name(int i, char *out, int len)
+{
+	if (i < NCOLOURS)
+		snprintf(out, len, "%s", colour_names[i]);
+	else if (i < NCOLOURS + NPATTERNS)
+		snprintf(out, len, "%s", pattern_names[i - NCOLOURS]);
+	else
+		snprintf(out, len, "%s", wall_label[i - NCOLOURS - NPATTERNS]);
+}
+
+static void scan_choices(void)
+{
+	nwall = NCOLOURS + NPATTERNS;
+	add_files("/home/wallpapers", "");
+	add_files("/home/photos", "");
+}
+
+/* ---- the saved settings ---- */
+static void save_conf(void)
+{
+	FILE *f = fopen(CONF, "w");
+	char line[110];
+
+	if (!f)
+		return;
+	if (have_brightness)
+		fprintf(f, "brightness=%d\n", brightness);
+	if (have_padgain)
+		fprintf(f, "padgain=%d\n", padgain);
+	if (desk < NCOLOURS)
+		sprintf(line, "desktop=C:%d", desk);
+	else if (desk < NCOLOURS + NPATTERNS)
+		sprintf(line, "desktop=P:%d", desk - NCOLOURS);
+	else
+		sprintf(line, "desktop=F:%s", wall_path[desk - NCOLOURS - NPATTERNS]);
+	fprintf(f, "%s\n", line);
+	fclose(f);
+}
+
+/* returns the desktop line's kind and value through the arguments; 0 = no line */
+static void load_conf(char *kind, char *path, int *n)
+{
+	FILE *f = fopen(CONF, "r");
+	char line[200];
+
+	*kind = 0;
+	path[0] = 0;
+	*n = 0;
+	if (!f)
+		return;
+	while (fgets(line, sizeof(line), f)) {
+		char *e = line + strlen(line);
+
+		while (e > line && (e[-1] == '\n' || e[-1] == '\r'))
+			*--e = 0;
+		if (!strncmp(line, "brightness=", 11)) {
+			brightness = atoi(line + 11);
+			have_brightness = 1;
+		} else if (!strncmp(line, "padgain=", 8)) {
+			padgain = atoi(line + 8);
+			have_padgain = 1;
+		} else if (!strncmp(line, "desktop=", 8) && line[8] && line[9] == ':') {
+			*kind = line[8];
+			if (*kind == 'F')
+				snprintf(path, 160, "%s", line + 10);
+			else
+				*n = atoi(line + 10);
+		}
+	}
+	fclose(f);
+}
+
+static void tell_desktop(void)
+{
+	FILE *f = fopen("/tmp/dsdesk.pid", "r");
+	int pid = 0;
+
+	if (f) {
+		if (fscanf(f, "%d", &pid) != 1)
+			pid = 0;
+		fclose(f);
+	}
+	if (pid > 0)
+		kill(pid, SIGUSR1);
+}
+
+static void set_brightness(int v)
+{
+	char cmd[24];
+
+	if (v < 1)
+		v = 1;
+	if (v > 5)
+		v = 5;
+	brightness = v;
+	have_brightness = 1;
+	sprintf(cmd, "backlight %d\n", v);
+	proc_set(cmd);
+	if (!applying)
+		save_conf();
+}
+
+static void set_padgain(int v)
+{
+	char cmd[24];
+
+	if (v < 1)
+		v = 1;
+	if (v > 8)
+		v = 8;
+	padgain = v;
+	have_padgain = 1;
+	sprintf(cmd, "padgain %d\n", v);
+	proc_set(cmd);
+	if (!applying)
+		save_conf();
+}
+
+static void set_desk(int d)
+{
+	int n = nchoices();
+
+	desk = (d % n + n) % n;
+	save_conf();
+	tell_desktop();
+}
+
+static void adjust_time(long delta, int field)
+{
+	time_t now = time(NULL);
+	struct tm tm;
+	struct timeval tv;
+
+	if (field) {					/* month / year: through the calendar */
+		struct tm *p = localtime(&now);
+
+		tm = *p;
+		if (field == 1)
+			tm.tm_mon++;
+		else
+			tm.tm_year++;
+		now = mktime(&tm);
+	} else {
+		now += delta;
+	}
+	tv.tv_sec = now;
+	tv.tv_usec = 0;
+	settimeofday(&tv, NULL);
+}
+
+/* ---- drawing ---- */
+#define RX0		4
+#define LABELW		62
+#define BTNW		16
+#define BTNH		13
+#define ROWH		17
+#define ROWY(i)		(4 + (i) * ROWH)
+#define VALX		(RX0 + LABELW + BTNW + 3)	/* the value field */
+#define VALW		78
+#define PLUSX		(VALX + VALW + 3)
+
+struct btn {
+	int x, y, w, h, id;
+};
+static struct btn btns[16];
+static int nbtn;
+
+static void add_btn(int x, int y, int w, int h, int id)
+{
+	btns[nbtn].x = x;
+	btns[nbtn].y = y;
+	btns[nbtn].w = w;
+	btns[nbtn].h = h;
+	btns[nbtn++].id = id;
+}
+
+enum { B_BR_M = 1, B_BR_P, B_PD_M, B_PD_P, B_DK_M, B_DK_P, B_TH, B_TM, B_DD, B_DMO, B_DY, B_SOUND };
+
+static void draw_spin(int row, const char *label, int minus_id, int plus_id)
+{
+	int y = ROWY(row);
+
+	w95_text(win, gc, row == focus ? W95_NAVY : W95_DARK, RX0, y + 2, label);
+	w95_button(win, gc, RX0 + LABELW, y, BTNW, BTNH, "-", 0);
+	w95_box(win, gc, VALX, y, VALW, BTNH, 1, W95_WHITEFILL);
+	w95_button(win, gc, PLUSX, y, BTNW, BTNH, "+", 0);
+	add_btn(RX0 + LABELW, y, BTNW, BTNH, minus_id);
+	add_btn(PLUSX, y, BTNW, BTNH, plus_id);
+}
+
+static void draw_value(int row, const char *text)
+{
+	int y = ROWY(row);
+
+	w95_fill(win, gc, W95_LIGHT, VALX + 2, y + 2, VALW - 4, BTNH - 4);
+	w95_text(win, gc, W95_DARK, VALX + 4, y + 2, text);
+}
+
+static void draw_pips(int row, int level, int max)
+{
+	int y = ROWY(row), i;
+
+	w95_fill(win, gc, W95_LIGHT, VALX + 2, y + 2, VALW - 4, BTNH - 4);
+	for (i = 0; i < max; i++)
+		w95_fill(win, gc, i < level ? W95_NAVY : W95_SHADOW, VALX + 5 + i * (VALW - 10) / max, y + 4,
+			 (VALW - 10) / max - 2, BTNH - 8);
+}
+
+static void draw_clock(void)
+{
+	time_t now = time(NULL);
+	struct tm *tm = localtime(&now);
+	char t[40];
+	int y = ROWY(3);
+
+	w95_fill(win, gc, W95_FACE, 0, y, WIN_W, ROWH * 2);
+	nbtn = FIXED_BTNS;				/* the clock buttons are rebuilt below */
+	sprintf(t, "%02d:%02d:%02d", tm->tm_hour, tm->tm_min, tm->tm_sec);
+	w95_text(win, gc, W95_DARK, RX0, y + 2, "Time");
+	w95_box(win, gc, VALX, y, VALW, BTNH, 1, W95_WHITEFILL);
+	w95_text(win, gc, W95_DARK, VALX + 4, y + 2, t);
+	w95_button(win, gc, PLUSX, y, 20, BTNH, "H+", 0);
+	w95_button(win, gc, PLUSX + 22, y, 20, BTNH, "M+", 0);
+	add_btn(PLUSX, y, 20, BTNH, B_TH);
+	add_btn(PLUSX + 22, y, 20, BTNH, B_TM);
+	y = ROWY(4);
+	sprintf(t, "%04d-%02d-%02d", tm->tm_year + 1900, tm->tm_mon + 1, tm->tm_mday);
+	w95_text(win, gc, W95_DARK, RX0, y + 2, "Date");
+	w95_box(win, gc, VALX, y, VALW, BTNH, 1, W95_WHITEFILL);
+	w95_text(win, gc, W95_DARK, VALX + 4, y + 2, t);
+	w95_button(win, gc, PLUSX, y, 20, BTNH, "D+", 0);
+	w95_button(win, gc, PLUSX + 22, y, 20, BTNH, "Mo", 0);
+	w95_button(win, gc, PLUSX + 44, y, 20, BTNH, "Y+", 0);
+	add_btn(PLUSX, y, 20, BTNH, B_DD);
+	add_btn(PLUSX + 22, y, 20, BTNH, B_DMO);
+	add_btn(PLUSX + 44, y, 20, BTNH, B_DY);
+}
+
+static void draw_info(void)
+{
+	struct info in;
+	char t[48];
+	FILE *f;
+	long total = 0, freem = 0;
+	char l[80];
+	int y = ROWY(5) + 2;
+
+	w95_fill(win, gc, W95_FACE, 0, y, WIN_W, th * 3 + 8);
+	proc_info(&in);
+	if (in.battery >= 0)
+		sprintf(t, "Battery %d%%%s", in.battery * 100 / 15, in.charger ? "  (external power)" : "");
+	else
+		strcpy(t, "Battery: unknown");
+	w95_text(win, gc, W95_DARK, RX0, y, t);
+	if (in.volume >= 0)
+		sprintf(t, "Volume %d%% (the DSi's volume buttons)", in.volume * 100 / 31);
+	else
+		strcpy(t, "Volume: unknown");
+	w95_text(win, gc, W95_DARK, RX0, y + th + 1, t);
+	f = fopen("/proc/meminfo", "r");
+	if (f) {
+		while (fgets(l, sizeof(l), f)) {
+			if (!strncmp(l, "MemTotal:", 9))
+				total = atol(l + 9);
+			else if (!strncmp(l, "MemFree:", 8))
+				freem = atol(l + 8);
+		}
+		fclose(f);
+	}
+	sprintf(t, "Memory %ld of %ld kB free", freem, total);
+	w95_text(win, gc, W95_DARK, RX0, y + 2 * (th + 1), t);
+}
+
+static void draw_all(void)
+{
+	char t[40];
+
+	nbtn = 0;
+	w95_fill(win, gc, W95_FACE, 0, 0, WIN_W, WIN_H);
+	draw_spin(0, "Brightness", B_BR_M, B_BR_P);
+	draw_pips(0, brightness, 5);
+	draw_spin(1, "Pointer", B_PD_M, B_PD_P);
+	sprintf(t, "speed %d of 8", padgain);
+	draw_value(1, t);
+	draw_spin(2, "Desktop", B_DK_M, B_DK_P);
+	choice_name(desk, t, sizeof(t));
+	t[11] = 0;
+	draw_value(2, t);
+	w95_button(win, gc, RX0, WIN_H - BTNH - 4, 70, BTNH, "Sound test", 0);
+	add_btn(RX0, WIN_H - BTNH - 4, 70, BTNH, B_SOUND);
+	draw_clock();
+	draw_info();
+}
+
+static void refresh_row(int row)
+{
+	char t[40];
+
+	if (row == 0) {
+		draw_pips(0, brightness, 5);
+	} else if (row == 1) {
+		sprintf(t, "speed %d of 8", padgain);
+		draw_value(1, t);
+	} else if (row == 2) {
+		choice_name(desk, t, sizeof(t));
+		t[11] = 0;
+		draw_value(2, t);
+	}
+}
+
+static void act(int id)
+{
+	switch (id) {
+	case B_BR_M: set_brightness(brightness - 1); refresh_row(0); break;
+	case B_BR_P: set_brightness(brightness + 1); refresh_row(0); break;
+	case B_PD_M: set_padgain(padgain - 1); refresh_row(1); break;
+	case B_PD_P: set_padgain(padgain + 1); refresh_row(1); break;
+	case B_DK_M: set_desk(desk - 1); refresh_row(2); break;
+	case B_DK_P: set_desk(desk + 1); refresh_row(2); break;
+	case B_TH: adjust_time(3600, 0); draw_clock(); break;
+	case B_TM: adjust_time(60, 0); draw_clock(); break;
+	case B_DD: adjust_time(86400, 0); draw_clock(); break;
+	case B_DMO: adjust_time(0, 1); draw_clock(); break;
+	case B_DY: adjust_time(0, 2); draw_clock(); break;
+	case B_SOUND:
+		if (vfork() == 0) {
+			execl("/boot/dsplay", "/boot/dsplay", (char *)NULL);
+			_exit(127);
+		}
+		break;
+	}
+}
+
+/* `dssettings apply`: at every desktop start, bring back what was saved (no window) */
+static int apply(void)
+{
+	char kind, path[160];
+	int n;
+
+	load_conf(&kind, path, &n);
+	applying = 1;
+	if (have_brightness)
+		set_brightness(brightness);
+	if (have_padgain)
+		set_padgain(padgain);
+	return 0;
+}
+
+int main(int argc, char **argv)
+{
+	GR_EVENT ev;
+	GR_FONT_ID font;
+	char kind, path[160];
+	int n, i, first = 1;
+	struct info in;
+
+	if (argc > 1 && !strcmp(argv[1], "apply"))
+		return apply();
+	if (GrOpen() < 0) {
+		fprintf(stderr, "dssettings: cannot connect to Nano-X\n");
+		return 1;
+	}
+	gc = GrNewGC();
+	font = GrCreateFont("Tiny", 0, NULL);
+	GrSetGCFont(gc, font);
+	w95_init(font);
+	th = w95_texth(gc);
+	scan_choices();
+	load_conf(&kind, path, &n);
+	if (proc_info(&in) == 0) {
+		if (!have_brightness && in.backlight >= 1)
+			brightness = in.backlight;
+		if (!have_padgain)
+			padgain = in.padgain;
+	}
+	if (kind == 'C' && n >= 0 && n < NCOLOURS)
+		desk = n;
+	else if (kind == 'P' && n >= 0 && n < NPATTERNS)
+		desk = NCOLOURS + n;
+	else if (kind == 'F') {
+		for (i = NCOLOURS + NPATTERNS; i < nwall; i++)
+			if (!strcmp(wall_path[i - NCOLOURS - NPATTERNS], path))
+				desk = i;
+	}
+
+	win = GrNewWindowEx(GR_WM_PROPS_APPFRAME | GR_WM_PROPS_CAPTION | GR_WM_PROPS_CLOSEBOX, "Settings",
+			    GR_ROOT_WINDOW_ID, 16, 4, WIN_W, WIN_H, W95_FACE);
+	GrSelectEvents(win, GR_EVENT_MASK_EXPOSURE | GR_EVENT_MASK_BUTTON_DOWN | GR_EVENT_MASK_KEY_DOWN | GR_EVENT_MASK_CLOSE_REQ);
+	GrMapWindow(win);
+	GrSetFocus(win);
+
+	for (;;) {
+		GrGetNextEventTimeout(&ev, 1000);
+		switch (ev.type) {
+		case GR_EVENT_TYPE_EXPOSURE:
+			draw_all();
+			break;
+		case GR_EVENT_TYPE_CLOSE_REQ:
+			GrClose();
+			return 0;
+		case GR_EVENT_TYPE_BUTTON_DOWN:
+			for (i = 0; i < nbtn; i++)
+				if (ev.button.x >= btns[i].x && ev.button.x < btns[i].x + btns[i].w && ev.button.y >= btns[i].y &&
+				    ev.button.y < btns[i].y + btns[i].h) {
+					act(btns[i].id);
+					break;
+				}
+			break;
+		case GR_EVENT_TYPE_KEY_DOWN:
+			switch (ev.keystroke.ch) {
+			case 'q':
+			case MWKEY_ESCAPE:
+				GrClose();
+				return 0;
+			case MWKEY_UP:
+				if (focus > 0) {
+					focus--;
+					draw_all();
+				}
+				break;
+			case MWKEY_DOWN:
+				if (focus < 2) {
+					focus++;
+					draw_all();
+				}
+				break;
+			case MWKEY_LEFT:
+				act(focus == 0 ? B_BR_M : (focus == 1 ? B_PD_M : B_DK_M));
+				break;
+			case MWKEY_RIGHT:
+				act(focus == 0 ? B_BR_P : (focus == 1 ? B_PD_P : B_DK_P));
+				break;
+			}
+			break;
+		case GR_EVENT_TYPE_TIMEOUT:
+			draw_clock();				/* the clock runs; the numbers are read now and then */
+			if (first || (time(NULL) % 5) == 0) {
+				draw_info();
+				first = 0;
+			}
+			break;
+		}
+	}
+	return 0;
+}
