diff --git a/linux-2.6.x/arch/arm/mach-nds/volume.c b/linux-2.6.x/arch/arm/mach-nds/volume.c
index 8c3adfbf3..f26ddef69 100644
--- a/linux-2.6.x/arch/arm/mach-nds/volume.c
+++ b/linux-2.6.x/arch/arm/mach-nds/volume.c
@@ -8,6 +8,8 @@
 #include <linux/kernel.h>
 #include <linux/init.h>
 #include <linux/proc_fs.h>
+#include <linux/string.h>
+#include <asm/uaccess.h>
 
 static int vol_level = -1;
 static int vol_status = 5;
@@ -56,8 +58,69 @@ static int mic_read_proc(char *page, char **start, off_t off, int count, int *eo
 	return len - off;
 }
 
+extern int dsisd_pm(unsigned int op, unsigned int val, unsigned int *out);
+extern int ndspad_gain;
+
+/*
+ * /proc/dsisettings: battery, volume, backlight and trackpad speed.
+ *   read:  battery=N charger=0|1 volume=N backlight=N padgain=N    (battery 0..15, volume 0..31, backlight 1..5; -1 = unknown)
+ *   write: "backlight N" (1..5, never off) or "padgain N" (1..8)
+ */
+static int settings_read_proc(char *page, char **start, off_t off, int count, int *eof, void *data)
+{
+	unsigned int o[3] = { 0xffffffff, 0xffffffff, 0xffffffff };
+	int len, bat, chg, vol, bl;
+
+	if (dsisd_pm(0, 0, o) != 0)
+		o[0] = o[1] = o[2] = 0xffffffff;
+	bat = o[0] == 0xffffffff ? -1 : (int)(o[0] & 15);
+	chg = o[0] == 0xffffffff ? 0 : (int)((o[0] >> 7) & 1);
+	vol = o[1] == 0xffffffff ? -1 : (int)(o[1] & 0x1f);
+	bl = o[2] == 0xffffffff ? -1 : (int)(o[2] & 7) + 1;
+	len = sprintf(page, "battery=%d charger=%d volume=%d backlight=%d padgain=%d\n", bat, chg, vol, bl, ndspad_gain);
+	*eof = 1;
+	if (off >= len)
+		return 0;
+	*start = page + off;
+	return len - off;
+}
+
+static int settings_write_proc(struct file *file, const char __user *buffer, unsigned long count, void *data)
+{
+	char buf[32];
+	unsigned int o[3];
+	unsigned long n;
+
+	if (count > sizeof(buf) - 1)
+		count = sizeof(buf) - 1;
+	if (copy_from_user(buf, buffer, count))
+		return -EFAULT;
+	buf[count] = 0;
+	if (!strncmp(buf, "backlight ", 10)) {
+		n = simple_strtoul(buf + 10, NULL, 10);
+		if (n < 1 || n > 5)
+			return -EINVAL;
+		dsisd_pm(1, n - 1, o);
+	} else if (!strncmp(buf, "padgain ", 8)) {
+		n = simple_strtoul(buf + 8, NULL, 10);
+		if (n < 1 || n > 8)
+			return -EINVAL;
+		ndspad_gain = n;
+	} else {
+		return -EINVAL;
+	}
+	return count;
+}
+
 static int __init nds_volume_init(void)
 {
+	struct proc_dir_entry *e;
+
+	e = create_proc_entry("dsisettings", 0644, NULL);
+	if (e) {
+		e->read_proc = settings_read_proc;
+		e->write_proc = settings_write_proc;
+	}
 	create_proc_read_entry("dsimic", 0444, NULL, mic_read_proc, NULL);
 	create_proc_read_entry("dsivolume", 0444, NULL, vol_read_proc, NULL);
 	return 0;
diff --git a/linux-2.6.x/drivers/block/dldi_c.c b/linux-2.6.x/drivers/block/dldi_c.c
index c6a0d39d2..7fb695b48 100644
--- a/linux-2.6.x/drivers/block/dldi_c.c
+++ b/linux-2.6.x/drivers/block/dldi_c.c
@@ -210,6 +210,23 @@ int dsisd_camera_cmd(unsigned int sub, unsigned int arg, unsigned int *value, un
 	return ret;
 }
 
+/* Power chip status (and the backlight): op 1 sets the backlight register to val (0..4). out[0] battery register, out[1] volume register,
+ * out[2] backlight register (0xffffffff = unreadable). 0 = ok. */
+int dsisd_pm(unsigned int op, unsigned int val, unsigned int *out)
+{
+	int ret;
+
+	down(&sd_mutex);
+	ret = sd_request_locked(NDS_SD_CMD_PM, val, op);
+	if (ret == NDS_SD_OK) {
+		out[0] = sd_block.info[0];
+		out[1] = sd_block.info[1];
+		out[2] = sd_block.info[2];
+	}
+	up(&sd_mutex);
+	return ret;
+}
+
 /* The ARM7's microphone counters (arm7/microphone.c): out[0..7] events, out[8..15] settings, out[16..17] lowest/highest sample. 0 = ok. */
 int dsisd_micdiag(unsigned int *out)
 {
