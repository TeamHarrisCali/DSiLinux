+				input_report_rel(&ndspad_dev, REL_X, dx * ndspad_gain);
+				input_report_rel(&ndspad_dev, REL_Y, dy * ndspad_gain);
 				input_sync(&ndspad_dev);
 				pad_lx = x;
 				pad_ly = y;
