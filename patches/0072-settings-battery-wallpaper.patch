 	{ "Save log", "/boot/savelog" },
 };
@@ -170,8 +172,131 @@ static void launch(const char *prog, const char *arg)
  */
 #define VOLW	130
 #define VOL_SECONDS	2
+static int bar_dirty;
+
+/*
+ * Desktop background and settings. /home/settings.conf (written by the Settings app) has a line  desktop=C:n  (plain colour n),
+ * desktop=P:n (built in pattern n) or desktop=F:/path/file.bmp (a 256x192 24 bit BMP, e.g. a photo). A wallpaper is a pixmap that
+ * belongs to this (long running) program, which is why this program, not Settings, sets it. SIGUSR1 = read the line again.
+ */
+#define CONF_FILE	"/home/settings.conf"
+static volatile int reload_desktop = 1;
+static GR_WINDOW_ID wall_pix;
+static unsigned short wallbuf[PW * PH];
+
+static const struct { const char *name; int r, g, b; } desk_colours[] = {
+	{ "Teal", 0, 128, 128 }, { "Navy", 0, 0, 128 }, { "Green", 0, 100, 60 }, { "Grey", 128, 128, 128 },
+	{ "Purple", 96, 32, 128 }, { "Black", 0, 0, 0 },
+};
+#define NCOLOURS	6
+#define NPATTERNS	3
+
+static void on_usr1(int sig)
+{
+	reload_desktop = 1;
+}
+
+static unsigned short ds555(int r, int g, int b)	/* 0..31 each; DS pixel with the opaque bit */
+{
+	return 0x8000 | r | (g << 5) | (b << 10);
+}
+
+static void make_pattern(int n)
+{
+	int x, y;
+
+	for (y = 0; y < PH; y++)
+		for (x = 0; x < PW; x++) {
+			int t = y * 31 / (PH - 1), r, g, b;
+
+			if (n == 0) {			/* sky: dark blue to light blue */
+				r = 2 + t / 2; g = 6 + t * 18 / 31; b = 14 + t * 17 / 31;
+			} else if (n == 1) {		/* dusk: purple to orange */
+				r = 8 + t * 23 / 31; g = 3 + t * 11 / 31; b = 14 - t * 8 / 31;
+			} else {			/* grid on teal */
+				r = 0; g = 14; b = 14;
+				if ((x & 15) == 0 || (y & 15) == 0) {
+					r = 4; g = 20; b = 20;
+				}
+			}
+			wallbuf[y * PW + x] = ds555(r, g, b);
+		}
+}
+
+static void apply_desktop(void)
+{
+	char line[200], kind = 'C';
+	int n = 0, ok = 0, y;
+	FILE *f = fopen(CONF_FILE, "r");
+	GR_WINDOW_ID old = wall_pix, pix;
+	char path[160];
+
+	path[0] = 0;
+	if (f) {
+		while (fgets(line, sizeof(line), f)) {
+			if (!strncmp(line, "desktop=", 8) && line[8] && line[9] == ':') {
+				char *e = line + strlen(line);
+
+				while (e > line && (e[-1] == '\n' || e[-1] == '\r'))
+					*--e = 0;
+				kind = line[8];
+				if (kind == 'F')
+					snprintf(path, sizeof(path), "%s", line + 10);
+				else
+					n = atoi(line + 10);
+			}
+		}
+		fclose(f);
+	}
+	if (kind == 'F' && path[0] && bmp_read(path, wallbuf) == 0)
+		ok = 1;
+	else if (kind == 'P' && n >= 0 && n < NPATTERNS) {
+		make_pattern(n);
+		ok = 1;
+	}
+	if (ok) {
+		pix = GrNewPixmap(PW, PH, NULL);
+		for (y = 0; y < PH; y += 16)		/* in strips: one big request is too much for the connection */
+			GrArea(pix, gc, 0, y, PW, 16, wallbuf + y * PW, MWPF_TRUECOLOR555);	/* 16 bit data is taken as the screen's own pixels */
+		GrSetBackgroundPixmap(GR_ROOT_WINDOW_ID, pix, GR_BACKGROUND_TOPLEFT);
+		wall_pix = pix;
+	} else {
+		if (n < 0 || n >= NCOLOURS || kind != 'C')
+			n = 0;
+		GrSetBackgroundPixmap(GR_ROOT_WINDOW_ID, 0, GR_BACKGROUND_TILE);
+		wall_pix = 0;
+		GrSetWindowBackgroundColor(GR_ROOT_WINDOW_ID, GR_RGB(desk_colours[n].r, desk_colours[n].g, desk_colours[n].b));
+	}
+	GrClearWindow(GR_ROOT_WINDOW_ID, GR_TRUE);
+	if (old)
+		GrDestroyWindow(old);
+	fprintf(stderr, "dsdesk: desktop %c:%d %s -> %s\n", kind, n, path, ok ? "wallpaper" : "colour");
+}
+
+/* battery from /proc/dsisettings (the ARM7 reads the power chip: a few ms, so never while a memo records) */
+static int bat_level = -1, bat_chg;
+
+static void poll_battery(void)
+{
+	FILE *f;
+	int b = -1, c = 0, v, bl, pg;
+
+	if (access("/tmp/rec.lock", F_OK) == 0)
+		return;
+	f = fopen("/proc/dsisettings", "r");
+	if (!f)
+		return;
+	if (fscanf(f, "battery=%d charger=%d volume=%d backlight=%d padgain=%d", &b, &c, &v, &bl, &pg) >= 2 &&
+	    (b != bat_level || c != bat_chg)) {
+		bat_level = b;
+		bat_chg = c;
+		bar_dirty = 1;
+	}
+	fclose(f);
+}
+
 static GR_WINDOW_ID volwin;
-static int vol_cur = -1, bar_dirty;		/* volume percent shown in the taskbar tray (-1 unknown) */
+static int vol_cur = -1;		/* volume percent shown in the taskbar tray (-1 unknown) */
 static time_t vol_since;
 static int vol_last = -2, vol_pct, vol_status;
 static char vol_msg[40];
@@ -301,6 +426,28 @@ static void draw_bar(void)
 		w95_text(bar, gc, W95_DARK, x + 11, 3 + (barh - 5 - th) / 2, vt);
 	}
 
+	/* battery: a small battery picture (filled to the level, green / yellow / red) and the percentage, left of the volume */
+	if (bat_level >= 0) {
+		char bt[8];
+		int bwid, iy, pct = bat_level * 100 / 15, fw;
+		GR_COLOR fc = pct >= 40 ? GR_RGB(0, 160, 0) : (pct >= 20 ? GR_RGB(220, 170, 0) : GR_RGB(220, 0, 0));
+
+		sprintf(bt, "%d%%", pct);
+		bwid = w95_textw(gc, bt) + 25;
+		x -= bwid + 2;
+		iy = 3 + (barh - 5 - 7) / 2;
+		w95_box(bar, gc, x, 3, bwid, barh - 5, 1, W95_FACEFILL);
+		w95_fill(bar, gc, W95_DARK, x + 4, iy, 13, 7);		/* the case */
+		w95_fill(bar, gc, W95_LIGHT, x + 5, iy + 1, 11, 5);
+		w95_fill(bar, gc, W95_DARK, x + 17, iy + 2, 1, 3);	/* the tip */
+		fw = 11 * bat_level / 15;
+		if (fw > 0)
+			w95_fill(bar, gc, fc, x + 5, iy + 1, fw, 5);
+		if (bat_chg)						/* on external power */
+			w95_fill(bar, gc, GR_RGB(255, 200, 0), x + 19, iy + 1, 1, 5);
+		w95_text(bar, gc, W95_DARK, x + 21, 3 + (barh - 5 - th) / 2, bt);
+	}
+
