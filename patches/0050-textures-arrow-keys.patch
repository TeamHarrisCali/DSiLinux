+
+/*
+ * Arrow keys: four 16x16 buttons (left, up, down, right) in the bottom right corner of the trackpad area, for programs
+ * that need arrow keys (the DS d-pad sends them too, but a touch is handy). The key is held while the touch lasts, so
+ * it repeats.
+ */
+#define ARROW_TILE0	230		/* 4 buttons x 4 tiles: 230..245 (the tile data ends at 255) */
+#define ARROW_N		4
+#define ARROW_COL0	24		/* tile column of the first button; each is 2 tiles wide */
+#define ARROW_ROW0	7		/* tile rows 7 and 8 */
+static const int arrow_key[ARROW_N] = { KEY_LEFT, KEY_UP, KEY_DOWN, KEY_RIGHT };
+
+static int in_arrows(u8 x, u8 y)
+{
+	return y >= ARROW_ROW0 * 8 && y < (ARROW_ROW0 + 2) * 8 && x >= ARROW_COL0 * 8;
+}
+
+/* arrow shape (pointing up) in a 16x16 grid: head rows 3..8, stem rows 9..12 */
+static int arrow_up_px(int r, int c)
+{
+	if (r >= 3 && r <= 8)
+		return c >= 7 - (r - 3) && c <= 8 + (r - 3);
+	if (r >= 9 && r <= 12)
+		return c >= 6 && c <= 9;
+	return 0;
+}
+
+static void draw_arrows(void)
+{
+	int b, r, c, t;
+
+	for (b = 0; b < ARROW_N; b++) {
+		u8 big[16][16];
+		u8 cell[16][8];
+		int key = arrow_key[b];
+
+		for (r = 0; r < 16; r++)
+			for (c = 0; c < 16; c++) {
+				int on, rr = r, cc = c;
+
+				switch (key) {
+				case KEY_UP:	on = arrow_up_px(rr, cc); break;
+				case KEY_DOWN:	on = arrow_up_px(15 - rr, cc); break;
+				case KEY_LEFT:	on = arrow_up_px(cc, rr); break;
+				default:	on = arrow_up_px(cc, 15 - rr); break;
+				}
+				big[r][c] = on ? 1 : 4;			/* 1 symbol, 4 face */
+				if (r == 0 || c == 0)
+					big[r][c] = 2;			/* light edge */
+				if (r == 15 || c == 15)
+					big[r][c] = 3;			/* dark edge */
+			}
+		t = ARROW_TILE0 + b * 4;
+		for (c = 0; c < 2; c++) {		/* left and right half: tiles t, t+1 and t+2, t+3 */
+			for (r = 0; r < 16; r++) {
+				int k;
+
+				for (k = 0; k < 8; k++)
+					cell[r][k] = big[r][c * 8 + k];
+			}
+			cell_to_tiles(cell, t + c * 2);
+		}
+		for (c = 0; c < 2; c++)
+			for (r = 0; r < 2; r++) {
+				int x = ARROW_COL0 + b * 2 + c, y = ARROW_ROW0 + r;
+
+				bgmap[y * 32 + x] = fgmap[y * 32 + x] = (t + c * 2 + r) | 0x2000;
+			}
+	}
+}
+
+static int arrow_active = KEY_RESERVED;		/* the arrow key held by the current touch */
+
+static void arrow_touch(int touched, u8 x, u8 y)
+{
+	int want = KEY_RESERVED;
+
+	if (touched && in_arrows(x, y)) {
+		int i = (x / 8 - ARROW_COL0) / 2;
+
+		if (i >= 0 && i < ARROW_N)
+			want = arrow_key[i];
+	}
+	if (want == arrow_active)
+		return;
+	if (arrow_active != KEY_RESERVED) {
+		input_report_key(&ndstouch_dev, arrow_active, 0);
+		input_sync(&ndstouch_dev);
+	}
+	arrow_active = want;
+	if (want != KEY_RESERVED) {
+		input_report_key(&ndstouch_dev, want, 1);
+		input_sync(&ndstouch_dev);
+	}
+}
