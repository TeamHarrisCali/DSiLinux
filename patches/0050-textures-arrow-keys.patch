+
+/* copy a picture (16 bit pixels, bit 15 set, rows of width pixels) to the texture memory at byte offset
+ * (multiple of 8). Returns 0 or -1. */
+static int gx_texture_load(unsigned int offset, const void *pixels, unsigned int bytes)
+{
+	struct gx_texload t;
+
+	gx_flush();			/* the engine must be idle of earlier texture use: queued words go first */
+	t.data = (unsigned long)pixels;
+	t.bytes = bytes;
+	t.offset = offset;
