 #define NDSFB_GX_SETUP	0x4e05
 #define NDSFB_GX_SUBMIT	0x4e06
 #define NDSFB_VSYNC	0x4e07	/* wait for the next vertical blank */
+#define NDSFB_GX_TEXLOAD	0x4e08	/* copy texture data into the 3D engine's texture memory */
 static DECLARE_WAIT_QUEUE_HEAD(ndsfb_flip_wq);
 static volatile int ndsfb_flip_pending;
 static int ndsfb_flip_y;
@@ -324,7 +325,15 @@ struct ndsfb_cursor {
  *                   engines' command registers (a command with several parameters is several pairs with the
  *                   same offset). Only offsets 0x400-0x5ff (command ports), 0x060, 0x350, 0x354 are accepted.
  * The geometry FIFO stalls the CPU when it is full, which is how a program is paced.
+ *   NDSFB_GX_TEXLOAD struct ndsfb_gx_tex: copy bytes of texture data to byte offset of the 128 KB texture memory
+ *                   (VRAM bank D, texture slot 0: texture offset n in TEXIMAGE_PARAM is n / 8). The bank is
+ *                   mapped to the CPU only for the copy; the engine reads textures while it is a texture slot.
  */
+struct ndsfb_gx_tex {
+	unsigned long data;		/* user pointer */
+	unsigned int bytes;		/* even */
+	unsigned int offset;		/* multiple of 8 */
+};
 struct ndsfb_gx_submit {
 	unsigned long words;		/* user pointer to count * 2 unsigned ints */
 	unsigned int count;
@@ -343,11 +352,44 @@ static void ndsfb_gx_setup(int on)
 		DISPLAY_CR |= (1 << 3) | (1 << 8);		/* BG0 is 3D, BG0 on */
 	} else {
 		DISPLAY_CR &= ~((1 << 3) | (1 << 8));
+		writeb(0, VRAM_D_CR);
 		ndsfb_gx_on = 0;
 		POWER_CR &= ~(POWER_MATRIX | POWER_3D_CORE);
 	}
 }
 
+#define GX_TEX_BYTES	0x20000
+#define VRAM_D_LCDC	((volatile u16 *)0x06860000)
+
+static int ndsfb_gx_texload(struct ndsfb_gx_tex __user *arg)
+{
+	struct ndsfb_gx_tex t;
+	u16 buf[128];
+	unsigned int done = 0, n, i;
+
+	if (!ndsfb_gx_on)
+		return -EINVAL;
+	if (copy_from_user(&t, arg, sizeof(t)))
+		return -EFAULT;
+	if ((t.bytes & 1) || (t.offset & 7) || t.offset > GX_TEX_BYTES || t.bytes > GX_TEX_BYTES - t.offset)
+		return -EINVAL;
+	writeb(VRAM_ENABLE | 0, VRAM_D_CR);		/* bank D at the CPU (0x06860000) */
+	while (done < t.bytes) {
+		n = t.bytes - done;
+		if (n > sizeof(buf))
+			n = sizeof(buf);
+		if (copy_from_user(buf, (void __user *)(t.data + done), n)) {
+			writeb(VRAM_ENABLE | 3, VRAM_D_CR);
+			return -EFAULT;
+		}
+		for (i = 0; i < n / 2; i++)
+			VRAM_D_LCDC[(t.offset + done) / 2 + i] = buf[i];
+		done += n;
+	}
+	writeb(VRAM_ENABLE | 3 | VRAM_OFFSET(0), VRAM_D_CR);	/* texture slot 0 */
+	return 0;
+}
+
 static int gx_reg_ok(unsigned int off)
 {
 	return (off >= 0x400 && off < 0x600) || off == 0x060 || off == 0x350 || off == 0x354;
@@ -731,6 +773,10 @@ static int ndsfb_ioctl(struct inode *inode, struct file *file,
 				return -EINVAL;
 			ndsfb_gx_setup(arg != 0);
 			return 0;
+		case NDSFB_GX_TEXLOAD:
+			if (info->par != 0)
+				return -EINVAL;
+			return ndsfb_gx_texload((struct ndsfb_gx_tex __user *)argp);
 		case NDSFB_GX_SUBMIT:
 			if (info->par != 0)
 				return -EINVAL;
