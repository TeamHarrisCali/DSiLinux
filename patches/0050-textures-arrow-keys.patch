 # 3D speed test on the text screen: TinySDGL's "gears" (a software OpenGL, no 3D hardware used).
 # The desktop owns the screen: stop it first (Start menu > Exit desktop, or /boot/desktop stop).
 # It prints frames per second every few seconds. Esc or q ends it, the arrow keys turn the gears.
-# /boot/gl hw: the same gears on the DS hardware 3D engine; /boot/gl tri: one coloured triangle (smallest test).
+# /boot/gl hw: the same gears on the DS hardware 3D engine; /boot/gl tri: one coloured triangle (smallest test);
+# /boot/gl cube: a lit brick-textured cube (the 3D engine's texture memory).
 # /boot/gl profile: a 15 second profiling run (dsgears) that prints a table of where the time of a frame goes.
 if [ -n "`pidof nano-X`" ]; then
 	echo "gl: stop the desktop first (Start menu > Exit desktop)"
 	exit 1
 fi
-if [ "$1" = "hw" ] || [ "$1" = "tri" ]; then
+if [ "$1" = "hw" ] || [ "$1" = "tri" ] || [ "$1" = "cube" ]; then
 	echo "dsgx: the DS's hardware 3D engine. Esc or q to quit"
-	if [ "$1" = "tri" ]; then /boot/dsgx tri; else /boot/dsgx; fi
+	if [ "$1" = "tri" ] || [ "$1" = "cube" ]; then /boot/dsgx $1; else /boot/dsgx; fi
 elif [ "$1" = "profile" ]; then
 	echo "dsgears: 5 tests of 3 s, then a table of where a frame's time goes"
 	/boot/dsgears
