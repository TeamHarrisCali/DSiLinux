+				arrow_touch(touched, x, y);
+				break;
+			}
 			if (btn_active || (touched && !wasTouched && !pad_active && in_strip(x, y))) {
 				strip_touch(touched, x);
 				break;
@@ -689,6 +793,8 @@ static int __init touchscreen_init(void)
 			ndstouch_dev.keybit[LONG(qwertyKeyMap[i])] |= BIT(qwertyKeyMap[i]);
 	}
 
+	for (i = 0; i < ARROW_N; i++)
+		ndstouch_dev.keybit[LONG(arrow_key[i])] |= BIT(arrow_key[i]);
