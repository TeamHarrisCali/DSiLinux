+++ b/user/microwin/src/drivers/kbd_tty.c
@@ -126,6 +126,41 @@ TTY_Read(MWKEY *kbuf, MWKEYMOD *modifiers, MWSCANCODE *scancode)
 	cc = read(fd, buf, 1);
 	if (cc > 0) {
 		mwkey = buf[0];
+#if NDSDRIVER
+		/* the console sends arrow, home/end and page keys as ESC [ A and so on, all bytes together: turn them
+		 * into the Nano-X keys. A lone ESC (nothing follows at once) stays ESC. */
+		if (mwkey == 27) {
+			unsigned char s1, s2;
+
+			if (read(fd, &s1, 1) == 1 && (s1 == '[' || s1 == 'O') && read(fd, &s2, 1) == 1) {
+				MWKEY k = 0;
+
+				switch (s2) {
+				case 'A': k = MWKEY_UP; break;
+				case 'B': k = MWKEY_DOWN; break;
+				case 'C': k = MWKEY_RIGHT; break;
+				case 'D': k = MWKEY_LEFT; break;
+				case 'H': k = MWKEY_HOME; break;
+				case 'F': k = MWKEY_END; break;
+				case '1': case '2': case '3': case '4': case '5': case '6': {
+					unsigned char s3;
+
+					if (read(fd, &s3, 1) == 1 && s3 == '~')
+						k = s2 == '1' ? MWKEY_HOME : s2 == '2' ? MWKEY_INSERT :
+						    s2 == '3' ? MWKEY_DELETE : s2 == '4' ? MWKEY_END :
+						    s2 == '5' ? MWKEY_PAGEUP : MWKEY_PAGEDOWN;
+					break;
+				}
+				}
+				if (k) {
+					*kbuf = k;
+					*modifiers = 0;
+					*scancode = 0;
+					return 1;
+				}
+			}
+		}
+#endif
 		if (mwkey == 27 && escape_quits)	/* ESC -> quit*/
 			mwkey = MWKEY_QUIT;
 		else if (mwkey == ('P'&0x1f))		/* ^P -> print*/
diff --git a/vendors/Nintendo/DSI/gl b/vendors/Nintendo/DSI/gl
index 76680146d..0dc2de30a 100644
--- a/vendors/Nintendo/DSI/gl
