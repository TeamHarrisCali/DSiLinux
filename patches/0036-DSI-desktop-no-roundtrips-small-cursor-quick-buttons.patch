-/* the programs call this once after creating their font */
+/* the programs call this once after creating their font. Anything that needs an answer from the server costs
+ * about 40 ms on the DS, so the sizes are read here once and drawing never asks. */
 static void w95_init(GR_FONT_ID font)
 {
+	GR_FONT_INFO fi;
+
 	w95_font = font;
+	GrGetFontInfo(font, &fi);
+	w95_fw = fi.maxwidth;
+	w95_fh = fi.height;
+	/* make the usual colours now (each GrNewGC waits for an answer) */
+	w95_gc(W95_FACE);
+	w95_gc(W95_LIGHT);
+	w95_gc(W95_SHADOW);
+	w95_gc(W95_DARK);
+	w95_gc(W95_NAVY);
 }
 
 /* the g parameters below are kept for the callers; drawing uses the per-colour contexts */
@@ -117,20 +130,19 @@ static void w95_text(GR_WINDOW_ID w, GR_GC_ID g, GR_COLOR c, int x, int y, const
 	GrText(w, w95_gc(c), x, y, (void *)s, -1, GR_TFASCII | GR_TFTOP);
 }
 
+/* fixed width font: no request to the server */
 static int w95_textw(GR_GC_ID g, const char *s)
 {
-	GR_SIZE wd, h, base;
+	int n = 0;
 
-	GrGetGCTextSize(g, (void *)s, -1, GR_TFASCII | GR_TFTOP, &wd, &h, &base);
-	return wd;
+	while (s[n])
+		n++;
+	return n * w95_fw;
 }
 
 static int w95_texth(GR_GC_ID g)
 {
-	GR_SIZE wd, h, base;
-
-	GrGetGCTextSize(g, (void *)"Mg", -1, GR_TFASCII | GR_TFTOP, &wd, &h, &base);
-	return h;
+	return w95_fh;
 }
 
