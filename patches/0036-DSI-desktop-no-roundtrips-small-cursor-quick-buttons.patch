+/*
+ * Quick buttons: a strip of four buttons at the top of the touch screen, above the trackpad. A tap types the
+ * command for you (as keys, so it works in the text console and in a terminal window) and presses Enter.
+ * The labels are drawn into free tiles after the keyboard's, from the console's mini 4x6 font at double size.
+ */
+#define STRIP_TILE0	189		/* the keyboard uses tiles 0..188 */
+#define STRIP_N		4
+#define STRIP_ROWS	2		/* tile rows 0 and 1 */
+
+static const char *strip_label[STRIP_N] = { "Desk", "Test", "Log", "Bench" };
+static const char *strip_cmd[STRIP_N] = { "/boot/desktop", "/boot/selftest", "/boot/savelog", "/boot/dsbench" };
+static int strip_x0[STRIP_N], strip_x1[STRIP_N];
+
+static void tile_px(u8 *tile, int row, int px, int val)
+{
+	u8 *b = tile + row * 4 + px / 2;
+
+	if (px & 1)
+		*b = (*b & 0x0f) | (val << 4);
+	else
+		*b = (*b & 0xf0) | val;
+}
+
+/* an 8x16 pixel cell (colour indexes 0 face, 1 text, 2 light, 3 dark) written as two tiles: top half, bottom half */
+static void cell_to_tiles(u8 cell[16][8], int tile)
+{
+	u8 *t = (u8 *)BG_GFX_SUB + tile * 32;
+	int r, c;
+
+	for (r = 0; r < 16; r++)
+		for (c = 0; c < 8; c++)
+			tile_px(t + (r / 8) * 32, r % 8, c, cell[r][c]);
+}
+
+static void cell_frame(u8 cell[16][8], int capl, int capr)
+{
+	int r, c;
+
+	for (r = 0; r < 16; r++)
+		for (c = 0; c < 8; c++)
+			cell[r][c] = 0;
+	for (c = 0; c < 8; c++) {
+		cell[0][c] = 2;
+		cell[15][c] = 3;
+	}
+	if (capl)
+		for (r = 0; r < 15; r++)
+			cell[r][0] = 2;
+	if (capr)
+		for (r = 1; r < 16; r++)
+			cell[r][7] = 3;
+}
+
+static void draw_strip(void)
+{
+	const struct font_desc *fd = find_font("MINI4x6");
+	u8 cell[16][8];
+	int tile = STRIP_TILE0, capl, capr, col = 0, i, k;
+
+	if (!fd || fd->width > 8 || fd->height > 6)
+		return;
+
+	PALETTE_SUB[32 + 0] = 0x6318;	/* face: light grey */
+	PALETTE_SUB[32 + 1] = 0x0000;	/* text */
+	PALETTE_SUB[32 + 2] = 0x7fff;	/* light edge */
+	PALETTE_SUB[32 + 3] = 0x39ce;	/* dark edge */
+
+	capl = tile;
+	cell_frame(cell, 1, 0);
+	cell_to_tiles(cell, tile);
+	tile += 2;
+	capr = tile;
+	cell_frame(cell, 0, 1);
+	cell_to_tiles(cell, tile);
+	tile += 2;
+
+	for (i = 0; i < STRIP_N; i++) {
+		const char *l = strip_label[i];
+		int n = strlen(l);
+		int x;
+
+		strip_x0[i] = col * 8;
+		bgmap[0 * 32 + col] = fgmap[0 * 32 + col] = (capl) | 0x2000;
+		bgmap[1 * 32 + col] = fgmap[1 * 32 + col] = (capl + 1) | 0x2000;
+		for (k = 0; k < n; k++) {
+			unsigned char ch = (unsigned char)l[k];
+			int gx, gy;
+
+			cell_frame(cell, 0, 0);
+			for (gy = 0; gy < fd->height; gy++) {
+				unsigned char rowbits = ((const unsigned char *)fd->data)[ch * fd->height + gy];
+
+				for (gx = 0; gx < fd->width; gx++)
+					if (rowbits & (0x80 >> gx)) {
+						int cy = 2 + gy * 2, cx = gx * 2;
+
+						cell[cy][cx] = cell[cy][cx + 1] = 1;
+						cell[cy + 1][cx] = cell[cy + 1][cx + 1] = 1;
+					}
+			}
+			cell_to_tiles(cell, tile);
+			x = col + 1 + k;
+			bgmap[0 * 32 + x] = fgmap[0 * 32 + x] = tile | 0x2000;
+			bgmap[1 * 32 + x] = fgmap[1 * 32 + x] = (tile + 1) | 0x2000;
+			tile += 2;
+		}
+		x = col + 1 + n;
+		bgmap[0 * 32 + x] = fgmap[0 * 32 + x] = (capr) | 0x2000;
+		bgmap[1 * 32 + x] = fgmap[1 * 32 + x] = (capr + 1) | 0x2000;
+		strip_x1[i] = (x + 1) * 8;
+		col = x + 2;	/* one tile gap */
+	}
+}
+
+/* key code for the few characters the commands use; 0 if none */
+static int char_to_key(char c)
+{
+	static const unsigned char letters[26] = {
+		KEY_A, KEY_B, KEY_C, KEY_D, KEY_E, KEY_F, KEY_G, KEY_H, KEY_I, KEY_J, KEY_K, KEY_L, KEY_M,
+		KEY_N, KEY_O, KEY_P, KEY_Q, KEY_R, KEY_S, KEY_T, KEY_U, KEY_V, KEY_W, KEY_X, KEY_Y, KEY_Z
+	};
+
+	if (c >= 'a' && c <= 'z')
+		return letters[c - 'a'];
+	if (c == '/')
+		return KEY_SLASH;
+	if (c == '.')
+		return KEY_DOT;
+	if (c == '-')
+		return KEY_MINUS;
+	if (c == ' ')
+		return KEY_SPACE;
+	return 0;
+}
+
+static void press_key(int key)
+{
+	input_report_key(&ndstouch_dev, key, 1);
+	input_sync(&ndstouch_dev);
+	input_report_key(&ndstouch_dev, key, 0);
+	input_sync(&ndstouch_dev);
+}
+
+static void type_command(const char *s)
+{
+	for (; *s; s++) {
+		int k = char_to_key(*s);
+
+		if (k)
+			press_key(k);
+	}
+	press_key(KEY_ENTER);
+}
+
+static int btn_active;
+
+static int in_strip(u8 x, u8 y)
+{
+	return y < STRIP_ROWS * 8 && x < 240;
+}
+
+static void strip_touch(int touched, u8 x)
+{
+	int i;
+
+	if (touched && !btn_active) {
+		btn_active = 1;
+		for (i = 0; i < STRIP_N; i++)
+			if (x >= strip_x0[i] && x < strip_x1[i]) {
+				type_command(strip_cmd[i]);
+				break;
+			}
+	} else if (!touched) {
+		btn_active = 0;
+	}
+}
+
 /* blue-grey panel over the trackpad area: map entries use palette bank 1 whose entry 6 (the solid tile's colour) differs */
 static void draw_pad(void)
 {
@@ -274,6 +457,7 @@ static void draw_pad(void)
 			fgmap[y * 32 + x] = 0x1000;
 		}
 	}
+	draw_strip();
 }
 
 static void update_keyboard(u16 pressedKey)
@@ -410,6 +594,10 @@ static void ndstouch_input_event(u8 touched, u8 x, u8 y)
 	switch(mode) {
 		case KEYBOARD_MODE:
 			/* a touch that starts on the trackpad only moves the pointer, one that starts on the keyboard only types */
+			if (btn_active || (touched && !wasTouched && !pad_active && in_strip(x, y))) {
+				strip_touch(touched, x);
+				break;
+			}
 			if (pad_active || (touched && !wasTouched && in_pad(x, y))) {
 				pad_touch(touched, x, y);
 				break;
