-#define NTESTS 8
+/* ping-pong over a socket pair with another process, no Nano-X: the raw cost of switching between two programs */
+static long ipc_pingpong(void)
+{
+	int sv[2], i;
+	char c = 'x';
+	pid_t pid;
+	long t;
+
+	if (socketpair(AF_UNIX, SOCK_STREAM, 0, sv) < 0)
+		return -1;
+	pid = vfork();
+	if (pid == 0) {
+		dup2(sv[1], 3);
+		close(sv[0]);
+		execl("/boot/dsbench", "dsbench", "echo", (char *)NULL);
+		_exit(127);
+	}
+	if (pid < 0)
+		return -2;
+	close(sv[1]);
+	t = now_ms();
+	for (i = 0; i < 100; i++) {
+		if (write(sv[0], &c, 1) != 1 || read(sv[0], &c, 1) != 1)
+			break;
+	}
+	t = now_ms() - t;
+	close(sv[0]);
+	return i == 100 ? t : -3;
+}
+
+#define NTESTS 9
 static const char *names[NTESTS] = {
 	"20 fills of 10000 px",
 	"200 set-colour requests",
@@ -60,9 +94,10 @@ static const char *names[NTESTS] = {
