@@ -129,13 +171,17 @@ int main(void)
 			for (i = 0; i < 100; i++)
 				w95_box(w, gc, 10, 10, 60, 20, i & 1, W95_FACEFILL);
 			break;
+		case 8:
+			break;
 		}
 		sync_server();
