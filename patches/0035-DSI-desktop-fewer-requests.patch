 /*
- * w95.h - a Windows 95 look for the DSLinuxDSi desktop programs (dsdesk, dsnotes, dsfiles).
+ * w95.h - a Windows 95 look for the DSLinuxDSi desktop programs (dsdesk, dsnotes, dsfiles, dsbench).
  * 3D bevels in the classic grey, navy highlights, teal desktop.
+ *
+ * Speed matters more than elegance here: on the DS every Nano-X request costs about a millisecond, whatever
+ * it draws. So there is one graphics context per colour (no set-colour requests between drawing calls) and a
+ * bevelled box is four stacked rectangle fills instead of eight lines.
  */
 #ifndef W95_H
 #define W95_H
@@ -14,51 +18,103 @@
 #define W95_NAVY	GR_RGB(0, 0, 128)
 #define W95_TEAL	GR_RGB(0, 128, 128)
 
+/* w95_box interior */
+#define W95_KEEP	0	/* leave the inside alone (draws eight lines, slow) */
+#define W95_FACEFILL	1	/* grey inside */
+#define W95_WHITEFILL	2	/* white inside (text fields) */
+
+static GR_FONT_ID w95_font;
+
+#define W95_MAXGC	10
+static GR_COLOR w95_gc_color[W95_MAXGC];
+static GR_GC_ID w95_gc_id[W95_MAXGC];
+static int w95_gc_n;
+
+/* the graphics context that draws in colour c (made once, with the interface font) */
+static GR_GC_ID w95_gc(GR_COLOR c)
+{
+	int i;
+
+	for (i = 0; i < w95_gc_n; i++)
+		if (w95_gc_color[i] == c)
+			return w95_gc_id[i];
+	if (w95_gc_n >= W95_MAXGC)
+		i = W95_MAXGC - 1;	/* out of slots: reuse the last one, recolour it */
+	else
+		i = w95_gc_n++;
+	if (!w95_gc_id[i])
+		w95_gc_id[i] = GrNewGC();
+	w95_gc_color[i] = c;
+	GrSetGCForeground(w95_gc_id[i], c);
+	GrSetGCUseBackground(w95_gc_id[i], GR_FALSE);
+	if (w95_font)
+		GrSetGCFont(w95_gc_id[i], w95_font);
+	return w95_gc_id[i];
+}
+
+/* the programs call this once after creating their font */
+static void w95_init(GR_FONT_ID font)
+{
+	w95_font = font;
+}
+
+/* the g parameters below are kept for the callers; drawing uses the per-colour contexts */
 static void w95_fill(GR_WINDOW_ID w, GR_GC_ID g, GR_COLOR c, int x, int y, int wd, int h)
 {
-	GrSetGCForeground(g, c);
-	GrFillRect(w, g, x, y, wd, h);
+	GrFillRect(w, w95_gc(c), x, y, wd, h);
 }
 
 static void w95_hline(GR_WINDOW_ID w, GR_GC_ID g, GR_COLOR c, int x1, int x2, int y)
 {
-	GrSetGCForeground(g, c);
-	GrLine(w, g, x1, y, x2, y);
+	GrLine(w, w95_gc(c), x1, y, x2, y);
 }
 
 static void w95_vline(GR_WINDOW_ID w, GR_GC_ID g, GR_COLOR c, int x, int y1, int y2)
 {
-	GrSetGCForeground(g, c);
-	GrLine(w, g, x, y1, x, y2);
+	GrLine(w, w95_gc(c), x, y1, x, y2);
 }
 
-/* a raised (sunken = 0) or sunken (sunken = 1) box with a two pixel bevel, filled with the grey face */
-static void w95_box(GR_WINDOW_ID w, GR_GC_ID g, int x, int y, int wd, int h, int sunken, int fill)
