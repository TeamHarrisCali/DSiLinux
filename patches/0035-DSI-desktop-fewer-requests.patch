+/* the old way: eight lines, each preceded by a set-colour request */
+static void slow_box(int x, int y, int wd, int h, int sunken)
+{
+	GR_COLOR tl = sunken ? W95_SHADOW : W95_LIGHT, br = sunken ? W95_LIGHT : W95_DARK;
+	int r = x + wd - 1, b = y + h - 1;
+
+	GrSetGCForeground(gc, W95_FACE);
+	GrFillRect(w, gc, x, y, wd, h);
+	GrSetGCForeground(gc, tl);
+	GrLine(w, gc, x, y, r - 1, y);
+	GrLine(w, gc, x, y, x, b - 1);
+	GrSetGCForeground(gc, br);
+	GrLine(w, gc, x, b, r, b);
+	GrLine(w, gc, r, y, r, b);
+	GrSetGCForeground(gc, tl);
+	GrLine(w, gc, x + 1, y + 1, r - 2, y + 1);
+	GrLine(w, gc, x + 1, y + 1, x + 1, b - 2);
+	GrSetGCForeground(gc, br);
+	GrLine(w, gc, x + 1, b - 1, r - 1, b - 1);
+	GrLine(w, gc, r - 1, y + 1, r - 1, b - 1);
+}
