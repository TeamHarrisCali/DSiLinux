+/*
+ * /proc/dsiwifi2nets, for the Wi-Fi window: a state line, then one line per network heard in the last scan in /proc/dswifi's format
+ * ("bssid channel open|wep|wpa|wpa2 signal rates name", signal = SNR, rates "g")
+ */
+static int nets_read_proc(char *page, char **start, off_t off, int count, int *eof, void *data)
+{
+	int len, i;
+
+	len = sprintf(page, "state %s connected %d wpa2 %d keys %d scanning %d\n", session ? "up" : "down", connected, wpa2, keys_ok,
+		      scanning);
+	for (i = 0; session && !scanning && i < nnets && len < (int)PAGE_SIZE - 80; i++)
+		len += sprintf(page + len, "%02x:%02x:%02x:%02x:%02x:%02x %d %s %d g %s\n", nets[i].bssid[0], nets[i].bssid[1],
+			       nets[i].bssid[2], nets[i].bssid[3], nets[i].bssid[4], nets[i].bssid[5], nets[i].channel, nets[i].sec,
+			       nets[i].snr, nets[i].ssid);
+	*eof = 1;
+	if (off >= len)
+		return 0;
+	*start = page + off;
+	return len - off;
+}
