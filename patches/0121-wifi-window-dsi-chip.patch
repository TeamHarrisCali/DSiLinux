+	if (!strncmp(cmd, "scan", 4)) {			/* scan again (wlan0 up, not connected) */
+		if (!session)
+			return -ENOTCONN;
+		scanning = 1;				/* already "scanning" for whoever reads the list next */
+		scan_pending = 1;
+		wake_up(&thr_wait);
+		return count;
+	}
 	if (!strncmp(cmd, "connect", 7) || !strncmp(cmd, "disconnect", 10)) {
 		if (!session)
 			return -ENOTCONN;		/* ifconfig wlan0 up first */
@@ -1361,6 +1404,9 @@ static int __init dsiwifi_init(void)
 		e->read_proc = twl_read_proc;
 		e->write_proc = twl_write_proc;
