+/* the DSi chip: password (WPA2), connect, wait for the connection (the chip retries twice, 15 s apart), DHCP */
+static void connect_dsi(struct net *n, const char *pass)
+{
+	char cmd[120], ip[24];
+	struct dsist st;
+	int s, tries;
+	FILE *f;
+
+	wifi_on();
+	if (!wifi_up()) {
+		draw_all();
+		return;
+	}
+	snprintf(cmd, sizeof(cmd), "Connecting to %s...", n->ssid);
+	say(cmd);
+	dlog(cmd);
+	run("killall udhcpc 2>/dev/null");
+	if (n->wpa2) {
+		snprintf(cmd, sizeof(cmd), "psk %s\n", pass ? pass : "");
+		s = dsi_cmd(cmd);
+		memset(cmd, 0, sizeof(cmd));
+		if (s) {
+			snprintf(status, sizeof(status), "The password must have 8 to 63 characters");
+			draw_all();
+			return;
+		}
+	}
+	snprintf(cmd, sizeof(cmd), "connect %s\n", n->ssid);
+	if (dsi_cmd(cmd)) {
+		snprintf(status, sizeof(status), "The DSi Wi-Fi refused the connect");
+		draw_all();
+		return;
+	}
+	for (s = 0; s <= 100; s += 2) {
+		dsi_state(&st);
+		if (st.connected && (!st.wpa2 || st.keys))
+			break;
+		snprintf(cmd, sizeof(cmd), "Joining %s: %d s%s", n->ssid, s, st.connected ? ", checking the password" : "");
+		say(cmd);
+		sleep(2);
+	}
+	if (!st.connected || (st.wpa2 && !st.keys)) {
+		if (st.connected)
+			snprintf(status, sizeof(status), "%s: password not accepted%s", n->ssid, n->saved ? " (Forget it?)" : "");
+		else
+			snprintf(status, sizeof(status), "No answer from %s", n->ssid);
+		dlog(status);
+		dsi_cmd("disconnect\n");
+		draw_all();
+		return;
+	}
+	dlog("joined");
+	for (tries = 0; tries < 2; tries++) {
+		say(tries ? "No answer: DHCP again..." : "Asking for an address (DHCP)...");
+		run("udhcpc -n -q -i wlan0 >> /tmp/dsnet-dhcp.log 2>&1");
+		wifi_ip(ip);
+		if (ip[0])
+			break;
+	}
+	dlog(ip[0] ? ip : "no address (DHCP): /tmp/dsnet-dhcp.log");
+	if (ip[0]) {
+		snprintf(cur_ssid, sizeof(cur_ssid), "%s", n->ssid);
+		save_known(n->ssid, n->wpa2 && pass ? pass : "", 0);
+		if ((f = fopen("/tmp/wifi.current", "w"))) {	/* the tray's tooltip */
+			fprintf(f, "%s\n", n->ssid);
+			fclose(f);
+		}
+		load_known();
+		status[0] = 0;
+	} else {
+		snprintf(status, sizeof(status), "No address from %s", n->ssid);
+	}
+	draw_all();
+}
+
+/* the other chip (both share the antenna: the one in use goes down first) */
+static void switch_chip(void)
+{
+	if (!dsi_ok)
+		return;
+	if (wifi_up())
+		run(use_dsi ? "killall udhcpc 2>/dev/null; ifconfig wlan0 down" : "killall udhcpc 2>/dev/null; ifconfig nds down");
+	if (dryrun)
+		sim_up = sim_conn = sim_joined = 0;
+	use_dsi = !use_dsi;
+	nnet = 0;
+	cur_ssid[0] = 0;
+	unlink("/tmp/wifi.current");
+	snprintf(status, sizeof(status), use_dsi ? "DSi chip: open and WPA2 networks" : "DS chip: open and WEP networks");
+	draw_all();
+}
