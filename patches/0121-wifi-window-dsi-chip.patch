+
+/* the DSi chip: a command to /proc/dsiwifi2 (written directly: a password never passes through a shell); 0 = accepted */
+static int dsi_cmd(const char *c)
+{
+	FILE *f;
+	int bad;
+
+	if (dryrun) {
+		fprintf(stderr, "dsnet would write: %s", strncmp(c, "psk ", 4) ? c : "psk (the password)\n");
+		if (!strncmp(c, "connect", 7))
+			sim_joined = 1;
+		return 0;
+	}
+	f = fopen("/proc/dsiwifi2", "w");
+	if (!f)
+		return -1;
+	bad = fputs(c, f) < 0;
+	bad |= fclose(f) != 0;
+	return bad ? -1 : 0;
+}
+
+/* the DSi chip's state, the first line of /proc/dsiwifi2nets */
+struct dsist {
+	int up, connected, wpa2, keys, scanning;
+};
+
+static void dsi_state(struct dsist *st)
+{
+	FILE *f;
+	char up[8] = "";
+
+	memset(st, 0, sizeof(*st));
+	if (dryrun) {
+		st->up = sim_up;
+		st->connected = st->keys = sim_joined;
+		return;
+	}
+	if (!(f = fopen("/proc/dsiwifi2nets", "r")))
+		return;
+	if (fscanf(f, "state %7s connected %d wpa2 %d keys %d scanning %d", up, &st->connected, &st->wpa2, &st->keys, &st->scanning) >= 1)
+		st->up = !strcmp(up, "up");
+	fclose(f);
+}
+
+/* the firmware file is in the kernel's buffer (it stays there after ifconfig wlan0 down) */
+static int dsi_fw_loaded(void)
+{
+	FILE *f = fopen("/proc/dsiwifi2fw", "r");
+	unsigned n = 0;
+
+	if (f) {
+		if (fscanf(f, "%u", &n) != 1)
+			n = 0;
+		fclose(f);
+	}
+	return n > 50000;
+}
