 			draw_row(y);
+	if (bar_count != sb_count || bar_view != view || bar_rows != rows)
+		draw_bar();
 	GrFlush();
 }
 
@@ -154,6 +193,7 @@ static void touch_all(void)
 {
 	memset(dirty, 1, sizeof(dirty));
 	scrolled = 0;
+	bar_count = -1;
 }
 
 /* ---------------------------------------------------------------- screen model */
@@ -539,6 +579,67 @@ static void scroll_view(int d)
 	flush_screen();
 }
 
+/* a tap on the scroll bar */
+static void bar_tap(int y)
+{
+	int ty, th;
+
+	bar_geometry(&ty, &th);
+	if (y < fh)
+		scroll_view(3);
+	else if (y >= rows * fh - fh)
+		scroll_view(-3);
+	else if (y < ty)
+		scroll_view(rows - 1);
+	else if (y >= ty + th)
+		scroll_view(-(rows - 1));
+}
+
+/* the window got w x h pixels: as many columns and rows as fit, the cursor's line kept on the screen */
+static void resize_term(int w, int h)
+{
+	struct winsize ws;
+	int nc = (w - SBW) / fw, nr = h / fh, y;
+
+	if (nc < 10) nc = 10;
+	if (nc > MAXC) nc = MAXC;
+	if (nr < 3) nr = 3;
+	if (nr > MAXR) nr = MAXR;
+	if (nc == cols && nr == rows) {
+		touch_all();
+		flush_screen();
+		return;
+	}
+	top = 0;
+	bot = rows - 1;
+	while (cy >= nr) {			/* fewer rows: the top lines go to the scrollback */
+		scroll_up();
+		cy--;
+	}
+	for (y = 0; y < MAXR; y++)		/* new cells are blank */
+		if (y >= rows)
+			clear_cells(y, 0, MAXC);
+		else if (nc > cols)
+			clear_cells(y, cols, nc);
+	cols = nc;
+	rows = nr;
+	top = 0;
+	bot = rows - 1;
+	if (cx >= cols)
+		cx = cols - 1;
+	wrapnext = 0;
+	view = 0;
+	if (ptyfd >= 0) {
+		memset(&ws, 0, sizeof(ws));
+		ws.ws_col = cols;
+		ws.ws_row = rows;
+		ioctl(ptyfd, TIOCSWINSZ, &ws);	/* the programs in it get SIGWINCH */
+	}
+	GrClearWindow(win, GR_FALSE);
+	touch_all();
+	flush_screen();
+}
+
