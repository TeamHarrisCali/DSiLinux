+/* the top of the taskbar (dsdesk's window titled "taskbar"), or the screen's height */
+static GR_COORD usable_height(void)
+{
+	GR_SCREEN_INFO si;
+	GR_WINDOW_ID parent, *children = NULL;
+	GR_COUNT n = 0, i;
+	GR_COORD h;
+
+	GrGetScreenInfo(&si);
+	h = si.rows;
+	GrQueryTree(GR_ROOT_WINDOW_ID, &parent, &children, &n);
+	for (i = 0; i < n; i++) {
+		GR_WM_PROPERTIES p;
+		GR_WINDOW_INFO wi;
+
+		GrGetWMProperties(children[i], &p);
+		if (p.title && !strcmp((char *)p.title, "taskbar")) {
+			GrGetWindowInfo(children[i], &wi);
+			if (wi.mapped && wi.y > 0 && wi.y < h)
+				h = wi.y;
+		}
+		if (p.title)
+			free(p.title);
+	}
+	if (children)
+		free(children);
+	return h;
+}
+
+/* container and client to w x h (the container's size; the frame keeps its thickness) */
+static void resize_frame(win *window, GR_SIZE w, GR_SIZE h)
+{
+	GR_WINDOW_INFO ci, cl;
+
+	GrGetWindowInfo(window->wid, &ci);
+	GrGetWindowInfo(window->clientid, &cl);
+	if (w < MIN_W) w = MIN_W;
+	if (h < MIN_H) h = MIN_H;
+	GrResizeWindow(window->wid, w, h);
+	GrResizeWindow(window->clientid, w - (ci.width - cl.width), h - (ci.height - cl.height));
+}
+
+/* the maximise box: the whole screen above the taskbar, or back to where and how big it was */
+static void toggle_maximise(win *window)
+{
+	GR_WINDOW_INFO info;
+	GR_SCREEN_INFO si;
+
+	GrGetWindowInfo(window->wid, &info);
+	if (!window->maxed) {
+		window->rx = info.x;
+		window->ry = info.y;
+		window->rw = info.width;
+		window->rh = info.height;
+		GrGetScreenInfo(&si);
+		GrMoveWindow(window->wid, 0, 0);
+		resize_frame(window, si.cols, usable_height());
+		window->maxed = 1;
+	} else {
+		window->maxed = 0;
+		resize_frame(window, window->rw, window->rh);
+		GrMoveWindow(window->wid, window->rx, window->ry);
+	}
+	GrRaiseWindow(window->wid);
+	redraw_ncarea(window);
+}
 
