+/* the scroll bar: an arrow box at each end, the thumb shows which part of scrollback + screen is in view */
+static void bar_geometry(int *ty, int *th)
+{
+	int track = rows * fh - 2 * fh, total = sb_count + rows;
+
+	*th = track * rows / total;
+	if (*th < 4)
+		*th = 4;
+	*ty = fh + (track - *th) * (sb_count - view) / (sb_count ? sb_count : 1);
+}
+
+static void draw_bar(void)
+{
+	int x = cols * fw, h = rows * fh, ty, th, i;
+
+	bar_count = sb_count;
+	bar_view = view;
+	bar_rows = rows;
+	GrSetGCForeground(gc, pal[8]);
+	GrFillRect(win, gc, x, 0, SBW, h);
+	GrSetGCForeground(gc, pal[7]);
+	GrFillRect(win, gc, x, 0, SBW, fh - 1);
+	GrFillRect(win, gc, x, h - fh + 1, SBW, fh - 1);
+	bar_geometry(&ty, &th);
+	GrFillRect(win, gc, x + 1, ty, SBW - 2, th);
+	GrSetGCForeground(gc, pal[0]);
+	for (i = 0; i < 3; i++) {				/* the arrows: small triangles */
+		GrLine(win, gc, x + 3 - i, 3 + i, x + 3 + i, 3 + i);
+		GrLine(win, gc, x + 3 - i, h - 4 - i, x + 3 + i, h - 4 - i);
+	}
+	cur_fgc = 0xffffffff;			/* the text's colours must be set again */
+}
