From 1d79fa54ef882094c6b370c75fec9239f83c39d7 Mon Sep 17 00:00:00 2001
From: TeamHarrisCali <34009957+TeamHarrisCali@users.noreply.github.com>
Date: Wed, 11 Nov 2026 14:24:00 -0600
Subject: [PATCH] Mic: keep the DSi I2S clock on when playback ends (the ADC
 shares it: after a playback the mic FIFO never got a sample: fifo_full=0) and
 make mic start re-enable it; Photos picture 160x120 like the camera window,
 logs what it loads; dscam logs the frame period every 5 s

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 linux-2.6.x/arch/arm/mach-nds/arm7/dsivol.c   |  4 ++--
 .../arch/arm/mach-nds/arm7/microphone.c       |  3 +++
 user/microwin/src/demos/nanox/dscam.c         | 24 +++++++++++++++++++
 user/microwin/src/demos/nanox/dsgallery.c     | 23 +++++++++++-------
 4 files changed, 43 insertions(+), 11 deletions(-)

diff --git a/linux-2.6.x/arch/arm/mach-nds/arm7/dsivol.c b/linux-2.6.x/arch/arm/mach-nds/arm7/dsivol.c
index 778e64204..1beeba7e6 100644
--- a/linux-2.6.x/arch/arm/mach-nds/arm7/dsivol.c
+++ b/linux-2.6.x/arch/arm/mach-nds/arm7/dsivol.c
@@ -173,8 +173,8 @@ void dsivol_sound_power(int on)
 	}
 	if (on)
 		REG_SNDEXTCNT = (REG_SNDEXTCNT & ~0x000f) | (1 << 15) | 8;	/* I2S on, 100% ARM output, 32 kHz */
-	else
-		REG_SNDEXTCNT &= ~(1 << 15);
+	/* off: the I2S output stays on. The microphone's ADC shares this clock: with it off, the mic FIFO never receives a sample (found
+	 * in the card log: fifo_full=0 for a whole recording made after a playback). */
 }
 
 /* MCU level 0..31 -> DAC volume, 1.5 dB per step, 0 dB at 31; 0 is as quiet as the codec goes */
diff --git a/linux-2.6.x/arch/arm/mach-nds/arm7/microphone.c b/linux-2.6.x/arch/arm/mach-nds/arm7/microphone.c
index 7815c869b..fca3c0d79 100644
--- a/linux-2.6.x/arch/arm/mach-nds/arm7/microphone.c
+++ b/linux-2.6.x/arch/arm/mach-nds/arm7/microphone.c
@@ -17,6 +17,7 @@
 #define REG_MICCNT		(*(volatile u16 *)0x04004600)
 #define REG_MICDATA		(*(volatile u32 *)0x04004604)
 #define MICCNT_FORMAT_NORMAL	2
+#define REG_SNDEXTCNT		(*(volatile u16 *)0x04004700)
 #define MICCNT_EMPTY		(1 << 8)
 #define MICCNT_OVERRUN		(1 << 11)
 #define MICCNT_CLEAR_FIFO	(1 << 12)
@@ -188,6 +189,8 @@ void mic_start()
 	// Setup timer3, since timer0 is used for wifi, 
 	// and timers 1 and 2 are for sound.
 	if (dsitouch_active()) {		/* DSi: FIFO on, 32.7 kHz, normal format, emptied */
+		if (!(REG_SNDEXTCNT & (1 << 15)))	/* the I2S clock must run for the ADC */
+			REG_SNDEXTCNT = (REG_SNDEXTCNT & ~0x000f) | (1 << 15) | 8;
 		REG_MICCNT &= ~MICCNT_ENABLE;
 		REG_MICCNT = MICCNT_CLEAR_FIFO | MICCNT_FORMAT_NORMAL;
 		REG_MICCNT |= MICCNT_ENABLE;
diff --git a/user/microwin/src/demos/nanox/dscam.c b/user/microwin/src/demos/nanox/dscam.c
index a06332a3a..b4080741f 100644
--- a/user/microwin/src/demos/nanox/dscam.c
+++ b/user/microwin/src/demos/nanox/dscam.c
@@ -205,6 +205,30 @@ int main(int argc, char **argv)
 				fails = 0;
 				frames++;
 				got_frame = 1;
+				{	/* frame period statistics for the log, every 5 s */
+					static long last_us, sum_us, min_us = 1000000, max_us, cnt, rep_us;
+					long nowu = usec();
+
+					if (last_us) {
+						long dt = nowu - last_us;
+
+						sum_us += dt;
+						cnt++;
+						if (dt < min_us)
+							min_us = dt;
+						if (dt > max_us)
+							max_us = dt;
+					}
+					last_us = nowu;
+					if (!rep_us)
+						rep_us = nowu;
+					if (nowu - rep_us >= 5000000L && cnt) {
+						fprintf(stderr, "dscam: %ld frames in 5 s, period avg %ld ms min %ld max %ld\n", cnt, sum_us / cnt / 1000, min_us / 1000, max_us / 1000);
+						rep_us = nowu;
+						sum_us = cnt = max_us = 0;
+						min_us = 1000000;
+					}
+				}
 				downscale();
 				gx_texture_load_vbl(0, small, sizeof(small));	/* the kernel loads it at the start of a screen refresh gap */
 				draw_picture(flipx, flipy);
diff --git a/user/microwin/src/demos/nanox/dsgallery.c b/user/microwin/src/demos/nanox/dsgallery.c
index a7b995521..f2666fe8f 100644
--- a/user/microwin/src/demos/nanox/dsgallery.c
+++ b/user/microwin/src/demos/nanox/dsgallery.c
@@ -1,6 +1,6 @@
 /*
  * dsgallery - photo viewer for the DSLinuxDSi desktop: shows the photos of dscam (/home/photos/photoNNN.bmp, 256x192 BMP).
- * It draws with plain Nano-X (a 192x144 picture, nearest neighbour from the 256x192 photo), NOT with the 3D engine: the engine
+ * It draws with plain Nano-X (a 160x120 picture, nearest neighbour from the 256x192 photo), NOT with the 3D engine: the engine
  * can only serve one program at a time, and the camera is the one that needs it. A photo takes a moment to appear (about half a
  * second), it is drawn once, not every frame.
  * Keys: left/right (or , and .) = previous/next, d = delete (press twice), c = open the camera, q or Esc = quit.
@@ -16,8 +16,8 @@
 #include "dsbmp.h"
 
 #define MAXPHOTOS	200
-#define VW		192		/* the picture on the screen */
-#define VH		144
+#define VW		160		/* the picture on the screen: 5/8 of the photo, the same size as the camera window */
+#define VH		120
 #define WIN_W		(VW + 4)
 #define WIN_H		(VH + 4 + 24)
 
@@ -59,11 +59,14 @@ static void scan(void)
 static int load(void)
 {
 	char path[64];
+	int r;
 
 	if (!nphotos)
 		return -1;
 	sprintf(path, PHOTO_DIR "/%s", names[sel]);
-	return bmp_read(path, frame);
+	r = bmp_read(path, frame);
+	fprintf(stderr, "dsgallery: %s: %s (%d)\n", names[sel], r ? "cannot read" : "loaded", r);
+	return r;
 }
 
 /* the photo, in strips of 16 rows (one big request would be too much for the connection) */
@@ -77,17 +80,19 @@ static void draw_photo(void)
 		return;
 	}
 	for (y0 = 0; y0 < VH; y0 += 16) {
-		for (y = 0; y < 16; y++) {
-			const unsigned short *row = frame + ((y0 + y) * 4 / 3) * PW;
+		int rows = VH - y0 < 16 ? VH - y0 : 16;
+
+		for (y = 0; y < rows; y++) {
+			const unsigned short *row = frame + ((y0 + y) * 8 / 5) * PW;
 
 			for (x = 0; x < VW; x++) {
-				unsigned short p = row[x * 4 / 3];
+				unsigned short p = row[x * 8 / 5];
 
 				/* DS pixel (red in the low bits) -> 0RRRRRGGGGGBBBBB for the server */
 				strip[y * VW + x] = ((p & 31) << 10) | (p & 0x3e0) | ((p >> 10) & 31);
 			}
 		}
-		GrArea(win, gc, 2, 2 + y0, VW, 16, strip, MWPF_TRUECOLOR555);
+		GrArea(win, gc, 2, 2 + y0, VW, rows, strip, MWPF_TRUECOLOR555);
 	}
 }
 
@@ -143,7 +148,7 @@ int main(int argc, char **argv)
 	have = load() == 0;
 
 	win = GrNewWindowEx(GR_WM_PROPS_APPFRAME | GR_WM_PROPS_CAPTION | GR_WM_PROPS_CLOSEBOX, "Photos",
-			    GR_ROOT_WINDOW_ID, 24, 4, WIN_W, WIN_H, W95_FACE);
+			    GR_ROOT_WINDOW_ID, 14, 4, WIN_W, WIN_H, W95_FACE);
 	GrSelectEvents(win, GR_EVENT_MASK_EXPOSURE | GR_EVENT_MASK_KEY_DOWN | GR_EVENT_MASK_CLOSE_REQ |
 		       GR_EVENT_MASK_BUTTON_DOWN);
 	GrMapWindow(win);
-- 
