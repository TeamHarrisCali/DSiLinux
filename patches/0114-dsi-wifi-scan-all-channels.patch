From 63416cd1fe80c6784ad2d771824fcdffe4bfa0e8 Mon Sep 17 00:00:00 2001
From: TeamHarrisCali <34009957+TeamHarrisCali@users.noreply.github.com>
Date: Fri, 13 Nov 2026 11:25:09 -0600
Subject: [PATCH] DSi Wi-Fi chip scan: one scan over all channels, phy mode 11g

w98l's channel-by-channel scan (dswifi's way, phy mode 11ag) got
"set channel params" refused (error 1) and every network came back on
channel 1. Scan once over all channels instead: channel params with phy
mode 11g and an empty channel list, then start; up to 200 packets.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 linux-2.6.x/arch/arm/mach-nds/dsiwifi.c | 54 +++++++++++--------------
 1 file changed, 24 insertions(+), 30 deletions(-)

diff --git a/linux-2.6.x/arch/arm/mach-nds/dsiwifi.c b/linux-2.6.x/arch/arm/mach-nds/dsiwifi.c
index 36ea29867..d922764e2 100644
--- a/linux-2.6.x/arch/arm/mach-nds/dsiwifi.c
+++ b/linux-2.6.x/arch/arm/mach-nds/dsiwifi.c
@@ -258,7 +258,7 @@ static int pump(int ms, int *flag, int *bad)
 {
 	int rounds;
 
-	for (rounds = 0; rounds < 64 && !*flag; rounds++) {
+	for (rounds = 0; rounds < 200 && !*flag; rounds++) {
 		unsigned int out[19], hdr, len, alen, id;
 		int b2 = 0, r = dsisd_twlop_rx(12, 0, ms, 0, 0, out, rx);
 
@@ -304,9 +304,8 @@ static int pump(int ms, int *flag, int *bad)
 
 static void wmi_scan(int *bad)
 {
-	static const unsigned short mhz[13] = { 2412, 2417, 2422, 2427, 2432, 2437, 2442, 2447, 2452, 2457, 2462, 2467, 2472 };
 	unsigned char b[40];
-	int c, i;
+	int i;
 	unsigned int v;
 
 	nnets = 0;
@@ -317,33 +316,28 @@ static void wmi_scan(int *bad)
 	memset(b, 0, sizeof(b));
 	mbox_out(1, 1, WMI_SET_BSS_FILTER_CMD, b, 8, bad);		/* none while setting up */
 	mbox_out(1, 1, WMI_SET_PROBED_SSID_CMD, b, 35, bad);		/* entry 0, no SSID: any */
-	for (c = 0; c < 13 && !*bad; c++) {
-		/* channel params: reserved, scanparam, phy mode 3 (11ag, as dswifi), 1 channel, its MHz */
-		memset(b, 0, sizeof(b));
-		b[2] = 3;
-		b[3] = 1;
-		b[4] = mhz[c] & 0xff;
-		b[5] = mhz[c] >> 8;
-		mbox_out(1, 1, WMI_SET_CHANNEL_PARAMS_CMD, b, 6, bad);
-		/* scan params: fg start/end, bg period 0xFFFF, max active dwell 20, passive dwell 50, short scan ratio 3, flags 1, min active 0 */
-		memset(b, 0, sizeof(b));
-		for (i = 0; i < 6; i++)
-			b[i] = 0xFF;
-		b[6] = 20;
-		b[8] = 50;
-		b[10] = 3;
-		b[11] = 1;
-		mbox_out(1, 1, WMI_SET_SCAN_PARAMS_CMD, b, 20, bad);
-		memset(b, 0, sizeof(b));
-		b[0] = 1;					/* all BSSs */
-		mbox_out(1, 1, WMI_SET_BSS_FILTER_CMD, b, 8, bad);
-		memset(b, 0, sizeof(b));
-		b[8] = 20;					/* home dwell time */
-		mbox_out(1, 1, WMI_START_SCAN_CMD, b, 20, bad);
-		scan_done = 0;
-		pump(400, &scan_done, bad);
-	}
-	lg("  scanned 13 channels: %u networks\n", nnets, 0, 0);
+	/* one scan over every channel (w98l's channel-by-channel scan with phy mode 11ag, as dswifi, had its channel commands refused and
+	 * stayed on channel 1): channel params with phy mode 11g (2) and no channel list (= all), scan params, all BSSs, start */
+	memset(b, 0, sizeof(b));
+	b[2] = 2;
+	mbox_out(1, 1, WMI_SET_CHANNEL_PARAMS_CMD, b, 6, bad);
+	memset(b, 0, sizeof(b));
+	for (i = 0; i < 6; i++)
+		b[i] = 0xFF;
+	b[6] = 20;
+	b[8] = 50;
+	b[10] = 3;
+	b[11] = 1;
+	mbox_out(1, 1, WMI_SET_SCAN_PARAMS_CMD, b, 20, bad);
+	memset(b, 0, sizeof(b));
+	b[0] = 1;						/* all BSSs */
+	mbox_out(1, 1, WMI_SET_BSS_FILTER_CMD, b, 8, bad);
+	memset(b, 0, sizeof(b));
+	b[8] = 20;						/* home dwell time */
+	mbox_out(1, 1, WMI_START_SCAN_CMD, b, 20, bad);
+	scan_done = 0;
+	pump(6000, &scan_done, bad);
+	lg(scan_done ? "  scan complete: %u networks\n" : "  scan did not report completion: %u networks\n", nnets, 0, 0);
 	for (i = 0; i < nnets && i < 16; i++) {
 		char line[96];
 
-- 
2.56.0

