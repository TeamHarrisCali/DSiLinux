From f1b36c4d3b67f52fdfdaf15ac20c0d59a73f68a9 Mon Sep 17 00:00:00 2001
From: TeamHarrisCali <noreply@example.invalid>
Date: Tue, 10 Nov 2026 22:04:44 -0600
Subject: [PATCH] nds: CONFIG_NDS_DSI_FASTCPU (ARM9 134 MHz via SCFG_CLK bit 0,
 only when DSi mode is proven, before delay calibration), off by default

---
 linux-2.6.x/arch/arm/mach-nds/Kconfig   | 11 +++++++++++
 linux-2.6.x/arch/arm/mach-nds/arch.c    | 23 +++++++++++++++++++++++
 vendors/Nintendo/DSI/config.linux-2.6.x |  1 +
 3 files changed, 35 insertions(+)

diff --git a/linux-2.6.x/arch/arm/mach-nds/Kconfig b/linux-2.6.x/arch/arm/mach-nds/Kconfig
index d15f94689..dd53ac048 100644
--- a/linux-2.6.x/arch/arm/mach-nds/Kconfig
+++ b/linux-2.6.x/arch/arm/mach-nds/Kconfig
@@ -14,6 +14,17 @@ config NDS_DSI
 	  A kernel built this way does NOT boot on a DS or a DSi in DS mode.
 	  If unsure, say N.
 
+config NDS_DSI_FASTCPU
+	bool "Run the ARM9 at 134 MHz in DSi mode (SCFG_CLK bit 0)"
+	depends on ARCH_NDS && NDS_DSI
+	default n
+	help
+	  Sets the DSi's ARM9 clock to 134 MHz instead of 67 MHz. Done only when the
+	  early RAM test proves DSi mode, and before the delay loop is calibrated.
+	  The BogoMIPS line in the boot log shows whether it took effect. Untested on
+	  real hardware: if the console misbehaves, use the build without it.
+	  If unsure, say N.
+
 config NDS_DSISD
 	bool "DSi internal SD card (replaces the DLDI card driver)"
 	depends on ARCH_NDS && NDS_DSI && NDS_DLDI
diff --git a/linux-2.6.x/arch/arm/mach-nds/arch.c b/linux-2.6.x/arch/arm/mach-nds/arch.c
index 3cd1b40a0..0dacfdf17 100644
--- a/linux-2.6.x/arch/arm/mach-nds/arch.c
+++ b/linux-2.6.x/arch/arm/mach-nds/arch.c
@@ -66,6 +66,10 @@ static void poweroff(void)
  * Both addresses are above the kernel image and unused this early.
  */
 static int nds_ram_is_mirrored = -1;
+#ifdef CONFIG_NDS_DSI_FASTCPU
+#define SCFG_CLK9	0x04004004
+static int nds_clk_before = -1, nds_clk_after = -1;
+#endif
 
 static void nds_probe_ram(void)
 {
@@ -82,6 +86,18 @@ static void nds_probe_ram(void)
 	*p1 = s1;
 	dmac_flush_range((unsigned long)p0, (unsigned long)p0 + 4);
 	dmac_flush_range((unsigned long)p1, (unsigned long)p1 + 4);
+
+#ifdef CONFIG_NDS_DSI_FASTCPU
+	/*
+	 * ARM9 clock 67 -> 134 MHz (SCFG_CLK bit 0). Only when real DSi mode is proven by the RAM test above, and before
+	 * calibrate_delay() so that udelay() loops are calibrated at the final speed.
+	 */
+	if (!nds_ram_is_mirrored) {
+		nds_clk_before = readw(SCFG_CLK9);
+		writew(nds_clk_before | 1, SCFG_CLK9);
+		nds_clk_after = readw(SCFG_CLK9);
+	}
+#endif
 }
 #endif
 
@@ -90,6 +106,13 @@ static void nds_machine_init(void)
 #ifdef CONFIG_NDS_DSI
 	printk(KERN_INFO "NDS: main RAM above 4 MB is %s\n",
 	       nds_ram_is_mirrored ? "MIRRORED (only 4 MB real!)" : "real (16 MB)");
+#ifdef CONFIG_NDS_DSI_FASTCPU
+	if (nds_clk_after < 0)
+		printk(KERN_INFO "NDS: ARM9 clock unchanged (not in DSi mode)\n");
+	else
+		printk(KERN_INFO "NDS: ARM9 SCFG_CLK %04x -> %04x: %s\n", nds_clk_before, nds_clk_after,
+		       (nds_clk_after & 1) ? "134 MHz requested and accepted" : "134 MHz NOT accepted (stays 67 MHz)");
+#endif
 #endif
 	POWER_CR = POWER_2D | POWER_2D_SUB | POWER_LCD | POWER_SWAP_LCDS ;
 
diff --git a/vendors/Nintendo/DSI/config.linux-2.6.x b/vendors/Nintendo/DSI/config.linux-2.6.x
index 553d5c1d6..59d9cbd4a 100644
--- a/vendors/Nintendo/DSI/config.linux-2.6.x
+++ b/vendors/Nintendo/DSI/config.linux-2.6.x
@@ -98,6 +98,7 @@ CONFIG_FLASH_SIZE=0x00800000
 #
 CONFIG_NDS_DSI=y
 CONFIG_NDS_DSISD=y
+# CONFIG_NDS_DSI_FASTCPU is not set
 # CONFIG_NDS_DSISD_WRITE is not set
 CONFIG_NDS_DSISD_LOGFILE=y
 # CONFIG_NDS_DSISD_TOUCHDIAG is not set
-- 
2.56.0

