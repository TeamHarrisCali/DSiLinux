+/* a tooltip above the tray picture the pointer is on (or was tapped): the battery and volume percentages, the Wi-Fi state */
+static void draw_tip(void)
+{
+	if (!tipwin)
+		return;
+	w95_fill(tipwin, gc, W95_DARK, 0, 0, tip_w, th + 4);
+	w95_fill(tipwin, gc, GR_RGB(255, 255, 225), 1, 1, tip_w - 2, th + 2);
+	w95_text(tipwin, gc, W95_DARK, 3, 2, tip_text);
+}
+
+static void hide_tip(void)
+{
+	if (tipwin)
+		GrDestroyWindow(tipwin);
+	tipwin = 0;
+	tip_item = -1;
+}
+
+static void show_tip(int item)
+{
+	int x;
+
+	if (item == TRAY_WIFI) {
+		FILE *f;
+		char line[64], essid[33] = "";
+
+		if (wifi_state == 2 && (f = fopen("/home/wifi.conf", "r"))) {	/* the network the Wi-Fi window / wifi-connect joined */
+			while (fgets(line, sizeof(line), f))
+				if (sscanf(line, "essid=\"%32[^\"]\"", essid) == 1)
+					break;
+			fclose(f);
+		}
+		if (wifi_state == 2)
+			snprintf(tip_text, sizeof(tip_text), "%s%s%s", essid, essid[0] ? " " : "", wifi_ip);
+		else
+			snprintf(tip_text, sizeof(tip_text), "Wi-Fi %s - tap: Wi-Fi", wifi_state == 1 ? "on" : "off");
+	} else if (item == TRAY_BAT) {
+		if (bat_level < 0)
+			strcpy(tip_text, "Battery: unknown");
+		else
+			snprintf(tip_text, sizeof(tip_text), "Battery %d%%%s", bat_level * 100 / 15, bat_chg ? ", charging" : "");
+	} else {
+		if (vol_cur < 0)
+			strcpy(tip_text, "Volume: unknown");
+		else if (vol_cur == 0)
+			strcpy(tip_text, "Volume: muted");
+		else
+			snprintf(tip_text, sizeof(tip_text), "Volume %d%%", vol_cur);
+	}
+	hide_tip();
+	tip_item = item;
+	tip_since = time(NULL);
+	tip_w = w95_textw(gc, tip_text) + 6;
+	x = (tray_x0[item] + tray_x1[item]) / 2 - tip_w / 2;
+	if (x + tip_w > si.cols - 1)
+		x = si.cols - 1 - tip_w;
+	if (x < 0)
+		x = 0;
+	tipwin = GrNewWindowEx(GR_WM_PROPS_NODECORATE | GR_WM_PROPS_NOFOCUS | GR_WM_PROPS_NOMOVE, "tip", GR_ROOT_WINDOW_ID,
+			       x, si.rows - barh - th - 6, tip_w, th + 4, W95_FACE);
+	GrSelectEvents(tipwin, GR_EVENT_MASK_EXPOSURE);
+	GrMapWindow(tipwin);
+}
+
+static int tray_item_at(int x)
+{
+	int k;
+
+	for (k = 0; k < 3; k++)
+		if (x >= tray_x0[k] && x < tray_x1[k])
+			return k;
+	return -1;
+}
