diff --git a/user/microwin/src/demos/nanox/dsnet.c b/user/microwin/src/demos/nanox/dsnet.c
new file mode 100644
index 000000000..8f6b493cb
--- /dev/null
+++ b/user/microwin/src/demos/nanox/dsnet.c
@@ -0,0 +1,564 @@
+/*
+ * dsnet - the Wi-Fi window of the DSLinuxDSi desktop (Start > Network > Wi-Fi, or a tap on the Wi-Fi icon in the tray).
+ * Linked into dssettings and started as "dssettings wifi": a program of its own would carry its own 50 KB copy of the Nano-X client library,
+ * and the ROM has no room for that.
+ * Switch Wi-Fi on and off, scan, see the networks (signal, lock = WEP, "saved"), connect (asks for the WEP key the first time and
+ * remembers it), forget a saved network. The DS Wi-Fi chip joins only open and WEP networks.
+ *   Networks:  /proc/dswifi (the kernel lists what the chip heard; reading it scans the channels first)
+ *   Commands:  ifconfig nds up/down, iwconfig nds essid/key, udhcpc -n -q -i nds (address by DHCP)
+ *   Saved:     /home/wifi.known (name TAB key per line); the network last joined also goes to /home/wifi.conf (the boot scripts' file)
+ * Keys: up/down choose, Enter (A) connect, s or Space (B) scan, w Wi-Fi on/off, f forget, q or Esc quit. Taps work on everything.
+ * PC test bed: DSNET_APS=file replaces /proc/dswifi, DSNET_DRYRUN=1 prints the commands instead of running them.
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <sys/ioctl.h>
+#include <sys/socket.h>
+#include <net/if.h>
+#include <netinet/in.h>
+#include <arpa/inet.h>
+#include "nano-X.h"
+#include "w95.h"
+
+#define WW	200
+#define WH	136
+#define LIST_Y	30
+#define ROWH	11
+#define NROWS	7
+#define MAXNET	24
+#ifdef NANOX_TESTBED
+static char KNOWN[200], CONF[200];	/* PC test bed: in $HOME */
+#else
+#define KNOWN	"/home/wifi.known"
+#define CONF	"/home/wifi.conf"
+#endif
+
+struct net {
+	char ssid[33];
+	int channel, wep, signal, saved;
+	char key[40];
+};
+
+static struct net nets[MAXNET];
+static int nnet, sel, first;
+static GR_WINDOW_ID win;
+static GR_GC_ID gc;
+static int th;
+static char status[64];
+static char cur_ssid[33];
+static int dryrun, sim_up, sim_conn;
+
+/* key entry: when a WEP network without a saved key is chosen */
+static int asking;
+static char keybuf[40];
+
+/* ---------------------------------------------------------------- the system */
+static int run(const char *cmd)
+{
+	if (dryrun) {
+		fprintf(stderr, "dsnet would run: %s\n", cmd);
+		if (strstr(cmd, "ifconfig nds up")) sim_up = 1;
+		if (strstr(cmd, "ifconfig nds down")) sim_up = sim_conn = 0;
+		if (strstr(cmd, "udhcpc")) sim_conn = 1;
+		return 0;
+	}
+	return system(cmd);
+}
+
+/* the name with every ' made safe for the shell's single quotes */
+static void quote(char *out, int n, const char *in)
+{
+	int k = 0;
+
+	out[k++] = '\'';
+	for (; *in && k < n - 6; in++) {
+		if (*in == '\'') {
+			strcpy(out + k, "'\\''");
+			k += 4;
+		} else {
+			out[k++] = *in;
+		}
+	}
+	out[k++] = '\'';
+	out[k] = 0;
+}
+
+static int wifi_up(void)
+{
+	struct ifreq ifr;
+	int fd, up = 0;
+
+	if (dryrun)
+		return sim_up;
+	fd = socket(AF_INET, SOCK_DGRAM, 0);
+	if (fd < 0)
+		return 0;
+	memset(&ifr, 0, sizeof(ifr));
+	strcpy(ifr.ifr_name, "nds");
+	if (ioctl(fd, SIOCGIFFLAGS, &ifr) == 0)
+		up = (ifr.ifr_flags & IFF_UP) != 0;
+	close(fd);
+	return up;
+}
+
+/* the IPv4 address of nds as text, or "" */
+static void wifi_ip(char *out)
+{
+	struct ifreq ifr;
+	int fd;
+
+	out[0] = 0;
+	if (dryrun) {
+		if (sim_conn)
+			strcpy(out, "192.168.43.17");
+		return;
+	}
+	fd = socket(AF_INET, SOCK_DGRAM, 0);
+	if (fd < 0)
+		return;
+	memset(&ifr, 0, sizeof(ifr));
+	strcpy(ifr.ifr_name, "nds");
+	ifr.ifr_addr.sa_family = AF_INET;
+	if (ioctl(fd, SIOCGIFADDR, &ifr) == 0) {
+		struct in_addr a = ((struct sockaddr_in *)&ifr.ifr_addr)->sin_addr;
+
+		if (a.s_addr)
+			strcpy(out, inet_ntoa(a));
+	}
+	close(fd);
+}
+
+static void load_known(void)
+{
+	FILE *f = fopen(KNOWN, "r");
+	char line[100];
+	int i;
+
+	for (i = 0; i < nnet; i++)
+		nets[i].saved = 0;
+	if (!f)
+		return;
+	while (fgets(line, sizeof(line), f)) {
+		char *tab = strchr(line, '\t'), *nl = strchr(line, '\n');
+
+		if (nl) *nl = 0;
+		if (!tab)
+			continue;
+		*tab = 0;
+		for (i = 0; i < nnet; i++)
+			if (!strcmp(nets[i].ssid, line)) {
+				nets[i].saved = 1;
+				strncpy(nets[i].key, tab + 1, sizeof(nets[i].key) - 1);
+			}
+	}
+	fclose(f);
+}
+
+/* rewrite the saved list: add or replace ssid (key may be ""), or remove it (forget) */
+static void save_known(const char *ssid, const char *key, int forget)
+{
+	FILE *f = fopen(KNOWN, "r"), *o;
+	char lines[32][100], line[100];
+	int n = 0, i;
+
+	if (f) {
+		while (n < 31 && fgets(line, sizeof(line), f)) {
+			char *tab = strchr(line, '\t');
+
+			if (tab && (int)(tab - line) == (int)strlen(ssid) && !strncmp(line, ssid, tab - line))
+				continue;		/* the old entry of this network */
+			strcpy(lines[n++], line);
+		}
+		fclose(f);
+	}
+	o = fopen(KNOWN, "w");
+	if (!o)
+		return;
+	for (i = 0; i < n; i++)
+		fputs(lines[i], o);
+	if (!forget)
+		fprintf(o, "%s\t%s\n", ssid, key);
+	fclose(o);
+}
+
+/* read the networks from /proc/dswifi: "bssid channel open|wep signal name"; the same name heard twice keeps its best signal */
+static void read_networks(void)
+{
+	const char *src = getenv("DSNET_APS");
+	FILE *f = fopen(src ? src : "/proc/dswifi", "r");
+	char line[128];
+
+	nnet = 0;
+	if (!f)
+		return;
+	while (fgets(line, sizeof(line), f) && nnet < MAXNET) {
+		char bssid[24], sec[8], *name, *nl;
+		int ch, sig, i, pos = 0;
+
+		if (sscanf(line, "%23s %d %7s %d %n", bssid, &ch, sec, &sig, &pos) < 4 || !pos)
+			continue;
+		name = line + pos;
+		if ((nl = strchr(name, '\n')))
+			*nl = 0;
+		for (i = 0; i < nnet; i++)
+			if (!strcmp(nets[i].ssid, name))
+				break;
+		if (i < nnet) {
+			if (sig > nets[i].signal)
+				nets[i].signal = sig;
+			continue;
+		}
+		memset(&nets[nnet], 0, sizeof(nets[0]));
+		strncpy(nets[nnet].ssid, name, 32);
+		nets[nnet].channel = ch;
+		nets[nnet].wep = !strcmp(sec, "wep");
+		nets[nnet].signal = sig;
+		nnet++;
+	}
+	fclose(f);
+	{					/* strongest first */
+		int a, b;
+
+		for (a = 0; a < nnet; a++)
+			for (b = a + 1; b < nnet; b++)
+				if (nets[b].signal > nets[a].signal) {
+					struct net t = nets[a];
+
+					nets[a] = nets[b];
+					nets[b] = t;
+				}
+	}
+	load_known();
+	if (sel >= nnet)
+		sel = nnet ? nnet - 1 : 0;
+	first = 0;
+}
+
+/* ---------------------------------------------------------------- drawing */
+static void bars(int x, int y, int level, GR_COLOR on)	/* level 0..3 */
+{
+	int i;
+
+	for (i = 0; i < 3; i++)
+		w95_fill(win, gc, i < level ? on : W95_SHADOW, x + i * 3, y + 6 - i * 2 - 1, 2, 2 + i * 2 + 1);
+}
+
+static int level_of(int signal)
+{
+	return signal > 40 ? 3 : signal > 20 ? 2 : signal > 0 ? 1 : 0;
+}
+
+static void draw_status(void)
+{
+	char ip[24], t[80];
+
+	w95_fill(win, gc, W95_FACE, 0, 17, WW, 12);
+	if (!wifi_up()) {
+		snprintf(t, sizeof(t), "%s", status[0] ? status : "Wi-Fi is off");
+	} else {
+		wifi_ip(ip);
+		if (status[0])
+			snprintf(t, sizeof(t), "%s", status);
+		else if (ip[0])
+			snprintf(t, sizeof(t), "Online %s %s", cur_ssid[0] ? cur_ssid : "", ip);
+		else
+			snprintf(t, sizeof(t), "On, not connected");
+	}
+	t[(WW - 6) / (w95_textw(gc, "M") ? w95_textw(gc, "M") : 6)] = 0;
+	w95_text(win, gc, W95_DARK, 3, 18, t);
+}
+
+static void draw_buttons(void)
+{
+	w95_fill(win, gc, W95_FACE, 0, 0, WW, 17);
+	w95_button(win, gc, 2, 2, 62, 14, wifi_up() ? "Wi-Fi: On" : "Wi-Fi: Off", 0);
+	w95_button(win, gc, 66, 2, 40, 14, "Scan", 0);
+	w95_fill(win, gc, W95_FACE, 0, LIST_Y + NROWS * ROWH + 4, WW, WH - (LIST_Y + NROWS * ROWH + 4));
+	w95_button(win, gc, 2, WH - 16, 60, 14, "Connect", 0);
+	w95_button(win, gc, 64, WH - 16, 48, 14, "Forget", 0);
+	w95_button(win, gc, WW - 36, WH - 16, 16, 14, "^", 0);
+	w95_button(win, gc, WW - 18, WH - 16, 16, 14, "v", 0);
+}
+
+static void draw_list(void)
+{
+	int r;
+
+	w95_box(win, gc, 2, LIST_Y, WW - 4, NROWS * ROWH + 4, 1, W95_WHITEFILL);
+	if (asking) {
+		char t[64];
+
+		snprintf(t, sizeof(t), "WEP key for %s:", nets[sel].ssid);
+		w95_text(win, gc, W95_DARK, 6, LIST_Y + 4, t);
+		w95_box(win, gc, 6, LIST_Y + 16, WW - 12, 14, 1, W95_WHITEFILL);
+		w95_text(win, gc, W95_DARK, 9, LIST_Y + 18, keybuf);
+		w95_fill(win, gc, W95_DARK, 9 + w95_textw(gc, keybuf), LIST_Y + 18, 1, th);
+		w95_text(win, gc, W95_SHADOW, 6, LIST_Y + 34, "5 or 13 letters, or 10 / 26 hex");
+		w95_text(win, gc, W95_SHADOW, 6, LIST_Y + 46, "Enter: connect   Esc: cancel");
+		return;
+	}
+	if (!nnet) {
+		w95_text(win, gc, W95_SHADOW, 6, LIST_Y + 4, wifi_up() ? "No networks yet: Scan" : "Wi-Fi is off: Scan turns it on");
+		return;
+	}
+	for (r = 0; r < NROWS && first + r < nnet; r++) {
+		struct net *n = &nets[first + r];
+		int y = LIST_Y + 2 + r * ROWH, on = first + r == sel;
+		GR_COLOR fgc = on ? W95_LIGHT : W95_DARK;
+
+		if (on)
+			w95_fill(win, gc, W95_NAVY, 4, y, WW - 8, ROWH);
+		bars(7, y + 2, level_of(n->signal), on ? W95_LIGHT : W95_DARK);
+		if (n->wep) {			/* a padlock */
+			w95_fill(win, gc, fgc, 18, y + 5, 5, 4);
+			w95_fill(win, gc, fgc, 19, y + 2, 3, 1);
+			w95_fill(win, gc, fgc, 19, y + 3, 1, 2);
+			w95_fill(win, gc, fgc, 21, y + 3, 1, 2);
+		}
+		w95_text(win, gc, fgc, 26, y + (ROWH - th) / 2, n->ssid[0] ? n->ssid : "(hidden)");
+		if (!strcmp(n->ssid, cur_ssid) && cur_ssid[0])
+			w95_text(win, gc, on ? W95_LIGHT : GR_RGB(0, 128, 0), WW - 50, y + (ROWH - th) / 2, "online");
+		else if (n->saved)
+			w95_text(win, gc, on ? W95_LIGHT : W95_SHADOW, WW - 44, y + (ROWH - th) / 2, "saved");
+	}
+}
+
+static void draw_all(void)
+{
+	draw_buttons();
+	draw_status();
+	draw_list();
+}
+
+static void say(const char *s)
+{
+	snprintf(status, sizeof(status), "%s", s);
+	draw_status();
+	GrFlush();
+}
+
+/* ---------------------------------------------------------------- actions */
+static void wifi_on(void)
+{
+	if (!wifi_up()) {
+		say("Switching Wi-Fi on...");
+		run("ifconfig nds up");
+		sleep(1);
+	}
+}
+
+static void toggle(void)
+{
+	if (wifi_up()) {
+		run("killall udhcpc 2>/dev/null; ifconfig nds down");
+		nnet = 0;
+		cur_ssid[0] = 0;
+		status[0] = 0;
+	} else {
+		wifi_on();
+		status[0] = 0;
+	}
+	draw_all();
+}
+
+static void scan(void)
+{
+	wifi_on();
+	say("Scanning (a few seconds)...");
+	read_networks();
+	if (!nnet) {		/* the chip fills its list as it hears beacons: one more pass */
+		read_networks();
+	}
+	status[0] = 0;
+	draw_all();
+}
+
+static void connect_to(struct net *n, const char *key)
+{
+	char q[80], cmd[200], ip[24], k[44];
+	FILE *f;
+
+	wifi_on();
+	snprintf(cmd, sizeof(cmd), "Connecting to %s...", n->ssid);
+	say(cmd);
+	quote(q, sizeof(q), n->ssid);
+	run("killall udhcpc 2>/dev/null");
+	snprintf(cmd, sizeof(cmd), "iwconfig nds essid %s > /dev/null 2>&1", q);
+	run(cmd);
+	k[0] = 0;
+	if (key && key[0]) {
+		int len = strlen(key);
+
+		/* 5 or 13 characters are a text key (s:), 10 or 26 hex digits are used as they are */
+		snprintf(k, sizeof(k), "%s%s", (len == 5 || len == 13) && strncmp(key, "s:", 2) ? "s:" : "", key);
+		quote(q, sizeof(q), k);
+		snprintf(cmd, sizeof(cmd), "iwconfig nds key %s > /dev/null 2>&1", q);
+	} else {
+		snprintf(cmd, sizeof(cmd), "iwconfig nds key off > /dev/null 2>&1");
+	}
+	run(cmd);
+	sleep(2);
+	say("Asking for an address (DHCP)...");
+	run("udhcpc -n -q -i nds > /tmp/dsnet-dhcp.log 2>&1");
+	wifi_ip(ip);
+	if (ip[0]) {
+		snprintf(cur_ssid, sizeof(cur_ssid), "%s", n->ssid);
+		save_known(n->ssid, key ? key : "", 0);
+		f = fopen(CONF, "w");	/* the boot scripts' settings (Start > Network > Wi-Fi status, rc) */
+		if (f) {
+			fprintf(f, "essid=\"%s\"\nwepkey=\"%s\"\n", n->ssid, k);
+			fclose(f);
+		}
+		load_known();
+		status[0] = 0;
+	} else {
+		snprintf(status, sizeof(status), "No address from %s%s", n->ssid, n->wep ? " (key?)" : "");
+	}
+	draw_all();
+}
+
+static void choose(int i)
+{
+	if (i < 0 || i >= nnet)
+		return;
+	sel = i;
+	if (sel < first)
+		first = sel;
+	if (sel >= first + NROWS)
+		first = sel - NROWS + 1;
+	draw_list();
+}
+
+static void activate(void)
+{
+	struct net *n;
+
+	if (!nnet)
+		return;
+	n = &nets[sel];
+	if (n->wep && !n->saved) {	/* ask for the key first */
+		asking = 1;
+		keybuf[0] = 0;
+		draw_list();
+		return;
+	}
+	connect_to(n, n->saved ? n->key : NULL);
+}
+
+static void key_entry(int k)
+{
+	int len = strlen(keybuf);
+
+	if (k == MWKEY_ESCAPE) {
+		asking = 0;
+	} else if (k == MWKEY_ENTER || k == '\r') {
+		asking = 0;
+		draw_list();
+		connect_to(&nets[sel], keybuf);
+		return;
+	} else if (k == MWKEY_BACKSPACE || k == 8 || k == 127) {
+		if (len)
+			keybuf[len - 1] = 0;
+	} else if (k >= 32 && k < 127 && len < (int)sizeof(keybuf) - 1) {
+		keybuf[len] = k;
+		keybuf[len + 1] = 0;
+	}
+	draw_list();
+}
+
+int dsnet_main(int argc, char **argv)
+{
+	GR_EVENT ev;
+	GR_FONT_ID font;
+
+	dryrun = getenv("DSNET_DRYRUN") != NULL;
+#ifdef NANOX_TESTBED
+	snprintf(KNOWN, sizeof(KNOWN), "%s/wifi.known", getenv("HOME") ? getenv("HOME") : ".");
+	snprintf(CONF, sizeof(CONF), "%s/wifi.conf", getenv("HOME") ? getenv("HOME") : ".");
+#endif
+	if (GrOpen() < 0) {
+		fprintf(stderr, "dsnet: cannot connect to Nano-X\n");
+		return 1;
+	}
+	gc = GrNewGC();
+	font = GrCreateFont("Tiny", 0, NULL);
+	GrSetGCFont(gc, font);
+	w95_init(font);
+	th = w95_texth(gc);
+	win = GrNewWindowEx(GR_WM_PROPS_APPFRAME | GR_WM_PROPS_CAPTION | GR_WM_PROPS_CLOSEBOX, (GR_CHAR *)"Wi-Fi", GR_ROOT_WINDOW_ID,
+			    20, 6, WW, WH, W95_FACE);
+	GrSelectEvents(win, GR_EVENT_MASK_EXPOSURE | GR_EVENT_MASK_KEY_DOWN | GR_EVENT_MASK_CLOSE_REQ | GR_EVENT_MASK_BUTTON_DOWN);
+	GrMapWindow(win);
+	GrSetFocus(win);
+	if (wifi_up())			/* already on: show what is around at once */
+		read_networks();
+
+	for (;;) {
+		GrGetNextEvent(&ev);
+		switch (ev.type) {
+		case GR_EVENT_TYPE_EXPOSURE:
+			draw_all();
+			break;
+		case GR_EVENT_TYPE_CLOSE_REQ:
+			GrClose();
+			return 0;
+		case GR_EVENT_TYPE_KEY_DOWN: {
+			int k = ev.keystroke.ch;
+
+			if (asking) {
+				key_entry(k);
+				break;
+			}
+			if (k == MWKEY_ESCAPE || k == 'q') {
+				GrClose();
+				return 0;
+			}
+			if (k == MWKEY_UP) choose(sel - 1);
+			else if (k == MWKEY_DOWN) choose(sel + 1);
+			else if (k == MWKEY_ENTER || k == '\r') activate();
+			else if (k == 's' || k == ' ') scan();
+			else if (k == 'w') toggle();
+			else if (k == 'f' && nnet && nets[sel].saved) {
+				save_known(nets[sel].ssid, "", 1);
+				load_known();
+				draw_list();
+			}
+			break;
+		}
+		case GR_EVENT_TYPE_BUTTON_DOWN: {
+			int x = ev.button.x, y = ev.button.y;
+
+			if (asking)
+				break;
+			if (y < 17) {
+				if (x < 64) toggle();
+				else if (x < 106) scan();
+			} else if (y >= LIST_Y && y < LIST_Y + NROWS * ROWH + 2) {
+				int i = first + (y - LIST_Y - 2) / ROWH;
+
+				if (i == sel && i < nnet)
+					activate();
+				else
+					choose(i);
+			} else if (y >= WH - 16) {
+				if (x < 62) activate();
+				else if (x < 112) {
+					if (nnet && nets[sel].saved) {
+						save_known(nets[sel].ssid, "", 1);
+						load_known();
+						draw_list();
+					}
+				} else if (x >= WW - 36 && x < WW - 18) {
+					if (first > 0) { first--; draw_list(); }
+				} else if (x >= WW - 18) {
+					if (first + NROWS < nnet) { first++; draw_list(); }
+				}
+			}
+			break;
+		}
+		}
+	}
+	return 0;
+}
