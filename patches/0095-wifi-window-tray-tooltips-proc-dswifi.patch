 };
 
+/*
+ * /proc/dswifi (DSLinuxDSi): the networks the chip has heard, one per line, for programs that should not depend on iwlist (the image's
+ * iwlist speaks wireless extensions 17, this driver 19, whose scan format differs: the network names got lost). Reading it starts a
+ * channel scan (up to 3 s), then lists:   bssid channel open|wep signal name
+ */
+static int dswifi_read_proc(char *page, char **start, off_t off, int count, int *eof, void *data)
+{
+	int i, len = 0;
+
+	if (off > 0) {			/* everything was given out by the first read */
+		*eof = 1;
+		return 0;
+	}
+	scan_complete = 0;
+	nds_fifo_send(FIFO_WIFI_CMD(FIFO_WIFI_CMD_SCAN, 0));
+	wait_event_interruptible_timeout(ndswifi_wait, scan_complete != 0, 3 * HZ);
+	ap_query_complete = 0;
+	nds_fifo_send(FIFO_WIFI_CMD(FIFO_WIFI_CMD_AP_QUERY, 1));	/* stop list updates while it is read */
+	wait_event_interruptible_timeout(ndswifi_wait, ap_query_complete != 0, 3 * HZ);
+	dmac_inv_range((unsigned long)&aplist[0], (unsigned long)&aplist[WIFI_MAX_AP]);	/* what the ARM7 wrote, not old cache lines */
+	for (i = 0; i < WIFI_MAX_AP && len < PAGE_SIZE - 80; i++) {
+		char name[33];
+		int n = aplist[i].ssid_len, k;
+
+		if (!aplist[i].channel)
+			continue;
+		if (n < 0 || n > 32)
+			n = 0;
+		for (k = 0; k < n; k++) {
+			char c = aplist[i].ssid[k];
+
+			name[k] = (c >= 32 && c < 127) ? c : '?';
+		}
+		name[n] = 0;
+		len += sprintf(page + len, "%02x:%02x:%02x:%02x:%02x:%02x %d %s %d %s\n",
+			       aplist[i].bssid[0], aplist[i].bssid[1], aplist[i].bssid[2], aplist[i].bssid[3], aplist[i].bssid[4],
+			       aplist[i].bssid[5], aplist[i].channel, (aplist[i].flags & WFLAG_APDATA_WEP) ? "wep" : "open",
+			       aplist[i].rssi, name);
+	}
+	ap_query_complete = 0;
+	nds_fifo_send(FIFO_WIFI_CMD(FIFO_WIFI_CMD_AP_QUERY, 0));	/* updates on again */
+	wait_event_interruptible_timeout(ndswifi_wait, ap_query_complete != 0, 3 * HZ);
+	*eof = 1;
+	return len;
+}
