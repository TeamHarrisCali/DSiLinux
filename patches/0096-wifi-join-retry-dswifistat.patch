 	say("Asking for an address (DHCP)...");
 	run("udhcpc -n -q -i nds > /tmp/dsnet-dhcp.log 2>&1");
 	wifi_ip(ip);
+	dlog(ip[0] ? ip : "no address (DHCP): /tmp/dsnet-dhcp.log");
 	if (ip[0]) {
 		snprintf(cur_ssid, sizeof(cur_ssid), "%s", n->ssid);
 		save_known(n->ssid, key ? key : "", 0);
@@ -438,6 +497,10 @@ static void activate(void)
 	if (!nnet)
 		return;
 	n = &nets[sel];
+	if (n->wpa) {
+		say("WPA: the DS chip cannot join");
+		return;
