 	return len;
 }
 
+/*
+ * /proc/dswifistat: how joining the chosen network goes, without scanning (cheap, so the log and the Wi-Fi window can read it often).
+ *   state 0x0013 up authenticated associated     the ARM7's state flags, named
+ *   auth 3 assoc 1 status 0 0                    frames sent, the access point's last answers (-1 = none yet; 0 = accepted)
+ *   channel 6 wanted 6 rate 20 rx 812 tx-bytes 2410
+ */
+static int dswifistat_read_proc(char *page, char **start, off_t off, int count, int *eof, void *data)
+{
+	static const char *names[] = { "up", "associated", "associating", "cannot-associate", "authenticated", "tx-error", "scanning" };
+	u32 st, js;
+	int i, len;
+
+	if (off > 0) {
+		*eof = 1;
+		return 0;
+	}
+	dmac_inv_range((unsigned long)&arm7_stats[0], (unsigned long)&arm7_stats[WIFI_STATS_MAX]);
+	stats_query_complete = 0;
+	nds_fifo_send(FIFO_WIFI_CMD(FIFO_WIFI_CMD_STATS_QUERY, 0));
+	wait_event_interruptible_timeout(ndswifi_wait, stats_query_complete != 0, WIFI_ARM7_TIMEOUT);
+	dmac_inv_range((unsigned long)&arm7_stats[0], (unsigned long)&arm7_stats[WIFI_STATS_MAX]);
+	st = arm7_stats[WIFI_STATS_DEBUG5];
+	len = sprintf(page, "state 0x%04x", st);
+	for (i = 0; i < 7; i++)
+		if (st & (1 << i))
+			len += sprintf(page + len, " %s", names[i]);
+	js = arm7_stats[WIFI_STATS_JOIN_STATUS];
+	len += sprintf(page + len, "\nauth %u assoc %u status %d %d\nchannel %u wanted %u rate %u rx %u tx-bytes %u\n",
+		       arm7_stats[WIFI_STATS_AUTH_TRIES], arm7_stats[WIFI_STATS_ASSOC_TRIES],
+		       (js & 0xffff) == 0xffff ? -1 : (int)(js & 0xffff), (js >> 16) == 0xffff ? -1 : (int)(js >> 16),
+		       arm7_stats[WIFI_STATS_CHANNELS] & 0xff, (arm7_stats[WIFI_STATS_CHANNELS] >> 8) & 0xff,
+		       arm7_stats[WIFI_STATS_CHANNELS] >> 16, arm7_stats[WIFI_STATS_RXRAWPACKETS], arm7_stats[WIFI_STATS_TXBYTES]);
+	*eof = 1;
+	return len;
+}
+
 static int __init init_nds(void)
 {
 	u8 *p = NULL;
@@ -1289,6 +1325,7 @@ static int __init init_nds(void)
 	/* need to talk to the device, to set it up */
 	register_fifocb(&nds_cmd_fifocb);
 	create_proc_read_entry("dswifi", 0444, NULL, dswifi_read_proc, NULL);
+	create_proc_read_entry("dswifistat", 0444, NULL, dswifistat_read_proc, NULL);
 
 	/* Initialise stats buffer and send address to ARM7 */
 	for (i = 0; i < WIFI_STATS_MAX; i++)
diff --git a/linux-2.6.x/include/asm-arm/arch-nds/wifi.h b/linux-2.6.x/include/asm-arm/arch-nds/wifi.h
index 54aab48a0..cd1547540 100644
--- a/linux-2.6.x/include/asm-arm/arch-nds/wifi.h
+++ b/linux-2.6.x/include/asm-arm/arch-nds/wifi.h
@@ -51,6 +51,12 @@ enum WIFI_STATS {
 	WIFI_STATS_HW_1D8,
 	WIFI_STATS_HW_1DC,
 
+	/* joining a network (DSLinuxDSi): frames sent, the access point's last answers, channels */
+	WIFI_STATS_AUTH_TRIES,
