+/* what the window did, for the log (Save log puts /tmp/dsnet.log on the card) */
+static void dlog(const char *s)
+{
+	FILE *f = fopen("/tmp/dsnet.log", "a");
+
+	if (f) {
+		fprintf(f, "dsnet: %s\n", s);
+		fclose(f);
+	}
+}
+
+/*
+ * Wait until the console has joined the network (the ARM7 retries the authentication / association every second), at most 12 s.
+ * /proc/dswifistat: "state 0x.. names", "auth N assoc N status A B". Returns 1 when joined.
+ */
+static int join_wait(const char *ssid)
+{
+	char line[96], t[64];
+	unsigned st = 0, auth = 0, assoc = 0;
+	int sa = -1, sb = -1, s;
+
+	if (dryrun)
+		return 1;
+	for (s = 0; s < 12; s++) {
+		FILE *f = fopen("/proc/dswifistat", "r");
+
+		if (f) {
+			while (fgets(line, sizeof(line), f)) {
+				sscanf(line, "state 0x%x", &st);
+				sscanf(line, "auth %u assoc %u status %d %d", &auth, &assoc, &sa, &sb);
+			}
+			fclose(f);
+		}
+		if (st & 2)
+			return 1;
+		snprintf(t, sizeof(t), "Joining %s: tries %u/%u", ssid, auth, assoc);
+		say(t);
+		sleep(1);
+	}
+	snprintf(t, sizeof(t), "not joined: state 0x%x auth %u assoc %u status %d %d", st, auth, assoc, sa, sb);
+	dlog(t);
+	if (sa > 0)
+		snprintf(status, sizeof(status), "%s refused the login (%d)", ssid, sa);
+	else if (sb > 0)
+		snprintf(status, sizeof(status), "%s refused to join (%d)", ssid, sb);
+	else
+		snprintf(status, sizeof(status), "No answer from %s", ssid);
+	return 0;
+}
+
 static void connect_to(struct net *n, const char *key)
 {
 	char q[80], cmd[200], ip[24], k[44];
@@ -383,11 +436,9 @@ static void connect_to(struct net *n, const char *key)
 	wifi_on();
 	snprintf(cmd, sizeof(cmd), "Connecting to %s...", n->ssid);
 	say(cmd);
-	quote(q, sizeof(q), n->ssid);
+	dlog(cmd);
 	run("killall udhcpc 2>/dev/null");
-	snprintf(cmd, sizeof(cmd), "iwconfig nds essid %s > /dev/null 2>&1", q);
-	run(cmd);
-	k[0] = 0;
+	k[0] = 0;	/* the key first: choosing the network starts the login with the key mode set at that moment */
 	if (key && key[0]) {
 		int len = strlen(key);
 
@@ -399,10 +450,18 @@ static void connect_to(struct net *n, const char *key)
 		snprintf(cmd, sizeof(cmd), "iwconfig nds key off > /dev/null 2>&1");
 	}
 	run(cmd);
-	sleep(2);
+	quote(q, sizeof(q), n->ssid);
+	snprintf(cmd, sizeof(cmd), "iwconfig nds essid %s > /dev/null 2>&1", q);
+	run(cmd);
+	if (!join_wait(n->ssid)) {
+		draw_all();
