diff --git a/linux-2.6.x/arch/arm/mach-nds/arm7/wifi.c b/linux-2.6.x/arch/arm/mach-nds/arm7/wifi.c
index f2a3c8536..d069a4342 100644
--- a/linux-2.6.x/arch/arm/mach-nds/arm7/wifi.c
+++ b/linux-2.6.x/arch/arm/mach-nds/arm7/wifi.c
@@ -428,6 +428,29 @@ static void wifi_try_to_associate(void)
 	}
 }
 
+/*
+ * Called 60 times a second (ARM7 vblank). The original driver sent one authentication frame when the network was chosen and never again:
+ * if that frame or the answer was lost (or it went out while a scan still hopped channels), the console stayed unjoined for good.
+ * Now: while a network is chosen but not joined, the authentication (or, once authenticated, the association) is sent again every second.
+ */
+void wifi_join_tick(void)
+{
+	static int ticks;
+
+	if (!(wifi_data.state & WIFI_STATE_UP) || (wifi_data.state & (WIFI_STATE_ASSOCIATED | WIFI_STATE_CHANNEL_SCANNING)) ||
+	    !wifi_data.ssid[0] || !wifi_data.stats) {
+		ticks = 0;
+		return;
+	}
+	if (++ticks < 60)
+		return;
+	ticks = 0;
+	if (wifi_data.state & WIFI_STATE_AUTHENTICATED)
+		Wifi_SendAssocPacket();
+	else
+		wifi_try_to_associate();	/* finds the network again (channel), sends the authentication */
+}
+
 void Wifi_SetSSID(int off, char b1, char b2)
 {
 	wifi_data.ssid[(off * 2) + 1] = b1;
@@ -439,6 +462,10 @@ void Wifi_SetSSID(int off, char b1, char b2)
 		wifi_data.ssid[0] = off * 2 + 1;
 	if (!b1 || !b2) {
 		/* once we see the null terminator, we are done */
+		if (wifi_data.stats) {
+			wifi_data.stats[WIFI_STATS_AUTH_TRIES] = wifi_data.stats[WIFI_STATS_ASSOC_TRIES] = 0;
+			wifi_data.stats[WIFI_STATS_JOIN_STATUS] = 0xffffffff;
+		}
 		if (wifi_data.state & WIFI_STATE_UP) {
 			wifi_try_to_associate();
 		}
@@ -760,6 +787,7 @@ void wifi_stats_query(void)
 	wifi_data.stats[WIFI_STATS_DEBUG4] = WIFI_REG(0xB8);
 
 	wifi_data.stats[WIFI_STATS_DEBUG5] = wifi_data.state;
+	wifi_data.stats[WIFI_STATS_CHANNELS] = wifi_data.curChannel | (wifi_data.reqChannel << 8) | ((u32)wifi_data.maxrate << 16);
 
 	wifi_data.state &= ~WIFI_STATE_SAW_TX_ERR;
 
@@ -1152,6 +1180,7 @@ static int Wifi_ProcessReassocResponse(int macbase, int framelen)
 	}
 
 	status = fixed_params[1];
+	wifi_data.stats[WIFI_STATS_JOIN_STATUS] = (wifi_data.stats[WIFI_STATS_JOIN_STATUS] & 0xffff) | ((u32)status << 16);
 	if (status == 0) {	// status code, 0==success
 		WIFI_AIDS = fixed_params[2];
 		WIFI_REG(0x2A) = fixed_params[2];
@@ -1223,6 +1252,7 @@ static int Wifi_ProcessAuthenticationFrame(int macbase, int framelen)
 	auth_algorithm = fixed_params[0];
 	auth_sequence = fixed_params[1];
 	status = fixed_params[2];
+	wifi_data.stats[WIFI_STATS_JOIN_STATUS] = (wifi_data.stats[WIFI_STATS_JOIN_STATUS] & 0xffff0000) | status;
 	// open system
 	if (auth_algorithm == 0) {
 		// a good response
@@ -1749,6 +1779,7 @@ static void Wifi_SendAuthPacket(int wepmode)
 	((u16 *) data)[4] = 0x000A;	// 1Mbit
 	((u16 *) data)[5] = i + 6 - 12 + 4;	// length
 
+	wifi_data.stats[WIFI_STATS_AUTH_TRIES]++;
 	wifi_send_raw(i + 6, data);
 }
 
@@ -1788,6 +1819,7 @@ static void Wifi_SendAssocPacket(void)
 	u8 data[96];
 	int i, j, numrates;
 
+	wifi_data.stats[WIFI_STATS_ASSOC_TRIES]++;
 	i = Wifi_GenMgtHeader(data, 0x0000);
 
 	if (wifi_data.curWepmode) {
