From f3513b3dd320d1e505d286ab8726c973a9d5feae Mon Sep 17 00:00:00 2001
From: TeamHarrisCali <noreply@example.invalid>
Date: Tue, 10 Nov 2026 20:26:06 -0600
Subject: [PATCH] nds ARM7: DSi-mode touchscreen via the codec registers
 (derived from BlocksDS libnds, zlib)

When the ARM7 is in DSi mode (SCFG_EXT bit 31) the DS-style SPI touch protocol gets no answer; read the pen and
position through the TSC2117 codec interface instead. DS mode is unchanged.
---
 linux-2.6.x/arch/arm/mach-nds/Makefile        |   3 +-
 linux-2.6.x/arch/arm/mach-nds/arm7/dsitouch.c | 199 ++++++++++++++++++
 linux-2.6.x/arch/arm/mach-nds/arm7/dsitouch.h |  12 ++
 linux-2.6.x/arch/arm/mach-nds/arm7/main.c     |  19 +-
 4 files changed, 229 insertions(+), 4 deletions(-)
 create mode 100644 linux-2.6.x/arch/arm/mach-nds/arm7/dsitouch.c
 create mode 100644 linux-2.6.x/arch/arm/mach-nds/arm7/dsitouch.h

diff --git a/linux-2.6.x/arch/arm/mach-nds/Makefile b/linux-2.6.x/arch/arm/mach-nds/Makefile
index c08595ad7..61ae158a9 100644
--- a/linux-2.6.x/arch/arm/mach-nds/Makefile
+++ b/linux-2.6.x/arch/arm/mach-nds/Makefile
@@ -24,6 +24,7 @@ extra-y += arm7/microphone.o
 extra-y += arm7/wifi.o
 extra-y += arm7/divide.o
 extra-y += arm7/sdmmc.o
+extra-y += arm7/dsitouch.o
 extra-y += arm7.bin
 
 # this does not seem to have any effect (why?):
@@ -35,7 +36,7 @@ $(obj)/arm7.bin: $(obj)/arm7.elf
 	$(OBJCOPY) -O binary $(obj)/arm7.elf $(obj)/arm7.bin
 	rm -f $(obj)/head.o
 
-arm7obj = $(obj)/arm7/head.o $(obj)/arm7/main.o $(obj)/arm7/time.o $(obj)/arm7/spi.o $(obj)/arm7/sound.o $(obj)/arm7/microphone.o $(obj)/arm7/wifi.o $(obj)/arm7/divide.o $(obj)/arm7/sdmmc.o
+arm7obj = $(obj)/arm7/head.o $(obj)/arm7/main.o $(obj)/arm7/time.o $(obj)/arm7/spi.o $(obj)/arm7/sound.o $(obj)/arm7/microphone.o $(obj)/arm7/wifi.o $(obj)/arm7/divide.o $(obj)/arm7/sdmmc.o $(obj)/arm7/dsitouch.o
 
 $(obj)/arm7.elf: $(arm7obj) $(src)/arm7/arm7.lds
 	$(LD) -nostartfiles -nostdlib -o $(obj)/arm7.elf $(arm7obj) -T $(src)/arm7/arm7.lds
diff --git a/linux-2.6.x/arch/arm/mach-nds/arm7/dsitouch.c b/linux-2.6.x/arch/arm/mach-nds/arm7/dsitouch.c
new file mode 100644
index 000000000..5bca74233
--- /dev/null
+++ b/linux-2.6.x/arch/arm/mach-nds/arm7/dsitouch.c
@@ -0,0 +1,199 @@
+/*
+ * DSi-mode touchscreen reader for the DSLinux ARM7.
+ *
+ * In DSi mode the touch/sound chip (TSC2117, "codec") is switched out of its DS compatible
+ * mode, so the DS style SPI touch commands in spi.c get no answer. This reads the touch
+ * panel through the codec's register interface instead.
+ *
+ * Derived from BlocksDS libnds (source/arm7/codec.twl.c, touch.c, touchFilter.c), which is
+ * Copyright (C) 2017 fincs, 2024 Adrian "asie" Siekierka and the BlocksDS project, zlib
+ * licence:
+ *
+ *   This software is provided 'as-is', without any express or implied warranty. In no event
+ *   will the authors be held liable for any damages arising from the use of this software.
+ *   Permission is granted to anyone to use this software for any purpose, including
+ *   commercial applications, and to alter it and redistribute it freely, subject to the
+ *   following restrictions: 1. The origin of this software must not be misrepresented; you
+ *   must not claim that you wrote the original software. 2. Altered source versions must be
+ *   plainly marked as such, and must not be misrepresented as being the original software.
+ *   3. This notice may not be removed or altered from any source distribution.
+ *
+ * This version is altered: ported to the DSLinux ARM7 (no libnds), polling with bounded
+ * waits, and a simple median-style filter instead of libnds's.
+ */
+#define __DSLINUX_ARM7__
+
+#include "linux/config.h"
+#include "asm/types.h"
+
+#include "dsitouch.h"
+
+#define REG_SPI_CR	(*(volatile u16 *)0x040001C0)
+#define REG_SPI_DATA	(*(volatile u16 *)0x040001C2)
+#define SCFG_EXT7	(*(volatile u32 *)0x04004008)
+
+#define SPI_BUSY	(1 << 7)
+#define SPI_TOUCH	(2 << 8)	/* device 2: touch / codec, baud 4 MHz (0) */
+#define SPI_CONTINUOUS	(1 << 11)
+#define SPI_ENABLE	(1 << 15)
+
+/* codec banks and touch registers (libnds nds/arm7/codec.h) */
+#define CDC_TOUCHCNT	0x03
+#define CDC_TOUCHDATA	0xFC
+#define R_SAR_ADC_CTRL1	0x02
+#define R_SAR_ADC_CTRL2	0x03
+#define R_PRECHARGE	0x04
+#define R_PANEL_STAB	0x05
+#define R_STATUS	0x09
+#define R_PEN_DOWN	0x0E
+#define R_SCAN_TIMER	0x0F
+#define R_DEBOUNCE_UP	0x12
+
+static int active;
+static u8 cur_bank = 0x63;
+
+static void wait_busy(void)
+{
+	u32 cap = 0;
+
+	while ((REG_SPI_CR & SPI_BUSY) && ++cap < 200000)
+		;
+}
+
+static u8 xchg(u8 v)
+{
+	REG_SPI_DATA = v;
+	wait_busy();
+	return REG_SPI_DATA & 0xFF;
+}
+
+static u8 tsc_read(u8 reg)
+{
+	wait_busy();
+	REG_SPI_CR = SPI_ENABLE | SPI_TOUCH | SPI_CONTINUOUS;
+	xchg(1 | (reg << 1));
+	REG_SPI_CR = SPI_ENABLE | SPI_TOUCH;
+	return xchg(0);
+}
+
+static void tsc_write(u8 reg, u8 value)
+{
+	wait_busy();
+	REG_SPI_CR = SPI_ENABLE | SPI_TOUCH | SPI_CONTINUOUS;
+	xchg(reg << 1);
+	REG_SPI_CR = SPI_ENABLE | SPI_TOUCH;
+	xchg(value);
+}
+
+static void bank_switch(u8 bank)
+{
+	if (bank != cur_bank) {
+		tsc_write(cur_bank == 0xFF ? 0x7F : 0x00, bank);
+		cur_bank = bank;
+	}
+}
+
+static u8 cdc_read(u8 bank, u8 reg)
+{
+	bank_switch(bank);
+	return tsc_read(reg);
+}
+
+static void cdc_write(u8 bank, u8 reg, u8 value)
+{
+	bank_switch(bank);
+	tsc_write(reg, value);
+}
+
+static void cdc_write_mask(u8 bank, u8 reg, u8 mask, u8 value)
+{
+	bank_switch(bank);
+	tsc_write(reg, (tsc_read(reg) & ~mask) | (value & mask));
+}
+
+static void cdc_read_array(u8 bank, u8 reg, u8 *out, u8 size)
+{
+	bank_switch(bank);
+	wait_busy();
+	REG_SPI_CR = SPI_ENABLE | SPI_TOUCH | SPI_CONTINUOUS;
+	xchg(1 | (reg << 1));
+	for (; size > 1; size--)
+		*out++ = xchg(0);
+	REG_SPI_CR = SPI_ENABLE | SPI_TOUCH;
+	*out++ = xchg(0);
+}
+
+int dsitouch_init(void)
+{
+	/* DSi mode = the ARM7 may access SCFG_EXT (bit 31). In DS mode it reads 0. */
+	if (!(SCFG_EXT7 & 0x80000000u))
+		return 0;
+
+	/* cdcTouchInit() from libnds */
+	cdc_write_mask(CDC_TOUCHCNT, R_PEN_DOWN, 0x80, 0);
+	cdc_write_mask(CDC_TOUCHCNT, R_SAR_ADC_CTRL1, 3 << 3, 3 << 3);	/* ADC clock /8 */
+	cdc_write(CDC_TOUCHCNT, R_SCAN_TIMER, 0xA0);
+	cdc_write_mask(CDC_TOUCHCNT, R_PEN_DOWN, 0x38, 5 << 3);
+	cdc_write_mask(CDC_TOUCHCNT, R_PEN_DOWN, 0x40, 0 << 6);
+	/* self conversion | scan X,Y,Z | IRQ mode 3 */
+	cdc_write(CDC_TOUCHCNT, R_SAR_ADC_CTRL2, (1 << 7) | (2 << 2) | 3);
+	cdc_write_mask(CDC_TOUCHCNT, R_PANEL_STAB, 7, 4);		/* 30 us */
+	cdc_write_mask(CDC_TOUCHCNT, R_PRECHARGE, 7, 6);		/* sense 300 us */
+	cdc_write_mask(CDC_TOUCHCNT, R_PRECHARGE, 7 << 4, 4 << 4);	/* precharge 30 us */
+	cdc_write_mask(CDC_TOUCHCNT, R_DEBOUNCE_UP, 7, 0);
+	cdc_write_mask(CDC_TOUCHCNT, R_PEN_DOWN, 0x80, 0x80);
+
+	active = 1;
+	return 1;
+}
+
+int dsitouch_active(void)
+{
+	return active;
+}
+
+int dsitouch_pen_down(void)
+{
+	return (cdc_read(CDC_TOUCHCNT, R_STATUS) & 0xC0) != 0x40
+	    && !(cdc_read(CDC_TOUCHCNT, R_PEN_DOWN) & 0x02);
+}
+
+/* sort five values and average the middle three (drops one low and one high outlier) */
+static u16 filter5(u16 *v, int *noisy)
+{
+	int i, j;
+
+	for (i = 1; i < 5; i++) {
+		u16 t = v[i];
+
+		for (j = i - 1; j >= 0 && v[j] > t; j--)
+			v[j + 1] = v[j];
+		v[j + 1] = t;
+	}
+	*noisy = (int)v[3] - (int)v[1];
+	return (u16)(((u32)v[1] + v[2] + v[3]) / 3);
+}
+
+/* Raw 12 bit X/Y like the DS path. Returns 1 on a valid, steady sample, else 0. */
+int dsitouch_read_xy(s16 *rawx, s16 *rawy)
+{
+	u8 buf[40];
+	u16 xs[5], ys[5];
+	int i, nx, ny;
+
+	cdc_read_array(CDC_TOUCHDATA, 0x01, buf, 40);
+	/* 20 big-endian halfwords: 5 X, 5 Y, 5 Z1, 5 Z2; the top 4 bits must be 0 */
+	for (i = 0; i < 10; i++) {
+		if ((buf[i * 2] & 0xF0))
+			return 0;
+	}
+	for (i = 0; i < 5; i++) {
+		xs[i] = (buf[i * 2] << 8) | buf[i * 2 + 1];
+		ys[i] = (buf[10 + i * 2] << 8) | buf[10 + i * 2 + 1];
+	}
+	*rawx = (s16)filter5(xs, &nx);
+	*rawy = (s16)filter5(ys, &ny);
+	if (*rawx == 0 || nx > 60 || ny > 60)
+		return 0;
+	return 1;
+}
diff --git a/linux-2.6.x/arch/arm/mach-nds/arm7/dsitouch.h b/linux-2.6.x/arch/arm/mach-nds/arm7/dsitouch.h
new file mode 100644
index 000000000..2a8cc47ce
--- /dev/null
+++ b/linux-2.6.x/arch/arm/mach-nds/arm7/dsitouch.h
@@ -0,0 +1,12 @@
+#ifndef _mach_nds_arm7_dsitouch_h_
+#define _mach_nds_arm7_dsitouch_h_
+
+/* Returns 1 and enables the DSi-mode (codec) touch reader if the ARM7 is in DSi mode, else 0. */
+int dsitouch_init(void);
+int dsitouch_active(void);
+/* Pen currently on the panel? (DSi mode only) */
+int dsitouch_pen_down(void);
+/* Raw 12 bit position like the DS path; 1 = valid sample. (DSi mode only) */
+int dsitouch_read_xy(s16 *rawx, s16 *rawy);
+
+#endif
diff --git a/linux-2.6.x/arch/arm/mach-nds/arm7/main.c b/linux-2.6.x/arch/arm/mach-nds/arm7/main.c
index 8c1da5a62..923e93b8f 100644
--- a/linux-2.6.x/arch/arm/mach-nds/arm7/main.c
+++ b/linux-2.6.x/arch/arm/mach-nds/arm7/main.c
@@ -15,6 +15,7 @@
 #include "spi.h"
 #include "wifi.h"
 #include "sdmmc.h"
+#include "dsitouch.h"
 #include "time.h"
 
 static s32 xscale, yscale;
@@ -285,7 +286,13 @@ static void sendTouchState(u16 buttons)
 	s16 x, y, px, py;
 	static u8 lastx = 0, lasty = 0;
 
-	if (buttons & TOUCH_RELEASED) {
+	int dsi = dsitouch_active();
+	int released;
+
+	/* DSi mode: the touch chip is in its DSi register mode; ask it instead of the DS pen bit */
+	released = dsi ? !dsitouch_pen_down() : (buttons & TOUCH_RELEASED);
+
+	if (released) {
 		if (lasty != 255)
 			nds_fifo_send(FIFO_TOUCH);
 		lastx = 255;
@@ -294,8 +301,13 @@ static void sendTouchState(u16 buttons)
 		/* Some dude is smacking his fingerprint on the touchscreen. */
                 
 		/* Code from devkitpro/libnds/source/arm7/touch.c */
+		if (dsi) {
+			if (!dsitouch_read_xy(&x, &y))
+				return;
+		} else {
                 x = touch_read_value(TSC_MEASURE_X, _MaxRetry, _MaxRange);
                 y = touch_read_value(TSC_MEASURE_Y, _MaxRetry, _MaxRange);
+		}
 
                 px = ( x * xscale - xoffset + xscale/2 ) >>19;
                 py = ( y * yscale - yoffset + yscale/2 ) >>19;
@@ -400,8 +412,9 @@ int main(void)
 	xoffset = ((PersonalData->calX1 + PersonalData->calX2) * xscale  - ((PersonalData->calX1px + PersonalData->calX2px) << 19) ) / 2;
 	yoffset = ((PersonalData->calY1 + PersonalData->calY2) * yscale  - ((PersonalData->calY1px + PersonalData->calY2px) << 19) ) / 2;
 
-	/* Dummy read to enable the touchpad PENIRQ */
-	touch_read_value(TSC_MEASURE_X, _MaxRetry, _MaxRange);
+	/* DSi mode: set up the codec touch reader; otherwise do the DS dummy read that enables the touchpad PENIRQ */
+	if (!dsitouch_init())
+		touch_read_value(TSC_MEASURE_X, _MaxRetry, _MaxRange);
 
 	/* Enable VBLANK Interrupt */
 	DISP_SR = DISP_VBLANK_IRQ;
-- 
