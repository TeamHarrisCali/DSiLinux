From b47dd1458603a0a644987e703e1a7d4510c8f80c Mon Sep 17 00:00:00 2001
From: TeamHarrisCali <34009957+TeamHarrisCali@users.noreply.github.com>
Date: Wed, 11 Nov 2026 06:03:40 -0600
Subject: [PATCH] Hardware 3D, step 1: kernel NDSFB_GX_SETUP/SUBMIT (command
 words to the geometry engine, 3D layer behind the bitmap layers) and dsgx,
 the gears on the DS 3D engine (+ a triangle test); /boot/gl hw and /boot/gl
 tri

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 linux-2.6.x/drivers/video/ndsfb.c |  76 ++++++
 user/TinySDGL/Makefile            |   1 +
 user/TinySDGL/examples/Makefile   |   5 +-
 user/TinySDGL/examples/dsgx.c     | 420 ++++++++++++++++++++++++++++++
 vendors/Nintendo/DSI/Makefile     |   1 +
 vendors/Nintendo/DSI/gl           |   6 +-
 6 files changed, 507 insertions(+), 2 deletions(-)
 create mode 100644 user/TinySDGL/examples/dsgx.c

diff --git a/linux-2.6.x/drivers/video/ndsfb.c b/linux-2.6.x/drivers/video/ndsfb.c
index e3cdc283f..eff73376b 100644
--- a/linux-2.6.x/drivers/video/ndsfb.c
+++ b/linux-2.6.x/drivers/video/ndsfb.c
@@ -242,6 +242,8 @@ static int ndsfb_blank(int blank_mode, struct fb_info *info);
 #define NDSFB_FLIP_ASYNC	0x4e02
 #define NDSFB_FLIP_WAIT	0x4e03
 #define NDSFB_CURSOR	0x4e04
+#define NDSFB_GX_SETUP	0x4e05
+#define NDSFB_GX_SUBMIT	0x4e06
 static DECLARE_WAIT_QUEUE_HEAD(ndsfb_flip_wq);
 static volatile int ndsfb_flip_pending;
 static int ndsfb_flip_y;
@@ -301,6 +303,69 @@ struct ndsfb_cursor {
 	unsigned short tiles[64];	/* 16x16 pixels as four 8x8 tiles of 4 bit pixels, 1D order */
 };
 
+/*
+ * Hardware 3D (the DS geometry and rendering engines, drawing on BG0 of the main screen, below the bitmap layers:
+ * wherever the frame buffer has a transparent pixel (bit 15 clear in 16 bit, index 0 in 8 bit) the 3D picture shows
+ * through). The engines' registers are kernel-only (MPU), so programs hand over command words:
+ *   NDSFB_GX_SETUP  arg 1: power the 3D engines, put BG0 behind BG2/BG3 and switch it to 3D; arg 0: off
+ *   NDSFB_GX_SUBMIT struct ndsfb_gx_submit: count pairs (register offset, value), written in order to the
+ *                   engines' command registers (a command with several parameters is several pairs with the
+ *                   same offset). Only offsets 0x400-0x5ff (command ports), 0x060, 0x350, 0x354 are accepted.
+ * The geometry FIFO stalls the CPU when it is full, which is how a program is paced.
+ */
+struct ndsfb_gx_submit {
+	unsigned long words;		/* user pointer to count * 2 unsigned ints */
+	unsigned int count;
+};
+static int ndsfb_gx_on;
+
+static void ndsfb_gx_setup(int on)
+{
+	if (on) {
+		POWER_CR |= POWER_MATRIX | POWER_3D_CORE;
+		*(volatile u32 *)0x04000060 = 0;		/* DISP3DCNT: plain */
+		*(volatile u32 *)0x04000350 = 0;		/* rear plane: transparent black */
+		*(volatile u32 *)0x04000354 = 0x7fff;		/* rear plane depth: far */
+		BG0_CR = 3;					/* lowest priority: bitmaps cover it */
+		ndsfb_gx_on = 1;
+		DISPLAY_CR |= (1 << 3) | (1 << 8);		/* BG0 is 3D, BG0 on */
+	} else {
+		DISPLAY_CR &= ~((1 << 3) | (1 << 8));
+		ndsfb_gx_on = 0;
+		POWER_CR &= ~(POWER_MATRIX | POWER_3D_CORE);
+	}
+}
+
+static int gx_reg_ok(unsigned int off)
+{
+	return (off >= 0x400 && off < 0x600) || off == 0x060 || off == 0x350 || off == 0x354;
+}
+
+static int ndsfb_gx_submit(struct ndsfb_gx_submit __user *arg)
+{
+	struct ndsfb_gx_submit s;
+	unsigned int buf[256], done = 0, i, n;
+
+	if (!ndsfb_gx_on)
+		return -EINVAL;
+	if (copy_from_user(&s, arg, sizeof(s)))
+		return -EFAULT;
+	while (done < s.count) {
+		n = s.count - done;
+		if (n > 128)
+			n = 128;
+		if (copy_from_user(buf, (void __user *)(s.words + done * 8), n * 8))
+			return -EFAULT;
+		for (i = 0; i < n; i++) {
+			if (!gx_reg_ok(buf[2 * i]))
+				return -EINVAL;
+			*(volatile u32 *)(0x04000000 + buf[2 * i]) = buf[2 * i + 1];
+		}
+		done += n;
+	}
+	return 0;
+}
+
 #define OBJ_PALETTE	((volatile u16 *)0x05000200)
 #define OAM		((volatile u16 *)0x07000000)
 #define OBJ_TILES	((volatile u16 *)0x06400000)
@@ -537,6 +602,8 @@ static int ndsfb_set_par(struct fb_info *info)
 		}
 		if (ndsfb_cursor_ready)
 			DISPLAY_CR |= (1 << 12) | (1 << 4);
+		if (ndsfb_gx_on)
+			DISPLAY_CR |= (1 << 3) | (1 << 8);
 		writeb(VRAM_ENABLE | VRAM_A_MAIN_BG_0x6000000, VRAM_A_CR);
 		if (info->var.xres_virtual == 512)
 			if (info->fix.visual == FB_VISUAL_TRUECOLOR)
@@ -637,6 +704,15 @@ static int ndsfb_ioctl(struct inode *inode, struct file *file,
 			if (info->par != 0)
 				return -EINVAL;
 			return ndsfb_cursor_ioctl((struct ndsfb_cursor __user *)argp);
+		case NDSFB_GX_SETUP:
+			if (info->par != 0)
+				return -EINVAL;
+			ndsfb_gx_setup(arg != 0);
+			return 0;
+		case NDSFB_GX_SUBMIT:
+			if (info->par != 0)
+				return -EINVAL;
+			return ndsfb_gx_submit((struct ndsfb_gx_submit __user *)argp);
 		case FBIOGET_VBLANK:
 			{
 				struct fb_vblank vblank;
