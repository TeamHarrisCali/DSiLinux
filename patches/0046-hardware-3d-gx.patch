diff --git a/user/TinySDGL/examples/dsgx.c b/user/TinySDGL/examples/dsgx.c
new file mode 100644
index 000000000..caa640a49
--- /dev/null
+++ b/user/TinySDGL/examples/dsgx.c
@@ -0,0 +1,420 @@
+/*
+ * dsgx - the gears demo on the Nintendo DS's hardware 3D engine (no TinyGL, no SDL).
+ *
+ *   dsgx          the three lit gears, 3 seconds of numbers on exit
+ *   dsgx tri      one colour triangle: the smallest test of the pipeline
+ *
+ * Runs on the text screen (stop the desktop first). The kernel (drivers/video/ndsfb.c) lets a program write
+ * command words to the geometry engine; the engine transforms, lights, clips and fills, and draws on BG0 behind the
+ * frame buffer's bitmap layers, so the frame buffer is cleared to transparent pixels (0). Esc or q quits.
+ *
+ * Number formats of the engine: matrices 1.19.12 (4096 = 1.0), vertex 16 bit 1.3.12, normals and light
+ * directions 1.0.9 packed 3 x 10 bits, colours RGB555.
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <math.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <termios.h>
+#include <sys/ioctl.h>
+#include <sys/mman.h>
+#include <sys/time.h>
+#include <linux/fb.h>
+#include <linux/kd.h>
+
+#define NDSFB_GX_SETUP	0x4e05
+#define NDSFB_GX_SUBMIT	0x4e06
+
+#ifndef M_PI
+#define M_PI 3.14159265
+#endif
+
+/* command ports (offset from 0x04000000) */
+#define GX_CONTROL	0x060
+#define GX_CLEARCOLOR	0x350
+#define GX_CLEARDEPTH	0x354
+#define MTX_MODE	0x440
+#define MTX_PUSH	0x444
+#define MTX_POP		0x448
+#define MTX_IDENTITY	0x454
+#define MTX_MULT_4X4	0x460
+#define MTX_MULT_3X3	0x468
+#define MTX_TRANS	0x470
+#define GX_COLOR	0x480
+#define GX_NORMAL	0x484
+#define GX_VTX16	0x48C
+#define GX_POLYATTR	0x4A4
+#define GX_DIFAMB	0x4C0
+#define GX_SPEEMI	0x4C4
+#define GX_LIGHTVEC	0x4C8
+#define GX_LIGHTCOL	0x4CC
+#define GX_BEGIN	0x500
+#define GX_END		0x504
+#define GX_SWAP		0x540
+#define GX_VIEWPORT	0x580
+
+struct gx_submit {
+	unsigned long words;
+	unsigned int count;
+};
+
+static int fb = -1;
+static unsigned int cmd[2 * 4096];
+static int ncmd;
+
+static void flush_cmds(void)
+{
+	struct gx_submit s;
+
+	if (!ncmd)
+		return;
+	s.words = (unsigned long)cmd;
+	s.count = ncmd;
+	if (ioctl(fb, NDSFB_GX_SUBMIT, &s) < 0)
+		perror("dsgx: NDSFB_GX_SUBMIT");
+	ncmd = 0;
+}
+
+static void W(unsigned int reg, unsigned int val)
+{
+	if (ncmd >= 4096)
+		flush_cmds();
+	cmd[2 * ncmd] = reg;
+	cmd[2 * ncmd + 1] = val;
+	ncmd++;
+}
+
+static int f12(double x)
+{
+	return (int)(x * 4096.0 + (x < 0 ? -0.5 : 0.5));
+}
+
+static unsigned int pack_dir(double x, double y, double z)
+{
+	double l = sqrt(x * x + y * y + z * z);
+	int a, b, c;
+
+	if (l > 0) {
+		x /= l; y /= l; z /= l;
+	}
+	a = (int)(x * 511.0 + (x < 0 ? -0.5 : 0.5));
+	b = (int)(y * 511.0 + (y < 0 ? -0.5 : 0.5));
+	c = (int)(z * 511.0 + (z < 0 ? -0.5 : 0.5));
+	return (a & 0x3ff) | ((b & 0x3ff) << 10) | ((c & 0x3ff) << 20);
+}
+
+#define RGB15(r, g, b)	((r) | ((g) << 5) | ((b) << 10))
+
+/* ---- gear geometry, recorded once (the same shapes as gears.c) ---- */
+#define MAXV 1200
+struct vtx {
+	unsigned int xy, z;		/* VTX_16 parameters */
+	unsigned int normal;		/* NORMAL parameter in effect for this vertex */
+	unsigned int newnormal;		/* 1 when it differs from the previous vertex's */
+};
+struct strip {
+	int type, first, count;
+};
+struct gearmesh {
+	struct vtx v[MAXV];
+	struct strip s[8];
+	int nv, ns;
+	unsigned int color;		/* diffuse colour */
+};
+
+static struct gearmesh *rec;
+static unsigned int cur_normal;
+static int last_emitted_normal_idx;
+
+static void rec_normal(double x, double y, double z)
+{
+	cur_normal = pack_dir(x, y, z);
+}
+
+static void rec_begin(int type)
+{
+	rec->s[rec->ns].type = type;
+	rec->s[rec->ns].first = rec->nv;
+	rec->s[rec->ns].count = 0;
+}
+
+static void rec_vertex(double x, double y, double z)
+{
+	struct vtx *v = &rec->v[rec->nv++];
+
+	v->xy = (f12(x) & 0xffff) | ((unsigned int)(f12(y) & 0xffff) << 16);
+	v->z = f12(z) & 0xffff;
+	v->normal = cur_normal;
+	rec->s[rec->ns].count++;
+}
+
+static void rec_end(void)
+{
+	rec->ns++;
+}
+
+static void gear(struct gearmesh *m, double inner_radius, double outer_radius, double width, int teeth,
+		 double tooth_depth)
+{
+	int i;
+	double r0, r1, r2, angle, da, u, v, len;
+
+	rec = m;
+	m->nv = 0;
+	m->ns = 0;
+	r0 = inner_radius;
+	r1 = outer_radius - tooth_depth / 2.0;
+	r2 = outer_radius + tooth_depth / 2.0;
+	da = 2.0 * M_PI / teeth / 4.0;
+
+	rec_normal(0.0, 0.0, 1.0);
+	rec_begin(3);			/* quad strip: front face */
+	for (i = 0; i <= teeth; i++) {
+		angle = i * 2.0 * M_PI / teeth;
+		rec_vertex(r0 * cos(angle), r0 * sin(angle), width * 0.5);
+		rec_vertex(r1 * cos(angle), r1 * sin(angle), width * 0.5);
+		rec_vertex(r0 * cos(angle), r0 * sin(angle), width * 0.5);
+		rec_vertex(r1 * cos(angle + 3 * da), r1 * sin(angle + 3 * da), width * 0.5);
+	}
+	rec_end();
+
+	rec_begin(3);			/* outward faces of teeth */
+	for (i = 0; i < teeth; i++) {
+		angle = i * 2.0 * M_PI / teeth;
+
+		rec_vertex(r1 * cos(angle), r1 * sin(angle), width * 0.5);
+		rec_vertex(r1 * cos(angle), r1 * sin(angle), -width * 0.5);
+		u = r2 * cos(angle + da) - r1 * cos(angle);
+		v = r2 * sin(angle + da) - r1 * sin(angle);
+		len = sqrt(u * u + v * v);
+		u /= len;
+		v /= len;
+		rec_normal(v, -u, 0.0);
+		rec_vertex(r2 * cos(angle + da), r2 * sin(angle + da), width * 0.5);
+		rec_vertex(r2 * cos(angle + da), r2 * sin(angle + da), -width * 0.5);
+		rec_normal(cos(angle), sin(angle), 0.0);
+		rec_vertex(r2 * cos(angle + 2 * da), r2 * sin(angle + 2 * da), width * 0.5);
+		rec_vertex(r2 * cos(angle + 2 * da), r2 * sin(angle + 2 * da), -width * 0.5);
+		u = r1 * cos(angle + 3 * da) - r2 * cos(angle + 2 * da);
+		v = r1 * sin(angle + 3 * da) - r2 * sin(angle + 2 * da);
+		rec_normal(v, -u, 0.0);
+		rec_vertex(r1 * cos(angle + 3 * da), r1 * sin(angle + 3 * da), width * 0.5);
+		rec_vertex(r1 * cos(angle + 3 * da), r1 * sin(angle + 3 * da), -width * 0.5);
+		rec_normal(cos(angle), sin(angle), 0.0);
+	}
+	rec_vertex(r1 * cos(0), r1 * sin(0), width * 0.5);
+	rec_vertex(r1 * cos(0), r1 * sin(0), -width * 0.5);
+	rec_end();
+
+	rec_begin(3);			/* inside radius cylinder */
+	for (i = 0; i <= teeth; i++) {
+		angle = i * 2.0 * M_PI / teeth;
+		rec_normal(-cos(angle), -sin(angle), 0.0);
+		rec_vertex(r0 * cos(angle), r0 * sin(angle), -width * 0.5);
+		rec_vertex(r0 * cos(angle), r0 * sin(angle), width * 0.5);
+	}
+	rec_end();
+}
+
+static void draw_mesh(const struct gearmesh *m)
+{
+	int i, j;
+
+	W(GX_DIFAMB, m->color | (1 << 15) | (RGB15(6, 6, 6) << 16));
+	W(GX_SPEEMI, 0);
+	for (i = 0; i < m->ns; i++) {
+		unsigned int last = 0xffffffff;
+
+		W(GX_BEGIN, m->s[i].type);
+		for (j = m->s[i].first; j < m->s[i].first + m->s[i].count; j++) {
+			if (m->v[j].normal != last) {
+				W(GX_NORMAL, m->v[j].normal);
+				last = m->v[j].normal;
+			}
+			W(GX_VTX16, m->v[j].xy);
+			W(GX_VTX16, m->v[j].z);
+		}
+		W(GX_END, 0);
+	}
+}
+
+/* column-major rotation about an axis (1 = x, 2 = y, 3 = z), degrees */
+static void rotate(int axis, double deg)
+{
+	double c = cos(deg * M_PI / 180.0), s = sin(deg * M_PI / 180.0);
+	int m[9] = { 4096, 0, 0, 0, 4096, 0, 0, 0, 4096 };
+	int i;
+
+	switch (axis) {
+	case 1: m[4] = f12(c); m[5] = f12(s); m[7] = f12(-s); m[8] = f12(c); break;
+	case 2: m[0] = f12(c); m[2] = f12(-s); m[6] = f12(s); m[8] = f12(c); break;
+	default: m[0] = f12(c); m[1] = f12(s); m[3] = f12(-s); m[4] = f12(c); break;
+	}
+	for (i = 0; i < 9; i++)
+		W(MTX_MULT_3X3, m[i]);
+}
+
+static void translate(double x, double y, double z)
+{
+	W(MTX_TRANS, f12(x));
+	W(MTX_TRANS, f12(y));
+	W(MTX_TRANS, f12(z));
+}
+
+static void frustum(double l, double r, double b, double t, double n, double f)
+{
+	double m[16] = {
+		2 * n / (r - l), 0, 0, 0,
+		0, 2 * n / (t - b), 0, 0,
+		(r + l) / (r - l), (t + b) / (t - b), -(f + n) / (f - n), -1,
+		0, 0, -2 * f * n / (f - n), 0
+	};
+	int i;
+
+	for (i = 0; i < 16; i++)
+		W(MTX_MULT_4X4, f12(m[i]));
+}
+
+static long usec(void)
+{
+	struct timeval tv;
+
+	gettimeofday(&tv, NULL);
+	return tv.tv_sec * 1000000L + tv.tv_usec;
+}
+
+int main(int argc, char **argv)
+{
+	struct fb_fix_screeninfo fix;
+	struct fb_var_screeninfo var;
+	struct termios old, raw;
+	unsigned char *mem;
+	static struct gearmesh g[3];
+	int tty, i, running = 1, tri = (argc > 1 && !strcmp(argv[1], "tri"));
+	long frames = 0, t0, t1;
+	double angle = 0.0, view_rotx = 20.0, view_roty = 30.0;
+
+	fb = open("/dev/fb0", O_RDWR);
+	if (fb < 0) {
+		perror("dsgx: /dev/fb0");
+		return 1;
+	}
+	ioctl(fb, FBIOGET_FSCREENINFO, &fix);
+	ioctl(fb, FBIOGET_VSCREENINFO, &var);
+	mem = mmap(NULL, fix.smem_len, PROT_READ | PROT_WRITE, MAP_SHARED, fb, 0);
+	tty = open("/dev/tty0", O_RDWR);
+	if (tty >= 0)
+		ioctl(tty, KDSETMODE, KD_GRAPHICS);	/* the console stops drawing */
+	/* the frame buffer must not hide the 3D picture: transparent pixels everywhere (pixel 0) */
+	if (mem != MAP_FAILED) {
+		volatile unsigned long *p = (volatile unsigned long *)mem;
+		unsigned long n = (var.xres_virtual * var.yres_virtual * (var.bits_per_pixel / 8)) / 4;
+
+		for (i = 0; (unsigned long)i < n && i < 256 * 192 / 2; i++)
+			p[i] = 0;
+	}
+	if (ioctl(fb, NDSFB_GX_SETUP, 1) < 0) {
+		perror("dsgx: NDSFB_GX_SETUP (is this kernel new enough?)");
+		return 1;
+	}
+
+	tcgetattr(0, &old);
+	raw = old;
+	raw.c_lflag &= ~(ICANON | ECHO);
+	raw.c_cc[VMIN] = 0;
+	raw.c_cc[VTIME] = 0;
+	tcsetattr(0, TCSANOW, &raw);
+
+	if (!tri) {
+		gear(&g[0], 1.0, 4.0, 1.0, 20, 0.7);
+		gear(&g[1], 0.5, 2.0, 2.0, 10, 0.7);
+		gear(&g[2], 1.3, 2.0, 0.5, 10, 0.7);
+		g[0].color = RGB15(25, 3, 0);
+		g[1].color = RGB15(0, 25, 6);
+		g[2].color = RGB15(6, 6, 31);
+	}
+
+	/* one time set-up: clear values, viewport, projection */
+	W(GX_CONTROL, 0);
+	W(GX_CLEARCOLOR, 0);		/* transparent */
+	W(GX_CLEARDEPTH, 0x7fff);
+	W(GX_VIEWPORT, 0 | (0 << 8) | (255 << 16) | (191 << 24));
+	W(MTX_MODE, 0);
+	W(MTX_IDENTITY, 0);
+	if (tri)
+		frustum(-1.0, 1.0, -0.75, 0.75, 1.0, 100.0);
+	else
+		frustum(-1.0, 1.0, -0.75, 0.75, 5.0, 60.0);
+	flush_cmds();
+
+	t0 = usec();
+	while (running) {
+		char c;
+
+		if (read(0, &c, 1) == 1 && (c == 27 || c == 'q'))
+			break;
+
+		/* camera and light: light direction is where the light travels (OpenGL position (5,5,10) w = 0) */
+		W(MTX_MODE, 2);
+		W(MTX_IDENTITY, 0);
+		W(GX_LIGHTCOL, (0 << 30) | RGB15(31, 31, 31));
+		W(GX_LIGHTVEC, (0u << 30) | pack_dir(-5.0, -5.0, -10.0));
+		if (tri)
+			W(GX_POLYATTR, (3 << 6) | (31 << 16));	/* no lighting, no culling, opaque */
+		else
+			W(GX_POLYATTR, 1 | (3 << 6) | (31 << 16));	/* light 0, no culling, opaque */
+
+		if (tri) {
+			translate(0.0, 0.0, -3.0);
+			rotate(3, angle);
+			W(GX_BEGIN, 0);
+			W(GX_COLOR, RGB15(31, 0, 0));
+			W(GX_VTX16, (f12(-1.0) & 0xffff) | ((unsigned int)f12(-1.0) << 16));
+			W(GX_VTX16, 0);
+			W(GX_COLOR, RGB15(0, 31, 0));
+			W(GX_VTX16, (f12(1.0) & 0xffff) | ((unsigned int)f12(-1.0) << 16));
+			W(GX_VTX16, 0);
+			W(GX_COLOR, RGB15(0, 0, 31));
+			W(GX_VTX16, (f12(0.0) & 0xffff) | ((unsigned int)f12(1.0) << 16));
+			W(GX_VTX16, 0);
+			W(GX_END, 0);
+		} else {
+			translate(0.0, 0.0, -45.0);
+			rotate(1, view_rotx);
+			rotate(2, view_roty);
+
+			W(MTX_PUSH, 0);
+			translate(-3.0, -2.0, 0.0);
+			rotate(3, angle);
+			draw_mesh(&g[0]);
+			W(MTX_POP, 1);
+
+			W(MTX_PUSH, 0);
+			translate(3.1, -2.0, 0.0);
+			rotate(3, -2.0 * angle - 9.0);
+			draw_mesh(&g[1]);
+			W(MTX_POP, 1);
+
+			W(MTX_PUSH, 0);
+			translate(-3.1, 4.2, 0.0);
+			rotate(3, -2.0 * angle - 25.0);
+			draw_mesh(&g[2]);
+			W(MTX_POP, 1);
+		}
+		W(GX_SWAP, 0);
+		flush_cmds();
+		angle += 2.0;
+		frames++;
+	}
+	t1 = usec();
+
+	tcsetattr(0, TCSANOW, &old);
+	ioctl(fb, NDSFB_GX_SETUP, 0);
+	if (tty >= 0)
+		ioctl(tty, KDSETMODE, KD_TEXT);
+	printf("dsgx %s: %ld frames in %.2f s = %.1f frames per second\n", tri ? "triangle" : "gears", frames,
+	       (t1 - t0) / 1e6, frames * 1e6 / (double)(t1 - t0));
+	return 0;
+}
