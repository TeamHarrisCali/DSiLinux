+static void on_usr1(int s)
+{
+	sig_review = 1;
+}
+
+static void on_usr2(int s)
+{
+	sig_camera = 1;
+}
+
+/* 1 = another dscam runs and has been told what to show; this one has to end. Otherwise our pid is recorded. */
+static int other_running(int want_review)
+{
+	FILE *f = fopen(PIDFILE, "r");
+	int pid = 0;
+
+	if (f) {
+		if (fscanf(f, "%d", &pid) != 1)
+			pid = 0;
+		fclose(f);
+	}
+	if (pid > 0 && pid != getpid() && kill(pid, 0) == 0) {
+		kill(pid, want_review ? SIGUSR1 : SIGUSR2);
+		return 1;
+	}
+	f = fopen(PIDFILE, "w");
+	if (f) {
+		fprintf(f, "%d\n", getpid());
+		fclose(f);
+	}
+	return 0;
+}
