 static int mic_is_running;
 static u32 dbg_on, dbg_start, dbg_stop, dbg_irq, dbg_full, dbg_empty, dbg_have, dbg_wraps;
 
@@ -198,6 +201,8 @@ void mic_start()
 		dbg_smin = 0x7fff;
 		dbg_smax = -0x8000;
 		dbg_restart_ovr = dbg_restart_stall = 0;
+		ord_known = ord_hi_first = ord_n = 0;
+		ord_x = ord_y = 0;
 		empty_run = 0;
 	}
 	if (dsitouch_active())
@@ -264,6 +269,13 @@ static void dsi_push(s16 sample)
  * the ARM9 sound driver offers as the capture rate). (The first version took the newest sample once per tick at a rate that
  * was twice what was asked for: half speed and a whine from every sample being stored twice.)
  */
+/*
+ * Each FIFO word holds TWO 16 bit samples (the log of w96l: lastraw=00030004, upper half never just the sign of the lower half):
+ * the FIFO's 16364 words a second are 32728 samples a second, the I2S rate. Taking only the lower half was an unfiltered decimation
+ * by two that folded everything above 8 kHz into the voice band (the whine at inconsistent times). Which half is the earlier sample
+ * is not documented: it is found from the data, for a smooth signal the right order has the smaller sum of differences between
+ * neighbouring samples (measured over the first 2048 words after the start; until then low half first).
+ */
 static void dsi_timer_tick(void)
 {
 	u16 cnt = REG_MICCNT;
@@ -283,16 +295,36 @@ static void dsi_timer_tick(void)
 	dbg_full++;
 	while (!(REG_MICCNT & MICCNT_EMPTY) && n--) {
 		u32 raw = REG_MICDATA;
+		s16 lo = (s16)(raw & 0xffff), hi = (s16)(raw >> 16), first, second;
 
 		dbg_raw = raw;
-		if ((raw >> 16) != ((raw & 0x8000) ? 0xffff : 0))	/* more than a sign extension in the upper half? */
+		if ((raw >> 16) != ((raw & 0x8000) ? 0xffff : 0))
 			dbg_hi_other++;
-		dsi_last = (s16)(raw & 0xffff);
-		if (dsi_last < dbg_smin)
-			dbg_smin = dsi_last;
-		if (dsi_last > dbg_smax)
-			dbg_smax = dsi_last;
-		dsi_push(dsi_last);
+		if (!ord_known) {
+			if (ord_n) {
+				ord_x += (u32)(lo > ord_prev_hi ? lo - ord_prev_hi : ord_prev_hi - lo);	/* order lo,hi: hi(n-1) then lo(n) */
+				ord_y += (u32)(hi > ord_prev_lo ? hi - ord_prev_lo : ord_prev_lo - hi);	/* order hi,lo: lo(n-1) then hi(n) */
+			}
+			ord_prev_lo = lo;
+			ord_prev_hi = hi;
+			if (++ord_n >= 2048) {
+				ord_hi_first = ord_y < ord_x;
+				ord_known = 1;
+			}
+		}
+		first = ord_hi_first ? hi : lo;
+		second = ord_hi_first ? lo : hi;
+		dsi_last = second;
+		if (first < dbg_smin)
+			dbg_smin = first;
+		if (second < dbg_smin)
+			dbg_smin = second;
+		if (first > dbg_smax)
+			dbg_smax = first;
+		if (second > dbg_smax)
+			dbg_smax = second;
+		dsi_push(first);
+		dsi_push(second);
 	}
 }
 
@@ -357,9 +389,9 @@ void mic_diag(u32 *touch, u32 *diag, u32 *info)
 	touch[6] = dbg_have;
 	touch[7] = dbg_hi_other;		/* FIFO words whose upper half is not just the sign of the lower half */
 	diag[0] = dbg_raw;			/* the last raw FIFO word */
-	diag[1] = buffer_size;
-	diag[2] = period_size;
-	diag[3] = mic_rate;
+	diag[1] = ord_x;			/* sample order test: sum of differences, low half first */
+	diag[2] = ord_y;			/* ... high half first */
+	diag[3] = ord_hi_first | (ord_known << 1);
 	diag[4] = mic_format;
 	diag[5] = ((u32)(u16)dsi_last << 16) | current_ptr;
 	diag[6] = REG_MICCNT | (REG_TM3CNT_H << 16);
