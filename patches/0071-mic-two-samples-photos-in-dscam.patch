+/* ---- photo list ---- */
+static char names[MAXPHOTOS][24];
+static int nphotos, sel;
+
+static int cmpnames(const void *a, const void *b)
+{
+	return strcmp((const char *)a, (const char *)b);
+}
+
+static void scan_photos(void)
+{
+	DIR *d = opendir(PHOTO_DIR);
+	struct dirent *e;
+
+	nphotos = 0;
+	if (d) {
+		while ((e = readdir(d)) != NULL && nphotos < MAXPHOTOS) {
+			int n = strlen(e->d_name);
+
+			if (n > 8 && n < 24 && !strncmp(e->d_name, "photo", 5) && !strcmp(e->d_name + n - 4, ".bmp"))
+				strcpy(names[nphotos++], e->d_name);
+		}
+		closedir(d);
+	}
+	qsort(names, nphotos, sizeof(names[0]), cmpnames);
+	if (sel >= nphotos)
+		sel = nphotos - 1;
+	if (sel < 0)
+		sel = 0;
+}
+
+/* load photo sel into the texture; 0 = ok */
+static int show_photo(void)
+{
+	char path[64];
+	int r;
+
+	if (!nphotos)
+		return -1;
+	sprintf(path, PHOTO_DIR "/%s", names[sel]);
+	r = bmp_read(path, frame);
+	fprintf(stderr, "dscam: viewer: %s: %s (%d)\n", names[sel], r ? "cannot read" : "loaded", r);
+	if (r)
+		return r;
+	downscale();
+	return gx_texture_load_vbl(0, small, sizeof(small));
+}
+
+/* ---- one running copy, told what to show through signals ---- */
