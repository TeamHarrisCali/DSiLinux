From 2f8b0657ad5211a76b2c955d28f729692256a51e Mon Sep 17 00:00:00 2001
From: TeamHarrisCali <34009957+TeamHarrisCali@users.noreply.github.com>
Date: Fri, 13 Nov 2026 12:14:59 -0600
Subject: [PATCH] wlan0: connect by name on any channel when the scan missed it

w98s: the WPA2 test never sent its connect: the name typed was not in
the scan, which only ever reports channel 1 (no scan-complete event,
no command error). Now:
- the requested name is logged, trailing spaces are dropped, and a
  name that does not match exactly is matched ignoring case;
- a name not in the scan is joined with channel 0 and no BSSID (the
  firmware searches every channel, as ath6kl connects), WPA2 with AES
  when a password was given, and the name is probed for directly
  (WMI_SET_PROBED_SSID, flag "this SSID"), which also finds hidden
  networks;
- the scan asks the firmware for its channel list (as dswifi does) and
  logs the answer, for the channel-1 question.
The new code is in noinline helpers: inside do_connect() gcc 4.0.4
crashed ("unrecognizable insn").

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 linux-2.6.x/arch/arm/mach-nds/dsiwifi.c | 93 ++++++++++++++++++++-----
 1 file changed, 74 insertions(+), 19 deletions(-)

diff --git a/linux-2.6.x/arch/arm/mach-nds/dsiwifi.c b/linux-2.6.x/arch/arm/mach-nds/dsiwifi.c
index 132bb190c..0887e38fe 100644
--- a/linux-2.6.x/arch/arm/mach-nds/dsiwifi.c
+++ b/linux-2.6.x/arch/arm/mach-nds/dsiwifi.c
@@ -200,6 +200,7 @@ static noinline void write_part(const char *name, unsigned int addr, const unsig
 #define WMI_CMD_ERROR_EVENT	0x1005
 #define WMI_REG_DOMAIN_EVENT	0x1006
 #define WMI_SCAN_COMPLETE_EVENT	0x100A
+#define WMI_GET_CHANNEL_LIST_CMD	0x000E		/* answered by a WMI message with the same id: u8 ?, u8 count, u16 MHz[count] */
 
 static unsigned char pkt[2048], rx[2048];
 
@@ -565,6 +566,10 @@ static void handle_pkt(unsigned int hdr, int *ev_scan_done)
 		if (ev_scan_done)
 			*ev_scan_done = 1;
 		break;
+	case WMI_GET_CHANNEL_LIST_CMD:
+		lg("  WMI channel list: %u channels, %u to %u MHz\n", rx[9], rx[10] | (rx[11] << 8),
+		   rx[9] ? rx[10 + 2 * (rx[9] - 1)] | (rx[11 + 2 * (rx[9] - 1)] << 8) : 0);
+		break;
 	case WMI_CMD_ERROR_EVENT:
 		lg("  WMI command error: command %04x error %u\n", rx[8] | (rx[9] << 8), rx[10], 0);
 		break;
@@ -628,6 +633,7 @@ static noinline void wmi_scan(int *bad)
 	memset(b, 0, sizeof(b));
 	mbox_out(1, 1, WMI_SET_BSS_FILTER_CMD, b, 8, bad);		/* none while setting up */
 	mbox_out(1, 1, WMI_SET_PROBED_SSID_CMD, b, 35, bad);		/* entry 0, no SSID: any */
+	mbox_out(1, 1, WMI_GET_CHANNEL_LIST_CMD, b, 0, bad);		/* w98s: every network still on channel 1; what does it allow? */
 	/* one scan over every channel (w98l's channel-by-channel scan with phy mode 11ag, as dswifi, had its channel commands refused and
 	 * stayed on channel 1): channel params with phy mode 11g (2) and no channel list (= all), scan params, all BSSs, start */
 	memset(b, 0, sizeof(b));
@@ -865,6 +871,55 @@ static int wifi_channel_to_mhz(int ch)
 	return ch == 14 ? 2484 : 2412 + (ch - 1) * 5;
 }
 
+/* the network to join: by name (exact, then ignoring case), an open or (with a password) WPA2 network; without a name the strongest
+ * open one. A name not in the scan (it only ever sees channel 1, w98m-w98s) is joined on any channel: the firmware searches for it
+ * (channel 0, no BSSID, as ath6kl does), with a password as WPA2 with AES. noinline: inside do_connect() gcc 4.0.4 crashed. */
+static noinline struct net2 *find_net(void)
+{
+	static struct net2 any;
+	struct net2 *n = 0;
+	int i, pass;
+
+	if (conn_req[0]) {
+		char line[80];
+
+		snprintf(line, sizeof(line), "connect: looking for \"%s\" (%d characters)\n", conn_req, (int)strlen(conn_req));
+		lgs(line);
+	}
+	for (pass = 0; pass < 2 && !n; pass++)
+		for (i = 0; i < nnets; i++) {
+			if (conn_req[0] ? (pass ? strnicmp(nets[i].ssid, conn_req, 33) : strcmp(nets[i].ssid, conn_req)) ||
+			    (strcmp(nets[i].sec, "open") && strcmp(nets[i].sec, "wpa2")) : strcmp(nets[i].sec, "open"))
+				continue;
+			if (!n || nets[i].rssi > n->rssi)
+				n = &nets[i];
+		}
+	if (!n && conn_req[0]) {
+		memset(&any, 0, sizeof(any));
+		strcpy(any.ssid, conn_req);
+		strcpy(any.sec, psk[0] ? "wpa2" : "open");
+		any.group = 4;
+		n = &any;
+		lg(psk[0] ? "connect: not in the scan: the firmware searches every channel for it (WPA2, AES)\n" :
+		   "connect: not in the scan: the firmware searches every channel for it (open)\n", 0, 0, 0);
+	}
+	if (!n)
+		lg("connect: no open network in the scan\n", 0, 0, 0);
+	return n;
+}
+
+/* probe for this name (entry 0, flag 1: this SSID): answered even by a hidden network */
+static noinline void probe_name(const char *ssid, int *bad)
+{
+	static unsigned char b[36];
+
+	memset(b, 0, sizeof(b));
+	b[1] = 1;
+	b[2] = strlen(ssid);
+	memcpy(b + 3, ssid, b[2]);
+	mbox_out(1, 1, WMI_SET_PROBED_SSID_CMD, b, 35, bad);
+}
+
 /* dswifi's wmi_connect() for an open network */
 static noinline void do_connect(void)
 {
@@ -872,19 +927,9 @@ static noinline void do_connect(void)
 	struct net2 *n = 0;
 	int i, bad = 0;
 
-	for (i = 0; i < nnets; i++) {
-		/* by name: an open or (with a password) WPA2 network; without a name: the strongest open one */
-		if (conn_req[0] ? strcmp(nets[i].ssid, conn_req) || (strcmp(nets[i].sec, "open") && strcmp(nets[i].sec, "wpa2")) :
-		    strcmp(nets[i].sec, "open"))
-			continue;
-		if (!n || nets[i].rssi > n->rssi)
-			n = &nets[i];
-	}
-	if (!n) {
-		lg(conn_req[0] ? "connect: no open or WPA2 network of that name in the scan\n" : "connect: no open network in the scan\n",
-		   0, 0, 0);
+	n = find_net();
+	if (!n)
 		return;
-	}
 	wpa2 = !strcmp(n->sec, "wpa2");
 	keys_ok = 0;
 	if (wpa2) {
@@ -901,7 +946,10 @@ static noinline void do_connect(void)
 	{
 		char line[80];
 
-		snprintf(line, sizeof(line), "connect: %s, channel %d, signal %d\n", n->ssid, n->channel, n->rssi);
+		if (n->channel)
+			snprintf(line, sizeof(line), "connect: %s, channel %d, signal %d\n", n->ssid, n->channel, n->rssi);
+		else
+			snprintf(line, sizeof(line), "connect: %s, any channel\n", n->ssid);
 		lgs(line);
 	}
 	memset(b, 0, sizeof(b));				/* BSS filter: none (dswifi uses 4, "current beacon": a report per beacon) */
@@ -915,12 +963,15 @@ static noinline void do_connect(void)
 	b[11] = 5;
 	b[12] = 200;
 	mbox_out(1, 1, WMI_SET_SCAN_PARAMS_CMD, b, 20, &bad);
-	memset(b, 0, sizeof(b));				/* channel params: 11g, the AP's channel */
+	memset(b, 0, sizeof(b));				/* channel params: 11g, the AP's channel (none known: no list = all) */
 	b[2] = 2;
-	b[3] = 1;
-	b[4] = wifi_channel_to_mhz(n->channel) & 0xff;
-	b[5] = wifi_channel_to_mhz(n->channel) >> 8;
+	if (n->channel) {
+		b[3] = 1;
+		b[4] = wifi_channel_to_mhz(n->channel) & 0xff;
+		b[5] = wifi_channel_to_mhz(n->channel) >> 8;
+	}
 	mbox_out(1, 1, WMI_SET_CHANNEL_PARAMS_CMD, b, 6, &bad);
+	probe_name(n->ssid, &bad);
 	b[0] = 0;
 	mbox_out_x(1, 1, 0x2008, WMI_SYNCHRONIZE_CMD, b, 1, &bad);
 	b[0] = 2;						/* power mode: maximum performance */
@@ -961,8 +1012,10 @@ static noinline void do_connect(void)
 	}
 	b[7] = strlen(n->ssid);
 	memcpy(b + 8, n->ssid, b[7]);
-	b[40] = wifi_channel_to_mhz(n->channel) & 0xff;
-	b[41] = wifi_channel_to_mhz(n->channel) >> 8;
+	if (n->channel) {					/* else 0: any channel, any BSSID */
+		b[40] = wifi_channel_to_mhz(n->channel) & 0xff;
+		b[41] = wifi_channel_to_mhz(n->channel) >> 8;
+	}
 	memcpy(b + 42, n->bssid, 6);
 	b[48] = 0x20;
 	mbox_out(1, 1, WMI_CONNECT_CMD, b, 52, &bad);
@@ -1231,6 +1284,8 @@ static int twl_write_proc(struct file *file, const char __user *buffer, unsigned
 				nm++;
 			for (k = 0; nm[k] && nm[k] != '\n' && k < 32; k++)
 				conn_req[k] = nm[k];
+			while (k > 0 && (conn_req[k - 1] == ' ' || conn_req[k - 1] == '\r'))
+				k--;
 			conn_req[k] = 0;
 			conn_tries = 0;
 			conn_pending = 1;
-- 
2.56.0

