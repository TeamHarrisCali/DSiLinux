# BusyBox 1.36.1 applets for the DSi (scripts/build-busybox.sh applies these lines to allnoconfig; docs/BUSYBOX-HUSH-PLAN.md)
# --- the build: NOMMU flat binary, the toolchain's options (as scripts/build-tools.sh) ---
CONFIG_NOMMU=y
CONFIG_EXTRA_CFLAGS="-mcpu=arm946e-s -mfpu=fpe3 -D__PIC__ -fpic -msingle-pic-base -DEMBED -D__uClinux__ -Dlinux -Dunix -Dre_exec=bb_re_exec"
# CONFIG_LFS: no (uClibc 0.9.27 here has no large file support)
CONFIG_FEATURE_DEVPTS=y
CONFIG_LONG_OPTS=y
CONFIG_FEATURE_EDITING=y
CONFIG_FEATURE_EDITING_MAX_LEN=1024
CONFIG_FEATURE_EDITING_HISTORY=255
CONFIG_FEATURE_EDITING_SAVEHISTORY=y
CONFIG_FEATURE_TAB_COMPLETION=y
CONFIG_FEATURE_EDITING_FANCY_PROMPT=y
# --- the shell: hush ---
CONFIG_SHELL_HUSH=y
CONFIG_HUSH=y
CONFIG_SH_IS_HUSH=y
# CONFIG_SH_IS_NONE is not set
CONFIG_BASH_IS_NONE=y
CONFIG_HUSH_BASH_COMPAT=y
CONFIG_HUSH_BRACE_EXPANSION=y
CONFIG_HUSH_INTERACTIVE=y
CONFIG_HUSH_SAVEHISTORY=y
CONFIG_HUSH_JOB=y
CONFIG_HUSH_TICK=y
CONFIG_HUSH_IF=y
CONFIG_HUSH_LOOPS=y
CONFIG_HUSH_CASE=y
CONFIG_HUSH_FUNCTIONS=y
CONFIG_HUSH_LOCAL=y
CONFIG_HUSH_RANDOM_SUPPORT=y
CONFIG_HUSH_MODE_X=y
CONFIG_HUSH_ECHO=y
CONFIG_HUSH_PRINTF=y
CONFIG_HUSH_TEST=y
CONFIG_HUSH_HELP=y
CONFIG_HUSH_EXPORT=y
CONFIG_HUSH_EXPORT_N=y
CONFIG_HUSH_READONLY=y
CONFIG_HUSH_KILL=y
CONFIG_HUSH_WAIT=y
CONFIG_HUSH_COMMAND=y
CONFIG_HUSH_TRAP=y
CONFIG_HUSH_TYPE=y
CONFIG_HUSH_READ=y
CONFIG_HUSH_SET=y
CONFIG_HUSH_UNSET=y
CONFIG_HUSH_ULIMIT=y
CONFIG_HUSH_UMASK=y
CONFIG_HUSH_GETOPTS=y
CONFIG_FEATURE_SH_MATH=y
CONFIG_FEATURE_SH_MATH_64=y
CONFIG_FEATURE_SH_EXTRA_QUIET=y
# --- tools (the plan's list, plus everyday ones that today come as separate programs from the card) ---
CONFIG_AWK=y
CONFIG_FEATURE_AWK_LIBM=y
CONFIG_SED=y
CONFIG_LESS=y
CONFIG_FEATURE_LESS_MAXLINES=9999999
CONFIG_FEATURE_LESS_BRACKETS=y
CONFIG_FEATURE_LESS_FLAGS=y
CONFIG_FEATURE_LESS_REGEXP=y
CONFIG_FEATURE_LESS_WINCH=y
CONFIG_TOP=y
CONFIG_FEATURE_TOP_CPU_USAGE_PERCENTAGE=y
CONFIG_FREE=y
CONFIG_PS=y
CONFIG_WATCH=y
CONFIG_UPTIME=y
CONFIG_SORT=y
CONFIG_FEATURE_SORT_BIG=y
CONFIG_UNIQ=y
CONFIG_DIFF=y
CONFIG_FEATURE_DIFF_LONG_OPTIONS=y
CONFIG_CMP=y
CONFIG_TAR=y
CONFIG_FEATURE_TAR_CREATE=y
CONFIG_FEATURE_TAR_GNU_EXTENSIONS=y
CONFIG_FEATURE_TAR_AUTODETECT=y
CONFIG_FEATURE_SEAMLESS_GZ=y
CONFIG_FEATURE_SEAMLESS_BZ2=y
CONFIG_FEATURE_SEAMLESS_XZ=y
CONFIG_GZIP=y
CONFIG_GUNZIP=y
CONFIG_ZCAT=y
CONFIG_BUNZIP2=y
CONFIG_BZCAT=y
CONFIG_UNXZ=y
CONFIG_XZCAT=y
CONFIG_SHA256SUM=y
CONFIG_MD5SUM=y
CONFIG_WGET=y
CONFIG_FEATURE_WGET_LONG_OPTIONS=y
CONFIG_FEATURE_WGET_STATUSBAR=y
CONFIG_FEATURE_WGET_TIMEOUT=y
CONFIG_NTPD=y
CONFIG_HEAD=y
CONFIG_TAIL=y
CONFIG_FEATURE_FANCY_TAIL=y
CONFIG_CUT=y
CONFIG_TR=y
CONFIG_WC=y
CONFIG_XARGS=y
CONFIG_SEQ=y
CONFIG_BASENAME=y
CONFIG_DIRNAME=y
# CONFIG_DATE: no (needs clock_settime, missing in uClibc 0.9.27; the card has date)
CONFIG_CAT=y
CONFIG_CP=y
CONFIG_MV=y
CONFIG_RM=y
CONFIG_MKDIR=y
CONFIG_RMDIR=y
CONFIG_LN=y
# CONFIG_TOUCH: no (needs utimensat, after kernel 2.6.14; the card has touch)
# CONFIG_STAT: no (needs st_atim, which uClibc 0.9.27 lacks)
CONFIG_TEE=y
CONFIG_YES=y
CONFIG_REALPATH=y
CONFIG_STTY=y
CONFIG_RESET=y
CONFIG_PRINTF=y
